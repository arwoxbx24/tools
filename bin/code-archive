#!/usr/bin/env bash
set -euo pipefail
# U1 (ADR-1): validate before reading secrets; askpass (git single-prompt) skips.
if ! [[ ${CA_ASKPASS:-} == 1 && $# -eq 1 ]]; then
  usage(){ printf '%s\n' 'usage: code-archive <repo>...' 'code-archive --changed' 'code-archive --protect-all' 'code-archive --help'; }
  [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && { usage; exit 0; }
  [[ $# -eq 0 ]] && { usage >&2; exit 64; }
  if [[ "${1:-}" != "--changed" && "${1:-}" != "--protect-all" ]]; then
    re='^[A-Za-z0-9._][A-Za-z0-9._-]*$'
    for a in "$@"; do
      if ! [[ $a =~ $re && $a != . && $a != .. ]]; then
        printf 'err:usage %s\n' "$a" >&2; usage >&2
        printf '%s %s err:usage layer=config invalid-name\n' "$(date +%F_%T)" "${a//[^[:print:]]/?}" >> "${CA_LOG:-/root/workspaces/system/services/gitmirror/code-archive.log}" 2>/dev/null || true
        exit 64
      fi
    done
  fi
fi
CA_ENV_FILE="${CA_ENV_FILE:-/root/workspaces/secrets/gitmirror.env}"
set -a; . "$CA_ENV_FILE"; set +a
[[ -n "${GITLAB_MIRROR_TOKEN:-}" ]] || { echo "err:no-key" >&2; exit 2; }
cd /
# Askpass mode: git invokes this script as GIT_ASKPASS with a single prompt arg.
if [[ ${CA_ASKPASS:-} == 1 && $# -eq 1 ]]; then
  [[ "$1" == *gitlab* ]] || exit 1
  if [[ "$1" == *Username* ]]; then echo oauth2; else echo "$GITLAB_MIRROR_TOKEN"; fi
  exit 0
fi
export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="/root/workspaces/tools/bin/code-archive" CA_ASKPASS=1
CA_GITHUB_BASE="${CA_GITHUB_BASE:-git@github.com:arwoxbx24}"
CA_GITLAB_BASE="${CA_GITLAB_BASE:-https://gitlab.com/arwox24-group}"
CA_REPOS_DIR="${CA_REPOS_DIR:-/home/gitmirror/repos}"
CA_LOG="${CA_LOG:-/root/workspaces/system/services/gitmirror/code-archive.log}"
CA_STATE_DIR="${CA_STATE_DIR:-/home/gitmirror/state}"
CA_NOTIFY_ENV="${CA_NOTIFY_ENV:-/root/workspaces/secrets/services/pm2-notify.env}"
mask(){ sed -E 's#(ghp_|gho_|github_pat_|glpat-|oauth2:)[^@ ]*#***#g'; }
reason(){
  local text="$1" line
  line="$(printf '%s\n' "$text" | mask | LC_ALL=C tr -cd '[:print:]\n' | sed -n '1p')"
  printf '%s' "${line:0:200}"
}
err_layer(){
  local class="$1" why="$2"
  case "$why" in
    *'Could not resolve host'*|*'timed out'*|*'Connection refused'*|*'Connection reset'*) printf network; return;;
  esac
  case "$class" in
    usage|no-key) printf config;;
    fetch|not-found|list-fetch|list-shrunk)
      case "$why" in *'Permission denied'*|*'Authentication failed'*|*'HTTP 403'*|*'HTTP 401'*|*'Repository not found'*) printf auth;; *) printf github;; esac;;
    gitlab|secret|visibility|incomplete)
      case "$why" in *'HTTP 403'*|*'HTTP 401'*|*'http=403'*|*'http=401'*) printf auth;; *) printf gitlab;; esac;;
    init|add|ref|no-space) printf disk;;
    *) printf config;;
  esac
}
state_write(){
  local file="$1" value="$2" tmp="$1.tmp.$$"
  printf '%s\n' "$value" > "$tmp" && mv -f "$tmp" "$file"
}
cleanup_state_tmp(){ rm -f "$CA_STATE_DIR"/*.tmp.$$ "${list_tmp:-}"; }
trap cleanup_state_tmp EXIT
source_gone(){
  local name="$1" org gho
  org="${CA_GITHUB_BASE##*[:/]}"
  gho="$(gh api "repos/$org/$name" 2>&1)" || true
  source_gone_reason="$gho"
  [[ "$gho" == *'HTTP 404'* ]]
}
# Short masked reason (first `!`/`error:`/`fatal:` line, <=200 chars) for
# err:gitlab journal lines, so a failed push/API call is diagnosable.
gitlab_err(){
  local out="$1" line
  line="$(printf '%s\n' "$out" | mask | grep -m1 -E '!|error:|fatal:' || true)"
  [[ -n "$line" ]] || line="$(printf '%s\n' "$out" | mask | grep -m1 . || true)"
  printf '%s' "${line:0:200}"
}
# U7b: notify the owner on a mirror failure. CA_NOTIFY_ENV (default
# pm2-notify.env) is sourced inside a subshell so token/chat values never print
# to journal or stdout. Under CA_NO_NOTIFY=1 the message is appended verbatim to
# $CA_STATE_DIR/notify.out instead of calling Telegram. A failed send never
# changes the archive exit code.
notify_send(){
  local text="$1" token chat
  if [[ "${CA_NO_NOTIFY:-0}" == 1 ]]; then
    printf '%s\n' "$text" >> "${CA_STATE_DIR}/notify.out" 2>/dev/null || true
    return 0
  fi
  (
    token=""; chat=""
    if [[ -f "$CA_NOTIFY_ENV" ]]; then
      set -a; . "$CA_NOTIFY_ENV"; set +a
      token="${TG_BOT_TOKEN:-}"; chat="${TG_CHAT_ID:-}"
    fi
    if [[ -n "$token" && -n "$chat" ]]; then
      curl -s --max-time 10 "https://api.telegram.org/bot${token}/sendMessage" \
        -d "chat_id=${chat}" --data-urlencode "text=$text" >/dev/null 2>&1 || true
    fi
  )
  return 0
}
# One-repo failure wording; err:secret names the key-replacement reason.
notify_fail_msg(){
  local name="$1" result="$2"
  case "$result" in
    err:secret) printf 'в %s найден ключ, копия в GitLab остановлена до замены ключа' "$name";;
    *) printf 'в %s копия в GitLab не выполнена: %s' "$name" "$result";;
  esac
}
# Rule "one message": the first failure creates state/<name>.fail and notifies;
# later failures stay silent; success removes the marker.
notify_fail(){
  local name="$1" result="$2"
  [[ -f "$CA_STATE_DIR/$name.fail" ]] && return 0
  : > "$CA_STATE_DIR/$name.fail"
  notify_send "$(notify_fail_msg "$name" "$result")"
}
notify_ok(){
  local name="$1"
  rm -f "$CA_STATE_DIR/$name.fail"
}
# U8b: ensure the GitLab target project exists and is private, creating it in
# its group if missing. Sets $result and returns 1 on any failure. The token is
# fed on stdin (`-H @-`) so it never appears in the process args.
gitlab_group_id=""
gitlab_created=0
gitlab_project_id=""
gitlab_ensure_project(){
  local name="$1" code body vis
  local group="${CA_GITLAB_BASE##*/}"
  local api="${CA_GITLAB_API:-https://gitlab.com/api/v4}"
  gitlab_created=0
  body="$(mktemp)"
  code=$(printf 'PRIVATE-TOKEN: %s\n' "$GITLAB_MIRROR_TOKEN" | curl -s --max-time 60 -o "$body" -w '%{http_code}' -H @- "$api/projects/$group%2F$name")
  if [[ "$code" == 200 ]]; then
    gitlab_project_id="$(jq -r '.id // ""' "$body")"
    vis=$(jq -r '.visibility // ""' "$body")
    rm -f "$body"
    if [[ "$vis" != "private" ]]; then
      result=err:visibility; error_reason="visibility=$vis"; return 1
    fi
    return 0
  fi
  if [[ "$code" != 404 ]]; then
    rm -f "$body"; result=err:gitlab; error_reason="http=$code"; return 1
  fi
  rm -f "$body"
  # Project missing: resolve the group id once per run, then create the project.
  if [[ -z "${gitlab_group_id:-}" ]]; then
    body="$(mktemp)"
    code=$(printf 'PRIVATE-TOKEN: %s\n' "$GITLAB_MIRROR_TOKEN" | curl -s --max-time 60 -o "$body" -w '%{http_code}' -H @- "$api/groups/$group")
    if [[ "$code" == 200 ]]; then gitlab_group_id="$(jq -r '.id' "$body")"; fi
    rm -f "$body"
    if [[ -z "${gitlab_group_id:-}" ]]; then result=err:gitlab; error_reason="http=$code"; return 1; fi
  fi
  body="$(mktemp)"
  code=$(printf 'PRIVATE-TOKEN: %s\n' "$GITLAB_MIRROR_TOKEN" | curl -s --max-time 60 -o "$body" -w '%{http_code}' -H @- \
      -X POST --data-urlencode "path=$name" --data-urlencode "name=$name" \
      --data-urlencode "namespace_id=$gitlab_group_id" --data-urlencode "visibility=private" \
      "$api/projects")
  if [[ "$code" == 201 ]]; then
    gitlab_project_id="$(jq -r '.id // ""' "$body")"
    gitlab_created=1
  fi
  rm -f "$body"
  if [[ "$code" != 201 ]]; then result=err:gitlab; error_reason="http=$code"; return 1; fi
  return 0
}
# U7c/D15: protect the `*` branch (no delete / no force-push) on a GitLab
# project. POST /projects/:id/protected_branches; success is confirmed by a
# list GET containing a `*` entry (an "already protected" POST may error).
# Sets $result and returns 1 on failure. Token fed on stdin, never in args.
gitlab_protect_branches(){
  local name="$1" pid="$2" code body
  local api="${CA_GITLAB_API:-https://gitlab.com/api/v4}"
  body="$(mktemp)"
  code=$(printf 'PRIVATE-TOKEN: %s\n' "$GITLAB_MIRROR_TOKEN" | curl -s --max-time 60 -o "$body" -w '%{http_code}' -H @- \
      -X POST --data-urlencode "name=*" --data-urlencode "push_access_level=40" \
      --data-urlencode "merge_access_level=40" --data-urlencode "allow_force_push=false" \
      "$api/projects/$pid/protected_branches")
  rm -f "$body"
  # Success is defined by the list holding a `*` entry, not the POST alone.
  body="$(mktemp)"
  code=$(printf 'PRIVATE-TOKEN: %s\n' "$GITLAB_MIRROR_TOKEN" | curl -s --max-time 60 -o "$body" -w '%{http_code}' -H @- \
      "$api/projects/$pid/protected_branches")
  if jq -e --arg n '*' '.[] | select(.name == $n)' "$body" >/dev/null 2>&1; then
    rm -f "$body"; return 0
  fi
  rm -f "$body"; result=err:gitlab; error_reason="protect http=$code"; return 1
}
# Mirror one repo. On success sets $result (ok|ok:created) and returns 0; on
# failure sets $result (err:<why>) and returns non-zero. Called in an if
# condition so a failure doesn't abort the whole pass.
mirror_name(){
  local name="$1" src dst existing=0 ferr
  src="$CA_GITHUB_BASE/$name.git"; dst="$CA_REPOS_DIR/$name.git"
  result=ok; error_reason=""
  if [[ -d "$dst" ]]; then
    existing=1
    # U2: clean leaked credentials / mirror refspec from every remote of an existing copy.
    for r in $(git --git-dir="$dst" remote); do
      git --git-dir="$dst" config --unset-all "remote.$r.mirror" || true
      git --git-dir="$dst" config --unset-all "remote.$r.fetch" '^\+refs/\*:refs/\*$' || true
      u=$(git --git-dir="$dst" config --get "remote.$r.url" || true)
      if [[ "$u" == https://*"@"* ]]; then git --git-dir="$dst" remote set-url "$r" "https://${u##https://*@}"; fi
    done
    git --git-dir="$dst" remote set-url github "$src"
  else
    # U1 (ADR-3): probe a new source first; a missing one is err:not-found.
    # SSH denies (revoked key / lost access) print the same "Repository not
    # found" text, so confirm via the GitHub API's HTTP 404 before silencing.
    if ! lr="$(LC_ALL=C timeout 30 git -c core.sshCommand='ssh -o BatchMode=yes -o ConnectTimeout=10' ls-remote "$src" 2>&1)"; then
      if [[ "$lr" == *"does not appear to be a git repository"* ]]; then
        result=err:not-found; return 1
      fi
      if [[ "$lr" == *"Repository not found"* ]]; then
        if source_gone "$name"; then
          error_reason="$lr"
          result=err:not-found; return 1
        fi
      fi
    fi
    git init -q --bare "$dst" || { result=err:init; error_reason='git init failed'; return 1; }
    git --git-dir="$dst" remote add github "$src" || { result=err:add; error_reason='git remote add failed'; return 1; }
    result=ok:created
  fi
  # U3: only accumulate — fetch into temp space, propagate to real refs, archiving rewrites.
  ferr="$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 --git-dir="$dst" fetch -q --refmap= github '+refs/heads/*:refs/incoming/heads/*' '+refs/tags/*:refs/incoming/tags/*' 2>&1)" || {
    # U7: if an existing copy's source is gone, keep the copy untouched and report kept.
    if (( existing )) && [[ -n "$(git --git-dir="$dst" for-each-ref --count=1 --format='%(refname)' refs/heads refs/tags)" ]] \
       && { [[ "$ferr" == *"Repository not found"* || "$ferr" == *"does not appear to be a git repository"* ]]; }; then
      if source_gone "$name"; then
        result=kept:source-gone; return 0
      fi
      error_reason="$ferr${source_gone_reason:+$'\n'$source_gone_reason}"
    else
      error_reason="$ferr"
    fi
    result=err:fetch; return 1
  }
  # U7: an empty source produces no incoming refs — nothing to mirror.
  if [[ -z "$(git --git-dir="$dst" for-each-ref --count=1 --format='%(refname)' refs/incoming/)" ]]; then
    result=skip:empty; return 0
  fi
  while read -r ref obj; do
    case "$ref" in
      refs/incoming/heads/*) kind=heads; leaf="${ref#refs/incoming/heads/}";;
      refs/incoming/tags/*) kind=tags; leaf="${ref#refs/incoming/tags/}";;
      *) continue;;
    esac
    real="refs/$kind/$leaf"
    if git --git-dir="$dst" rev-parse -q --verify "$real" >/dev/null 2>&1; then
      old=$(git --git-dir="$dst" rev-parse "$real")
      if git --git-dir="$dst" merge-base --is-ancestor "$old" "$obj" 2>/dev/null; then
        git --git-dir="$dst" update-ref "$real" "$obj"
      else
        ts="$(date +%Y%m%d-%H%M%S)"; base="refs/$kind/archive/$ts"
        rn="$base/$leaf"; n=0
        while git --git-dir="$dst" rev-parse -q --verify "$rn" >/dev/null 2>&1; do n=$((n+1)); rn="${base}-${n}/$leaf"; done
        git --git-dir="$dst" update-ref "$rn" "$old"
        git --git-dir="$dst" update-ref "$real" "$obj"
      fi
    else
      if ! git --git-dir="$dst" update-ref "$real" "$obj" 2>/dev/null; then
        # A child ref blocks its parent (foo/bar blocks foo): archive all
        # children first, then retry the parent ref.
        ts="$(date +%Y%m%d-%H%M%S)"; base="refs/$kind/archive/$ts"
        while read -r occupied; do
          occupied_leaf="${occupied#refs/$kind/}"
          rn="$base/$occupied_leaf"; n=0
          while git --git-dir="$dst" rev-parse -q --verify "$rn" >/dev/null 2>&1; do n=$((n+1)); rn="${base}-${n}/$occupied_leaf"; done
          git --git-dir="$dst" update-ref "$rn" "$(git --git-dir="$dst" rev-parse "$occupied")" \
            && git --git-dir="$dst" update-ref -d "$occupied" \
            || { result=err:ref; error_reason='update-ref failed'; return 1; }
          result="ok:ref-conflict archive/$ts/$occupied_leaf"
        done < <(git --git-dir="$dst" for-each-ref --format='%(refname)' "$real/")
        # U7: the new ref is blocked because an ancestor name is already a ref
        # (e.g. foo/bar arrives while foo exists). Archive every occupying
        # ancestor under archive/<ts>/<name>, remove it, then retry.
        p="$leaf"
        while [[ "$p" == */* ]]; do
          p="${p%/*}"
          if git --git-dir="$dst" rev-parse -q --verify "refs/$kind/$p" >/dev/null 2>&1; then
            ts="$(date +%Y%m%d-%H%M%S)"; base="refs/$kind/archive/$ts"
            rn="$base/$p"; n=0
            while git --git-dir="$dst" rev-parse -q --verify "$rn" >/dev/null 2>&1; do n=$((n+1)); rn="${base}-${n}/$p"; done
            git --git-dir="$dst" update-ref "$rn" "$(git --git-dir="$dst" rev-parse "refs/$kind/$p")"
            git --git-dir="$dst" update-ref -d "refs/$kind/$p"
            result="ok:ref-conflict archive/$ts/$p"
          fi
        done
        git --git-dir="$dst" update-ref "$real" "$obj" || { result=err:ref; error_reason='update-ref failed'; return 1; }
      fi
    fi
  done < <(git --git-dir="$dst" for-each-ref --format='%(refname) %(objectname)' refs/incoming/)
  while read -r ref _; do git --git-dir="$dst" update-ref -d "$ref"; done < <(git --git-dir="$dst" for-each-ref --format='%(refname)' refs/incoming/)
  # U8a: push to GitLab without rewrite; on rejection, retry with rewritten/<timestamp>/<name>
  if [[ "$CA_GITLAB_BASE" == /* ]]; then
    # Local path mode: create bare repo if missing
    gl_path="$CA_GITLAB_BASE/$name.git"
    if [[ ! -d "$gl_path" ]]; then
      if ! gl_out="$(git init -q --bare "$gl_path" 2>&1)"; then result=err:gitlab; error_reason="$gl_out"; return 1; fi
    fi
    gl_dest="$gl_path"
  else
    # HTTPS mode: set up gitlab remote
    gl_dest="$CA_GITLAB_BASE/$name.git"
    if git --git-dir="$dst" config --get remote.gitlab.url >/dev/null 2>&1; then
      if ! gl_out="$(git --git-dir="$dst" remote set-url gitlab "$gl_dest" 2>&1)"; then result=err:gitlab; error_reason="$gl_out"; return 1; fi
    else
      if ! gl_out="$(git --git-dir="$dst" remote add gitlab "$gl_dest" 2>&1)"; then result=err:gitlab; error_reason="$gl_out"; return 1; fi
    fi
    gl_dest="gitlab"
    # U8b: verify the target project exists and is private (creating it if
    # missing) before pushing.
    if [[ "$CA_GITLAB_BASE" == https://* ]] && ! gitlab_ensure_project "$name"; then
      return 1
    fi
    # U7c: protect the `*` branch (no delete/force-push) when the project was
    # just created.
    if [[ "$CA_GITLAB_BASE" == https://* ]] && [[ "$gitlab_created" == 1 ]]; then
      gitlab_created=0
      gitlab_protect_branches "$name" "$gitlab_project_id" || return 1
    fi
  fi
  # U8a: push all heads+tags without force; on a "not fast-forward" rejection
  # archive the rejected ref under rewritten/<ts>/<dest-name> and keep going.
  gl_push "$dst" 'refs/heads/*:refs/heads/*' 'refs/tags/*:refs/tags/*' || return 1
  if ! gl_refs="$(git --git-dir="$dst" ls-remote --heads --tags "$gl_dest" 2>&1)"; then
    result=err:gitlab; error_reason="$gl_refs"; return 1
  fi
  missing=()
  while read -r ref obj; do
    [[ -n "$ref" ]] || continue
    if ! awk -v obj="$obj" '$1 == obj { found=1 } END { exit !found }' <<<"$gl_refs"; then
      missing+=("$ref")
    fi
  done < <(git --git-dir="$dst" for-each-ref --format='%(refname) %(objectname)' refs/heads refs/tags)
  if (( ${#missing[@]} )); then
    result=err:incomplete; error_reason="${#missing[@]} missing"; return 1
  fi
  if [[ -n "$rewritten_first" ]]; then
    result="ok:gitlab-rewritten $rewritten_first"
  fi
  return 0
}
# U8a: push refspecs (`$@`) from repo $1 to $gl_dest without force. A rejected
# ref that is not a fast-forward is archived under rewritten/<ts>/<dest-name>
# (the name is taken from the destination side, so `refs/heads/server/*`
# becomes server/<branch>) rather than failing the pass. On a hard unhandled
# failure sets $result to err:gitlab and returns 1; $rewritten_first is '' after
# a clean push.
# U7f: expand a (possibly wildcard) refspec `src:dst` into explicit `src:dst`
# pairs over the refs currently present in repo $1 (`*` in src and dst align). A
# ref deleted mid-push is simply absent from the result instead of failing the
# push with "does not match any".
expand_refspec(){
  local repo="$1" rs="$2" src dst pre suf ref mid
  src="${rs%%:*}"; dst="${rs#*:}"
  if [[ "$src" == *"*"* ]]; then
    pre="${src%%\**}"
    suf="${src##*\*}"
    while read -r ref; do
      [[ "$ref" == "$pre"*"$suf" ]] || continue
      mid="${ref#"$pre"}"; mid="${mid%"$suf"}"
      printf '%s:%s\n' "$ref" "${dst/\*/$mid}"
    done < <(git --git-dir="$repo" for-each-ref --format='%(refname)' "$pre")
  else
    printf '%s:%s\n' "$src" "$dst"
  fi
}
gl_push(){
  local repo="$1"; shift
  local line refspec ref_src ref_dest ref_category dest_name ts rewritten_ref retry_out retry_rc obj
  local rr rs retry_refs
  push_out=$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 --git-dir="$repo" push --porcelain "$gl_dest" "$@" 2>&1); push_rc=$?
  # U7f: a source ref vanished between composing the ref list and the push
  # ("error: src refspec <ref> does not match any"), e.g. ship deletes a merged
  # branch while pushing. Not a failure: re-push once against an explicit
  # list of the refs that still exist, so the vanished one is simply skipped.
  if [[ "$push_rc" != 0 && "$push_out" == *"does not match any"* ]]; then
    retry_refs=()
    for rs in "$@"; do
      while read -r rr; do retry_refs+=("$rr"); done < <(expand_refspec "$repo" "$rs")
    done
    push_out=$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 --git-dir="$repo" push --porcelain "$gl_dest" "${retry_refs[@]}" 2>&1); push_rc=$?
  fi
  # U7b: a rejected push whose barrier reports a leaked secret fails as err:secret.
  if [[ "$push_out" == *"BLOCKED: secret-gate"* ]]; then result="err:secret"; error_reason="$push_out"; return 1; fi
  rewritten_first=""
  while read -r line; do
    [[ "$line" == "!"* ]] || continue
    refspec=$(printf '%s\n' "$line" | awk '{print $2}')
    ref_src="${refspec%%:*}"
    ref_dest="${refspec#*:}"
    # Already archived the exact object? Then a re-push must not add a second
    # rewritten ref — mark it handled and keep going (idempotent retries).
    obj="$(git --git-dir="$repo" rev-parse "$ref_src" 2>/dev/null || true)"
    if git --git-dir="$repo" ls-remote "$gl_dest" 'refs/*/rewritten/*' 2>/dev/null | awk -v o="$obj" '$1 == o { found=1 } END { exit !found }'; then
      rewritten_first="rewritten/existing"
      continue
    fi
    dest_rest="${ref_dest#refs/}"    # heads/main | heads/server/main
    ref_category="${dest_rest%%/*}"  # heads|tags
    dest_name="${dest_rest#*/}"      # main | server/main
    ts="$(date +%Y%m%d-%H%M%S)"
    rewritten_ref="refs/$ref_category/rewritten/$ts/$dest_name"
    retry_out=$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 --git-dir="$repo" push --porcelain "$gl_dest" "$ref_src:$rewritten_ref" 2>&1); retry_rc=$?
    if [[ "$retry_out" == *"BLOCKED: secret-gate"* ]]; then result="err:secret"; error_reason="$retry_out"; return 1; fi
    printf '%s\n' "$retry_out" | mask
    if [[ "$retry_rc" != 0 ]]; then result="err:gitlab"; error_reason="$retry_out"; return 1; fi
    if [[ -z "$rewritten_first" ]]; then rewritten_first="rewritten/$ts/$dest_name"; fi
  done <<< "$push_out"
  if [[ -z "$rewritten_first" && "$push_rc" != 0 ]]; then
    result="err:gitlab"; error_reason="$push_out"; return 1
  fi
  return 0
}
# Journal one result line for the current `name`.
journal_local(){
  local line class why
  if [[ "$result" == err:* ]]; then
    class="${result#err:}"; why="$(reason "${error_reason:-$result}")"
    line="$(printf '%s %s %s layer=%s %s\n' "$(date +%F_%T)" "$name" "$result" "$(err_layer "$class" "${error_reason:-$why}")" "$why" | mask)"
  else
    line="$(printf '%s %s %s\n' "$(date +%F_%T)" "$name" "$result" | mask)"
  fi
  printf '%s\n' "$line"
  printf '%s\n' "$line" >> "$CA_LOG"
}
# U7c/D15: --protect-all — protect the `*` branch across every project of the
# GitLab group. The group's projects are paged (per_page=100) via the API and
# each is protected; per-project journal lines plus a summary line are logged.
protect_all(){
  # `name` and `result` are globals read by journal_local; keep them non-local.
  local api group page rows row pid code body
  group="${CA_GITLAB_BASE##*/}"
  api="${CA_GITLAB_API:-https://gitlab.com/api/v4}"
  ok=0; err=0; skipped=0
  page=1
  while :; do
    body="$(mktemp)"
    code=$(printf 'PRIVATE-TOKEN: %s\n' "$GITLAB_MIRROR_TOKEN" | curl -s --max-time 60 -o "$body" -w '%{http_code}' -H @- \
        "$api/groups/$group/projects?per_page=100&page=$page")
    if [[ "$code" != 200 ]]; then
      rm -f "$body"
      name="$group"; result=err:gitlab; error_reason="list http=$code"; journal_local
      err=$((err+1)); break
    fi
    mapfile -t rows < <(jq -r '.[] | [.id, .path] | @tsv' "$body")
    rm -f "$body"
    [[ ${#rows[@]} -eq 0 ]] && break
    for row in "${rows[@]}"; do
      IFS=$'\t' read -r pid name <<< "$row"
      [[ -n "$pid" && -n "$name" ]] || continue
      if gitlab_protect_branches "$name" "$pid"; then
        result=ok; ok=$((ok+1))
      else
        err=$((err+1))
      fi
      journal_local
    done
    (( ${#rows[@]} < 100 )) && break
    page=$((page+1))
  done
  sum="=== protect-all $(date +%F_%T) | ok=$ok err=$err skipped=$skipped ==="
  printf '%s\n' "$sum"
  printf '%s\n' "$sum" >> "$CA_LOG"
  return $(( err > 0 ? 1 : 0 ))
}
# Mirror one name under a free-space floor `min` (KB); prints and logs its
# journal line and bumps ok/err. On a successful mirror `result` is ok/ok:created.
process_one(){
  local name="$1" min="$2" failed=0
  mkdir -p "$CA_STATE_DIR"
  exec {lockfd}>"${CA_STATE_DIR}/$name.lock"
  flock "$lockfd"
  avail=$(df --output=avail -k "$CA_REPOS_DIR" 2>/dev/null | tail -n1 | tr -d '[:space:]' || true)
  if [[ "$avail" =~ ^[0-9]+$ ]] && (( avail >= min )); then
    if mirror_name "$name"; then
      case "$result" in
        skip:*) skipped=$((skipped+1));;
        *) ok=$((ok+1));;
      esac
    else
      err=$((err+1)); failed=1
    fi
  else
    result=err:no-space; error_reason="available=${avail:-unknown}KB minimum=${min}KB"; err=$((err+1)); failed=1
  fi
  # U7b: first failure creates state/<name>.fail and notifies; --changed
  # collects names for one pass summary).
  if (( failed )); then
    # U1 (ADR-3): err:not-found never notifies the owner nor leaves a .fail.
    if [[ "$result" != err:not-found ]]; then
      if (( changed )); then
        if [[ ! -f "$CA_STATE_DIR/$name.fail" ]]; then
          : > "$CA_STATE_DIR/$name.fail"
          changed_failed+=("$name")
        fi
      else
        notify_fail "$name" "$result"
      fi
    fi
  else
    notify_ok "$name"
  fi
  journal_local
  exec {lockfd}>&-
}
mkdir -p "$CA_REPOS_DIR" "$(dirname "$CA_LOG")" "$CA_STATE_DIR"
if [[ "${1:-}" == "--changed" || "${1:-}" == "--protect-all" ]]; then
  exec {passfd}>"${CA_STATE_DIR}/pass.lock"
  if ! flock -n "$passfd"; then
    printf '%s pass busy\n' "$(date +%F_%T)" >> "$CA_LOG"
    exit 0
  fi
fi
if [[ "${1:-}" == "--protect-all" ]]; then
  mkdir -p "$(dirname "$CA_LOG")" "$CA_STATE_DIR"
  protect_all
  exit $?
fi
ok=0; err=0; skipped=0
changed=0
changed_failed=()
if [[ "${1:-}" == "--changed" ]]; then
  changed=1
  shift
  org="${CA_GITHUB_BASE##*[:/]}"
  # D5 source: list of "<name>\t<pushed_at>\t<size_kb>\t<archived>" rows. Use a
  # provided file (tests) or fetch the org's repos from GitHub via gh api.
  if [[ -n "${CA_LIST_FILE:-}" ]]; then
    list_file="$CA_LIST_FILE"
  else
    list_file="$(mktemp)"; list_tmp="$list_file"
    if ! gh api --paginate "/orgs/$org/repos?per_page=100" \
         -q '.[] | [.name, .pushed_at, (.size|tostring), (.archived|tostring)] | @tsv' > "$list_file"; then
      name="$org"; result=err:list-fetch; error_reason='gh api failed'; journal_local
      notify_send "не удалось получить список репозиториев GitHub — ночной проход сорван"
      echo "err:list-fetch" >&2
      exit 2
    fi
  fi
  # D3 completeness check: a list far smaller than the previous pass means the
  # source shrank (e.g. mass deletion) — refuse rather than silently drop copies.
  prev=""
  if [[ -f "$CA_STATE_DIR/list-count" ]]; then
    prev=$(<"$CA_STATE_DIR/list-count")
    [[ "$prev" =~ ^[0-9]+$ ]] || prev=""
  fi
  cur=$(wc -l < "$list_file")
  if [[ -n "$prev" ]] && (( cur < prev - 1 )); then
    name="$org"; result=err:list-shrunk; error_reason="$prev to $cur"; journal_local
    notify_send "список репозиториев GitHub сократился ($prev→$cur) — ночной проход остановлен"
    exit 2
  fi
  state_write "$CA_STATE_DIR/list-count" "$cur"
  mapfile -t rows < "$list_file"
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r name pushed size archived <<< "$row"
    [[ -n "$name" ]] || continue
    [[ "$archived" == "true" ]] && { skipped=$((skipped+1)); continue; }
    if [[ -d "$CA_REPOS_DIR/$name.git" ]] \
       && [[ -f "$CA_STATE_DIR/$name.pushed_at" ]] \
       && [[ "$(<"$CA_STATE_DIR/$name.pushed_at")" == "$pushed" ]]; then
      skipped=$((skipped+1)); continue
    fi
    # D10: keep at least 2 GiB + this repo's size free before mirroring it.
    process_one "$name" "$(( ${CA_FREE_MIN_KB:-2097152} + ${size:-0} ))"
    if [[ "$result" == ok* ]]; then
      state_write "$CA_STATE_DIR/$name.pushed_at" "$pushed"
    fi
  done
  # U7b: one consolidated owner message per night pass listing repos that moved
  # into failure (names are deduped by the .fail marker in process_one).
  if (( ${#changed_failed[@]} > 0 )); then
    notify_send "копии в GitLab не выполнены: ${changed_failed[*]}"
  fi
else
  for name; do
    process_one "$name" "${CA_FREE_MIN_KB:-2097152}"
    if [[ "$result" == ok* && -n "${CA_LIST_FILE:-}" && -f "$CA_LIST_FILE" ]]; then
      pushed=$(awk -F '\t' -v wanted="$name" '$1 == wanted { print $2; exit }' "$CA_LIST_FILE")
      [[ -n "$pushed" ]] && state_write "$CA_STATE_DIR/$name.pushed_at" "$pushed"
    fi
  done
fi
sum="=== pass $(date +%F_%T) | ok=$ok err=$err skipped=$skipped ==="
printf '%s\n' "$sum"
printf '%s\n' "$sum" >> "$CA_LOG"
if (( err == 0 )); then state_write "${CA_LAST_OK:-/root/workspaces/system/services/gitmirror/last-ok}" "$(date +%s)"; fi
pass_rc=$(( err > 0 ? 1 : 0 ))
drill_rc=0
if (( changed )) && [[ $(date +%u) == "${CA_DRILL_DOW:-1}" ]]; then
  if "${CA_DRILL_CMD:-$(dirname "$0")/code-archive-drill}"; then :; else drill_rc=$?; fi
  if [[ -s "$CA_STATE_DIR/drill.mismatch" ]]; then
    if [[ ! -f "$CA_STATE_DIR/drill.fail" ]]; then
      : > "$CA_STATE_DIR/drill.fail"
      notify_send "недельная проверка архива: в GitLab неполные копии: $(tr '\n' ' ' < "$CA_STATE_DIR/drill.mismatch")"
    fi
  else
    rm -f "$CA_STATE_DIR/drill.fail"
  fi
fi
exit $(( pass_rc > drill_rc ? pass_rc : drill_rc ))
