#!/usr/bin/env bash
set -u
umask 077
bin=$(cd -- "$(dirname -- "$0")" && pwd)
. "$bin/git-auto-lib"

ship_bin="$bin/ship"
SHIP_POST_STATE_DIR=${SHIP_POST_STATE_DIR:-/root/workspaces/tools/state/ship-post}
SHIP_POST_BEADS_ROOT=${SHIP_POST_BEADS_ROOT:-/root/workspaces/projects}
SHIP_POST_SINCE=${SHIP_POST_SINCE:-1791205200}
BEADS_ACTOR=${BEADS_ACTOR:-}
SHIP_POST_RETRY_SECONDS=${SHIP_POST_RETRY_SECONDS:-30}
[[ $SHIP_POST_RETRY_SECONDS =~ ^[1-9][0-9]*$ ]] || { echo 'ship-post: invalid retry interval' >&2; exit 2; }

dry_run=0; watch=0; submit=0; submit_wt=''; submit_atom=''; submit_tz=''
submit_evidence=''; submit_files=(); filter_atom=''

usage(){ cat >&2 <<'USAGE'
usage: ship-post [--dry-run]
       ship-post --watch [--atom <id>]
       ship-post --submit <worktree> --atom <id> --tz <path#U2> --evidence <text> --files <file>...
USAGE
exit 2
}

while [[ $# -gt 0 ]]; do
	case $1 in --atom|--submit|--tz|--evidence) [[ $# -ge 2 && -n $2 && $2 != --* ]] || usage ;; esac
	case $1 in
		--dry-run) dry_run=1; shift ;;
		--watch) watch=1; shift ;;
		--atom) filter_atom=${2:-}; submit_atom=${2:-}; shift 2 ;;
		--submit) submit=1; submit_wt=${2:-}; shift 2 ;;
		--tz) submit_tz=${2:-}; shift 2 ;;
		--evidence) submit_evidence=${2:-}; shift 2 ;;
		--files) shift; while [[ $# -gt 0 && $1 != -* ]]; do submit_files+=("$1"); shift; done ;;
		--) shift; submit_files+=("$@"); break ;;
		*) usage ;;
	esac
done
watch_filter=$filter_atom

usage_err(){ local msg=$1; echo "ship-post: $msg" >&2; exit 2; }
die(){ echo "ship-post: $*" >&2; exit 1; }

# ── repo / worktree helpers ──────────────────────────────────────────

resolve_repos(){
	local list name git_dir repo slug
	if [[ -n ${SHIP_POST_REPOS:-} ]]; then
		list=$SHIP_POST_REPOS
		IFS=':' read -ra _repos <<< "$list"
		return
	fi
	_repos=()
	while IFS=$'\t' read -r name git_dir repo slug; do
		_repos+=("$repo")
	done < <(ga_roots)
}

slugify(){ printf '%s' "$1" | sha256sum | cut -d ' ' -f1; }

receipt_file(){
	local repo=$1 atom=$2 sha=$3
	echo "$SHIP_POST_STATE_DIR/receipts/$(slugify "$repo")/$atom/$sha"
}

inflight_file(){
	local repo=$1 atom=$2
	echo "$SHIP_POST_STATE_DIR/inflight/$(slugify "$repo")/$atom"
}

lock_file(){
	local repo=$1
	echo "$SHIP_POST_STATE_DIR/locks/$(slugify "$repo").lock"
}

bd_cmd(){ (cd "$SHIP_POST_BEADS_ROOT" && env BEADS_ACTOR="$BEADS_ACTOR" bd "$@"); }

submit_receipt_file(){
	local repo=$1 wt=$2 atom=$3 sha=$4
	echo "$SHIP_POST_STATE_DIR/submissions/$(slugify "$repo")/$(slugify "$wt")/$atom/$sha"
}

write_submit_receipt(){
	local repo=$1 wt=$2 atom=$3 sha=$4 evidence=$5 file
	file=$(submit_receipt_file "$repo" "$wt" "$atom" "$sha")
	mkdir -p "$(dirname "$file")" || return 1
	printf 'repo=%s\nworktree=%s\natom=%s\nsha=%s\nevidence=%s\n' "$repo" "$wt" "$atom" "$sha" "$evidence" > "$file.tmp" && mv "$file.tmp" "$file"
}

# ── submit mode ──────────────────────────────────────────────────────

do_submit(){
	local wt=$1 atom=$2 tz=$3 evidence=$4; shift 4
	local files=("$@")

	[[ $watch == 0 && $dry_run == 0 ]] || usage_err "--submit cannot be combined with --watch or --dry-run"
	[[ -n $evidence ]] || usage_err "--evidence required"
	[[ $atom =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || usage_err "invalid atom: $atom"
	[[ -n $tz ]] || usage_err "--tz required"
	[[ $wt == /* && -d $wt ]] || usage_err "worktree must be an absolute directory: $wt"
	[[ ${#files[@]} -gt 0 ]] || usage_err "--files list empty"

	local wt_real
	wt_real=$(realpath "$wt" 2>/dev/null) || usage_err "cannot resolve worktree: $wt"
	[[ $wt_real == "$wt" ]] || usage_err "worktree must be absolute: $wt"
	[[ -f $wt_real/.git && ! -d $wt_real/.git ]] || usage_err "worktree must be linked: $wt_real"
	local wt_top
	wt_top=$(git -C "$wt_real" rev-parse --show-toplevel 2>/dev/null) || usage_err "not a git repository: $wt_real"
	[[ $wt_top == "$wt_real" ]] || usage_err "worktree subdirectory not allowed: $wt"
	local registered=0 line
	while IFS= read -r line; do [[ $line == "worktree $wt_real" ]] && registered=1; done < <(git -C "$wt_real" worktree list --porcelain)
	[[ $registered == 1 ]] || usage_err "not a registered linked worktree: $wt_real"

	local repo common name
	common=$(git -C "$wt_real" rev-parse --path-format=absolute --git-common-dir) || die "cannot locate repository"
	repo=$(dirname "$common")
	name=$(ga_repo_of "$repo" 2>/dev/null) || name=''
	resolve_repos
	local allowed=0 candidate cand
	for candidate in "${_repos[@]}"; do
		cand=$(realpath "$candidate" 2>/dev/null) || continue
		[[ $repo == "$cand" || $repo == "$cand"/* ]] && allowed=1
	done
	[[ $allowed == 1 ]] || usage_err "repository is not served by courier: $repo"
	local branch caller
	branch=$(git -C "$wt_real" symbolic-ref --short -q HEAD 2>/dev/null) || usage_err "cannot get branch"
	case $BEADS_ACTOR in Codex|codex) caller=codex ;; Claude|'Claude Code'|claude) caller=claude ;; *) usage_err "unknown BEADS_ACTOR: ${BEADS_ACTOR:-empty}" ;; esac
	[[ $branch == "$caller/$atom" || $branch == "$caller/$atom"-* ]] || usage_err "branch $branch must match $caller/$atom or $caller/$atom-<topic>"
	[[ $wt_real == */.worktrees/"$caller"/* ]] || usage_err "worktree must use .worktrees/<agent>/<task>"

	local atom_json
	atom_json=$(bd_cmd show "$atom" --json 2>/dev/null) || usage_err "bd show $atom failed"
	local status assignee assignee_raw
	status=$(jq -r '.[0].status // empty' <<< "$atom_json" 2>/dev/null)
	assignee_raw=$(jq -r '.[0].assignee // empty' <<< "$atom_json" 2>/dev/null)
	assignee=$assignee_raw
	case $assignee in Codex|codex) assignee=codex ;; Claude|'Claude Code'|claude) assignee=claude ;; esac
	[[ -n $assignee && $assignee == "$caller" ]] || usage_err "atom $atom assignee must be $caller"
	BEADS_ACTOR=$assignee_raw
	[[ $status == in_progress || $status == closed ]] || usage_err "atom $atom status=$status"

	local tz_path=${tz%%#*} tz_suffix="#${tz#*#}" tz_abs
	[[ $tz_suffix =~ ^#U[0-9]+$ ]] || usage_err "--tz must end with #U<number>"
	[[ $tz_path != /* && $tz_path != . && $tz_path != .. && $tz_path != ./* && $tz_path != */./* && $tz_path != *'/../'* && $tz_path != ../* && $tz_path != *'//' && $tz_path != *['*?['']'* ]] || usage_err "invalid ТЗ path: $tz_path"
	tz_abs=$(realpath "$wt_real/$tz_path" 2>/dev/null) || usage_err "cannot resolve ТЗ: $tz_path"
	[[ -f $tz_abs && $tz_abs == "$wt_real"/* ]] || usage_err "ТЗ must be an existing file inside worktree: $tz_path"
	local tz_stored="$tz_abs$tz_suffix"

	local seen_outside=0 f abs_f resolved parent literal
	local -A file_set
	for f in "${files[@]}"; do
		[[ -n $f && $f != /* && $f != . && $f != .. && $f != ./* && $f != ../* && $f != */./* && $f != */../* && $f != *'//' && $f != -* && $f != *['*?['']'*] && $f != *:* ]] || { echo "ship-post: invalid file path: $f" >&2; seen_outside=1; continue; }
		[[ -z ${file_set[$f]:-} ]] || { echo "ship-post: duplicate file: $f" >&2; seen_outside=1; continue; }
		file_set[$f]=1
		abs_f="$wt_real/$f"
		if [[ -e $abs_f || -L $abs_f ]]; then
			resolved=$(realpath "$abs_f" 2>/dev/null) || { echo "ship-post: cannot resolve file: $f" >&2; seen_outside=1; continue; }
			[[ -f $resolved && $resolved == "$wt_real"/* ]] || { echo "ship-post: file outside worktree: $f" >&2; seen_outside=1; }
		else
			git -C "$wt_real" cat-file -e "HEAD:$f" 2>/dev/null || { echo "ship-post: file missing or untracked: $f" >&2; seen_outside=1; continue; }
			parent=$(realpath "$(dirname "$abs_f")" 2>/dev/null) || { echo "ship-post: cannot resolve deleted file parent: $f" >&2; seen_outside=1; continue; }
			[[ $parent == "$wt_real" || $parent == "$wt_real"/* ]] || { echo "ship-post: deleted file outside worktree: $f" >&2; seen_outside=1; }
		fi
	done
	[[ $seen_outside == 0 ]] || die "file validation failed"
	[[ -n ${file_set[$tz_path]:-} ]] || usage_err "ТЗ must be listed in --files: $tz_path"

	local lock_path submit_lock_fd
	lock_path=$(git -C "$wt_real" rev-parse --git-path ship-post-submit.lock) || die "cannot find worktree lock path"
	exec {submit_lock_fd}>"$lock_path"; flock -x "$submit_lock_fd"

	local dirty=0 status_entry status_xy status_path status_source seen_dirty=0
	while IFS= read -r -d '' status_entry; do
		status_xy=${status_entry:0:2}; status_path=${status_entry:3}
		[[ $status_xy == '!!' ]] && continue
		dirty=1
		[[ -n ${file_set[$status_path]:-} ]] || { echo "ship-post: dirty file not in --files: $status_path" >&2; seen_dirty=1; }
		if [[ $status_xy == *R* || $status_xy == *C* ]]; then
			IFS= read -r -d '' status_source || { echo "ship-post: malformed rename status" >&2; seen_dirty=1; break; }
			[[ -n ${file_set[$status_source]:-} ]] || { echo "ship-post: rename source not in --files: $status_source" >&2; seen_dirty=1; }
		fi
	done < <(git -C "$wt_real" status --porcelain=v1 -z --untracked-files=all)
	[[ $seen_dirty == 0 ]] || die "dirty or staged files outside --files list"

	local head_msg head_matches=0 head_sha
	head_msg=$(git -C "$wt_real" log -1 --format=%B) || die "cannot read HEAD"
	grep -Fxq "ТЗ: $tz_stored" <<< "$head_msg" && grep -Fxq "Atom: $atom" <<< "$head_msg" && grep -Fxq "Agent: $caller" <<< "$head_msg" && head_matches=1
	if [[ $dirty == 0 ]]; then
		[[ $head_matches == 1 ]] || die "nothing to commit and HEAD trailers do not match"
		head_sha=$(git -C "$wt_real" rev-parse HEAD) || die "cannot read HEAD"
		if [[ $status == closed ]]; then
			write_submit_receipt "$repo" "$wt_real" "$atom" "$head_sha" "$evidence" || die "cannot write submission receipt"
			echo "ship-post: already closed $atom"
			return 0
		fi
	else
		[[ $status == in_progress ]] || usage_err "atom $atom already closed with dirty worktree"
		local index_path index_backup
		index_path=$(git -C "$wt_real" rev-parse --git-path index) || die "cannot locate index"
		index_backup="$index_path.ship-post-submit.$$"
		cp -f -- "$index_path" "$index_backup" || die "cannot back up index"
		local literal_paths=()
		for f in "${files[@]}"; do literal_paths+=(":(literal)$f"); done
		git -C "$wt_real" add -- "${literal_paths[@]}" || { cp -f -- "$index_backup" "$index_path"; rm -f -- "$index_backup"; die "git add failed"; }
		( cd "$wt_real" && gitleaks git --pre-commit --staged --redact --no-banner ) || { cp -f -- "$index_backup" "$index_path"; rm -f -- "$index_backup"; die "gitleaks failed"; }
		local first_line
		first_line=$(sed -n '1p' "$tz_abs" 2>/dev/null || echo "$atom")
		git -C "$wt_real" commit -q -m "$atom: ${first_line:-$atom}" \
			-m "$(printf 'ТЗ: %s\nAtom: %s\nAgent: %s' "$tz_stored" "$atom" "$caller")" || {
			local rc=$?
			cp -f -- "$index_backup" "$index_path"; rm -f -- "$index_backup"
			die "commit failed (exit $rc)"
		}
		rm -f -- "$index_backup"
		echo "ship-post: committed $atom"
	fi

	local _ base merge_tree merge_rc conflicts
	read -r _ base _ <<< "$(ga_base "$wt_real")"
	if ! git -C "$wt_real" fetch -q origin "$base"; then
		echo "ship-post: fetch origin/$base failed" >&2
		return 70
	fi
	merge_tree=$(git -C "$wt_real" merge-tree --write-tree --name-only "origin/$base" HEAD)
	merge_rc=$?
	if [[ $merge_rc == 1 ]]; then
		conflicts=$(sed '1d' <<< "$merge_tree")
		conflicts=${conflicts//$'\n'/ }
		echo "ship-post: conflict with origin/$base: $conflicts" >&2
		local fix_tz fix_agent
		head_msg=$(git -C "$wt_real" log -1 --format=%B 2>/dev/null || true)
		fix_tz=$(sed -n 's/^ТЗ: *//p' <<< "$head_msg" | head -1)
		fix_agent=$(sed -n 's/^Agent: *//p' <<< "$head_msg" | head -1)
		[[ -n $fix_tz ]] || fix_tz=$tz_stored
		[[ -n $fix_agent ]] || fix_agent=$caller
		echo "ship-post: fix: git -C $wt_real fetch origin && git -C $wt_real merge origin/$base -m \"$atom: merge origin/$base\" -m \"ТЗ: $fix_tz\" -m \"Atom: $atom\" -m \"Agent: $fix_agent\"; resolve files; git -C $wt_real commit --no-edit; test; submit again" >&2
		return 50
	fi
	[[ $merge_rc == 0 ]] || { echo "ship-post: merge-tree origin/$base failed (rc $merge_rc)" >&2; return 70; }

	head_sha=$(git -C "$wt_real" rev-parse HEAD)
	[[ -z $(git -C "$wt_real" status --porcelain=v1 --untracked-files=all) ]] || die "worktree not clean after commit"

	local close_out
	close_out=$(bd_cmd close "$atom" --reason "submitted $head_sha: $evidence" 2>&1) || {
		local rc=$?
		echo "ship-post: commit ok but bd close failed (exit $rc): $close_out" >&2
		return "$rc"
	}

	write_submit_receipt "$repo" "$wt_real" "$atom" "$head_sha" "$evidence" || die "cannot write submission receipt"
	echo "ship-post: closed $atom"
	return 0
}

# One eligibility/delivery path for startup, events and manual scans.
actor_name(){
 case $1 in Codex|codex) echo Codex ;; Claude|'Claude Code'|claude) echo 'Claude Code' ;; *) return 1 ;; esac
}

remote_result(){
 local wt=$1 head=$2 branch=$3 origin result
	remote_list='[]'
 origin=$(git -C "$wt" remote get-url origin) || return 23
 result=$(gh repo view "$origin" --json isPrivate 2>/dev/null) || return 23
 [[ $(jq -r '.isPrivate' <<<"$result") == true ]] || return 23
 result=$(gh pr list -R "$origin" --head "$branch" --state all --json headRefOid,state,url,mergeCommit,statusCheckRollup 2>/dev/null) || return 23
 jq -e 'type == "array"' <<<"$result" >/dev/null || return 23
	remote_list=$result
 remote_proof=$(jq -c --arg h "$head" '[.[] | select(.headRefOid==$h and .state=="MERGED" and (.mergeCommit.oid|type)=="string")][0] // empty' <<<"$result")
 [[ -n $remote_proof ]] && return 0
 [[ $(jq 'length' <<<"$result") == 0 ]] && return 21
 remote_open=$(jq -c --arg h "$head" '[.[] | select(.headRefOid==$h and .state=="OPEN")][0] // empty' <<<"$result")
 [[ -n $remote_open ]] && return 22
 return 24
}

record_failure(){
 local repo=$1 atom=$2 head=$3 rc=$4 cause=${5:-} key marker note act files
 key=$(receipt_file "$repo" "$atom" "$head"); marker="$key.failed"
 mkdir -p "$(dirname "$marker")" || return 1
 # A marker records an observation, not completion of the tracker transaction.
 printf '%s\n' "$rc" > "$marker.tmp" && mv "$marker.tmp" "$marker" || return 1
 printf '%s actor=%s atom=%s sha=%s stage=failed code=%s\n' "$(date -Iseconds)" "$BEADS_ACTOR" "$atom" "$head" "$rc" >&2
 case $rc in 23|70|75) return 0 ;; esac
 case $rc in
  10) [[ -n $cause ]] || cause='ветка, рабочая копия или SHA изменены после сдачи; preflight'; act='сдай через ship-post --submit' ;;
  20) [[ -n $cause ]] || cause='gitleaks нашёл секрет в коммитах'; act='убрать секрет из истории ветки, сдать заново' ;;
  24) [[ -n $cause ]] || cause='новый SHA не потомок отправленного'; act='сдать новый SHA; старый PR закрыть' ;;
  30) [[ -n $cause ]] || cause='push или `gh pr create` отклонён (не сеть)'; act='проверить права и имя ветки по логу квитанции, сдать заново' ;;
  40) [[ -n $cause ]] || cause='CI красный на точном SHA'; act='исправить по логу CI (ссылка в задаче), сдать заново' ;;
  50) files=$(grep -m5 CONFLICT "$key.log" 2>/dev/null | paste -sd, - | sed 's/,/, /g')
   [[ -n $cause ]] || { cause='конфликт с `origin/<base>`'; [[ -z $files ]] || cause="$cause: $files"; }
   act='`git -C <wt> fetch origin && git -C <wt> merge origin/<base>`, разрешить <файлы>, тесты, `bd close`, сдать заново' ;;
  60) [[ -n $cause ]] || cause='после слияния: CI prod красный или `bd close` не прошёл'; act='исправить по логу, `ship-promote` повторно' ;;
  80) [[ -n $cause ]] || cause='ТЗ не найдено или файл вне границ ТЗ'; act='исправить трейлер `ТЗ:` или границы, сдать заново' ;;
  *) [[ -n $cause ]] || cause="код $rc"; act="см. лог квитанции $key.log" ;;
 esac
 note="ship-post exit $rc: $cause; действие: $act"
 bd_cmd reopen "$atom" >/dev/null || return 1
 bd_cmd update "$atom" --append-notes "$note" >/dev/null || return 1
 touch "$marker.reported"
}

report_closed_skip(){
 local repo=$1 atom=$2 head=$3 branch=$4 status=$5 cause=$6 wt=$7 key base foreign=0 rc
 [[ $dry_run == 0 && $status == closed ]] || return 0
 case $branch in
  claude/"$atom"|claude/"$atom"-*|codex/"$atom"|codex/"$atom"-*) ;;
  claude/*|codex/*) foreign=1 ;;
  *) return 0 ;;
 esac
 if [[ $foreign == 1 ]]; then
  read -r _ base _ <<< "$(ga_base "$wt")"
  [[ -n $base ]] || return 0
  git -C "$wt" fetch -q origin "$base" || return 0
  git -C "$wt" merge-base --is-ancestor "$head" "origin/$base"; rc=$?
  case $rc in 0) return 0 ;; 1) ;; *) return 0 ;; esac
  cause="$cause; ветка $branch названа по другой задаче, коммит не в origin/$base"
 fi
 key=$(receipt_file "$repo" "$atom" "$head")
 [[ -f $key.failed.reported ]] && return 0
 record_failure "$repo" "$atom" "$head" 10 "$cause"
}

ack_delivery(){
 local rf=$1 atom=$2 marker st
 [[ -f $rf.ack ]] && return 0
 marker="ship-post receipt:$(jq -r .local_sha "$rf"):$atom"
 st=$(bd_cmd show "$atom" --json) || return 1
 if ! jq -e --arg marker "$marker" '.[0].notes // "" | contains($marker)' <<<"$st" >/dev/null; then
  bd_cmd update "$atom" --append-notes "$marker; ship-post delivered: actor $BEADS_ACTOR; local $(jq -r .local_sha "$rf"); remote $(jq -r .remote_head "$rf"); $(jq -r .remote.url "$rf")" >/dev/null || return 1
 fi
 touch "$rf.ack"
}

write_delivery_receipt(){
 local repo=$1 atom=$2 submitted=$3 remote_head=$4 rf name out
 rf=$(receipt_file "$repo" "$atom" "$submitted")
 mkdir -p "$(dirname "$rf")" || return 1
 jq -n --arg actor "$BEADS_ACTOR" --arg timestamp "$(date -Iseconds)" --arg repo "$repo" --arg atom "$atom" --arg sha "$submitted" --arg head "$remote_head" --argjson proof "$remote_proof" \
  '{actor:$actor,timestamp:$timestamp,stage:"delivered",repo:$repo,atom:$atom,local_sha:$sha,remote_head:$head,remote:$proof}' > "$rf.tmp" && mv "$rf.tmp" "$rf" || return 1
 ack_delivery "$rf" "$atom" || return 1
 echo "delivered $atom $remote_head"
 if ! name=$(ga_repo_of "$repo"); then name=$(basename "$repo"); fi
 if out=$("$bin/git-sync" "$name" 2>&1); then
  echo "live $name: $out"
 else
  echo "ship-post: live sync $name failed: $out" >&2
  bd_cmd update "$atom" --append-notes "ship-post live sync $name failed: $out" || true
 fi
 return 0
}

write_final_receipt(){
	local repo=$1 atom=$2 head=$3 stage=$4 pr=$5 rf note
	note='ship-post: wait-owner — PR открыт, на прод только ship-promote по слову владельца'
	[[ $stage == prod-hold ]] && note='ship-post: prod-hold guarded — защищённое репо, на прод только словом владельца по закону'
	rf=$(receipt_file "$repo" "$atom" "$head")
	bd_cmd update "$atom" --append-notes "$note" >/dev/null || return 1
	jq -n --arg actor "$BEADS_ACTOR" --arg timestamp "$(date -Iseconds)" --arg repo "$repo" --arg atom "$atom" --arg sha "$head" --arg stage "$stage" --arg pr "$pr" \
		'{actor:$actor,timestamp:$timestamp,stage:$stage,repo:$repo,atom:$atom,local_sha:$sha,pr:$pr}' > "$rf.tmp" && mv "$rf.tmp" "$rf" || return 1
	echo "$stage $atom${pr:+ pr:$pr}"
}

deliver_one(){
 local wt=$1 atom=$2 tz=$3 head=$4 repo=$5 branch=$6 rf inflight rc final_head ship_rc remote_proof='' remote_open='' remote_list='' superseded=0 log_start ship_out stage
 rf=$(receipt_file "$repo" "$atom" "$head"); inflight=$(inflight_file "$repo" "$atom")
 [[ -f $rf ]] && { ack_delivery "$rf" "$atom"; return $?; }
 mkdir -p "$(dirname "$rf")" "$(dirname "$inflight")" || return 1
 remote_result "$wt" "$head" "$branch"; rc=$?
 if [[ $rc == 0 ]]; then
  write_delivery_receipt "$repo" "$atom" "$head" "$head" || return 1
  return 0
 fi
 if [[ -f $inflight && $(cat "$inflight") != "$head" ]] && git -C "$wt" merge-base --is-ancestor "$(cat "$inflight")" "$head" 2>/dev/null \
  && ! jq -e 'any(.[]?; .state=="MERGED")' <<<"${remote_list:-[]}" >/dev/null; then
  printf '%s superseded %s -> %s\n' "$(date -Iseconds)" "$(cat "$inflight")" "$head" >> "$rf.log"
  superseded=1; [[ $rc == 24 ]] && rc=22
 fi
 if [[ $rc != 21 && $rc != 22 ]]; then
  echo "ship-post: remote outcome unresolved for $atom" >&2
  record_failure "$repo" "$atom" "$head" "$rc"; return 1
 fi
 if [[ $superseded == 0 && -f $inflight && $(cat "$inflight") != "$head" ]]; then
  echo "ship-post: prior in-flight SHA differs for $atom" >&2
  record_failure "$repo" "$atom" "$head" 24; return 1
 fi
 printf '%s\n' "$head" > "$inflight.tmp" && mv "$inflight.tmp" "$inflight" || return 1
 # Existing ship owns private origin, secret scan, CI and exact-head merge gates.
 printf '%s actor=%s atom=%s sha=%s stage=ship\n' "$(date -Iseconds)" "$BEADS_ACTOR" "$atom" "$head" >> "$rf.log"
 log_start=$(stat -c %s "$rf.log" 2>/dev/null || echo 0)
 (cd "$SHIP_POST_BEADS_ROOT" && env BEADS_ACTOR="$BEADS_ACTOR" "$ship_bin" "$wt" --atom "$atom" --tz "$tz" --handover --expected-head "$head") >> "$rf.log" 2>&1
 rc=$?
 if [[ $rc != 0 ]]; then
  ship_rc=$rc
  remote_result "$wt" "$head" "$branch"; rc=$?
  if [[ $rc == 0 ]]; then write_delivery_receipt "$repo" "$atom" "$head" "$head"; return $?; fi
  if [[ $rc == 23 ]]; then ship_rc=23
  elif [[ $ship_rc == 30 ]] && grep -qiE 'could not resolve|could not connect|connection (reset|refused|timed out)|network is unreachable|HTTP 50[234]|TLS connection' "$rf.log"; then ship_rc=70
  elif [[ $rc == 22 && $ship_rc == 40 ]]; then
   # A pending check or unavailable CI API is not a confirmed product failure.
   jq -e 'any(.statusCheckRollup[]?; (.conclusion=="FAILURE" or .conclusion=="CANCELLED" or .conclusion=="TIMED_OUT" or .state=="FAILURE" or .state=="ERROR"))' <<<"$remote_open" >/dev/null || ship_rc=70
  fi
  record_failure "$repo" "$atom" "$head" "$ship_rc"; return 1
 fi
 ship_out=$(tail -c +"$((log_start + 1))" "$rf.log")
 stage=''
 grep -q '^prod:wait-owner' <<<"$ship_out" && stage=wait-owner
 grep -q '^prod:hold' <<<"$ship_out" && stage=prod-hold
 if [[ -n $stage ]]; then
  write_final_receipt "$repo" "$atom" "$head" "$stage" "$(sed -n 's/^pr://p' <<<"$ship_out" | tail -1)" || return 1
  rm -f -- "$inflight"; return 0
 fi
 final_head=$head # Accepted delivery never rebases or commits another SHA.
 remote_result "$wt" "$final_head" "$branch" || { record_failure "$repo" "$atom" "$head" 23; return 1; }
 write_delivery_receipt "$repo" "$atom" "$head" "$final_head" || return 1
 rm -f -- "$inflight"
}

scan_repo(){
 local repo=$1 lk fd line wt head branch msg atom tz st status owner agent actor dirty base rf code rc remote_proof='' remote_open='' remote_list=''
 local ok=0 failed=0 skip=0 jobs_max p
 local -a pids=()
 jobs_max=${SHIP_POST_JOBS:-8}
 [[ $jobs_max =~ ^[1-9][0-9]*$ ]] || jobs_max=8
 [[ -d $repo ]] || return 1
 repo=$(realpath "$repo") || return 1
 [[ $(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) == "$repo" ]] || return 1
 lk=$(lock_file "$repo"); mkdir -p "$(dirname "$lk")" || return 1
 exec {fd}>"$lk"; flock -x "$fd" || return 1
 while IFS= read -r line; do
  [[ $line == 'worktree '* ]] || continue
  wt=${line#worktree }; [[ $wt != "$repo" && -f $wt/.git ]] || continue
  msg=$(git -C "$wt" log -1 --format=%B) || { failed=$((failed+1)); continue; }
  atom=$(sed -n 's/^Atom: *//p' <<<"$msg" | head -1)
  tz=$(sed -n 's/^ТЗ: *//p' <<<"$msg" | head -1)
  agent=$(sed -n 's/^Agent: *//p' <<<"$msg" | head -1)
  [[ $atom =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && -n $tz ]] || { skip=$((skip+1)); continue; }
  [[ -z $filter_atom || $atom == "$filter_atom" ]] || continue
  (( $(git -C "$wt" log -1 --format=%ct) >= SHIP_POST_SINCE )) || { skip=$((skip+1)); continue; }
  head=$(git -C "$wt" rev-parse HEAD) || continue
  branch=$(git -C "$wt" symbolic-ref --short -q HEAD) || { skip=$((skip+1)); continue; }
  st=$(bd_cmd show "$atom" --json) || { failed=$((failed+1)); continue; }
  status=$(jq -r '.[0].status' <<<"$st")
   owner=$(jq -r '.[0].assignee // empty' <<<"$st"); actor=$(actor_name "$owner") || { [[ -n $owner || $status != closed ]] || { echo "skip $atom no assignee"; report_closed_skip "$repo" "$atom" "$head" "$branch" "$status" 'no assignee' "$wt" || failed=$((failed+1)); }; skip=$((skip+1)); continue; }
   owner=codex; [[ $actor == 'Claude Code' ]] && owner=claude
   [[ $branch == "$owner/$atom" || $branch == "$owner/$atom"-* ]] || { [[ $status != closed ]] || { echo "skip $atom branch $branch != $owner/$atom"; report_closed_skip "$repo" "$atom" "$head" "$branch" "$status" "branch $branch != $owner/$atom" "$wt" || failed=$((failed+1)); }; skip=$((skip+1)); continue; }
   [[ -z $agent || $(actor_name "$agent") == "$actor" ]] || { [[ $status != closed ]] || { echo "skip $atom agent mismatch"; report_closed_skip "$repo" "$atom" "$head" "$branch" "$status" 'agent mismatch' "$wt" || failed=$((failed+1)); }; skip=$((skip+1)); continue; }
  rf=$(receipt_file "$repo" "$atom" "$head")
  if [[ $dry_run == 1 && ( -f $rf || -f $rf.failed || -f $(inflight_file "$repo" "$atom") ) ]]; then
   echo "reconcile $wt $atom"; continue
  fi
  if [[ -f $rf ]]; then
	  case $(jq -r '.stage // empty' "$rf" 2>/dev/null) in
	   wait-owner|prod-hold) continue ;;
	   'wait-owner no-ci') rm -f -- "$rf" ;; # legacy dcfg-ta2r0: ship never ran; run it once
	   *) (BEADS_ACTOR=$actor; ack_delivery "$rf" "$atom") || failed=$((failed+1)); continue ;;
	  esac
  fi
  if [[ -f $rf.failed || -f $(inflight_file "$repo" "$atom") ]]; then
   remote_result "$wt" "$head" "$branch"; rc=$?
   if [[ $rc == 0 ]]; then
    (BEADS_ACTOR=$actor; write_delivery_receipt "$repo" "$atom" "$head" "$head") || failed=$((failed+1))
    continue
   fi
   [[ $rc != 23 ]] || { failed=$((failed+1)); continue; }
  fi
  if [[ -f $rf.failed && ! -f $rf.failed.reported ]]; then
   code=$(cat "$rf.failed")
   case $code in 23|70|75) ;;
    *) (BEADS_ACTOR=$actor; record_failure "$repo" "$atom" "$head" "$code") || failed=$((failed+1)); continue ;;
   esac
  fi
  if [[ -f $rf.failed ]]; then case $(cat "$rf.failed") in 10|50|80) skip=$((skip+1)); continue ;; esac; fi
  [[ $status == closed ]] || { skip=$((skip+1)); continue; }
  dirty=$(git -C "$wt" status --porcelain=v1 --untracked-files=all) || { failed=$((failed+1)); continue; }
   [[ -z $dirty ]] || { echo "skip $atom dirty worktree"; report_closed_skip "$repo" "$atom" "$head" "$branch" "$status" 'dirty worktree' "$wt" || failed=$((failed+1)); skip=$((skip+1)); continue; }
  # Normalize legacy absolute and current worktree-relative TZ without escaping the worktree.
  [[ $tz == /* ]] || tz="$wt/$tz"
  tz="$(realpath -m "${tz%%#*}")#${tz#*#}"
   [[ ${tz%%#*} == "$wt/"* && -f ${tz%%#*} ]] || { [[ $status != closed ]] || { echo "skip $atom tz not a file in worktree"; report_closed_skip "$repo" "$atom" "$head" "$branch" "$status" 'tz not a file in worktree' "$wt" || failed=$((failed+1)); }; skip=$((skip+1)); continue; }
  if [[ $dry_run == 1 ]]; then echo "ready $wt $atom"; continue; fi
  while (( $(jobs -rp | wc -l) >= jobs_max )); do wait -n; done
  (BEADS_ACTOR=$actor; deliver_one "$wt" "$atom" "$tz" "$head" "$repo" "$branch") & pids+=("$!")
 done < <(git -C "$repo" worktree list --porcelain)
 for p in "${pids[@]}"; do wait "$p" && ok=$((ok+1)) || failed=$((failed+1)); done
 exec {fd}>&-
 echo "ok=$ok failed=$failed skip=$skip"
 [[ $failed == 0 ]]
}

ledger_identity(){
 local info db
 info=$(bd_cmd info --json) || return 1
 db=$(jq -er '.database_path' <<<"$info") || return 1
 [[ -d $db ]] || return 1
 printf '%s|%s|%s|%s\n' "$(realpath "$SHIP_POST_BEADS_ROOT")" "$(realpath "$db")" "$(stat -Lc '%d:%i' "$db")" "$(git -C "$SHIP_POST_BEADS_ROOT" branch --show-current 2>/dev/null)"
}

write_cursor(){
 jq -n --arg identity "$identity" --argjson seq "$seq" '{identity:$identity,seq:$seq}' > "$SHIP_POST_STATE_DIR/cursor.json.tmp" && mv "$SHIP_POST_STATE_DIR/cursor.json.tmp" "$SHIP_POST_STATE_DIR/cursor.json"
}

queue_all(){
 local repo pending
 for repo in "${_repos[@]}"; do
  pending="$SHIP_POST_STATE_DIR/pending/$(slugify "$repo")"
  touch "$pending.full" || return 1
  touch "$pending" || return 1
 done
}

queue_atom(){
 local atom=$1 repo pending
 for repo in "${_repos[@]}"; do
  pending="$SHIP_POST_STATE_DIR/pending/$(slugify "$repo")"
  printf '%s\n' "$atom" >> "$pending.atoms" || return 1
  touch "$pending" || return 1
 done
}

do_watch() (
 resolve_repos
 local identity seq=0 ev next pid reader_fd journal_pid watcher_lock tmp repo stored partial='' id
 local workers=()
 identity=$(ledger_identity) || die 'cannot establish ledger identity'
 mkdir -p "$SHIP_POST_STATE_DIR/pending" || return 1
 exec {watcher_lock}>"$SHIP_POST_STATE_DIR/watch.lock"
 flock -n "$watcher_lock" || die 'watcher already active'
 if [[ -f $SHIP_POST_STATE_DIR/cursor.json ]]; then
  stored=$(jq -er .identity "$SHIP_POST_STATE_DIR/cursor.json") || die 'invalid cursor identity'
  [[ $stored == "$identity" ]] || die 'ledger identity changed'
  seq=$(jq -er '.seq | select(type=="number" and .>=0 and floor==.)' "$SHIP_POST_STATE_DIR/cursor.json") || die 'invalid cursor sequence'
 fi
 queue_all || return 1
 tmp=$(mktemp -d "$SHIP_POST_STATE_DIR/watch.XXXXXX") || return 1
 cleanup_watch(){
  touch "$tmp/stop"
  [[ -z ${journal_pid:-} ]] || kill "$journal_pid" 2>/dev/null || true
  [[ -z ${journal_pid:-} ]] || wait "$journal_pid" 2>/dev/null || true
  for pid in "${workers[@]}"; do wait "$pid" || true; done
  rm -rf -- "$tmp"
 }
 trap cleanup_watch EXIT
 trap 'exit 143' TERM INT
 for repo in "${_repos[@]}"; do
  (
   local pending atoms atom failed
   pending="$SHIP_POST_STATE_DIR/pending/$(slugify "$repo")"
   while [[ ! -f $tmp/stop ]]; do
    if [[ -f $pending ]]; then
     rm -f -- "$pending"
     failed=0
     if [[ -f $pending.full ]]; then
      rm -f -- "$pending" "$pending.atoms" "$pending.full"
      filter_atom=$watch_filter scan_repo "$repo" || failed=1
     elif [[ -f $pending.atoms ]]; then
      atoms="$pending.atoms.$$"
      mv -- "$pending.atoms" "$atoms" || continue
      while IFS= read -r atom; do
       [[ -z $watch_filter || $atom == "$watch_filter" ]] || continue
       filter_atom=$atom scan_repo "$repo" || failed=1
      done < <(sort -u "$atoms")
      rm -f -- "$atoms"
     else
      scan_repo "$repo" || failed=1
     fi
     if [[ ${failed:-0} != 0 ]]; then
      touch "$pending.full" "$pending" || exit 1
      sleep "$SHIP_POST_RETRY_SECONDS"
     fi
    fi
    sleep 1
   done
  ) & workers+=("$!")
 done
 # Native --follow owns the journal polling. The coordinator never starts a model.
 coproc JOURNAL { cd "$SHIP_POST_BEADS_ROOT" && exec env BEADS_ACTOR="${BEADS_ACTOR:-Codex}" bd events tail --since "$seq" --follow --json 2>&1; }
 journal_pid=$JOURNAL_PID; exec {reader_fd}<&"${JOURNAL[0]}"
 while :; do
  for pid in "${workers[@]}"; do kill -0 "$pid" 2>/dev/null || die 'repository worker exited; restart required'; done
  IFS= read -r -t 1 ev <&"$reader_fd"; next=$?
  if [[ $next != 0 ]]; then
   if (( next > 128 )); then partial+=$ev; continue; fi
   break
  fi
  ev="$partial$ev"; partial=''
  [[ $ev == \{* ]] || { echo "ship-post: bd: $ev" >&2; continue; }
  if [[ $(jq -r '.code // empty' <<<"$ev" 2>/dev/null) == events_journal_truncated ]]; then
   next=$(jq -er '.floor | select(type=="number" and .>0 and floor==.)' <<<"$ev") || die 'invalid retention boundary'
   queue_all || return 1
   seq=$((next-1)); write_cursor || return 1
   die 'journal truncated; recovery scheduled, restart from retained floor'
  fi
  next=$(jq -er '.seq | select(type=="number" and .>=0 and floor==.)' <<<"$ev") || die 'malformed journal record'
  (( next > seq )) || continue
  if jq -e '(.op=="close" or .op=="update") and .issue.status=="closed"' <<<"$ev" >/dev/null; then
   id=$(jq -r '.issue.id // empty' <<<"$ev")
   if [[ -n $id && $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    queue_atom "$id" || return 1
   else
    queue_all || return 1
   fi
  fi
  seq=$next; write_cursor || return 1
 done
 wait "$journal_pid"; next=$?; journal_pid=''
 echo "ship-post: journal stream ended (exit $next)" >&2
 return 1
)

if [[ $submit == 1 ]]; then
 do_submit "$submit_wt" "$submit_atom" "$submit_tz" "$submit_evidence" "${submit_files[@]}"
elif [[ $watch == 1 ]]; then
 do_watch
else
 resolve_repos
 result=0
 for repo in "${_repos[@]}"; do scan_repo "$repo" || result=1; done
 exit "$result"
fi
