# --- U7a: --local mode (checks 27-32) ---
# Local invocation env: local-path GitLab base, no mirror source ever touched.
localenv=(CA_ENV_FILE=$T/env CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos \
          CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_GITLAB_BASE=$T/gitlab)
# Scaffold a developer repo whose origin claims the arwoxbx24 group (the URL
# itself is never contacted).
initlocal(){ # $1=dir $2=origin
  git init -q "$1"
  git -C "$1" config user.email t@t
  git -C "$1" config user.name t
  git -C "$1" checkout -q -b main
  git -C "$1" commit -q --allow-empty -m init
  git -C "$1" config remote.origin.url "$2"
}

# Check 27: --local pushes heads under refs/heads/server/*, journal ok:local, code 0
initlocal "$T/lw27" 'git@github.com:arwoxbx24/local27.git'
main27=$(git -C "$T/lw27" rev-parse main)
out27=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw27/.git" 2>&1); rc27=$?
srv27=$(git --git-dir="$T/gitlab/local27.git" rev-parse refs/heads/server/main 2>/dev/null) || srv27=""
if [[ $rc27 == 0 ]] && [[ "$srv27" == "$main27" ]] \
   && grep -qF 'local27 ok:local' <<<"$out27" \
   && grep -qF 'local27 ok:local' "$T/log/code-archive.log"; then
  p 27
else
  f 27
fi

# Check 28: repeat with no new commits leaves the GitLab ref count unchanged
before28=$(git --git-dir="$T/gitlab/local27.git" for-each-ref)
out28=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw27/.git" 2>&1); rc28=$?
after28=$(git --git-dir="$T/gitlab/local27.git" for-each-ref)
{ [[ $rc28 == 0 ]] && [[ "$before28" == "$after28" ]]; } && p 28 || f 28

# Check 29: locally amended branch -> old server/main intact, new tip rewritten
old29=$(git --git-dir="$T/gitlab/local27.git" rev-parse refs/heads/server/main)
git -C "$T/lw27" commit -q --amend --allow-empty -m v2
out29=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw27/.git" 2>&1); rc29=$?
srv29=$(git --git-dir="$T/gitlab/local27.git" rev-parse refs/heads/server/main)
rw29=$(git --git-dir="$T/gitlab/local27.git" for-each-ref 'refs/heads/rewritten/*/server/main' --format='%(objectname)' | head -1)
{ [[ $rc29 == 0 ]] && [[ "$srv29" == "$old29" ]] && [[ -n "$rw29" ]]; } && p 29 || f 29

# Check 30: origin outside the org -> skip:not-org, GitLab unchanged
before30=$(git --git-dir="$T/gitlab/local27.git" for-each-ref)
git -C "$T/lw27" config remote.origin.url 'git@github.com:otherorg/whatever.git'
out30=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw27/.git" 2>&1); rc30=$?
after30=$(git --git-dir="$T/gitlab/local27.git" for-each-ref)
{ [[ $rc30 == 0 ]] && grep -qF 'skip:not-org' <<<"$out30" \
  && [[ "$before30" == "$after30" ]]; } && p 30 || f 30

# Check 31: hh-scoring-* and stroyremont -> skip:excluded, no GitLab repo created
ok31=1
for excl in hh-scoring-x stroyremont; do
  git -C "$T/lw27" config remote.origin.url "git@github.com:arwoxbx24/$excl.git"
  out31=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw27/.git" 2>&1); rc31=$?
  if [[ $rc31 != 0 ]] || ! grep -qF 'skip:excluded' <<<"$out31" \
     || [[ -e "$T/gitlab/$excl.git" ]]; then ok31=0; fi
done
{ [[ $ok31 == 1 ]]; } && p 31 || f 31

# Check 32: busy queue lock -> immediate exit 0 + .again; holder re-pushes and
# clears it; every commit reaches GitLab.
initlocal "$T/lw32" 'git@github.com:arwoxbx24/lock32.git'
a32=$(git -C "$T/lw32" rev-parse main)                        # commit A
out32a=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw32/.git" 2>&1); rc32a=$?
git -C "$T/lw32" commit -q --allow-empty -m B
b32=$(git -C "$T/lw32" rev-parse main)                        # commit B
# Hold the queue lock externally so a concurrent invocation observes it busy.
bash -c 'exec 9>"'"$T"'/state/lock32.lock"; flock 9; touch "'"$T"'/hold32"; exec sleep 60' & holdpid=$!
while [[ ! -f "$T/hold32" ]]; do sleep 0.05; done
out32b=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw32/.git" 2>&1); rc32b=$?
again32b=$([[ -f "$T/state/lock32.again" ]] && echo yes || echo no)
kill "$holdpid" 2>/dev/null; wait "$holdpid" 2>/dev/null; rm -f "$T/hold32"; sleep 0.1
# Now the holder takes the lock, pushes, sees .again, deletes it and re-pushes.
out32c=$(env "${localenv[@]}" "$bin/code-archive" --local "$T/lw32/.git" 2>&1); rc32c=$?
again32c=$([[ -f "$T/state/lock32.again" ]] && echo yes || echo no)
srv32=$(git --git-dir="$T/gitlab/lock32.git" rev-parse refs/heads/server/main)
anc32=$(git --git-dir="$T/gitlab/lock32.git" merge-base --is-ancestor "$a32" "$srv32" 2>/dev/null && echo yes || echo no)
if [[ $rc32a == 0 && $rc32b == 0 && $rc32c == 0 \
   && "$again32b" == yes && "$again32c" == no \
   && "$srv32" == "$b32" && "$anc32" == yes ]]; then
  p 32
else
  f 32
fi

echo "PASS $ok FAIL $((32-ok))"
[[ $ok == 32 ]]
