printf '%s\t%s\t%s\t%s\n' \
  'night37a' '2026-10-02T22:00:00Z' '10' 'false' \
  'night37b' '2026-10-02T22:01:00Z' '10' 'false' > "$T/list37.tsv"
printf '%s\n' '2' > "$T/state/list-count"
gitlab_fail
