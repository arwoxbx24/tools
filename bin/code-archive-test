git -C "$T/reverse" update-ref refs/heads/foo HEAD
git -C "$T/reverse" push -q origin refs/heads/foo
out24b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" reverse 2>&1); rc24b=$?
