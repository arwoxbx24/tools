git -C "$T/rewrite-state" push -q origin main
printf '%s\t%s\t%s\t%s\n' 'rewrite-state' '2026-10-02T20:00:00Z' '1' 'false' > "$T/list25.tsv"
printf '%s\n' '1' > "$T/state/list-count"
out25a=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_LIST_FILE=$T/list25.tsv CA_DRILL_DOW=8 "$bin/code-archive" --changed 2>&1); rc25a=$?
git -C "$T/rewrite-state" commit -q --amend --allow-empty -m rewritten
git -C "$T/rewrite-state" push -qf origin main
printf '%s\t%s\t%s\t%s\n' 'rewrite-state' '2026-10-02T21:00:00Z' '1' 'false' > "$T/list25.tsv"
out25b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_LIST_FILE=$T/list25.tsv CA_DRILL_DOW=8 "$bin/code-archive" --changed 2>&1); rc25b=$?
rw25a=$(git --git-dir="$T/gitlab-early/rewrite-state.git" for-each-ref refs/heads/rewritten/ --format='%(refname)' | wc -l)
out25c=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_LIST_FILE=$T/list25.tsv CA_DRILL_DOW=8 "$bin/code-archive" --changed 2>&1); rc25c=$?
rw25b=$(git --git-dir="$T/gitlab-early/rewrite-state.git" for-each-ref refs/heads/rewritten/ --format='%(refname)' | wc -l)
if [[ $rc25a == 0 && $rc25b == 0 && $rc25c == 0 && $rw25a -gt 0 && $rw25a == $rw25b ]] \
   && [[ "$(cat "$T/state/rewrite-state.pushed_at")" == '2026-10-02T21:00:00Z' ]]; then
  p 25
else
  f 25
fi

# Check 26: a GitLab API error surfaces the HTTP code in the journal (no body).
