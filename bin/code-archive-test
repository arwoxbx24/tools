# Check 38: a failing run with NO CA_NO_NOTIFY on the command line (only the
# inherited test-env export) still routes the owner message to notify.out and
# never calls the Telegram curl stub. A stub curl at the head of PATH records
# every real curl invocation so a live api.telegram.org send cannot hide.
mkdir -p "$T/stub38"
cat > "$T/stub38/curl" <<'STUB'
#!/usr/bin/env bash
printf 'curl %s\n' "$*" >> "${CURL38_LOG:?}"
printf '500'
STUB
chmod +x "$T/stub38/curl"
mkgh "no38"; git -C "$T/seed" push -q "$T/github/no38.git" main
rm -f "$T/state/notify.out" "$T/curl38.log"
gitlab_fail
out38=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state \
        CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_GITLAB_BASE=$T/gitlab \
        CURL38_LOG="$T/curl38.log" PATH="$T/stub38:$PATH" \
        "$bin/code-archive" no38 2>&1); rc38=$?
gitlab_ok
if [[ $rc38 == 1 ]] \
   && grep -qF 'no38' "$T/state/notify.out" \
   && ( [[ ! -e "$T/curl38.log" ]] || ! grep -q 'api.telegram.org' "$T/curl38.log" ); then
  p 38
else
  f 38
fi

# --- U7c: branch protection `*` on the GitLab project (checks 39-42) ---
# Stub for the GitLab REST API. Behaviour is tuned per-test via env:
#   SP_LIST       group-project rows (JSON array of {id,path})
#   SP_BAD_POST   project id whose protect POST must error
#   SP_NO_LIST    project id whose protected-branches list lacks `*`
#   SP_NEW        project path that must be treated as missing (create path)
mkdir -p "$T/stubP"
cat > "$T/stubP/curl" <<'STUB'
#!/usr/bin/env bash
log="${CURLP_LOG:?}"
printf 'ARGS: %s\n' "$*" >> "$log"
if [[ ! -t 0 ]]; then
  while IFS= read -r line; do
    case "$line" in
      PRIVATE-TOKEN:*) printf 'PRIVATE-TOKEN:\n' >> "$log";;
    esac
  done
fi
url=""; for a in "$@"; do case "$a" in http://*|https://*) url="$a"; break;; esac; done
out=""; prev=""
for a in "$@"; do if [[ "$prev" == "-o" ]]; then out="$a"; fi; prev="$a"; done
is_post=no; case "$*" in *"-X POST"*) is_post=yes;; esac
is_protect=no; case "$url" in */protected_branches*) is_protect=yes;; esac
is_grouplist=no; case "$url" in *"/groups/"*"/projects"*) is_grouplist=yes;; esac
is_groupresolve=no; if [[ "$url" == *"/groups/"* && "$is_grouplist" == no ]]; then is_groupresolve=yes; fi
is_create=no; if [[ "$is_post" == yes && "$url" == *"/api/v4/projects" && "$url" != *"/projects/"* ]]; then is_create=yes; fi
is_single=no; if [[ "$is_protect" == no && "$is_post" == no && "$is_create" == no && "$url" == *"/projects/"* ]]; then is_single=yes; fi
code=500; body='{}'
if [[ "$is_protect" == yes ]]; then
  if [[ "$is_post" == yes ]]; then
    if [[ -n "${SP_BAD_POST:-}" && "$url" == *"/$SP_BAD_POST/"* ]]; then
      code=400; body='{"message":"already exists"}'
    else
      code=201; body='{"id":1,"name":"*"}'
    fi
  else
    code=200
    if [[ -n "${SP_NO_LIST:-}" && "$url" == *"/$SP_NO_LIST/"* ]]; then body='[]'
    else body='[{"name":"*"}]'; fi
  fi
elif [[ "$is_grouplist" == yes ]]; then
  code=200; body="${SP_LIST:-[]}"
elif [[ "$is_single" == yes ]]; then
  if [[ -n "${SP_NEW:-}" && "$url" == *"%2F$SP_NEW"* ]]; then code=404; body='{}'
  else code=200; body='{"id":77,"visibility":"private"}'; fi
elif [[ "$is_create" == yes ]]; then
  code=201; body='{"id":99}'
elif [[ "$is_groupresolve" == yes ]]; then
  code=200; body='{"id":42}'
fi
if [[ -n "$out" ]]; then printf '%s' "$body" > "$out"; fi
printf '%s' "$code"
STUB
chmod +x "$T/stubP/curl"

# Check 39: creating a NEW project mirrors it, then protects `*` — the run
