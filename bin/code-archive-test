   && grep -qF 'push_access_level=40' "$T/curlp.log" \
   && grep -qF 'merge_access_level=40' "$T/curlp.log" \
   && grep -qF 'allow_force_push=false' "$T/curlp.log" \
   && ! grep -q 'glpat-TESTONLY000' "$T/curlp.log" \
   && grep -qF 'newproj err:gitlab' "$T/log/code-archive.log"; then
