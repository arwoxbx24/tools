# Check 24: a copied foo/bar no longer blocks an incoming source foo.
git init -q --bare "$T/github/reverse.git"
git clone -q "$T/github/reverse.git" "$T/reverse"
git -C "$T/reverse" config user.email t@t
git -C "$T/reverse" config user.name t
git -C "$T/reverse" checkout -q -b main
git -C "$T/reverse" commit -q --allow-empty -m init
git -C "$T/reverse" update-ref refs/heads/foo/bar HEAD
git -C "$T/reverse" push -q origin main refs/heads/foo/bar
out24a=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" reverse 2>&1); rc24a=$?
git -C "$T/reverse" push -q origin --delete foo/bar
git -C "$T/reverse" update-ref -d refs/heads/foo/bar
git -C "$T/reverse" update-ref refs/heads/foo HEAD
git -C "$T/reverse" push -q origin refs/heads/foo
out24b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" reverse 2>&1); rc24b=$?
foo24=$(git --git-dir="$T/repos/reverse.git" rev-parse refs/heads/foo 2>/dev/null) || foo24=""
glfoo24=$(git --git-dir="$T/gitlab-early/reverse.git" for-each-ref --format='%(objectname) %(refname)' | awk -v obj="$foo24" '$1 == obj && $2 ~ /^refs\/heads\// { print obj; exit }')
arc24=$(git --git-dir="$T/repos/reverse.git" for-each-ref 'refs/heads/archive/*/foo/bar' --format='%(refname)')
if [[ $rc24a == 0 && $rc24b == 0 && -n "$foo24" && "$foo24" == "$glfoo24" && -n "$arc24" ]] \
   && ! grep -qF 'reverse err:' <<<"$out24b"; then
  p 24
else
  f 24
fi

# Check 25: a rewritten source is pushed once and records pushed_at.
git init -q --bare "$T/github/rewrite-state.git"
