# Check 46 (U1): invocation validation — --help/usage and refusal work with no
# secrets, bad or bare invocations exit 64 with no side effects, and a
# nonexistent source is err:not-found without notifying or leaving state.
before46a=$(wc -l < "$T/log/code-archive.log")
before46b=$(wc -l < "$T/state/notify.out" 2>/dev/null || echo 0)
out46h=$(env "${localenv[@]}" "$bin/code-archive" --help 2>&1); rc46h=$?
out46i=$(env "${localenv[@]}" "$bin/code-archive" -h 2>&1); rc46i=$?
out46x=$(env "${localenv[@]}" CA_ENV_FILE=$T/nonexistent "$bin/code-archive" --help 2>&1); rc46x=$?
us46=("--drill" "-x" "" ".."); rc46u=()
for a in "${us46[@]}"; do env "${localenv[@]}" "$bin/code-archive" "$a" >/dev/null 2>&1; rc46u+=("$?"); done
env "${localenv[@]}" "$bin/code-archive" >/dev/null 2>&1; rc46n=$?
out46m=$(env "${localenv[@]}" "$bin/code-archive" nosuchrepo46 2>&1); rc46m=$?
after46b=$(wc -l < "$T/state/notify.out" 2>/dev/null || echo 0)
errusage46=$(tail -n +$((before46a+1)) "$T/log/code-archive.log" | grep -c 'err:usage' || true)
mkgh ".github46"; mkgh "a-b_c.d46"
git -C "$T/seed" push -q "$T/github/.github46.git" main
git -C "$T/seed" push -q "$T/github/a-b_c.d46.git" main
out46g=$(env "${localenv[@]}" "$bin/code-archive" .github46 a-b_c.d46 2>&1); rc46g=$?
gh46=no; grep -qF -- '--changed' <<<"$out46h" && gh46=yes
gnf46=no; grep -Fq 'nosuchrepo46 err:not-found' "$T/log/code-archive.log" && gnf46=yes
gg146=no; grep -Fq '.github46 ok' "$T/log/code-archive.log" && gg146=yes
gg246=no; grep -Fq 'a-b_c.d46 ok' "$T/log/code-archive.log" && gg246=yes
sf46=no; compgen -G "$T/state/-*" >/dev/null 2>&1 || sf46=yes
rf46=no; compgen -G "$T/repos/-*" >/dev/null 2>&1 || rf46=yes
if [[ $rc46h == 0 && $rc46i == 0 && $rc46x == 0 \
   && $gh46 == yes \
   && $rc46n == 64 \
   && ${rc46u[0]} == 64 && ${rc46u[1]} == 64 && ${rc46u[2]} == 64 && ${rc46u[3]} == 64 \
   && $rc46m == 1 && $gnf46 == yes \
   && $after46b == $before46b \
   && ! -e "$T/repos/nosuchrepo46.git" \
   && ! -e "$T/state/nosuchrepo46.fail" \
   && $rc46g == 0 && $gg146 == yes && $gg246 == yes \
   && $errusage46 == 4 && $sf46 == yes && $rf46 == yes ]]; then
  p 46
else
  f 46
fi

# Check 47 (U1-fix1): SSH's "Repository not found" is only treated as
# err:not-found when the GitHub API confirms it (HTTP 404); a revoked key
# (403) still notifies, and --drill x is usable under CA_ASKPASS=1 with 2 args.
mkdir -p "$T/stub47"
realgit47="$(command -v git)"
cat > "$T/stub47/git" <<'STUB'
#!/usr/bin/env bash
realgit="${REALGIT47:?}"
for a in "$@"; do
  if [[ "$a" == "ls-remote" ]]; then
    printf '%s\n' 'ERROR: Repository not found.' >&2
    exit 128
  fi
done
exec "$realgit" "$@"
STUB
cat > "$T/stub47/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "${GH47_OUT:?}" >&2
exit 1
STUB
chmod +x "$T/stub47/git" "$T/stub47/gh"
before47=$(wc -l < "$T/state/notify.out" 2>/dev/null || echo 0)
out47m=$(env "${localenv[@]}" PATH="$T/stub47:$PATH" REALGIT47="$realgit47" \
         GH47_OUT='gh: Not Found (HTTP 404)' "$bin/code-archive" newmiss47 2>&1); rc47m=$?
mid47=$(wc -l < "$T/state/notify.out" 2>/dev/null || echo 0)
out47d=$(env "${localenv[@]}" PATH="$T/stub47:$PATH" REALGIT47="$realgit47" \
         GH47_OUT='gh: Forbidden (HTTP 403)' "$bin/code-archive" newdeny47 2>&1); rc47d=$?
after47=$(wc -l < "$T/state/notify.out" 2>/dev/null || echo 0)
out47a=$(env "${localenv[@]}" CA_ASKPASS=1 PATH="$T/stub47:$PATH" REALGIT47="$realgit47" \
         "$bin/code-archive" --drill x 2>&1); rc47a=$?
nf47=no; grep -Fq 'newmiss47 err:not-found' "$T/log/code-archive.log" && nf47=yes
nd47=no; grep -qF 'newdeny47 err:' "$T/log/code-archive.log" && \
  ! grep -qF 'newdeny47 err:not-found' "$T/log/code-archive.log" && nd47=yes
if [[ $rc47m == 1 && $nf47 == yes && $mid47 == $before47 \
   && ! -e "$T/repos/newmiss47.git" && ! -e "$T/state/newmiss47.fail" \
   && $rc47d == 1 && $nd47 == yes && $((after47 - before47)) == 1 \
   && $rc47a == 64 ]]; then
  p 47
else
  f 47
fi

echo "PASS $ok FAIL $((total-ok))"
[[ $ok == $total ]]
