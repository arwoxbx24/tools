# --- U7b: owner notification on mirror failure (checks 36-37) ---
# CA_NO_NOTIFY=1 (now part of localenv) routes messages to $CA_STATE_DIR/notify.out
# instead of Telegram; a file in place of the GitLab dir makes pushes fail.
gitlab_fail(){ rm -rf "$T/gitlab"; : > "$T/gitlab"; }
gitlab_ok(){ rm -f "$T/gitlab"; mkdir -p "$T/gitlab"; }

# Check 36: single run with GitLab failure -> one message + .fail; repeat silent
mkgh "once36"
git -C "$T/seed" push -q "$T/github/once36.git" main
rm -f "$T/state/notify.out"
gitlab_fail
out36a=$(env "${localenv[@]}" "$bin/code-archive" once36 2>&1); rc36a=$?
out36b=$(env "${localenv[@]}" "$bin/code-archive" once36 2>&1); rc36b=$?
gitlab_ok
if [[ $rc36a == 1 ]] && [[ $rc36b == 1 ]] \
   && [[ -f "$T/state/once36.fail" ]] \
   && [[ "$(wc -l < "$T/state/notify.out")" == 1 ]] \
   && grep -qF 'once36' "$T/state/notify.out"; then
  p 36
else
  f 36
fi

