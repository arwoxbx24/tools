#!/usr/bin/env bash
set -u
bin=$(cd -- "$(dirname -- "$0")" && pwd)
T=/root/workspaces/sandbox/test-code-archive-$$
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/github" "$T/repos" "$T/state" "$T/log"
git init -q --bare "$T/github/demo.git"
git init -q "$T/work"
git -C "$T/work" config user.email t@t
git -C "$T/work" config user.name t
git -C "$T/work" checkout -q -b main
git -C "$T/work" commit -q --allow-empty -m init
git -C "$T/work" tag v1
git -C "$T/work" push -q "$T/github/demo.git" main v1
printf '%s\n' 'GITLAB_MIRROR_TOKEN=glpat-TESTONLY000' > "$T/env"
touch "$T/empty"
ok=0
p(){ echo "PASS $1"; ok=$((ok+1)); }
f(){ echo "FAIL $1"; }
# Check 1: first run with valid token
out=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc=$?
s=$(git --git-dir="$T/github/demo.git" rev-parse main v1)
d=$(git --git-dir="$T/repos/demo.git" rev-parse main v1 2>/dev/null) || d=""
{ [[ $rc == 0 ]] && grep -qF 'demo ok:created' <<<"$out" && [[ $s == "$d" ]]; } && p 1 || f 1
# Check 2: same with empty env file -> exit 2
rm -rf "$T/repos"
out2=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/empty "$bin/code-archive" demo 2>&1); rc2=$?
{ [[ $rc2 == 2 ]] && grep -qF 'err:no-key' <<<"$out2"; } && p 2 || f 2
# Check 3: existing copy with a leaked-credential gitlab remote is cleaned
mkdir -p "$T/repos"
cp -rf "$T/github/demo.git" "$T/repos/demo.git"
git --git-dir="$T/repos/demo.git" remote add github "$T/github/demo.git"
git --git-dir="$T/repos/demo.git" remote add gitlab https://oauth2:glpat-TESTONLY111@gitlab.com/x/demo.git
git --git-dir="$T/repos/demo.git" config remote.gitlab.mirror true
git --git-dir="$T/repos/demo.git" config --add remote.gitlab.fetch '+refs/*:refs/*'
out3=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc3=$?
u3=$(git --git-dir="$T/repos/demo.git" config --get remote.gitlab.url)
m3=$(git --git-dir="$T/repos/demo.git" config --get remote.gitlab.mirror)
f3=$(git --git-dir="$T/repos/demo.git" config --get-all remote.gitlab.fetch)
c3=$(grep -c glpat- "$T/repos/demo.git/config" || true)
if [[ $rc3 == 0 ]] && [[ -z $m3 ]] \
   && ! grep -Fq '+refs/*:refs/*' <<<"$f3" \
   && [[ $u3 == 'https://gitlab.com/x/demo.git' ]] \
   && [[ $c3 == 0 ]] \
   && ! grep -q glpat- <<<"$out3" \
   && ! grep -q glpat- "$T/log/code-archive.log"; then
  p 3
else
  f 3
fi

# Check 4: rewritten main is archived; copy main advances to the new tip
git clone -q "$T/github/demo.git" "$T/rewrite"
git -C "$T/rewrite" checkout -q main
git -C "$T/rewrite" config user.email t@t
git -C "$T/rewrite" config user.name t
old_main=$(git --git-dir="$T/repos/demo.git" rev-parse main)
git -C "$T/rewrite" commit -q --amend --allow-empty -m x
git -C "$T/rewrite" push -qf origin main
out4=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc4=$?
new_main=$(git --git-dir="$T/github/demo.git" rev-parse main)
d_main=$(git --git-dir="$T/repos/demo.git" rev-parse main)
arch_obj=$(git --git-dir="$T/repos/demo.git" for-each-ref refs/heads/archive/ --format='%(objectname)')
arch_name=$(git --git-dir="$T/repos/demo.git" for-each-ref refs/heads/archive/ --format='%(refname)')
if [[ $rc4 == 0 ]] && [[ $new_main == $d_main ]] \
   && [[ $arch_obj == $old_main ]] \
   && [[ $arch_name == refs/heads/archive/*/main ]]; then
  p 4
else
  f 4
fi
# Check 5: branch deleted in source remains in copy
git -C "$T/rewrite" checkout -q -b feature
git -C "$T/rewrite" commit -q --allow-empty -m f
git -C "$T/rewrite" push -q origin feature
feat_src=$(git --git-dir="$T/github/demo.git" rev-parse feature)
out5a=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc5a=$?
feat_cpy=$(git --git-dir="$T/repos/demo.git" rev-parse feature 2>/dev/null) || feat_cpy=""
git -C "$T/rewrite" push -q origin --delete feature
out5b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc5b=$?
feat_cpy2=$(git --git-dir="$T/repos/demo.git" rev-parse feature 2>/dev/null) || feat_cpy2=""
if [[ $rc5a == 0 ]] && [[ $rc5b == 0 ]] \
   && [[ $feat_cpy == $feat_src ]] \
   && [[ $feat_cpy2 == $feat_src ]]; then
  p 5
else
  f 5
fi
# Check 6: source refs are unchanged across a run
refs_before=$(git --git-dir="$T/github/demo.git" for-each-ref)
out6=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc6=$?
refs_after=$(git --git-dir="$T/github/demo.git" for-each-ref)
{ [[ $rc6 == 0 ]] && [[ $refs_before == $refs_after ]]; } && p 6 || f 6
# Check 7: per-name isolation — a missing source errs without aborting the pass
rm -f "$T/last-ok"
out7=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo broken 2>&1); rc7=$?
if [[ $rc7 == 1 ]] \
   && grep -qF 'demo ok' <<<"$out7" \
   && grep -qF 'broken err:' <<<"$out7" \
   && grep -qF '=== pass ' <<<"$out7" \
   && grep -qF 'ok=1 err=1 skipped=0' <<<"$out7" \
   && grep -qF '=== pass ' "$T/log/code-archive.log" \
   && [[ ! -e "$T/last-ok" ]]; then
  p 7
else
  f 7
fi
# Check 8: two concurrent runs by the same new name serialize via flock
CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo2 >"$T/out8a" 2>&1 & pid8a=$!
CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo2 >"$T/out8b" 2>&1 & pid8b=$!
wait $pid8a; rc8a=$?
wait $pid8b; rc8b=$?
git --git-dir="$T/repos/demo2.git" fsck >/dev/null 2>&1; fsck8=$?
{ [[ $rc8a == 1 && $rc8b == 1 && $fsck8 == 0 ]]; } && p 8 || f 8
# Check 9: successful pass writes last-ok; insufficient space -> err:no-space
rm -f "$T/last-ok"
out9=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc9=$?
out9b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=999999999999 "$bin/code-archive" demo 2>&1); rc9b=$?
{ [[ $rc9 == 0 ]] && [[ -f "$T/last-ok" ]] \
  && [[ $rc9b == 1 ]] && grep -qF 'err:no-space' <<<"$out9b"; } && p 9 || f 9

echo "PASS $ok FAIL $((9-ok))"
[[ $ok == 9 ]]
