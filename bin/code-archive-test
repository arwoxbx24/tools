glfoo24=$(git --git-dir="$T/gitlab-early/reverse.git" for-each-ref --format='%(objectname) %(refname)' | awk -v obj="$foo24" '$1 == obj && $2 ~ /^refs\/heads\// { print obj; exit }')
arc24=$(git --git-dir="$T/repos/reverse.git" for-each-ref 'refs/heads/archive/*/foo/bar' --format='%(refname)')
if [[ $rc24a == 0 && $rc24b == 0 && -n "$foo24" && "$foo24" == "$glfoo24" && -n "$arc24" ]] \
   && ! grep -qF 'reverse err:' <<<"$out24b"; then
