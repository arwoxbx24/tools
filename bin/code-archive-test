#!/usr/bin/env bash
set -u
# U7b-fix2: no test run may reach the real Telegram channel. Both env vars are
# exported for every code-archive invocation inherited from this script; a
# failed check without these would otherwise send a live owner notification.
export CA_NO_NOTIFY=1
export CA_NOTIFY_ENV=/nonexistent/code-archive-test
bin=$(cd -- "$(dirname -- "$0")" && pwd)
T="${T:-/tmp/test-code-archive-$$}"
export CA_GITLAB_BASE="$T/gitlab-early"
trap 'rm -rf "$T"' EXIT
mkdir -p "$T/github" "$T/repos" "$T/state" "$T/log" "$T/gitlab" "$T/gitlab-early"
export CA_LOG="$T/log/code-archive.log"
export CA_STATE_DIR="$T/state"
for _iso in "$CA_LOG" "$CA_STATE_DIR"; do
  case "$_iso" in
    /root/workspaces/system/services/gitmirror/*|/home/gitmirror/*)
      echo "FAIL isolation"; exit 1;;
  esac
done
export CA_LAST_OK="$T/last-ok"
git init -q --bare "$T/github/demo.git"
git init -q "$T/work"
git -C "$T/work" config user.email t@t
git -C "$T/work" config user.name t
git -C "$T/work" checkout -q -b main
git -C "$T/work" commit -q --allow-empty -m init
git -C "$T/work" tag v1
git -C "$T/work" push -q "$T/github/demo.git" main v1
printf '%s\n' 'GITLAB_MIRROR_TOKEN=glpat-TESTONLY000' > "$T/env"
touch "$T/empty"
ok=0
total=0
p(){ echo "PASS $1"; ok=$((ok+1)); total=$((total+1)); }
f(){ echo "FAIL $1"; total=$((total+1)); }
# Check 1: first run with valid token
out=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc=$?
s=$(git --git-dir="$T/github/demo.git" rev-parse main v1)
d=$(git --git-dir="$T/repos/demo.git" rev-parse main v1 2>/dev/null) || d=""
{ [[ $rc == 0 ]] && grep -qF 'demo ok:created' <<<"$out" && [[ $s == "$d" ]]; } && p 1 || f 1
# Check 2: same with empty env file -> exit 2
rm -rf "$T/repos"
out2=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/empty "$bin/code-archive" demo 2>&1); rc2=$?
{ [[ $rc2 == 2 ]] && grep -qF 'err:no-key' <<<"$out2"; } && p 2 || f 2
# Check 3: existing copy with a leaked-credential gitlab remote is cleaned
mkdir -p "$T/repos"
cp -rf "$T/github/demo.git" "$T/repos/demo.git"
git --git-dir="$T/repos/demo.git" remote add github "$T/github/demo.git"
git --git-dir="$T/repos/demo.git" remote add gitlab https://oauth2:glpat-TESTONLY111@gitlab.com/x/demo.git
git --git-dir="$T/repos/demo.git" config remote.gitlab.mirror true
git --git-dir="$T/repos/demo.git" config --add remote.gitlab.fetch '+refs/*:refs/*'
out3=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc3=$?
u3=$(git --git-dir="$T/repos/demo.git" config --get remote.gitlab.url)
m3=$(git --git-dir="$T/repos/demo.git" config --get remote.gitlab.mirror)
f3=$(git --git-dir="$T/repos/demo.git" config --get-all remote.gitlab.fetch)
c3=$(grep -c glpat- "$T/repos/demo.git/config" || true)
if [[ $rc3 == 0 ]] && [[ -z $m3 ]] \
   && ! grep -Fq '+refs/*:refs/*' <<<"$f3" \
   && [[ $u3 == 'https://gitlab.com/x/demo.git' ]] \
   && [[ $c3 == 0 ]] \
   && ! grep -q glpat- <<<"$out3" \
   && ! grep -q glpat- "$T/log/code-archive.log"; then
  p 3
else
  f 3
fi

# Check 4: rewritten main is archived; copy main advances to the new tip
git clone -q "$T/github/demo.git" "$T/rewrite"
git -C "$T/rewrite" checkout -q main
git -C "$T/rewrite" config user.email t@t
git -C "$T/rewrite" config user.name t
old_main=$(git --git-dir="$T/repos/demo.git" rev-parse main)
git -C "$T/rewrite" commit -q --amend --allow-empty -m x
git -C "$T/rewrite" push -qf origin main
out4=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc4=$?
new_main=$(git --git-dir="$T/github/demo.git" rev-parse main)
d_main=$(git --git-dir="$T/repos/demo.git" rev-parse main)
arch_obj=$(git --git-dir="$T/repos/demo.git" for-each-ref refs/heads/archive/ --format='%(objectname)')
arch_name=$(git --git-dir="$T/repos/demo.git" for-each-ref refs/heads/archive/ --format='%(refname)')
if [[ $rc4 == 0 ]] && [[ $new_main == $d_main ]] \
   && [[ $arch_obj == $old_main ]] \
   && [[ $arch_name == refs/heads/archive/*/main ]]; then
  p 4
else
  f 4
fi
# Check 5: branch deleted in source remains in copy
git -C "$T/rewrite" checkout -q -b feature
git -C "$T/rewrite" commit -q --allow-empty -m f
git -C "$T/rewrite" push -q origin feature
feat_src=$(git --git-dir="$T/github/demo.git" rev-parse feature)
out5a=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc5a=$?
feat_cpy=$(git --git-dir="$T/repos/demo.git" rev-parse feature 2>/dev/null) || feat_cpy=""
git -C "$T/rewrite" push -q origin --delete feature
out5b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc5b=$?
feat_cpy2=$(git --git-dir="$T/repos/demo.git" rev-parse feature 2>/dev/null) || feat_cpy2=""
if [[ $rc5a == 0 ]] && [[ $rc5b == 0 ]] \
   && [[ $feat_cpy == $feat_src ]] \
   && [[ $feat_cpy2 == $feat_src ]]; then
  p 5
else
  f 5
fi
# Check 6: source refs are unchanged across a run
refs_before=$(git --git-dir="$T/github/demo.git" for-each-ref)
out6=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc6=$?
refs_after=$(git --git-dir="$T/github/demo.git" for-each-ref)
{ [[ $rc6 == 0 ]] && [[ $refs_before == $refs_after ]]; } && p 6 || f 6
# Check 7: per-name isolation — a missing source errs without aborting the pass
rm -f "$T/last-ok"
out7=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo broken 2>&1); rc7=$?
if [[ $rc7 == 1 ]] \
   && grep -qF 'demo ok' <<<"$out7" \
   && grep -qF 'broken err:' <<<"$out7" \
   && grep -qF '=== pass ' <<<"$out7" \
   && grep -qF 'ok=1 err=1 skipped=0' <<<"$out7" \
   && grep -qF '=== pass ' "$T/log/code-archive.log" \
   && [[ ! -e "$T/last-ok" ]]; then
  p 7
else
  f 7
fi
# Check 8: two concurrent runs by the same new name serialize via flock
# a nonexistent source now reports err:not-found and creates no copy, so demo2
# gets a real local source to keep the flock test meaningful.
git init -q --bare "$T/github/demo2.git"
git -C "$T/work" push -q "$T/github/demo2.git" main
CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 CA_GITLAB_BASE=$T/gitlab "$bin/code-archive" demo2 >"$T/out8a" 2>&1 & pid8a=$!
CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 CA_GITLAB_BASE=$T/gitlab "$bin/code-archive" demo2 >"$T/out8b" 2>&1 & pid8b=$!
wait $pid8a; rc8a=$?
wait $pid8b; rc8b=$?
git --git-dir="$T/repos/demo2.git" fsck >/dev/null 2>&1; fsck8=$?
{ [[ $rc8a == 0 && $rc8b == 0 && $fsck8 == 0 ]]; } && p 8 || f 8
# Check 9: successful pass writes last-ok; insufficient space -> err:no-space
rm -f "$T/last-ok"
out9=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc9=$?
out9b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=999999999999 "$bin/code-archive" demo 2>&1); rc9b=$?
{ [[ $rc9 == 0 ]] && [[ -f "$T/last-ok" ]] \
  && [[ $rc9b == 1 ]] && grep -qF 'err:no-space' <<<"$out9b"; } && p 9 || f 9

# Check 10: existing copy with a leaked-credential github url is set to SSH
git --git-dir="$T/repos/demo.git" remote set-url github 'https://ghp_TESTONLY000@example.invalid/x/demo.git'
out10=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env "$bin/code-archive" demo 2>&1); rc10=$?
url10=$(git --git-dir="$T/repos/demo.git" remote get-url github)
if [[ $rc10 == 0 ]] && [[ $url10 == "$T/github/demo.git" ]]; then p 10; else f 10; fi

# Scaffold a bare source repo so --changed can mirror it without the network.
mkgh(){ git init -q --bare "$T/github/$1.git"; }
# Check 11: --changed mirrors new/changed, skips the unchanged copy, writes pushed_at
for r in alpha bravo charlie delta; do mkgh "$r"; done
# U7: seed the sources with a commit so a fresh mirror is a real clone and
# reports ok rather than skip:empty (an actually empty source is covered by check 17).
git -C "$T" init -q seed
git -C "$T/seed" config user.email t@t
git -C "$T/seed" config user.name t
git -C "$T/seed" checkout -q -b main
git -C "$T/seed" commit -q --allow-empty -m init
for r in alpha bravo charlie delta; do git -C "$T/seed" push -q "$T/github/$r.git" main; done
cp -rf "$T/github/alpha.git" "$T/repos/alpha.git"
printf '%s\n' '2026-09-30T10:00:00Z' > "$T/state/alpha.pushed_at"
printf '%s\t%s\t%s\t%s\n' \
  'alpha'   '2026-09-30T10:00:00Z' '100' 'false' \
  'bravo'   '2026-09-30T11:00:00Z' '200' 'false' \
  'charlie' '2026-09-30T12:00:00Z' '300' 'false' \
  'delta'   '2026-09-30T13:00:00Z' '400' 'false' > "$T/list11.tsv"
rm -f "$T/last-ok"
out11=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_LIST_FILE=$T/list11.tsv "$bin/code-archive" --changed 2>&1); rc11=$?
if [[ $rc11 == 0 ]] \
   && grep -qF 'bravo ok' <<<"$out11" \
   && grep -qF 'charlie ok' <<<"$out11" \
   && grep -qF 'delta ok' <<<"$out11" \
   && ! grep -qF 'alpha' <<<"$out11" \
   && ! grep -qF 'alpha' "$T/log/code-archive.log" \
   && [[ "$(cat "$T/state/bravo.pushed_at")" == '2026-09-30T11:00:00Z' ]] \
   && [[ "$(cat "$T/state/charlie.pushed_at")" == '2026-09-30T12:00:00Z' ]] \
   && [[ "$(cat "$T/state/delta.pushed_at")" == '2026-09-30T13:00:00Z' ]] \
   && grep -qF 'ok=3 err=0 skipped=1' <<<"$out11" \
   && [[ -f "$T/last-ok" ]]; then
  p 11
else
  f 11
fi
# Check 12: list far smaller than state/list-count -> err:list-shrunk, code 2, last-ok untouched
printf '%s\n' '10' > "$T/state/list-count"
last12=$(cat "$T/last-ok")
out12=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_LIST_FILE=$T/list11.tsv "$bin/code-archive" --changed 2>&1); rc12=$?
if [[ $rc12 == 2 ]] \
   && grep -qF 'err:list-shrunk 10→4' <<<"$out12" \
   && [[ "$(cat "$T/last-ok")" == "$last12" ]]; then
  p 12
else
  f 12
fi
# Check 13: a row with archived=true is skipped without being mirrored or logged
mkgh "archrepo"
printf '%s\n' '1' > "$T/state/list-count"
printf '%s\t%s\t%s\t%s\n' 'archrepo' '2026-09-30T14:00:00Z' '50' 'true' > "$T/list13.tsv"
out13=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_LIST_FILE=$T/list13.tsv "$bin/code-archive" --changed 2>&1); rc13=$?
if [[ $rc13 == 0 ]] \
   && [[ ! -e "$T/repos/archrepo.git" ]] \
   && ! grep -qF 'archrepo' "$T/log/code-archive.log" \
   && grep -qF 'skipped=1' <<<"$out13"; then
  p 13
else
  f 13
fi

# Check 14: tag v1 deleted in source stays in copy; a rewritten tag v2 is archived
v1_keep=$(git --git-dir="$T/repos/demo.git" rev-parse v1)
git -C "$T/rewrite" checkout -q main
git -C "$T/rewrite" tag v2
git -C "$T/rewrite" push -q origin v2
out14a=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc14a=$?
old_v2=$(git --git-dir="$T/repos/demo.git" rev-parse v2)
git -C "$T/rewrite" commit -q --amend --allow-empty -m moved
git -C "$T/rewrite" tag -f v2
git -C "$T/rewrite" push -qf origin v2
git -C "$T/rewrite" push -q origin --delete v1
out14b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc14b=$?
v2_src=$(git --git-dir="$T/github/demo.git" rev-parse v2)
v2_cpy=$(git --git-dir="$T/repos/demo.git" rev-parse v2)
v1_cpy=$(git --git-dir="$T/repos/demo.git" rev-parse v1 2>/dev/null) || v1_cpy=""
arch_v2_obj=$(git --git-dir="$T/repos/demo.git" for-each-ref 'refs/tags/archive/*/v2' --format='%(objectname)')
arch_v2_name=$(git --git-dir="$T/repos/demo.git" for-each-ref 'refs/tags/archive/*/v2' --format='%(refname)')
if [[ $rc14a == 0 ]] && [[ $rc14b == 0 ]] \
   && [[ "$v1_cpy" == "$v1_keep" ]] \
   && [[ "$v2_cpy" == "$v2_src" ]] \
   && [[ "$arch_v2_obj" == "$old_v2" ]] \
   && [[ "$arch_v2_name" == refs/tags/archive/*/v2 ]]; then
  p 14
else
  f 14
fi

# Check 15: source turns branch foo into foo/bar — name conflict archived
git -C "$T/rewrite" checkout -q -b foo
git -C "$T/rewrite" commit -q --allow-empty -m fooc
git -C "$T/rewrite" push -q origin foo
out15a=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc15a=$?
foo_src=$(git --git-dir="$T/github/demo.git" rev-parse foo)
foo_cpy=$(git --git-dir="$T/repos/demo.git" rev-parse foo)
git -C "$T/rewrite" push -q origin --delete foo
git -C "$T/rewrite" checkout -q main
git -C "$T/rewrite" branch -D foo
git -C "$T/rewrite" update-ref refs/heads/foo/bar "$(git -C "$T/rewrite" rev-parse refs/heads/main)"
git -C "$T/rewrite" push -q origin refs/heads/foo/bar:refs/heads/foo/bar
out15b=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc15b=$?
foo_bar_src=$(git --git-dir="$T/github/demo.git" rev-parse refs/heads/foo/bar)
foo_bar_cpy=$(git --git-dir="$T/repos/demo.git" rev-parse refs/heads/foo/bar)
arc_foo_obj=$(git --git-dir="$T/repos/demo.git" for-each-ref 'refs/heads/archive/*/foo' --format='%(objectname)')
if [[ $rc15a == 0 ]] && [[ $rc15b == 0 ]] \
   && [[ "$foo_cpy" == "$foo_src" ]] \
   && [[ "$foo_bar_cpy" == "$foo_bar_src" ]] \
   && [[ "$arc_foo_obj" == "$foo_src" ]]; then
  p 15
else
  f 15
fi

# Check 16: source of an existing copy disappears -> kept:source-gone, refs unchanged
refs16_before=$(git --git-dir="$T/repos/demo.git" for-each-ref)
mv -f "$T/github/demo.git" "$T/github/demo.git.hidden"
out16=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc16=$?
refs16_after=$(git --git-dir="$T/repos/demo.git" for-each-ref)
mv -f "$T/github/demo.git.hidden" "$T/github/demo.git"
if [[ $rc16 == 0 ]] && grep -qF 'demo kept:source-gone' <<<"$out16" \
   && [[ "$refs16_before" == "$refs16_after" ]]; then
  p 16
else
  f 16
fi

# Check 17: empty source -> skip:empty
git init -q --bare "$T/github/empty0.git"
out17=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" empty0 2>&1); rc17=$?
if [[ $rc17 == 0 ]] && grep -qF 'empty0 skip:empty' <<<"$out17" \
   && grep -qF 'ok=0 err=0 skipped=1' <<<"$out17"; then
  p 17
else
  f 17
fi

# Check 18: after code-archive demo, GitLab has same refs as copy (excluding archive refs)
out18=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_GITLAB_BASE=$T/gitlab CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc18=$?
gl_heads=$(git --git-dir="$T/gitlab/demo.git" for-each-ref refs/heads refs/tags 2>/dev/null | grep -v '/archive/' | sort) || gl_heads=""
cpy_heads=$(git --git-dir="$T/repos/demo.git" for-each-ref refs/heads refs/tags | grep -v '/archive/' | sort)
if [[ $rc18 == 0 ]] && [[ "$gl_heads" == "$cpy_heads" ]]; then
  p 18
else
  f 18
fi

# Check 19: main rewritten in source -> old in GitLab unchanged, new under rewritten/<ts>/main
old_main_src=$(git --git-dir="$T/github/demo.git" rev-parse main)
git -C "$T/rewrite" checkout -q main
git -C "$T/rewrite" commit -q --amend --allow-empty -m rewritten
git -C "$T/rewrite" push -qf origin main
out19=$(CA_GITHUB_BASE=$T/github CA_REPOS_DIR=$T/repos CA_STATE_DIR=$T/state CA_LOG=$T/log/code-archive.log CA_ENV_FILE=$T/env CA_GITLAB_BASE=$T/gitlab CA_LAST_OK=$T/last-ok CA_FREE_MIN_KB=1 "$bin/code-archive" demo 2>&1); rc19=$?
gl_main=$(git --git-dir="$T/gitlab/demo.git" rev-parse refs/heads/main 2>/dev/null) || gl_main=""
gl_rewritten=$(git --git-dir="$T/gitlab/demo.git" for-each-ref 'refs/heads/rewritten/*/main' --format='%(objectname)' 2>/dev/null | head -1) || gl_rewritten=""
if [[ $rc19 == 0 ]] && [[ "$gl_main" == "$old_main_src" ]] \
   && [[ -n "$gl_rewritten" ]] \
   && grep -qF 'ok:gitlab-rewritten rewritten/' "$T/log/code-archive.log"; then
  p 19
else
  f 19
fi

# U8b: stub curl that logs its args and the value-free auth header, then
# answers per the requested URL. The token is only ever passed via `-H @-` on
# stdin, so it never appears in the logged args.
mkdir -p "$T/stub"
cat > "$T/stub/curl" <<'STUB'
#!/usr/bin/env bash
# Test-only curl stub: log args + value-free auth header, answer per URL.
log="${CURL_LOG:?}"
printf 'ARGS: %s\n' "$*" >> "$log"
if [[ ! -t 0 ]]; then
  while IFS= read -r line; do
    case "$line" in
      PRIVATE-TOKEN:*) printf 'PRIVATE-TOKEN:\n' >> "$log";;
    esac
  done
fi
url=""; for a in "$@"; do case "$a" in http://*|https://*) url="$a"; break;; esac; done
out=""; prev=""
for a in "$@"; do if [[ "$prev" == "-o" ]]; then out="$a"; fi; prev="$a"; done
code=500; body='{}'
if [[ "$url" == *"/projects/"* && "$*" != *"-X POST"* ]]; then
  if [[ "$url" == *"%2Fdemo3"* ]]; then code=404
  else code=200; body='{"visibility":"public"}'; fi
elif [[ "$url" == *"/projects"* && "$*" == *"-X POST"* ]]; then
  code=201; body='{"id":99}'
elif [[ "$url" == *"/groups/"* ]]; then
  code=200; body='{"id":42}'
fi
if [[ -n "$out" ]]; then printf '%s' "$body" > "$out"; fi
printf '%s' "$code"
STUB
chmod +x "$T/stub/curl"
printf '%s\n' 'GITLAB_MIRROR_TOKEN=glpat-TESTONLY000' > "$T/envU8b"

# Check 20: GitLab project already public -> err:visibility, no POST, no key leak
rm -f "$T/curl.log"
