# Check 44: a single code-archive <name> run survives a launch from a directory
# removed before the send starts. `ship` deletes a worktree dir mid-run; the
# orphaned process's CWD no longer exists on disk, but the top-level `cd /` in
# code-archive keeps it readable -> the mirror finishes ok, code 0.
main44=$(git --git-dir="$T/github/demo.git" rev-parse main)
mkdir -p "$T/gone44"
( cd "$T/gone44" && rmdir "$T/gone44"
  out44=$(env "${localenv[@]}" "$bin/code-archive" demo 2>&1); rc44=$?
  printf '%s' "$out44" > "$T/out44"
  printf '%s' "$rc44" > "$T/rc44" )
out44=$(cat "$T/out44")
rc44=$(cat "$T/rc44")
d44=$(git --git-dir="$T/repos/demo.git" rev-parse main 2>/dev/null) || d44=""
if [[ $rc44 == 0 ]] && [[ "$d44" == "$main44" ]] \
   && grep -qF 'demo ok' <<<"$out44"; then
  p 44
else
  f 44
fi

