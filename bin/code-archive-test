gitlab_ok
if [[ $rc37 == 1 ]] \
   && [[ -f "$T/state/night37a.fail" ]] \
   && [[ -f "$T/state/night37b.fail" ]] \
   && [[ "$(wc -l < "$T/state/notify.out")" == 1 ]] \
   && grep -qF 'night37a' "$T/state/notify.out" \
   && grep -qF 'night37b' "$T/state/notify.out"; then
