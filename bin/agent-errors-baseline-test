#!/usr/bin/env bash
set -u

bin=$(cd -- "$(dirname -- "$0")" && pwd)/agent-errors-baseline
[[ -f $bin && -x $bin ]] || { echo "FAIL: tool missing: $bin" >&2; exit 1; }

tmp=$(mktemp -d "${TMPDIR:-/tmp}/aeb-test-XXXXXX")
adir=$(mktemp -d "${TMPDIR:-/tmp}/aeb-anom-XXXXXX")
trap 'rm -rf "$tmp" "$adir"' EXIT

pad=$(printf 'z%.0s' {1..200})

# file a: use+result in DIFFERENT records; 1 ok use, 1 hook attachment (10 chars), bad jsonl line, blank line
cat >"$tmp/a.jsonl" <<EOF
{"type":"assistant","pad":"$pad","message":{"content":[{"type":"tool_use","id":"toolu_1","name":"Bash","input":{"command":"echo hi"}}]}}
{"type":"user","pad":"$pad","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_1","is_error":false,"content":"hi"}]}}
{"type":"attachment","pad":"$pad","attachment":{"type":"hook_additional_context","content":"0123456789"}}
{"type":"user" oops
EOF
while [[ $(wc -c <"$tmp/a.jsonl") -le 1100 ]]; do printf '{"type":"pad","pad":"%s"}\n' "$pad" >>"$tmp/a.jsonl"; done
printf '\n' >>"$tmp/a.jsonl"

# file b: same-record pairing (toolu_2), later-record pairing (toolu_3), ok Bash result whose
# text mentions "has been denied" (not a denial), Read error (not a bash error), real denial
cat >"$tmp/b.jsonl" <<EOF
{"type":"assistant","pad":"$pad","message":{"content":[{"type":"tool_use","id":"toolu_2","name":"Bash","input":{"command":"ls /x"}},{"type":"tool_result","tool_use_id":"toolu_2","is_error":true,"content":"ls: cannot access '/x': No such file or directory"}]}}
{"type":"user","pad":"$pad","message":{"content":[{"type":"tool_use","id":"toolu_3","name":"Bash","input":{"command":"rm -rf /"}}]}}
{"type":"user","pad":"$pad","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_3","is_error":true,"content":"tool_use request has been denied by policy"}]}}
{"type":"assistant","pad":"$pad","message":{"content":[{"type":"tool_use","id":"toolu_4","name":"Bash","input":{"command":"grep -r policy /log"}},{"type":"tool_result","tool_use_id":"toolu_4","is_error":false,"content":"req has been denied by policy: 1 hits"}]}}
{"type":"user","pad":"$pad","message":{"content":[{"type":"tool_use","id":"toolu_5","name":"Read","input":{"file_path":"/x"}},{"type":"tool_result","tool_use_id":"toolu_5","is_error":true,"content":"file does not exist"}]}}
{"type":"user","pad":"$pad","message":{"content":[{"type":"tool_use","id":"toolu_6","name":"Bash","input":{"command":"rm -rf /"}}]}}
{"type":"user","pad":"$pad","message":{"content":[{"type":"tool_result","tool_use_id":"toolu_6","is_error":true,"content":"Permission to use Bash (command rm -rf /) has been denied"}]}}
EOF
while [[ $(wc -c <"$tmp/b.jsonl") -le 1100 ]]; do printf '{"type":"pad","pad":"%s"}\n' "$pad" >>"$tmp/b.jsonl"; done

out=$("$bin" --corpus "$tmp" --days 7) || { echo 'FAIL: tool rc nonzero' >&2; exit 1; }
chk() { grep -Eq -- "$1" <<<"$out" || { echo "FAIL: expected [$1]" >&2; echo "$out" >&2; exit 1; }; }
chk '^bash_calls=5$'
chk '^bash_errors=3$'
chk '^denials=1$'
chk '^path_errors=2$'
chk '^injected_chars=10$'
chk '^subagent_injected_chars=0$'
chk '^FAIL bash_rate 60.00% > 3$'
chk '^FAIL denial_rate 20.00% > 0.4$'
chk '^PASS path_errors 2 <= 5.00 \(5/7 x 7\)$'
chk '^PASS injected_chars 10 <= 3082799 \(50% of 6165599/7 x 7\)$'
chk '^targets=4 pass=2 fail=2 secs=[0-9]+$'

"$bin" --corpus "$tmp" --days 1 >/dev/null || { echo 'FAIL: --days 1 rc nonzero' >&2; exit 1; }
# anomaly fixtures: one positive case per class, plus noise; each file padded past the 1k size filter
padf() { while [[ $(wc -c <"$1") -le 1100 ]]; do printf '{"type":"pad","pad":"%s"}\n' "$pad" >>"$1"; done; }
cat >"$adir/s1.jsonl" <<'EOF'
{"type":"user","message":{"content":"go"}}
{"type":"user","isMeta":true,"message":{"content":"Stop hook feedback: first"}}
{"type":"user","isMeta":true,"message":{"content":"Stop hook feedback: second"}}
EOF
cat >"$adir/s2.jsonl" <<'EOF'
{"type":"user","message":{"content":"go"}}
{"type":"user","isMeta":true,"message":{"content":"Stop hook feedback: a"}}
{"type":"user","isMeta":true,"message":{"content":"Stop hook feedback: b"}}
{"type":"user","isMeta":true,"message":{"content":"Stop hook feedback: c"}}
EOF
cat >"$adir/r1.jsonl" <<'EOF'
{"type":"user","message":{"content":"go"}}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"r1","name":"Bash","input":{"command":"make build"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"r1","is_error":true,"content":"boom"}]}}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"r2","name":"Bash","input":{"command":"make build"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"r2","is_error":true,"content":"boom"}]}}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"r3","name":"Bash","input":{"command":"make build"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"r3","is_error":true,"content":"boom"}]}}
EOF
cat >"$adir/d1.jsonl" <<'EOF'
{"type":"user","message":{"content":"go"}}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"d1","name":"Bash","input":{"command":"rm a"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"d1","is_error":true,"content":"Permission to use Bash has been denied"}]}}
{"type":"assistant","message":{"content":[{"type":"tool_use","id":"d2","name":"Bash","input":{"command":"rm b"}}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"d2","is_error":true,"content":"Permission to use Bash has been denied"}]}}
EOF
cat >"$adir/f1.jsonl" <<'EOF'
{"type":"user","message":{"content":"go"}}
{"type":"assistant","message":{"content":[{"type":"text","text":"all DONE"}]}}
{"type":"user" oops
EOF
cat >"$adir/n.jsonl" <<'EOF'
{"type":"user","message":{"content":"go"}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"x1","is_error":false,"content":"Stop hook feedback: x"}]}}
{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"x2","is_error":false,"content":"Stop hook feedback: x"}]}}
EOF
for f in "$adir"/*.jsonl; do padf "$f"; done

T=$'\t'
out=$("$bin" --anomalies --corpus "$adir" --days 7) || { echo 'FAIL: --anomalies rc nonzero' >&2; exit 1; }
chk "^s1${T}3${T}S1${T}Stop hook feedback: second$"
chk "^s2${T}3${T}S1${T}Stop hook feedback: b$"
chk "^s2${T}4${T}S2${T}Stop hook feedback: c$"
chk "^r1${T}7${T}R1${T}boom$"
chk "^d1${T}5${T}D1${T}Permission to use Bash has been denied$"
chk "^f1${T}2${T}F1${T}all DONE$"
chk '^anomalies=7 S1=3 S2=1 R1=1 D1=1 F1=1 skipped_lines=1$'
out=$("$bin" --anomalies --session s2 --corpus "$adir") || { echo 'FAIL: --session rc nonzero' >&2; exit 1; }
chk '^anomalies=3 S1=2 S2=1 R1=0 D1=0 F1=0 skipped_lines=0$'
out=$("$bin" --anomalies --session n --corpus "$adir") || { echo 'FAIL: --session n rc nonzero' >&2; exit 1; }
chk '^anomalies=0 S1=0 S2=0 R1=0 D1=0 F1=0 skipped_lines=0$'
out=$("$bin" --anomalies --session nope --corpus "$adir") || { echo 'FAIL: --session nope rc nonzero' >&2; exit 1; }
chk '^no transcript for nope$'
chk '^anomalies=0 S1=0 S2=0 R1=0 D1=0 F1=0 skipped_lines=0$'
"$bin" --anomalies --corpus "$tmp" >/dev/null || { echo 'FAIL: --anomalies on weekly corpus rc nonzero' >&2; exit 1; }
"$bin" --help | grep -q -- '--anomalies' || { echo 'FAIL: --help lacks --anomalies' >&2; exit 1; }
echo PASS
