#!/usr/bin/env bash
set -u
BIN="$(cd "$(dirname "$0")" && pwd)/secret-gate"
TOP="$(cd "$(dirname "$BIN")/.." && pwd)"
SANDBOX="/tmp/test-secret-gate-$$"
rm -rf "$SANDBOX"
mkdir -p "$SANDBOX/secrets" "$SANDBOX/conf" "$SANDBOX/repo"
export SECRET_WARN_LOG="$SANDBOX/secret-warn.log"

T1="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
T2="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf 'FAKE_TOKEN=%s\nDB_PASS=%s\n' "$T1" "$T2" > "$SANDBOX/secrets/fake.env"

cp -f "$TOP/config/secret-gate.stop" "$SANDBOX/conf/secret-gate.stop"
printf '# <sha256> <bd-id> <класс R2>\n' > "$SANDBOX/conf/secret-gate.allow"

export SECRET_GATE_DIR="$SANDBOX/secrets"
export SECRET_GATE_CONF="$SANDBOX/conf"

if ! "$BIN" build >/dev/null 2>&1; then
    echo "build failed"; rm -rf "$SANDBOX"; exit 1
fi

R="$SANDBOX/repo"
cd "$R" || { rm -rf "$SANDBOX"; exit 1; }
git init -q
git config user.email t@example.com
git config user.name t
mkdir -p "$SANDBOX/empty-hooks"
git config core.hooksPath "$SANDBOX/empty-hooks"
echo hi > f.txt
git add f.txt
git commit -qm base

PASS=0; FAIL=0

expect() {
    local name=$1 want=$2; shift 2
    "$BIN" "$@" >/dev/null 2>"$SANDBOX/err"
    local c=$?
    if [ "$c" -eq "$want" ]; then
        PASS=$((PASS+1))
    else
        FAIL=$((FAIL+1)); echo "FAIL[$name] want=$want got=$c args=[$*]"
    fi
}

# (б) чистый коммит -> 0
echo clean > c.txt
git add c.txt; git commit -qm clean
expect clean 0 check HEAD^..HEAD

# (а) значение в добавленной строке -> 1, BLOCKED, без значения в выводе
printf 'secret line: %s\n' "$T1" >> f.txt
git add f.txt; git commit -qm addval
out=$("$BIN" check HEAD^..HEAD 2>&1); c=$?
if [ "$c" -eq 1 ] && printf '%s\n' "$out" | grep -q 'BLOCKED' \
   && ! printf '%s\n' "$out" | grep -qF "$T1"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[value-line] code=$c out=$out"
fi

# (в) значение в сообщении коммита -> 1
echo msg > m.txt
git add m.txt; git commit -qm "secret $T1"
expect msg 1 check HEAD^..HEAD

# (г) значение в бинарном файле -> 1
printf '\x00%s\x00' "$T1" > b.bin
git add b.bin; git commit -qm bin
expect bin 1 check HEAD^..HEAD

# (д) аннотированный тег --tag -> 1
git tag -a tg -m "tag secret $T1" HEAD
expect tag 1 check --tag tg

# (е) --staged -> 1
printf 'staged %s\n' "$T1" > s.txt
git add s.txt
expect staged 1 check --staged
git reset -q; rm -f s.txt

# (ж) text - -> 1
if printf 'text %s\n' "$T1" | "$BIN" text - >/dev/null 2>&1; then c=0; else c=1; fi
[ "$c" -eq 1 ] && PASS=$((PASS+1)) || { FAIL=$((FAIL+1)); echo "FAIL[text]"; }

# (з) добавленная строка с gitleaks:allow -> 1
printf '%s  gitleaks:allow\n' "$T1" > g.txt
git add g.txt; git commit -qm gitleaks
expect gitleaks 1 check HEAD^..HEAD

# (и) хэш в allow -> 0
printf '%s\n' "$(printf '%s' "$T1" | sha256sum | awk '{print $1}')" >> "$SANDBOX/conf/secret-gate.allow"
printf 'allowed %s\n' "$T1" > allow.txt
git add allow.txt; git commit -qm allow
expect allow 0 check HEAD^..HEAD

# (й) inline-allow без хэша -> 1, с хэшем содержимого строки в allow -> 0
MK="gitleaks"":allow"
printf '%s\n' "$MK" > mk.txt
git add mk.txt; git commit -qm mklabel
expect mk-inline 1 check HEAD^..HEAD
printf '%s\n' "$(printf '%s' "$MK" | sha256sum | awk '{print $1}') test-bd ложное" >> "$SANDBOX/conf/secret-gate.allow"
expect mk-allowed 0 check HEAD^..HEAD

# (к) значение в DSN postgres://u:<значение>@h/db -> 1
printf 'postgres://u:%s@h/db\n' "$T2" > d.txt
git add d.txt; git commit -qm dsn
expect dsn 1 check HEAD^..HEAD

# (л) нет каталога -> 2
SECRET_GATE_DIR="$SANDBOX/nonexist" "$BIN" check HEAD >/dev/null 2>&1
lc=$?
[ "$lc" -eq 2 ] && PASS=$((PASS+1)) || { FAIL=$((FAIL+1)); echo "FAIL[nodir] got=$lc"; }

# (м) check 500 строк <= 1 с (тёплый реестр)
start=$(date +%s%3N)
seq 1 500 | "$BIN" text - >/dev/null 2>&1
code=$?
end=$(date +%s%3N)
el=$((end-start))
if [ "$code" -eq 0 ] && [ "$el" -le 1000 ]; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[perf] code=$code el=${el}ms"
fi

# (н) значения extra-файла и extra-каталога -> 1
T3="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
T4="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
mkdir -p "$SANDBOX/extra-dir"
printf 'EXTRA_FILE_TOK=%s\n' "$T3" > "$SANDBOX/extra.txt"
printf 'EXTRA_DIR_TOK=%s\n' "$T4" > "$SANDBOX/extra-dir/inner.env"
printf '%s\n%s\n' "$SANDBOX/extra.txt" "$SANDBOX/extra-dir" > "$SANDBOX/conf/secret-gate.extra"
if ! "$BIN" build >/dev/null 2>&1; then
    echo "rebuild(extra) failed"; rm -rf "$SANDBOX"; exit 1
fi
printf 'extra leak %s %s\n' "$T3" "$T4" > e.txt
git add e.txt; git commit -qm extra
expect extra 1 check HEAD^..HEAD

# (п) обычный текст и ключ description в реестр не попадают -> 0
TEXT="ordinary note text about the running system services"
printf '%s\n' "$TEXT" > "$SANDBOX/secrets/notes.md"
printf '%s\n' "$TEXT" > "$SANDBOX/secrets/run.jsonl"
printf '{"description": "%s"}\n' "$TEXT" > "$SANDBOX/secrets/config.json"
if ! "$BIN" build >/dev/null 2>&1; then
    echo "rebuild(plain) failed"; rm -rf "$SANDBOX"; exit 1
fi
printf '%s\n' "$TEXT" > pt.txt
git add pt.txt; git commit -qm plain
expect plain 0 check HEAD^..HEAD

# (р) api_token высокой энтропии в config.json -> 1
T5="$(head -c24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf '{"api_token": "%s"}\n' "$T5" > "$SANDBOX/secrets/config.json"
if ! "$BIN" build >/dev/null 2>&1; then
    echo "rebuild(tok) failed"; rm -rf "$SANDBOX"; exit 1
fi
printf 'token here: %s\n' "$T5" > rt.txt
git add rt.txt; git commit -qm tok
expect tok 1 check HEAD^..HEAD

# (о) повреждённый ввод -> исключение -> 2, secret-gate: error <тип> без значений
printf '\xff\xfe\xfa\n' > "$SANDBOX/conf/secret-gate.extra"
out=$("$BIN" build 2>&1); oc=$?
if [ "$oc" -eq 2 ] && printf '%s\n' "$out" | grep -qE 'secret-gate: error [A-Za-z]+' \
   && ! printf '%s\n' "$out" | grep -qF "$T3"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[exception] code=$oc out=$out"
fi
: > "$SANDBOX/conf/secret-gate.extra"

# (с) значение в первом из двух коммитов новой ветки -> 1
T6="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf 'RANGE_TOKEN=%s\n' "$T6" > "$SANDBOX/secrets/range.env"
"$BIN" build >/dev/null 2>&1 || exit 1
git checkout -qb range-branch
printf 'range %s\n' "$T6" > range.txt
git add range.txt; git commit -qm range-first
echo clean > range-clean.txt
git add range-clean.txt; git commit -qm range-clean
RANGE_TIP=$(git rev-parse HEAD)
expect range-first 1 check "$RANGE_TIP" --not --remotes=origin/*

# (т) значение добавлено и удалено внутри диапазона -> 1
T7="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf 'RANGE_REMOVE=%s\n' "$T7" > "$SANDBOX/secrets/remove.env"
"$BIN" build >/dev/null 2>&1 || exit 1
START=$(git rev-parse HEAD)
printf 'remove %s\n' "$T7" > removed.txt
git add removed.txt; git commit -qm range-add
rm -f removed.txt
git add -u; git commit -qm range-remove
expect range-removed 1 check "$START..HEAD"

# (у) сообщение не-верхнего коммита -> 1
T8="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf 'RANGE_MESSAGE=%s\n' "$T8" > "$SANDBOX/secrets/message.env"
"$BIN" build >/dev/null 2>&1 || exit 1
START=$(git rev-parse HEAD)
echo message > message.txt
git add message.txt; git commit -qm "range message $T8"
echo clean > message-clean.txt
git add message-clean.txt; git commit -qm message-clean
expect range-message 1 check "$START..HEAD"

# (ф) pre-push через копию dispatch: находка в диапазоне -> код 0 (push не остановлен),
#     в журнал предупреждений НЕ пишется новая строка от pre-push, ref появляется
REMOTE="$SANDBOX/remote.git"
git init --bare -q "$REMOTE"
git remote add origin "$REMOTE"
mkdir -p "$SANDBOX/hooks"
printf '#!/bin/sh\nexit 0\n' > "$SANDBOX/gitleaks"
chmod 700 "$SANDBOX/gitleaks"
sed -e "s|^SG=.*|SG=$BIN|" -e "s|/root/.local/bin/gitleaks|$SANDBOX/gitleaks|" "$TOP/git-hooks/dispatch" > "$SANDBOX/hooks/pre-push"
chmod 700 "$SANDBOX/hooks/pre-push"
BEFORE=$(grep -c 'secret-gate check' "$SECRET_WARN_LOG" 2>/dev/null || echo 0)
git -c core.hooksPath="$SANDBOX/hooks" push origin HEAD:refs/heads/range-branch >/dev/null 2>"$SANDBOX/pusherr"
c=$?
AFTER=$(grep -c 'secret-gate check' "$SECRET_WARN_LOG" 2>/dev/null || echo 0)
if [ "$c" -eq 0 ] && git --git-dir="$REMOTE" show-ref --verify --quiet refs/heads/range-branch \
   && [ "$AFTER" = "$BEFORE" ]; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[dispatch-range] code=$c"
fi

# (х) первый push чистой ветки в пустой remote -> 0, без stderr secret-gate
CLEAN="$SANDBOX/cleanrepo"; CLEAN_REMOTE="$SANDBOX/cleanremote.git"
git init -q "$CLEAN"; git init --bare -q "$CLEAN_REMOTE"
git -C "$CLEAN" config user.email t@example.com
git -C "$CLEAN" config user.name t
git -C "$CLEAN" config core.hooksPath "$SANDBOX/empty-hooks"
echo clean > "$CLEAN/clean.txt"
git -C "$CLEAN" add clean.txt; git -C "$CLEAN" commit -qm clean
git -C "$CLEAN" remote add origin "$CLEAN_REMOTE"
git -C "$CLEAN" -c core.hooksPath="$SANDBOX/hooks" push origin HEAD:refs/heads/clean >/dev/null 2>"$SANDBOX/cleanerr"
c=$?
if [ "$c" -eq 0 ] && ! grep -q 'secret-gate:' "$SANDBOX/cleanerr"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[dispatch-clean] code=$c"
fi

# (ц) бинарный blob >10MB не читается и завершается <=1с
START=$(git rev-parse HEAD)
truncate -s 10485761 huge.bin
git add huge.bin; git commit -qm huge-bin
start=$(date +%s%3N)
"$BIN" check "$START..HEAD" >/dev/null 2>&1
code=$?
end=$(date +%s%3N)
el=$((end-start))
if [ "$code" -eq 0 ] && [ "$el" -le 1000 ]; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[huge-bin] code=$code el=${el}ms"
fi

# (ч) gitlink 160000 в диапазоне -> 0, без git error
GL_SHA=1111111111111111111111111111111111111111
git update-index --add --cacheinfo "160000,$GL_SHA,sub"
git commit -qm gitlink
out=$("$BIN" check HEAD^..HEAD 2>&1); c=$?
if [ "$c" -eq 0 ] && ! printf '%s\n' "$out" | grep -q 'git error'; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[gitlink] code=$c out=$out"
fi

# (щ) pre-push через копию dispatch: цепочечный хук выходит с 0, после выхода TMPDIR пуст
TMPD="$SANDBOX/tmpdir"
rm -rf "$TMPD"; mkdir -p "$TMPD"
COMMON="$(git -C "$R" rev-parse --git-common-dir)"
mkdir -p "$COMMON/hooks"
printf '#!/bin/sh\nexit 0\n' > "$COMMON/hooks/pre-push"
chmod 700 "$COMMON/hooks/pre-push"
TMPDIR="$TMPD" git -c core.hooksPath="$SANDBOX/hooks" push origin HEAD:refs/heads/range-branch >/dev/null 2>&1
rc=$?
if [ "$rc" -ne 0 ]; then
    FAIL=$((FAIL+1)); echo "FAIL[dispatch-tmp] push rc=$rc"
elif [ -z "$(ls -A "$TMPD")" ]; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[dispatch-tmp]"
fi

echo "PASS $PASS FAIL $FAIL"
rm -rf "$SANDBOX"
[ "$FAIL" -eq 0 ]
