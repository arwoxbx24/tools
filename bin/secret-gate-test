#!/usr/bin/env bash
set -u
BIN="$(cd "$(dirname "$0")" && pwd)/secret-gate"
TOP="$(cd "$(dirname "$BIN")/.." && pwd)"
SANDBOX="/root/workspaces/sandbox/test-secret-gate-$$"
rm -rf "$SANDBOX"
mkdir -p "$SANDBOX/secrets" "$SANDBOX/conf" "$SANDBOX/repo"

T1="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
T2="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
printf 'FAKE_TOKEN=%s\nDB_PASS=%s\n' "$T1" "$T2" > "$SANDBOX/secrets/fake.env"

cp -f "$TOP/config/secret-gate.stop" "$SANDBOX/conf/secret-gate.stop"
printf '# <sha256> <bd-id> <класс R2>\n' > "$SANDBOX/conf/secret-gate.allow"

export SECRET_GATE_DIR="$SANDBOX/secrets"
export SECRET_GATE_CONF="$SANDBOX/conf"

if ! "$BIN" build >/dev/null 2>&1; then
    echo "build failed"; rm -rf "$SANDBOX"; exit 1
fi

R="$SANDBOX/repo"
cd "$R" || { rm -rf "$SANDBOX"; exit 1; }
git init -q
git config user.email t@example.com
git config user.name t
echo hi > f.txt
git add f.txt
git commit -qm base

PASS=0; FAIL=0

expect() {
    local name=$1 want=$2; shift 2
    "$BIN" "$@" >/dev/null 2>"$SANDBOX/err"
    local c=$?
    if [ "$c" -eq "$want" ]; then
        PASS=$((PASS+1))
    else
        FAIL=$((FAIL+1)); echo "FAIL[$name] want=$want got=$c args=[$*]"
    fi
}

# (б) чистый коммит -> 0
echo clean > c.txt
git add c.txt; git commit -qm clean
expect clean 0 check HEAD

# (а) значение в добавленной строке -> 1, BLOCKED, без значения в выводе
printf 'secret line: %s\n' "$T1" >> f.txt
git add f.txt; git commit -qm addval
out=$("$BIN" check HEAD 2>&1); c=$?
if [ "$c" -eq 1 ] && printf '%s\n' "$out" | grep -q 'BLOCKED' \
   && ! printf '%s\n' "$out" | grep -qF "$T1"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[value-line] code=$c out=$out"
fi

# (в) значение в сообщении коммита -> 1
echo msg > m.txt
git add m.txt; git commit -qm "secret $T1"
expect msg 1 check HEAD

# (г) значение в бинарном файле -> 1
printf '\x00%s\x00' "$T1" > b.bin
git add b.bin; git commit -qm bin
expect bin 1 check HEAD

# (д) аннотированный тег --tag -> 1
git tag -a tg -m "tag secret $T1" HEAD
expect tag 1 check --tag tg

# (е) --staged -> 1
printf 'staged %s\n' "$T1" > s.txt
git add s.txt
expect staged 1 check --staged
git reset -q; rm -f s.txt

# (ж) text - -> 1
if printf 'text %s\n' "$T1" | "$BIN" text - >/dev/null 2>&1; then c=0; else c=1; fi
[ "$c" -eq 1 ] && PASS=$((PASS+1)) || { FAIL=$((FAIL+1)); echo "FAIL[text]"; }

# (з) добавленная строка с gitleaks:allow -> 1
printf '%s  gitleaks:allow\n' "$T1" > g.txt
git add g.txt; git commit -qm gitleaks
expect gitleaks 1 check HEAD

# (и) хэш в allow -> 0
printf '%s\n' "$(printf '%s' "$T1" | sha256sum | awk '{print $1}')" >> "$SANDBOX/conf/secret-gate.allow"
expect allow 0 check HEAD

# (к) значение в DSN postgres://u:<значение>@h/db -> 1
printf 'postgres://u:%s@h/db\n' "$T2" > d.txt
git add d.txt; git commit -qm dsn
expect dsn 1 check HEAD

# (л) нет каталога -> 2
SECRET_GATE_DIR="$SANDBOX/nonexist" "$BIN" check HEAD >/dev/null 2>&1
lc=$?
[ "$lc" -eq 2 ] && PASS=$((PASS+1)) || { FAIL=$((FAIL+1)); echo "FAIL[nodir] got=$lc"; }

# (м) check 500 строк <= 1 с (тёплый реестр)
start=$(date +%s%3N)
seq 1 500 | "$BIN" text - >/dev/null 2>&1
code=$?
end=$(date +%s%3N)
el=$((end-start))
if [ "$code" -eq 0 ] && [ "$el" -le 1000 ]; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[perf] code=$code el=${el}ms"
fi

# (н) значения extra-файла и extra-каталога -> 1
T3="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
T4="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
mkdir -p "$SANDBOX/extra-dir"
printf 'EXTRA_FILE_TOK=%s\n' "$T3" > "$SANDBOX/extra.txt"
printf 'EXTRA_DIR_TOK=%s\n' "$T4" > "$SANDBOX/extra-dir/inner.env"
printf '%s\n%s\n' "$SANDBOX/extra.txt" "$SANDBOX/extra-dir" > "$SANDBOX/conf/secret-gate.extra"
if ! "$BIN" build >/dev/null 2>&1; then
    echo "rebuild(extra) failed"; rm -rf "$SANDBOX"; exit 1
fi
printf 'extra leak %s %s\n' "$T3" "$T4" > e.txt
git add e.txt; git commit -qm extra
expect extra 1 check HEAD

# (о) повреждённый ввод -> исключение -> 2, secret-gate: error <тип> без значений
printf '\xff\xfe\xfa\n' > "$SANDBOX/conf/secret-gate.extra"
out=$("$BIN" build 2>&1); oc=$?
if [ "$oc" -eq 2 ] && printf '%s\n' "$out" | grep -qE 'secret-gate: error [A-Za-z]+' \
   && ! printf '%s\n' "$out" | grep -qF "$T3"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[exception] code=$oc out=$out"
fi

echo "PASS $PASS FAIL $FAIL"
rm -rf "$SANDBOX"
[ "$FAIL" -eq 0 ]
