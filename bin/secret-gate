#!/usr/bin/env python3
import sys
if sys.argv[1:2] in (["-h"], ["--help"]):
    print("usage: secret-gate build | check [<range...>|--staged|--tag <obj>] | text - | scan <repo>  (проверяет секреты)")
    sys.exit(0)
import fcntl, hashlib, json, math, os, re, subprocess
TOK = re.compile(rb'[A-Za-z0-9]+'); DEF = '/root/workspaces/secrets'
PRINT = re.compile(rb'[ -~]{8,}'); MARK = b'\x1e'; END = b'\x1f'; MAX_BLOB = 10485760
INLINE = b'gitleaks' + b':allow'
SKIP_EXT = ('.tar', '.gz', '.tgz', '.zip', '.jsonl', '.log', '.md', '.sql', '.db', '.sqlite')
SECRET_KEY = re.compile(r'key|token|secret|pass|pwd|auth|credential|private|dsn|url')
def die(m, c=2): sys.stderr.write('secret-gate: %s\n' % m); sys.exit(c)
def git(a, cwd=None):
    p = subprocess.run(['git'] + a, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=cwd)
    if p.returncode:
        e = p.stderr.decode('utf-8', 'replace').strip().splitlines()
        die('git error: ' + (e[0] if e else 'git'))
    return p.stdout
def show(o, cwd=None):
    p = subprocess.run(['git', 'show', o], stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=cwd)
    return p.stdout if p.returncode == 0 else None
def conf():
    e = os.environ.get('SECRET_GATE_CONF')
    return e or os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), 'config')
def extra_path():
    return os.path.join(conf(), 'secret-gate.extra')
def extra_paths():
    out = []
    try:
        for l in open(extra_path(), encoding='utf-8'):
            s = l.strip()
            if s and not s.startswith('#'): out.append(s)
    except OSError: pass
    return out
def lines(fn):
    out = []
    try:
        for l in open(os.path.join(conf(), fn), encoding='utf-8'):
            s = l.strip()
            if s and not s.startswith('#'): out.append(s)
    except OSError: pass
    return out
def stop(t, st):
    s = t.decode('ascii', 'ignore')
    return any((x.endswith('*') and s.startswith(x[:-1])) or s == x for x in st)
def sha(b): return hashlib.sha256(b).hexdigest()
def ent(b):
    n = len(b)
    if not n: return 0.0
    c = {}
    for x in b: c[x] = c.get(x, 0) + 1
    return -(sum((v / n) * math.log2(v / n) for v in c.values()))
def clean(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in (34, 39):
        v = v[1:-1]
    v = re.split(rb'\s+[#;].*$', v, 1)[0].rstrip()
    return v
def env_vals(data):
    out = []
    for l in data.splitlines():
        l = l.strip()
        if not l: continue
        if l.startswith(b'export '): l = l[len(b'export '):].lstrip()
        if b'=' in l:
            k, v = l.split(b'=', 1)
            if re.fullmatch(rb'[A-Za-z_][A-Za-z0-9_]*', k): out.append(v)
    return out
def seq_vals(data, sep):
    out = []
    for l in data.splitlines():
        l = l.strip()
        if not l or l.startswith((b'#', b'- ')): continue
        m = re.match(rb'([A-Za-z_][A-Za-z0-9_.-]*)\s*' + (rb':' if sep == ':' else rb'=') + rb'\s*(.*)$', l)
        if m and SECRET_KEY.search(m.group(1).decode('ascii', 'ignore')): out.append(m.group(2))
    return out
def json_vals(data):
    out = []
    def walk(x):
        if isinstance(x, dict):
            for k, v in x.items():
                if SECRET_KEY.search(str(k)):
                    if isinstance(v, str): out.append(v.encode('utf-8', 'replace'))
                    elif isinstance(v, bool) or isinstance(v, (int, float)): out.append(str(v).encode())
                walk(v)
        elif isinstance(x, list):
            for i in x: walk(i)
    walk(json.loads(data.decode('utf-8', 'replace')))
    return out
def pem_vals(data):
    out = []; body = []; active = False
    for l in data.splitlines():
        if b'-----BEGIN' in l: active = True; body = []; continue
        if b'-----END' in l: active = False
        elif active and l.strip(): body.append(l.strip())
    if body:
        out.append(b''.join(body))
        out.extend(body)
    return out
def keep(v, st):
    if len(v) < 8 or stop(v, st): return False
    s = v.decode('ascii', 'ignore')
    if re.fullmatch(r'[a-z]+', s) or re.fullmatch(r'[0-9]+', s): return False
    return ent(v) >= 3.0
def collect(fn, st, src):
    out = {}
    if os.path.splitext(fn)[1].lower() in SKIP_EXT: return out
    try:
        data = open(fn, 'rb').read()
    except OSError:
        return out
    if not data or b'\0' in data[:8192]: return out
    vals = []
    try:
        ext = os.path.splitext(fn)[1].lower()
        if ext == '.json': vals = json_vals(data)
        elif ext in ('.yaml', '.yml'): vals = seq_vals(data, ':')
        elif ext == '.toml': vals = seq_vals(data, '=')
        else: vals = env_vals(data)
        if b'-----BEGIN' in data: vals += pem_vals(data)
    except Exception:
        return out
    for v in vals:
        v = clean(v)
        if len(v) >= 8 and keep(v, st): out[sha(v)] = src
    return out
def pth():
    d = os.environ.get('SECRET_GATE_DIR', DEF)
    return (d, os.path.join(d, '.secret-hashes'), os.path.join(d, '.secret-hashes.lock'))
def build():
    d, reg, lock = pth()
    if not os.path.isdir(d): die('secret dir missing: ' + d)
    st = lines('secret-gate.stop'); out = {}
    for n in sorted(os.listdir(d)):
        p = os.path.join(d, n)
        if n.startswith('.') or not os.path.isfile(p): continue
        out.update(collect(p, st, n))
    for p in extra_paths():
        if os.path.isdir(p):
            for root, _, files in os.walk(p):
                for n in files:
                    fp = os.path.join(root, n)
                    if os.path.isfile(fp): out.update(collect(fp, st, os.path.abspath(fp)))
        elif os.path.isfile(p): out.update(collect(p, st, os.path.abspath(p)))
    data = ''.join('%s %s\n' % (h, s) for h, s in sorted(out.items())).encode()
    fd = open(lock, 'a+b')
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        t = reg + '.tmp'
        with open(t, 'wb') as w: w.write(data); w.flush(); os.fsync(w.fileno())
        os.replace(t, reg); os.chmod(reg, 0o600)
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN); fd.close()
    sys.stdout.write('secret-gate: hashes=%d\n' % len(out))
def stale():
    fp = extra_path(); d, reg, lock = pth()
    if not os.path.isfile(fp) or not os.path.isfile(reg): return False
    rm = os.path.getmtime(reg)
    if os.path.getmtime(fp) > rm: return True
    return any(os.path.exists(p) and os.path.getmtime(p) > rm for p in extra_paths())
def reg():
    d, rg, lock = pth()
    if not os.path.isdir(d) or not os.path.isfile(rg): die('registry missing (run build)')
    out = {}; fd = open(lock, 'a+b')
    try:
        fcntl.flock(fd, fcntl.LOCK_SH)
        for l in open(rg, 'rb'):
            h, s = l.split(b' ', 1); out[h.decode()] = s.decode('utf-8', 'replace').strip()
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN); fd.close()
    return out
def ctx():
    if stale(): build()
    return reg(), {l.split()[0] for l in lines('secret-gate.allow')}, lines('secret-gate.stop')
def hit(content, r, a, st):
    for t in TOK.findall(content):
        h = sha(t)
        if h in r and h not in a and not stop(t, st): return r[h]
    return None
def rep(f):
    for lab, p, s in f: sys.stderr.write('secret-gate: BLOCKED %s %s <- %s\n' % (lab, p, s))
    sys.exit(1 if f else 0)
def added(data, lab, r, al, st):
    out = []; path = '?'
    for line in data.splitlines():
        if line.startswith(b'+++ b/'):
            path = line[6:].decode('utf-8', 'replace')
        elif line.startswith(b'+') and not line.startswith(b'+++'):
            if INLINE in line and sha(line[1:].strip()) not in al:
                out.append((lab, path, 'inline-allow'))
            s = hit(line[1:], r, al, st)
            if s: out.append((lab, path, s))
    return out
def staged(r, al, st):
    rep(added(git(['diff', '--cached', '--no-color']), 'staged', r, al, st))
def binaries(a, r, al, st, cwd=None):
    out = []; commit = ''; binary = {}; seen = set()
    raw = git(['log', '--raw', '--no-abbrev', '--format=%x1e%H'] + a, cwd)
    for line in raw.splitlines():
        if line.startswith(MARK):
            commit = line[1:].decode('ascii', 'replace')
            continue
        if not commit or not line.startswith(b':') or b'\t' not in line: continue
        meta, path = line.split(b'\t', 1); fields = meta.split()
        if len(fields) < 5 or fields[3] == b'0' * 40: continue
        if fields[1] == b'160000': continue
        blob = fields[3].decode('ascii', 'replace'); path = path.decode('utf-8', 'replace')
        key = (commit, blob, path)
        if key in seen: continue
        seen.add(key)
        if int(git(['cat-file', '-s', blob], cwd)) > MAX_BLOB: continue
        body = git(['cat-file', 'blob', blob], cwd)
        if commit not in binary:
            binary[commit] = {x.split('\t', 2)[2] for x in git(['diff-tree', '--root', '--no-commit-id', '--numstat', '-r', commit], cwd).decode('utf-8', 'replace').splitlines() if x.startswith('-\t-\t')}
        if b'\0' not in body and path not in binary[commit]: continue
        for candidate in PRINT.findall(body):
            s = hit(candidate, r, al, st)
            if s: out.append((commit[:7], path, s))
    return out
def range_(a, r, al, st, cwd=None):
    out = []
    data = git(['log', '-p', '--cc', '--no-color', '--format=%x1e%H%n%B%x1f'] + a, cwd)
    for item in data.split(MARK)[1:]:
        m = re.match(rb'([0-9a-f]+)\n(.*?)' + END, item, re.S)
        if not m: continue
        lab = m.group(1).decode('ascii')[:7]
        s = hit(m.group(2), r, al, st)
        if s: out.append((lab, 'commit message', s))
        out += added(item[m.end():], lab, r, al, st)
    out += binaries(a, r, al, st, cwd)
    rep(out)
def text(r, al, st):
    found = False
    for i, l in enumerate(sys.stdin.buffer.read().splitlines(), 1):
        s = hit(l, r, al, st)
        if s:
            sys.stderr.write('secret-gate: BLOCKED line %d - <- %s\n' % (i, s)); found = True
    sys.exit(1 if found else 0)
def scan(repo, r, al, st):
    if not os.path.isdir(repo): die('repo missing: ' + repo)
    range_(['--all'], r, al, st, repo)
def main(a):
    if not a: die('usage: build | check [<range...>|--staged|--tag <obj>] | text - | scan <repo>')
    c = a[0]
    if c == 'build': build()
    elif c == 'check':
        r, al, st = ctx()
        if a[1:] and a[1] == '--staged': staged(r, al, st)
        elif a[1:] and a[1] == '--tag':
            if len(a) < 3: die('usage: check --tag <obj>')
            s = hit(git(['cat-file', 'tag', a[2]]), r, al, st)
            rep([('tag', a[2], s)] if s else [])
        else: range_(a[1:], r, al, st)
    elif c == 'text':
        if len(a) < 2 or a[1] != '-': die('usage: text -')
        r, al, st = ctx(); text(r, al, st)
    elif c == 'scan':
        if len(a) < 2: die('usage: scan <repo>')
        r, al, st = ctx(); scan(a[1], r, al, st)
    else: die('unknown command: ' + c)
    return 0
if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except Exception as e:
        die('error %s' % type(e).__name__)
