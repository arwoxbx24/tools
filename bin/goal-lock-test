#!/usr/bin/env bash
set -u

dir=$(cd -- "$(dirname -- "$0")" && pwd)
d=$(mktemp -d /tmp/goal-lock-test.XXXXXX) || exit 1
trap 'rm -rf "$d"' EXIT
ok=0
total=11

nog=$d/nog.jsonl
goal=$d/goal.jsonl
missing=$d/missing.jsonl
neg_assistant=$d/neg-assistant.jsonl
neg_toolresult=$d/neg-toolresult.jsonl
neg_plain_user=$d/neg-plain-user.jsonl
: >"$nog"
# Real harness shape: meta user entry with string content. The junk first line
# checks that non-JSON transcript lines are skipped, never fatal.
printf '%s\n' 'not json {' \
  '{"type":"user","isMeta":true,"message":{"role":"user","content":"A session-scoped Stop hook is now active with condition: \"x\". ..."}}' >"$goal"
# Agent-written copies: assistant tool_use, user tool_result array, plain user string.
printf '%s\n' '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","name":"Bash","input":{"command":"echo Goal set: x"}},{"type":"tool_use","name":"Bash","input":{"command":"echo A session-scoped Stop hook is now active with condition"}}]}}' >"$neg_assistant"
printf '%s\n' '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"A session-scoped Stop hook is now active with condition"}]}}' >"$neg_toolresult"
printf '%s\n' '{"type":"user","message":{"role":"user","content":"A session-scoped Stop hook is now active with condition"}}' >"$neg_plain_user"
cwd=/root/workspaces/projects
reason_goal='goal-lock (owner 25.10): no goal set in this session — form it with /goal_task, the owner sends the /goal line; reading, bd and skills stay allowed.'

case_run() {
  local num=$1 label=$2 want=$3 tp=$4 name=$5 input=$6 agent=${7:-}
  local out rc dec reason
  out=$(jq -cn --arg tp "$tp" --arg cwd "$cwd" --arg name "$name" --argjson input "$input" --arg a "$agent" \
    '{hook_event_name:"PreToolUse",transcript_path:$tp,cwd:$cwd,tool_name:$name,tool_input:$input} + (if $a == "" then {} else {agent_id:$a} end)' \
    | "$dir/lead-hint"); rc=$?
  dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
  reason=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
  case $want in
    deny)
      if [[ $rc == 0 && $dec == deny && $reason == "$reason_goal" ]]; then
        echo "PASS $num: $label"; ok=$((ok+1)); return
      fi
      ;;
    notgoal)
      if [[ $rc == 0 && $reason != "$reason_goal" ]]; then
        echo "PASS $num: $label"; ok=$((ok+1)); return
      fi
      ;;
    allow)
      if [[ $rc == 0 && -z $out ]]; then
        echo "PASS $num: $label"; ok=$((ok+1)); return
      fi
      ;;
  esac
  echo "FAIL $num: rc=$rc out=$out"
}

case_run 1 'no goal + Edit /root/workspaces/projects/x.md -> deny' deny \
  "$nog" Edit '{"file_path":"/root/workspaces/projects/x.md"}'
case_run 2 'no goal + Bash python3 x.py -> deny' deny \
  "$nog" Bash '{"command":"python3 x.py"}'
case_run 3 'no goal + Bash bd ready -> allow' allow \
  "$nog" Bash '{"command":"bd ready"}'
case_run 4 'no goal + Read -> allow' allow \
  "$nog" Read '{"file_path":"/root/workspaces/projects/x.md"}'
case_run 5 'no goal + Bash grep -n a f -> not goal-lock' notgoal \
  "$nog" Bash '{"command":"grep -n a f"}'
case_run 6 'goal set + Edit x.md -> not goal-lock' notgoal \
  "$goal" Edit '{"file_path":"/root/workspaces/projects/x.md"}'
case_run 7 'subagent (agent_id) + no goal + Edit -> allow' allow \
  "$nog" Edit '{"file_path":"/root/workspaces/projects/x.md"}' sub
case_run 8 'missing transcript path -> allow' allow \
  "$missing" Edit '{"file_path":"/root/workspaces/projects/x.md"}'
case_run 9 'assistant tool_use with phrase + no goal -> deny' deny \
  "$neg_assistant" Edit '{"file_path":"/root/workspaces/projects/x.md"}'
case_run 10 'user tool_result array with phrase + no goal -> deny' deny \
  "$neg_toolresult" Edit '{"file_path":"/root/workspaces/projects/x.md"}'
case_run 11 'plain user string (no isMeta) with phrase + no goal -> deny' deny \
  "$neg_plain_user" Edit '{"file_path":"/root/workspaces/projects/x.md"}'

if [[ $ok == $total ]]; then
  echo "goal-lock-test: PASS"
  exit 0
fi
echo "goal-lock-test: FAIL $((total - ok))"
exit 1
