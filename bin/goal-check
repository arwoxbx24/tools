#!/usr/bin/env bash
# goal-check — доказать цель по acceptance-строкам эпика bd (TZ T1).
set -o pipefail

usage() {
  echo "usage: goal-check <epic-id> | goal-check --file <path>"
  echo "goal-check <epic-id> — acceptance_criteria эпика через bd show --json."
  echo "goal-check --file <path> — acceptance-текст из файла (для теста)."
  echo "AC-строка: AC<n>[@<sec>]: <команда> => <ожидание>; ожидание — текст, >=N или <empty>; @<sec> — таймаут 1..3600 (по умолчанию 300)."
  echo "EXCLUDE AC<n>: atom=<bd-id> owner=«<цитата владельца>» — исключение AC, если цитата есть в логе владельца."
  echo "Вердикт: GOAL=MET (rc 0) / GOAL=CLOSED (rc 0, есть EXCLUDED) / GOAL=NOT_MET (rc 0; rc 1 при таймауте AC) / GOAL=REFUSED (rc 2)."
  echo "Бюджет: суммарные таймауты AC ограничены 100 с; AC за бюджетом печатает rc=124 budget, вердикт GOAL=NOT_MET."
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

if [ "${1:-}" = "--file" ]; then
  [ $# -eq 2 ] || { usage >&2; exit 2; }
  acc=$(cat -- "$2") || { echo "goal-check: не прочитать $2" >&2; exit 1; }
  exsrc=$acc
  since=${GOAL_CHECK_SINCE_MS:-0}
elif [ $# -eq 1 ] && [ -n "$1" ] && [ "${1#-}" = "$1" ]; then
  command -v bd >/dev/null || { echo "goal-check: bd не найден" >&2; exit 1; }
  command -v jq >/dev/null || { echo "goal-check: jq не найден" >&2; exit 1; }
  js=$(bd -C /root/workspaces/projects show "$1" --json) || { echo "goal-check: bd show $1 не удался" >&2; exit 1; }
  acc=$(jq -r 'if type=="array" then .[0] else . end | .acceptance_criteria // .acceptance // empty' <<< "$js") || { echo "goal-check: bd show $1 не удался" >&2; exit 1; }
  exsrc=$(jq -r 'if type=="array" then .[0] else . end | .notes // empty' <<< "$js") || { echo "goal-check: bd show $1 не удался" >&2; exit 1; }
  since=$(jq -r 'if type=="array" then .[0] else . end | (.created_at // "") | if . == "" then 0 else fromdateiso8601 * 1000 end' <<< "$js") || { echo "goal-check: bd show $1 не удался" >&2; exit 1; }
else
  usage >&2
  exit 2
fi

owner_quoted() {
  local log=${GOAL_CHECK_OWNER_LOG:-/root/.claude/history.jsonl} m
  m=$(jq -Rr --argjson since "$since" 'fromjson? | select(type == "object") | select((.display | type) == "string") | select((.display | startswith("Here is a note offered by a side agent") | not) and (.display | contains("[ts:") | not) and ((.timestamp | type) == "number") and (.timestamp >= $since)) | .display' "$log" 2>/dev/null) || return 1
  grep -F -q -- "$1" <<< "$m"
}

nums=(); cmds=(); exps=(); parse_refs=(); tmos=(); ex_nums=(); ex_atoms=(); ex_quotes=()
while IFS= read -r line; do
  line=${line#"${line%%[![:space:]]*}"}
  [[ $line == AC* ]] || continue
  if [[ $line =~ ^AC([0-9]+[A-Za-z]?)(@([0-9]+))?:[[:space:]]*(.*)$ ]]; then
    n=${BASH_REMATCH[1]}
    sec=${BASH_REMATCH[3]:-300}
    rest=${BASH_REMATCH[4]}
    if [[ $rest == *" => "* ]] && [[ $sec =~ ^[0-9]{1,4}$ ]] && (( 10#$sec >= 1 && 10#$sec <= 3600 )); then
      cmd=${rest%' => '*}
      exp=${rest##*' => '}
      cmd=${cmd%"${cmd##*[![:space:]]}"}
      cmd=${cmd#"${cmd%%[![:space:]]*}"}
      exp=${exp%"${exp##*[![:space:]]}"}
      exp=${exp#"${exp%%[![:space:]]*}"}
      nums+=("$n"); cmds+=("$cmd"); exps+=("$exp"); tmos+=("$sec")
      continue
    fi
  fi
  ref=${line%%[[:space:]]*}; ref=${ref%:}
  parse_refs+=("$ref")
done <<< "$acc"

while IFS= read -r line; do
  line=${line#"${line%%[![:space:]]*}"}
  [[ $line == EXCLUDE* ]] || continue
  [[ $line =~ ^EXCLUDE[[:space:]]+AC([0-9]+[A-Za-z]?):[[:space:]]*(.*)$ ]] || continue
  en=${BASH_REMATCH[1]}
  erest=${BASH_REMATCH[2]}
  ea=""; eq=""
  if [[ $erest =~ atom=([^[:space:]]*) ]]; then ea=${BASH_REMATCH[1]}; fi
  if [[ $erest =~ owner=«(.*)»[[:space:]]*$ ]]; then eq=${BASH_REMATCH[1]}; fi
  ex_nums+=("$en"); ex_atoms+=("$ea"); ex_quotes+=("$eq")
done <<< "$exsrc"

if [ ${#parse_refs[@]} -gt 0 ]; then
  for ref in "${parse_refs[@]}"; do echo "REFUSED $ref reason=parse"; done
  echo "GOAL=REFUSED"
  exit 2
fi

if [ ${#nums[@]} -eq 0 ]; then
  echo "GOAL=NOT_MET reason=no-ac-lines"
  exit 0
fi

bad=';|&$`<>(){}'"'"'\'
reasons=()
for i in "${!nums[@]}"; do
  cmd=${cmds[i]}
  reason=""
  for ((j=0; j<${#cmd}; j++)); do
    c=${cmd:j:1}
    if [[ $bad == *"$c"* ]]; then reason=unsafe-char; break; fi
  done
  if [ -z "$reason" ]; then
    read -ra argv <<< "$cmd"
    w=${argv[0]:-}
    allowed=0
    case $w in
      grep|ls|test|wc|stat|cat|head|tail|find|jq|git|gh|bd) allowed=1 ;;
      /*)
        if [[ $w =~ ^/root/workspaces/tools/bin/[A-Za-z0-9._-]+-test$ ]]; then
          allowed=1
        else
          reason=tool-not-test
        fi
        ;;
    esac
    if [ -z "$reason" ]; then
      [ "$allowed" -eq 1 ] || reason=bad-command
    fi
  fi
  if [ -z "$reason" ]; then
    for arg in "${argv[@]}"; do
      case $arg in
        --output*|--ext-diff|--textconv|--web) reason=write-arg; break ;;
      esac
    done
  fi
  if [ -z "$reason" ]; then
    case ${argv[0]:-} in
      find)
        for arg in "${argv[@]:1}"; do
          case $arg in
            -exec|-execdir|-ok|-okdir|-delete|-fprint0|-fprint|-fprintf|-fls) reason=find-exec; break ;;
          esac
        done
        ;;
      git)
        g=1
        while :; do
          case ${argv[g]:-} in --git-dir=*) g=$((g+1)) ;; -C) g=$((g+2)) ;; *) break ;; esac
        done
        case ${argv[g]:-} in log|show|diff|rev-parse|ls-files|status) ;; branch) [ "${argv[g+1]:-}" = --list ] || reason=git-subcmd ;; *) reason=git-subcmd ;; esac
        ;;
      gh)
        case "${argv[1]:-} ${argv[2]:-}" in "pr view"|"pr list"|"pr checks"|"repo view") ;; *) reason=gh-subcmd ;; esac
        ;;
      bd)
        case ${argv[1]:-} in show|list|search) ;; comments) [ ${#argv[@]} -eq 3 ] && [ "${argv[2]}" != add ] || reason=bd-subcmd ;; *) reason=bd-subcmd ;; esac
        ;;
    esac
  fi
  reasons+=("$reason")
done

refused=0
for i in "${!nums[@]}"; do
  [ -z "${reasons[i]}" ] && continue
  refused=1
  echo "REFUSED AC${nums[i]} reason=${reasons[i]}"
done
if [ "$refused" -eq 1 ]; then
  echo "GOAL=REFUSED"
  exit 2
fi

allpass=1
nexcl=0
timedout=0
budget_ms=100000
for i in "${!nums[@]}"; do
  n=${nums[i]}; cmd=${cmds[i]}; exp=${exps[i]}
  excl=""
  for k in "${!ex_nums[@]}"; do
    [ "${ex_nums[k]}" = "$n" ] || continue
    ea=${ex_atoms[k]}; eq=${ex_quotes[k]}; xr=""
    if ! [[ $ea =~ ^[a-z]+-[a-z0-9]+(\.[0-9]+)?$ ]]; then xr=no-atom
    elif ! bd -C /root/workspaces/projects show "$ea" --json >/dev/null 2>&1; then xr=atom-not-found
    elif [ "${#eq}" -lt 12 ]; then xr=short-quote
    elif ! owner_quoted "$eq"; then xr=quote-not-found
    fi
    if [ -z "$xr" ]; then excl=$ea; break; fi
    echo "AC$n EXCLUDE_INVALID reason=$xr"
  done
  if [ -n "$excl" ]; then
    echo "AC$n EXCLUDED atom=$excl owner=found"
    nexcl=$((nexcl+1))
    continue
  fi
  if [ "$budget_ms" -le 0 ]; then
    allpass=0; timedout=1
    echo "AC$n FAIL rc=124 budget"
    continue
  fi
  # shortcut: no quoting, args split on spaces; upgrade if an AC needs a spaced pattern
  read -ra argv <<< "$cmd"
  first=${argv[0]}
  [[ ${argv[0]} =~ ^/root/workspaces/tools/bin/[A-Za-z0-9._-]+-test$ ]] && argv=("$(dirname -- "$0")/test-once" /root/workspaces/tools "${argv[@]}")
  tmo=$((10#${tmos[i]}))
  [ $((tmo * 1000)) -gt "$budget_ms" ] && tmo=$(( (budget_ms + 999) / 1000 ))
  t0=$(date +%s%3N)
  out=$(timeout "$tmo" "${argv[@]}" 2>&1); rc=$?
  budget_ms=$(( budget_ms - ($(date +%s%3N) - t0) ))
  [ "$rc" -eq 124 ] && timedout=1
  firstline=${out%%$'\n'*}
  shown=${firstline:0:160}
  [ -n "$shown" ] || shown=empty
  pass=0
  if [ "$rc" -eq 0 ] || { [ "$rc" -eq 1 ] && [ "$first" = grep ]; }; then
    case $exp in
      '<empty>') [ -z "$out" ] && pass=1 ;;
      '>='*)
        v=${exp#>=}
        if [[ $v =~ ^[0-9]+$ ]] && [[ $firstline =~ ^[0-9]+$ ]] && (( 10#$firstline >= 10#$v )); then
          pass=1
        fi
        ;;
      *) if [[ $out == *"$exp"* ]]; then
           pass=1
           shown=$(printf '%s\n' "$out" | grep -F -m1 -- "$exp")
           shown=${shown:0:160}
         elif [[ $exp == "PASS "* ]]; then
           name=${exp#PASS }
           if [ -n "$name" ]; then
             shown=$(printf '%s\n' "$out" | grep -E -m1 -- "^PASS([[:space:]]+[0-9]+:?)?[[:space:]]+$name([[:space:]]|$)")
             if [ -n "$shown" ]; then pass=1; shown=${shown:0:160}; fi
           fi
         fi
         ;;
    esac
  fi
  if [ "$pass" -eq 1 ]; then
    echo "AC$n PASS rc=$rc output=$shown"
  else
    allpass=0
    echo "AC$n FAIL rc=$rc expected=$exp output=$shown"
  fi
done

if [ "$allpass" -eq 1 ]; then
  if [ "$nexcl" -gt 0 ]; then
    echo "GOAL=CLOSED"
    exit 0
  fi
  echo "GOAL=MET"
  exit 0
fi
echo "GOAL=NOT_MET"
[ "$timedout" -eq 1 ] && exit 1
exit 0
