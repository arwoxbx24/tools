#!/bin/bash
# code-archive-drill-test: test suite for code-archive-drill

set -o pipefail
passed=0
failed=0

# Create temp directory
T="/root/workspaces/sandbox/test-code-archive-drill-$$"
trap 'rm -rf "$T"' EXIT INT TERM
mkdir -p "$T"/{github,repos,gitlab,state,work} || exit 1

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DRILL_SCRIPT="$SCRIPT_DIR/code-archive-drill"

# Env file
ENV_FILE="$T/.env"
cat > "$ENV_FILE" <<EOF
export CA_GITHUB_BASE="$T/github"
export CA_GITLAB_BASE="$T/gitlab"
export CA_REPOS_DIR="$T/repos"
export CA_STATE_DIR="$T/state"
export CA_LOG="$T/drill.log"
export CA_DRILL_DIR="$T/drill"
EOF

# Create initial repo with commits
(
  cd "$T/work" || exit 1
  git init >/dev/null 2>&1
  git config user.email "test@test.com"
  git config user.name "Test User"
  echo "test content" > file.txt
  git add file.txt
  git commit -m "initial commit" >/dev/null 2>&1
  git clone --bare . "$T/github/demo.git" >/dev/null 2>&1
) 2>/dev/null

# Clone github to gitlab and repos
git clone --bare "$T/github/demo.git" "$T/gitlab/demo.git" 2>/dev/null || cp -r "$T/github/demo.git" "$T/gitlab/demo.git"
git clone --bare "$T/github/demo.git" "$T/repos/demo.git" 2>/dev/null || cp -r "$T/github/demo.git" "$T/repos/demo.git"

# Create marker
echo "2026-10-02T10:00:00Z" > "$T/state/demo.pushed_at"

# Record initial refs count
demo_refs=$(git --git-dir="$T/repos/demo.git" for-each-ref | wc -l)
[[ "$demo_refs" -lt 1 ]] && demo_refs=1
echo "$demo_refs" > "$T/state/demo.refs"

run_drill() {
  local name="${1:-demo}"
  source "$ENV_FILE"
  CA_DRILL_NAME="$name" bash "$DRILL_SCRIPT" 2>&1
}

# TEST 1: drill:ok
output=$(run_drill demo 2>&1)
rc=$?
if [[ $rc -eq 0 ]] && echo "$output" | grep -q "drill:ok" && [[ ! -d "$T/drill" ]] && [[ -f "$T/state/demo.refs" ]]; then
  ((passed++))
else
  ((failed++))
fi

# TEST 1b: an extra local ref with unchanged GitLab and unchanged prior counts
# is local-ahead, not a shrink (D11 regression): must return drill:ok.
extra_sha=$(git --git-dir="$T/repos/demo.git" rev-parse HEAD)
git --git-dir="$T/repos/demo.git" update-ref refs/heads/extra "$extra_sha"
output=$(run_drill demo 2>&1)
rc=$?
git --git-dir="$T/repos/demo.git" update-ref -d refs/heads/extra
if [[ $rc -eq 0 ]] && echo "$output" | grep -q "drill:ok" && ! echo "$output" | grep -q "refs-shrunk"; then
  ((passed++))
else
  ((failed++))
fi

# TEST 2: drill:mismatch refs-shrunk
ref_to_del=$(git --git-dir="$T/repos/demo.git" for-each-ref --format='%(refname)' | head -1)
if [[ -n "$ref_to_del" ]]; then
  git --git-dir="$T/repos/demo.git" update-ref -d "$ref_to_del" >/dev/null 2>&1
fi
output=$(run_drill demo 2>&1)
rc=$?
if [[ $rc -ne 0 ]] && echo "$output" | grep -q "drill:mismatch refs-shrunk"; then
  ((passed++))
else
  ((failed++))
fi

# Restore ref
main_sha=$(git --git-dir="$T/github/demo.git" rev-parse main 2>/dev/null || git --git-dir="$T/github/demo.git" rev-parse master)
git --git-dir="$T/repos/demo.git" update-ref refs/heads/main "$main_sha" 2>/dev/null || git --git-dir="$T/repos/demo.git" update-ref refs/heads/master "$main_sha" 2>/dev/null || true

# TEST 3: drill:mismatch restore
output=$(run_drill nosuch 2>&1)
rc=$?
if [[ $rc -ne 0 ]] && echo "$output" | grep -q "drill:mismatch restore" && [[ ! -d "$T/drill" ]]; then
  ((passed++))
else
  ((failed++))
fi

# TEST 4: drill:missing
echo "2026-10-02T10:00:00Z" > "$T/state/ghost.pushed_at"
rm -rf "$T/repos/ghost.git" "$T/gitlab/ghost.git"
# Must source ENV_FILE for test 4 as well
source "$ENV_FILE"
output=$(CA_DRILL_NAME=demo bash "$DRILL_SCRIPT" 2>&1)
rc=$?
if echo "$output" | grep -q "drill:missing ghost" && [[ ! -f "$T/state/ghost.pushed_at" ]]; then
  ((passed++))
else
  ((failed++))
fi

# TEST 5: HTTPS GitLab askpass wiring is present and the script parses cleanly.
if bash -n "$DRILL_SCRIPT" && grep -q 'GIT_ASKPASS' "$DRILL_SCRIPT"; then
  ((passed++))
else
  ((failed++))
fi

# TEST 6: an SSH base with a path suffix becomes git@host:path/name.git.
printf '%s\n' '#!/bin/sh' 'echo "$*" >> "$SSH_ARGS"' 'exit 1' > "$T/stub-ssh"
chmod +x "$T/stub-ssh"
rm -f "$T/ssh.args"
source "$ENV_FILE"
output=$(CA_GITHUB_BASE=git@h:o GIT_SSH_COMMAND="$T/stub-ssh" SSH_ARGS="$T/ssh.args" CA_DRILL_NAME=demo bash "$DRILL_SCRIPT" 2>&1)
if grep -qF 'o/demo.git' "$T/ssh.args"; then
  ((passed++))
else
  ((failed++))
fi

# TEST 7: every drill outcome is appended to CA_LOG.
source "$ENV_FILE"
rm -f "$T/drill.log"
output=$(CA_DRILL_NAME=demo bash "$DRILL_SCRIPT" 2>&1)
if grep -q 'drill:' "$T/drill.log"; then
  ((passed++))
else
  ((failed++))
fi

# TEST 8: a state entry with a local copy but no GitLab project clears pushed_at.
git clone --bare "$T/github/demo.git" "$T/repos/ghost.git" 2>/dev/null || cp -r "$T/github/demo.git" "$T/repos/ghost.git"
echo '2026-10-02T10:00:00Z' > "$T/state/ghost.pushed_at"
rm -rf "$T/gitlab/ghost.git"
source "$ENV_FILE"
output=$(CA_DRILL_NAME=ghost bash "$DRILL_SCRIPT" 2>&1)
if [[ ! -f "$T/state/ghost.pushed_at" ]] && echo "$output" | grep -q 'drill:missing ghost gitlab'; then
  ((passed++))
else
  ((failed++))
fi

# TEST 9: GitHub HEAD present only under rewritten/ is still restorable.
head9=$(git --git-dir="$T/github/demo.git" rev-parse HEAD)
git --git-dir="$T/gitlab/demo.git" update-ref -d refs/heads/main 2>/dev/null || git --git-dir="$T/gitlab/demo.git" update-ref -d refs/heads/master
git --git-dir="$T/gitlab/demo.git" update-ref refs/heads/rewritten/test/main "$head9"
source "$ENV_FILE"
output=$(CA_DRILL_NAME=demo bash "$DRILL_SCRIPT" 2>&1)
if [[ $output == *'drill:ok'* ]]; then
  ((passed++))
else
  ((failed++))
fi

echo "PASS $passed FAIL $failed"
exit $(( failed > 0 ? 1 : 0 ))
