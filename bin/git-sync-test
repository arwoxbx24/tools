#!/usr/bin/env bash
set -u
bin=$(cd -- "$(dirname -- "$0")" && pwd)
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
export GA_NO_BD=1
export GA_LOCK_DIR="$d/locks"
export GA_LOG_DIR="$d/logs"
export GA_PROJECTS="$d/projects"
export GA_TOOLS="$d/tools"
export GA_CONTOUR_GITDIR="$d/contour.git"
export GA_CONTOUR_WT="$d/contour-wt"
mkdir -p "$GA_LOCK_DIR" "$GA_LOG_DIR" "$GA_PROJECTS" "$GA_TOOLS"

git init -q "$GA_PROJECTS"; git init -q "$GA_TOOLS"
for r in projects tools; do
	git -C "$d/$r" config user.email t@t; git -C "$d/$r" config user.name t
	git -C "$d/$r" checkout -q -b main; git -C "$d/$r" commit -q --allow-empty -m main
done

ok=0
p(){ echo "PASS $1"; ok=$((ok+1)); }
f(){ echo "FAIL $1"; }

repo(){ # $1 dir — init empty repo, identity, main branch
	local r=$1
	git init -q "$r"
	git -C "$r" config user.email t@t
	git -C "$r" config user.name t
	git -C "$r" checkout -q -b main
}
mkbare(){ # $1 repo $2 bare — origin -> push main, fetch, set HEAD
	git -C "$1" commit -q --allow-empty -m base
	git init -q --bare "$2"
	git -C "$1" remote add origin "$2"
	git -C "$1" push -q -u origin main
	git -C "$1" fetch -q origin
	git --git-dir="$2" symbolic-ref HEAD refs/heads/main
}
twinrepo(){ # <tag> — live tree with GIT_DIR outside it; origin/main adds twin.txt
	local t=$1 wt gd org
	wt="$d/twin-$t-wt"; gd="$d/twin-$t.git"; org="$d/twin-$t-origin.git"
	git init -q --separate-git-dir="$gd" "$wt"
	git -C "$wt" config user.email t@t
	git -C "$wt" config user.name t
	git -C "$wt" checkout -q -b main
	printf 'a\n' > "$wt/f"
	git -C "$wt" add f
	git -C "$wt" commit -q -m base
	git init -q --bare "$org"
	git -C "$wt" remote add origin "$org"
	git -C "$wt" push -q -u origin main
	git -C "$wt" fetch -q origin
	git --git-dir="$org" symbolic-ref HEAD refs/heads/main
	git clone -q "$org" "$d/twin-$t-adv"
	git -C "$d/twin-$t-adv" config user.email t@t
	git -C "$d/twin-$t-adv" config user.name t
	printf 'twin\n' > "$d/twin-$t-adv/twin.txt"
	git -C "$d/twin-$t-adv" add twin.txt
	git -C "$d/twin-$t-adv" commit -q -m add
	git -C "$d/twin-$t-adv" push -q origin main
}

# 1: allowlist
repo "$GA_PROJECTS/stroyremont"; mkbare "$GA_PROJECTS/stroyremont" "$d/origin-sr.git"
out=$(cd "$GA_PROJECTS/stroyremont" && "$bin/git-sync" stroyremont 2>&1)
grep -qF 'skip:allowlist' <<<"$out" && p 1 || f 1

# 2: hh-scoring
repo "$GA_PROJECTS/hh-scoring"; mkbare "$GA_PROJECTS/hh-scoring" "$d/origin-hh.git"
out=$(cd "$GA_PROJECTS/hh-scoring" && "$bin/git-sync" hh-scoring 2>&1)
grep -qF 'skip:hh-scoring' <<<"$out" && p 2 || f 2

# 3: ok — main clean, origin up to date
repo "$GA_PROJECTS/p-ok"; mkbare "$GA_PROJECTS/p-ok" "$d/origin-p-ok.git"
out=$(cd "$GA_PROJECTS/p-ok" && "$bin/git-sync" p-ok 2>&1)
grep -qF 'p-ok ok' <<<"$out" && p 3 || f 3

# 4: ff — origin advanced
repo "$GA_PROJECTS/p-ff"; mkbare "$GA_PROJECTS/p-ff" "$d/origin-p-ff.git"
git clone -q "$d/origin-p-ff.git" "$d/advance-ff"
git -C "$d/advance-ff" config user.email t@t; git -C "$d/advance-ff" config user.name t
git -C "$d/advance-ff" commit -q --allow-empty -m adv
git -C "$d/advance-ff" push -q origin main
out=$(cd "$GA_PROJECTS/p-ff" && "$bin/git-sync" p-ff 2>&1)
h=$(git -C "$GA_PROJECTS/p-ff" rev-parse HEAD); o=$(git -C "$d/origin-p-ff.git" rev-parse main)
{ grep -qF 'p-ff ff' <<<"$out" && [[ $h == "$o" ]]; } && p 4 || f 4

# 5: rescued main-local — local main diverged from origin
repo "$GA_PROJECTS/p-main1"; mkbare "$GA_PROJECTS/p-main1" "$d/origin-p-main1.git"
git -C "$GA_PROJECTS/p-main1" commit -q --allow-empty -m local
git clone -q "$d/origin-p-main1.git" "$d/advance-m1"
git -C "$d/advance-m1" config user.email t@t; git -C "$d/advance-m1" config user.name t
git -C "$d/advance-m1" commit -q --allow-empty -m remote
git -C "$d/advance-m1" push -q origin main
out=$(cd "$GA_PROJECTS/p-main1" && "$bin/git-sync" p-main1 2>&1)
h=$(git -C "$GA_PROJECTS/p-main1" rev-parse HEAD); o=$(git -C "$d/origin-p-main1.git" rev-parse main)
{ grep -qF rescued <<<"$out" && grep -qF main-local <<<"$out" && [[ $h == "$o" ]]; } && p 5 || f 5

# 6: rescued wip+tip — dirty (old) file on non-main branch
repo "$GA_PROJECTS/p-wip"
printf 'a\n' > "$GA_PROJECTS/p-wip/f"
git -C "$GA_PROJECTS/p-wip" add f
git -C "$GA_PROJECTS/p-wip" commit -q -m base
mkbare "$GA_PROJECTS/p-wip" "$d/origin-p-wip.git"
git -C "$GA_PROJECTS/p-wip" branch feature
git -C "$GA_PROJECTS/p-wip" checkout -q feature
printf 'b\n' >> "$GA_PROJECTS/p-wip/f"
touch -d '2 hours ago' "$GA_PROJECTS/p-wip/f"
out=$(cd "$GA_PROJECTS/p-wip" && "$bin/git-sync" p-wip 2>&1)
{ grep -qF rescued <<<"$out" && grep -qF feature-wip <<<"$out" && grep -qF feature-tip <<<"$out"; } && p 6 || f 6

# 7: skip:active — recently touched dirty file on main
repo "$GA_PROJECTS/p-active"
printf 'a\n' > "$GA_PROJECTS/p-active/f"
git -C "$GA_PROJECTS/p-active" add f
git -C "$GA_PROJECTS/p-active" commit -q -m base
mkbare "$GA_PROJECTS/p-active" "$d/origin-p-active.git"
printf 'b\n' >> "$GA_PROJECTS/p-active/f"
out=$(cd "$GA_PROJECTS/p-active" && "$bin/git-sync" p-active 2>&1)
grep -qF 'skip:active' <<<"$out" && p 7 || f 7

# 8: skip:active — recent commit on non-main branch
repo "$GA_PROJECTS/p-recent"; mkbare "$GA_PROJECTS/p-recent" "$d/origin-p-recent.git"
git -C "$GA_PROJECTS/p-recent" branch x
git -C "$GA_PROJECTS/p-recent" checkout -q x
git -C "$GA_PROJECTS/p-recent" commit -q --allow-empty -m recent
out=$(cd "$GA_PROJECTS/p-recent" && "$bin/git-sync" p-recent 2>&1)
grep -qF 'skip:active' <<<"$out" && p 8 || f 8

# 9: skip:unmerged-branch — old unmerged commit on non-main branch
repo "$GA_PROJECTS/p-unmerged"; mkbare "$GA_PROJECTS/p-unmerged" "$d/origin-p-unmerged.git"
git -C "$GA_PROJECTS/p-unmerged" branch feat
git -C "$GA_PROJECTS/p-unmerged" checkout -q feat
printf 'x\n' > "$GA_PROJECTS/p-unmerged/uf"
touch -d '2 hours ago' "$GA_PROJECTS/p-unmerged/uf"
git -C "$GA_PROJECTS/p-unmerged" add uf
old=$(date -d '2 hours ago' +%s)
GIT_COMMITTER_DATE="@$old" GIT_AUTHOR_DATE="@$old" git -C "$GA_PROJECTS/p-unmerged" commit -q -m feat
out=$(cd "$GA_PROJECTS/p-unmerged" && "$bin/git-sync" p-unmerged 2>&1)
grep -qF 'skip:unmerged-branch' <<<"$out" && p 9 || f 9

# 10: skip:locked — lock held by another holder
repo "$GA_PROJECTS/p-lock"; mkbare "$GA_PROJECTS/p-lock" "$d/origin-p-lock.git"
hash=$(printf '%s' p-lock | sha1sum | cut -c1-12)
( flock 9; sleep 12 ) 9>"$GA_LOCK_DIR/git-auto-$hash.lock" &
sleep 0.3
out=$(cd "$GA_PROJECTS/p-lock" && "$bin/git-sync" p-lock 2>&1)
wait
grep -qF 'skip:locked' <<<"$out" && p 10 || f 10

# 11: err:fetch — origin/main ref present, origin url dead
repo "$GA_PROJECTS/p-fetch"
git -C "$GA_PROJECTS/p-fetch" commit -q --allow-empty -m base
git init -q --bare "$d/origin-p-fetch.git"
git -C "$GA_PROJECTS/p-fetch" remote add origin "$d/origin-p-fetch.git"
git -C "$GA_PROJECTS/p-fetch" push -q -u origin main
git -C "$GA_PROJECTS/p-fetch" fetch -q origin
git -C "$GA_PROJECTS/p-fetch" remote set-url origin "$d/no-such-origin.git"
out=$(cd "$GA_PROJECTS/p-fetch" && "$bin/git-sync" p-fetch 2>&1); rc=$?
{ grep -qF 'err:fetch' <<<"$out" && [[ $rc == 1 ]]; } && p 11 || f 11

# 12: unknown name — rc 2, stderr lists valid names from ga_roots, no bd call
mkdir -p "$d/stubbin"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >>"$BD_CALLS"\n' >"$d/stubbin/bd"
chmod +x "$d/stubbin/bd"
export BD_CALLS="$d/bd-calls"; : >"$BD_CALLS"
err=$( (unset GA_NO_BD; PATH="$d/stubbin:$PATH" "$bin/git-sync" no-such-repo 2>&1 >/dev/null) ); rc=$?
names=$(. "$bin/git-auto-lib"; ga_roots | cut -f1)
allnames=1
while IFS= read -r n; do [[ -z $n ]] || grep -qF -- "$n" <<<"$err" || allnames=0; done <<<"$names"
{ [[ $rc == 2 ]] && grep -qF "git-sync: unknown name 'no-such-repo'; valid:" <<<"$err" \
	&& (( allnames )) && [[ ! -s $BD_CALLS ]]; } && p 12 || f 12

usnap(){ # <tag> <cmd...> — snapshot `git ls-files --others` of a repo (sc 19)
	local tag=$1; shift
	"$@" >"$d/u_${tag}" 2>/dev/null
}
ucheck(){ # <tag> <cmd...> — 0 if ls-files --others unchanged
	local tag=$1 a; shift
	a=$(cat "$d/u_${tag}" 2>/dev/null)
	[[ $a == "$("$@" 2>/dev/null)" ]]
}

# 13: rescued — dirty (old) tracked file on main + untracked keep.txt preserved
repo "$GA_PROJECTS/p-dirty13"
printf 'a\n' > "$GA_PROJECTS/p-dirty13/f"
git -C "$GA_PROJECTS/p-dirty13" add f
git -C "$GA_PROJECTS/p-dirty13" commit -q -m base
mkbare "$GA_PROJECTS/p-dirty13" "$d/origin-dirty13.git"
printf 'dirty13\n' >> "$GA_PROJECTS/p-dirty13/f"
touch -d '2 hours ago' "$GA_PROJECTS/p-dirty13/f"
printf 'keep\n' > "$GA_PROJECTS/p-dirty13/keep.txt"
usnap 13 git -C "$GA_PROJECTS/p-dirty13" ls-files --others
out=$(cd "$GA_PROJECTS/p-dirty13" && "$bin/git-sync" p-dirty13 2>&1)
wip=$(git -C "$GA_PROJECTS/p-dirty13" for-each-ref --format='%(refname)' refs/rescue 2>/dev/null | grep 'main-wip' | head -1)
{ grep -qF rescued <<<"$out" \
	&& git -C "$GA_PROJECTS/p-dirty13" diff "$wip^" "$wip" 2>/dev/null | grep -qF '+dirty13' \
	&& [[ -z $(git -C "$GA_PROJECTS/p-dirty13" status --porcelain -uno) ]] \
	&& [[ $(cat "$GA_PROJECTS/p-dirty13/keep.txt") == keep ]]; } && p 13 || f 13

# 14: GIT_AUTO_LOCK_HELD bypasses a held lock, fast and not skip:locked
repo "$GA_PROJECTS/p-lockheld"; mkbare "$GA_PROJECTS/p-lockheld" "$d/origin-lockheld.git"
hash=$(printf '%s' p-lockheld | sha1sum | cut -c1-12)
( flock 9; sleep 12 ) 9>"$GA_LOCK_DIR/git-auto-$hash.lock" &
sleep 0.3
usnap 14 git -C "$GA_PROJECTS/p-lockheld" ls-files --others
start=$(date +%s)
out=$(cd "$GA_PROJECTS/p-lockheld" && GIT_AUTO_LOCK_HELD="$hash" "$bin/git-sync" p-lockheld 2>&1)
end=$(date +%s)
wait
{ grep -qvF 'skip:locked' <<<"$out" && (( end-start < 3 )); } && p 14 || f 14

# 15: rescued — branch on codex/x (old commit), its change already squashed into origin/main
repo "$GA_PROJECTS/p-squash"
printf 'a\n' > "$GA_PROJECTS/p-squash/f"
git -C "$GA_PROJECTS/p-squash" add f
git -C "$GA_PROJECTS/p-squash" commit -q -m base
mkbare "$GA_PROJECTS/p-squash" "$d/origin-squash.git"
git -C "$GA_PROJECTS/p-squash" branch codex/x
git -C "$GA_PROJECTS/p-squash" checkout -q codex/x
printf 'a\nbranch\n' > "$GA_PROJECTS/p-squash/f"
old15=$(date -d '2 hours ago' +%s)
GIT_COMMITTER_DATE="@$old15" GIT_AUTHOR_DATE="@$old15" git -C "$GA_PROJECTS/p-squash" commit -q -am branch
sq0=$(git -C "$GA_PROJECTS/p-squash" rev-parse codex/x)
git clone -q "$d/origin-squash.git" "$d/adv-squash"
git -C "$d/adv-squash" config user.email t@t; git -C "$d/adv-squash" config user.name t
printf 'a\nbranch\n' > "$d/adv-squash/f"
git -C "$d/adv-squash" add f
git -C "$d/adv-squash" commit -q -m squashed
git -C "$d/adv-squash" push -q origin main
usnap 15 git -C "$GA_PROJECTS/p-squash" ls-files --others
out=$(cd "$GA_PROJECTS/p-squash" && "$bin/git-sync" p-squash 2>&1)
sq1=$(git -C "$GA_PROJECTS/p-squash" rev-parse codex/x)
{ grep -qF rescued <<<"$out" \
	&& [[ $(git -C "$GA_PROJECTS/p-squash" symbolic-ref --short -q HEAD) == main ]] \
	&& [[ $sq0 == "$sq1" ]] \
	&& [[ $(git -C "$GA_PROJECTS/p-squash" rev-parse HEAD) == $(git -C "$d/origin-squash.git" rev-parse main) ]]; } && p 15 || f 15

# 16: err:untracked — untracked clash.txt (diff content vs origin/main) blocks switch
repo "$GA_PROJECTS/p-clash16"
git -C "$GA_PROJECTS/p-clash16" commit -q --allow-empty -m base
git -C "$GA_PROJECTS/p-clash16" branch old
git -C "$GA_PROJECTS/p-clash16" checkout -q old
old16=$(date -d '2 hours ago' +%s)
GIT_COMMITTER_DATE="@$old16" GIT_AUTHOR_DATE="@$old16" git -C "$GA_PROJECTS/p-clash16" commit -q --allow-empty -m old
git -C "$GA_PROJECTS/p-clash16" checkout -q main
printf 'clash-main\n' > "$GA_PROJECTS/p-clash16/clash.txt"
git -C "$GA_PROJECTS/p-clash16" add clash.txt
git -C "$GA_PROJECTS/p-clash16" commit -q -m clash
git init -q --bare "$d/origin-clash16.git"
git -C "$GA_PROJECTS/p-clash16" remote add origin "$d/origin-clash16.git"
git -C "$GA_PROJECTS/p-clash16" push -q -u origin main
git -C "$GA_PROJECTS/p-clash16" fetch -q origin
git --git-dir="$d/origin-clash16.git" symbolic-ref HEAD refs/heads/main
git -C "$GA_PROJECTS/p-clash16" checkout -q old
printf 'keepme\n' > "$GA_PROJECTS/p-clash16/clash.txt"
usnap 16 git -C "$GA_PROJECTS/p-clash16" ls-files --others
out=$(cd "$GA_PROJECTS/p-clash16" && "$bin/git-sync" p-clash16 2>&1)
br16=$(git -C "$GA_PROJECTS/p-clash16" symbolic-ref --short -q HEAD)
{ grep -qF 'err:untracked' <<<"$out" \
	&& [[ $br16 == old ]] \
	&& [[ $(cat "$GA_PROJECTS/p-clash16/clash.txt") == keepme ]]; } && p 16 || f 16

# 17: contour form — separate git dir, origin ahead by 1 -> contour ff
git init -q --separate-git-dir="$GA_CONTOUR_GITDIR" "$GA_CONTOUR_WT"
git -C "$GA_CONTOUR_WT" config user.email t@t; git -C "$GA_CONTOUR_WT" config user.name t
git -C "$GA_CONTOUR_WT" checkout -q -b main
git -C "$GA_CONTOUR_WT" commit -q --allow-empty -m base
git init -q --bare "$d/origin-contour.git"
git -C "$GA_CONTOUR_WT" remote add origin "$d/origin-contour.git"
git -C "$GA_CONTOUR_WT" push -q -u origin main
git -C "$GA_CONTOUR_WT" fetch -q origin
git --git-dir="$d/origin-contour.git" symbolic-ref HEAD refs/heads/main
git clone -q "$d/origin-contour.git" "$d/adv-contour"
git -C "$d/adv-contour" config user.email t@t; git -C "$d/adv-contour" config user.name t
git -C "$d/adv-contour" commit -q --allow-empty -m adv
git -C "$d/adv-contour" push -q origin main
usnap 17 git --git-dir="$GA_CONTOUR_GITDIR" --work-tree="$GA_CONTOUR_WT" ls-files --others
out=$(cd "$GA_CONTOUR_WT" && "$bin/git-sync" contour 2>&1)
grep -qF 'contour ff' <<<"$out" && p 17 || f 17

# 18: --all over an isolated fixture of 3 clean repos
all_p="$d/all-projects"; all_t="$d/all-tools"
all_cg="$d/all-contour.git"; all_cw="$d/all-contour-wt"
repo "$all_p"; mkbare "$all_p" "$d/o-all-projects.git"
repo "$all_t"; mkbare "$all_t" "$d/o-all-tools.git"
repo "$all_p/sync-a"; mkbare "$all_p/sync-a" "$d/o-sync-a.git"
repo "$all_p/sync-b"; mkbare "$all_p/sync-b" "$d/o-sync-b.git"
repo "$all_p/sync-c"; mkbare "$all_p/sync-c" "$d/o-sync-c.git"
git init -q --separate-git-dir="$all_cg" "$all_cw"
git -C "$all_cw" config user.email t@t; git -C "$all_cw" config user.name t
git -C "$all_cw" checkout -q -b main
git -C "$all_cw" commit -q --allow-empty -m base
git init -q --bare "$d/o-all-contour.git"
git -C "$all_cw" remote add origin "$d/o-all-contour.git"
git -C "$all_cw" push -q -u origin main
git -C "$all_cw" fetch -q origin
git --git-dir="$d/o-all-contour.git" symbolic-ref HEAD refs/heads/main
usnap 18a git -C "$all_p/sync-a" ls-files --others
usnap 18b git -C "$all_p/sync-b" ls-files --others
usnap 18c git -C "$all_p/sync-c" ls-files --others
start=$(date +%s)
out=$(GA_PROJECTS="$all_p" GA_TOOLS="$all_t" GA_CONTOUR_GITDIR="$all_cg" GA_CONTOUR_WT="$all_cw" "$bin/git-sync" --all 2>&1); rc=$?
end=$(date +%s)
log=$GA_LOG_DIR/git-sync.log
{ [[ $rc == 0 ]] && (( end-start < 240 )) \
	&& grep -qF 'sync-a ok' "$log" && grep -qF 'sync-b ok' "$log" && grep -qF 'sync-c ok' "$log"; } && p 18 || f 18

# 19: untracked files (ls-files --others) of each repo unchanged across 13-18
{ ucheck 13 git -C "$GA_PROJECTS/p-dirty13" ls-files --others \
	&& ucheck 14 git -C "$GA_PROJECTS/p-lockheld" ls-files --others \
	&& ucheck 15 git -C "$GA_PROJECTS/p-squash" ls-files --others \
	&& ucheck 16 git -C "$GA_PROJECTS/p-clash16" ls-files --others \
	&& ucheck 17 git --git-dir="$GA_CONTOUR_GITDIR" --work-tree="$GA_CONTOUR_WT" ls-files --others \
	&& ucheck 18a git -C "$all_p/sync-a" ls-files --others \
	&& ucheck 18b git -C "$all_p/sync-b" ls-files --others \
	&& ucheck 18c git -C "$all_p/sync-c" ls-files --others; } && p 19 || f 19

# 20: rescued main-local — live on delivered feat, local main diverged from origin/main
repo "$GA_PROJECTS/p-20"; mkbare "$GA_PROJECTS/p-20" "$d/origin-20.git"
git -C "$GA_PROJECTS/p-20" branch feat && git -C "$GA_PROJECTS/p-20" checkout -q feat
old20=$(date -d '2 hours ago' +%s)
GIT_COMMITTER_DATE="@$old20" GIT_AUTHOR_DATE="@$old20" git -C "$GA_PROJECTS/p-20" commit -q --allow-empty -m featwork
git -C "$GA_PROJECTS/p-20" update-ref refs/delivered/x feat && git -C "$GA_PROJECTS/p-20" checkout -q main
git -C "$GA_PROJECTS/p-20" commit -q --allow-empty -m localmain
oldm20=$(git -C "$GA_PROJECTS/p-20" rev-parse HEAD); git -C "$GA_PROJECTS/p-20" checkout -q feat
git clone -q "$d/origin-20.git" "$d/adv-20"; git -C "$d/adv-20" config user.email t@t; git -C "$d/adv-20" config user.name t
git -C "$d/adv-20" commit -q --allow-empty -m remote && git -C "$d/adv-20" push -q origin main
out=$(cd "$GA_PROJECTS/p-20" && "$bin/git-sync" p-20 2>&1)
{ grep -qvF 'err:' <<<"$out" \
	&& [[ $(git -C "$GA_PROJECTS/p-20" symbolic-ref --short -q HEAD) == main ]] \
	&& [[ $(git -C "$GA_PROJECTS/p-20" rev-parse HEAD) == "$(git -C "$d/origin-20.git" rev-parse main)" ]] \
	&& [[ $(git -C "$GA_PROJECTS/p-20" for-each-ref --format='%(refname) %(objectname)' refs/rescue | awk '$1 ~ /main-local/ {print $2; exit}') == "$oldm20" ]]; } && p 20 || f 20

# 21: same + new.txt added in origin/main, untracked on disk; a) byte-identical b) differing
for c in a b; do
	repo "$GA_PROJECTS/p-21$c"; mkbare "$GA_PROJECTS/p-21$c" "$d/origin-21$c.git"
	git -C "$GA_PROJECTS/p-21$c" branch feat && git -C "$GA_PROJECTS/p-21$c" checkout -q feat
	old21=$(date -d '2 hours ago' +%s)
	GIT_COMMITTER_DATE="@$old21" GIT_AUTHOR_DATE="@$old21" git -C "$GA_PROJECTS/p-21$c" commit -q --allow-empty -m featwork
	git -C "$GA_PROJECTS/p-21$c" update-ref refs/delivered/x feat && git -C "$GA_PROJECTS/p-21$c" checkout -q main
	git -C "$GA_PROJECTS/p-21$c" commit -q --allow-empty -m localmain && git -C "$GA_PROJECTS/p-21$c" checkout -q feat
	git clone -q "$d/origin-21$c.git" "$d/adv-21$c"; git -C "$d/adv-21$c" config user.email t@t; git -C "$d/adv-21$c" config user.name t
	printf 'hello\n' > "$d/adv-21$c/new.txt"
	git -C "$d/adv-21$c" add new.txt && git -C "$d/adv-21$c" commit -q -m remote && git -C "$d/adv-21$c" push -q origin main
	if [[ $c == a ]]; then
		printf 'hello\n' > "$GA_PROJECTS/p-21a/new.txt"
		out=$(cd "$GA_PROJECTS/p-21a" && "$bin/git-sync" p-21a 2>&1)
		{ grep -qvF 'err:' <<<"$out" \
			&& [[ $(git -C "$GA_PROJECTS/p-21a" symbolic-ref --short -q HEAD) == main ]] \
			&& [[ $(git -C "$GA_PROJECTS/p-21a" rev-parse HEAD) == "$(git -C "$d/origin-21a.git" rev-parse main)" ]] \
			&& [[ $(git -C "$GA_PROJECTS/p-21a" rev-parse HEAD:new.txt) == "$(git -C "$d/origin-21a.git" rev-parse main:new.txt)" ]]; } && p 21a || f 21a
	else
		printf 'conflict\n' > "$GA_PROJECTS/p-21b/new.txt"
		h0=$(git -C "$GA_PROJECTS/p-21b" rev-parse HEAD)
		out=$(cd "$GA_PROJECTS/p-21b" && "$bin/git-sync" p-21b 2>&1)
		{ grep -qF 'err:untracked' <<<"$out" \
			&& [[ $(git -C "$GA_PROJECTS/p-21b" rev-parse HEAD) == "$h0" ]] \
			&& [[ $(cat "$GA_PROJECTS/p-21b/new.txt") == conflict ]]; } && p 21b || f 21b
	fi
done

# 22: live on feat (delivered, ancestor of main); local main lags origin (ancestor);
# new.txt added in origin/main, byte-identical untracked on disk -> one run rescued
repo "$GA_PROJECTS/p-22"; mkbare "$GA_PROJECTS/p-22" "$d/origin-22.git"
git -C "$GA_PROJECTS/p-22" branch feat && git -C "$GA_PROJECTS/p-22" checkout -q feat
old22=$(date -d '2 hours ago' +%s)
GIT_COMMITTER_DATE="@$old22" GIT_AUTHOR_DATE="@$old22" git -C "$GA_PROJECTS/p-22" commit -q --allow-empty -m featwork
git -C "$GA_PROJECTS/p-22" update-ref refs/delivered/x feat && git -C "$GA_PROJECTS/p-22" checkout -q main
git -C "$GA_PROJECTS/p-22" checkout -q feat
git clone -q "$d/origin-22.git" "$d/adv-22"; git -C "$d/adv-22" config user.email t@t; git -C "$d/adv-22" config user.name t
printf 'hello\n' > "$d/adv-22/new.txt"
git -C "$d/adv-22" add new.txt && git -C "$d/adv-22" commit -q -m remote && git -C "$d/adv-22" push -q origin main
printf 'hello\n' > "$GA_PROJECTS/p-22/new.txt"
out=$(cd "$GA_PROJECTS/p-22" && "$bin/git-sync" p-22 2>&1)
{ grep -qF rescued <<<"$out" \
	&& [[ $(git -C "$GA_PROJECTS/p-22" symbolic-ref --short -q HEAD) == main ]] \
	&& [[ $(git -C "$GA_PROJECTS/p-22" rev-parse HEAD) == "$(git -C "$d/origin-22.git" rev-parse main)" ]] \
	&& [[ -z $(git -C "$GA_PROJECTS/p-22" status --porcelain -uno) ]]; } && p 22 || f 22

# 24: skip:no-remote — repo without origin
repo "$GA_PROJECTS/p-noremote"
out=$(cd "$GA_PROJECTS/p-noremote" && "$bin/git-sync" p-noremote 2>&1); rc=$?
{ grep -qF 'skip:no-remote' <<<"$out" && [[ $rc == 0 ]]; } && p 24 || f 24

# 25: skip:no-main — origin has only master
repo "$GA_PROJECTS/p-nomain"
git -C "$GA_PROJECTS/p-nomain" commit -q --allow-empty -m base
git -C "$GA_PROJECTS/p-nomain" branch -M master
git init -q --bare "$d/origin-nomain.git"
git -C "$GA_PROJECTS/p-nomain" remote add origin "$d/origin-nomain.git"
git -C "$GA_PROJECTS/p-nomain" push -q -u origin master
git -C "$GA_PROJECTS/p-nomain" fetch -q origin
git -C "$GA_PROJECTS/p-nomain" update-ref -d refs/remotes/origin/master
out=$(cd "$GA_PROJECTS/p-nomain" && "$bin/git-sync" p-nomain 2>&1); rc=$?
{ grep -qF 'skip:no-main' <<<"$out" && [[ $rc == 0 ]]; } && p 25 || f 25

# 26: usage lists every ga_roots name — --help on stdout rc 0, missing arg rc 2
names=$(. "$bin/git-auto-lib"; ga_roots | cut -f1)
help=$("$bin/git-sync" --help 2>/dev/null); hrc=$?
uerr=$("$bin/git-sync" 2>&1 >/dev/null); urc=$?
allnames=1
while IFS= read -r n; do [[ -z $n ]] || grep -qF -- "$n" <<<"$(printf '%s\n' "$help" "$uerr")" || allnames=0; done <<<"$names"
{ [[ $hrc == 0 ]] && [[ $urc == 2 ]] && grep -qF 'valid:' <<<"$help" && grep -qF 'valid:' <<<"$uerr" \
	&& (( allnames )); } && p 26 || f 26

# 27: twin from another cwd — GIT_DIR outside the live tree, identical untracked twin -> rescued
mkdir -p "$d/twin-empty-p" "$d/twin-empty-t"
twinrepo a
printf 'b\n' >> "$d/twin-a-wt/f"
touch -d '2 hours ago' "$d/twin-a-wt/f"
printf 'twin\n' > "$d/twin-a-wt/twin.txt"
out=$(cd / && GA_PROJECTS="$d/twin-empty-p" GA_TOOLS="$d/twin-empty-t" \
	GA_CONTOUR_GITDIR="$d/twin-a.git" GA_CONTOUR_WT="$d/twin-a-wt" "$bin/git-sync" contour 2>&1)
{ grep -qF rescued <<<"$out" && ! grep -qF 'err:' <<<"$out" \
	&& git --git-dir="$d/twin-a.git" --work-tree="$d/twin-a-wt" ls-files --error-unmatch twin.txt >/dev/null 2>&1 \
	&& [[ $(git --git-dir="$d/twin-a.git" --work-tree="$d/twin-a-wt" rev-parse HEAD) == "$(git -C "$d/twin-a-origin.git" rev-parse main)" ]]; } \
	&& p '27 twin-from-other-cwd' || f '27 twin-from-other-cwd'

# 28: differing untracked twin from another cwd still err:untracked
twinrepo b
printf 'b\n' >> "$d/twin-b-wt/f"
touch -d '2 hours ago' "$d/twin-b-wt/f"
printf 'other\n' > "$d/twin-b-wt/twin.txt"
out=$(cd / && GA_PROJECTS="$d/twin-empty-p" GA_TOOLS="$d/twin-empty-t" \
	GA_CONTOUR_GITDIR="$d/twin-b.git" GA_CONTOUR_WT="$d/twin-b-wt" "$bin/git-sync" contour 2>&1)
{ grep -qF 'err:untracked' <<<"$out" && [[ $(cat "$d/twin-b-wt/twin.txt") == other ]]; } \
	&& p '28 differing-twin-refused' || f '28 differing-twin-refused'

# 29: --min-idle after the name is honored (0 disables the recent-edit gate)
repo "$GA_PROJECTS/p-idle29"
printf 'a\n' > "$GA_PROJECTS/p-idle29/f"
git -C "$GA_PROJECTS/p-idle29" add f
git -C "$GA_PROJECTS/p-idle29" commit -q -m base
mkbare "$GA_PROJECTS/p-idle29" "$d/origin-p-idle29.git"
printf 'b\n' >> "$GA_PROJECTS/p-idle29/f"
out=$(cd "$GA_PROJECTS/p-idle29" && "$bin/git-sync" p-idle29 --min-idle 0 2>&1)
{ grep -qF rescued <<<"$out" && ! grep -qF 'skip:active' <<<"$out"; } \
	&& p '29 min-idle-after-name' || f '29 min-idle-after-name'

[[ $ok == 29 ]]

