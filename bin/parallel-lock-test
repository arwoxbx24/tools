#!/usr/bin/env bash
set -u

dir=$(cd -- "$(dirname -- "$0")" && pwd)
settings=${PARALLEL_LOCK_SETTINGS:-/root/.claude/settings.json}
d=$(mktemp -d "${TMPDIR:-/tmp}/parallel-lock-test.XXXXXX")
trap 'rm -rf "$d"' EXIT
ok=0
total=0

usage() {
  printf '%s\n' \
    "usage: parallel-lock-test" \
    "" \
    "Behaviour test of the parallel-lock Stop hook (dcfg-h9073)." \
    "Extracts the Stop hook command containing 'parallel-lock' from a Claude" \
    "Code settings file (PARALLEL_LOCK_SETTINGS, default" \
    "/root/.claude/settings.json), stubs 'bd' with a fixture ready list and" \
    "runs the hook on case inputs." \
    "" \
    "env:" \
    "  PARALLEL_LOCK_SETTINGS  settings file with the hook (default /root/.claude/settings.json)"
}

case ${1:-} in
  --help|-h) usage; exit 0 ;;
  '') : ;;
  *) usage >&2; exit 2 ;;
esac

if [[ ! -r $settings ]]; then
  echo "FAIL settings: not readable: $settings"
  echo 'parallel-lock-test: FAIL 1'
  exit 1
fi

cmd=$(jq -r '.hooks.Stop[]?.hooks[]? | select(.type == "command") | .command | select(test("parallel-lock"))' "$settings" 2>/dev/null | head -n1)
if [[ -z $cmd ]]; then
  echo "FAIL settings: no Stop hook command containing 'parallel-lock' in $settings"
  echo 'parallel-lock-test: FAIL 1'
  exit 1
fi

cat > "$d/bd" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '[
  {"id":"cfg-1","title":"[CLAUDE-config-abcd] first","issue_type":"task","status":"open"},
  {"id":"cfg-2","title":"[CLAUDE-config-abcd] second","issue_type":"task","status":"open"},
  {"id":"other-1","title":"[CLAUDE-foreign-zzzz] other session","issue_type":"task","status":"open"},
  {"id":"epic-1","title":"[CLAUDE-config-abcd] own epic","issue_type":"epic","status":"open"}
]'
STUB
chmod 755 "$d/bd"

run_hook() { # json -> stdout, sets rc
  out=$(printf '%s' "$1" | PATH="$d:$PATH" bash -c "$cmd" 2>/dev/null)
  rc=$?
}

judge() { # name expected(yes|no) actual_out
  total=$((total + 1))
  local name=$1 want=$2 out=$3 got=no
  [[ $out == *'"decision":"block"'* ]] && got=yes
  if [[ $got == "$want" ]]; then
    echo "ok $name"; ok=$((ok + 1))
  else
    echo "FAIL $name: expected block=$want, got=${out:-<empty>}"
  fi
}

p_base=$(jq -nc --arg cwd '/root/workspaces/projects/incidents' --arg sid 'abcd-0000-0000-0000-000000000000' \
  '{session_id:$sid, cwd:$cwd, stop_hook_active:false, background_tasks:[]}')

run_hook "$p_base"; judge 'incidents, no helpers -> block' yes "$out"

run_hook "$(jq -c '.cwd = "/root/workspaces/tools"' <<<"$p_base")"; judge 'tools, no helpers -> block' yes "$out"

run_hook "$(jq -c '.cwd = "/tmp/x"' <<<"$p_base")"; judge 'outside /root -> no output' no "$out"

run_hook "$(jq -c '.cwd = "/root/workspaces/projects/incidents" | .agent_id = "sub-123"' <<<"$p_base")"; judge 'subagent (agent_id set) -> no output' no "$out"

run_hook "$(jq -c '.cwd = "/root/workspaces/projects/incidents" | .stop_hook_active = true' <<<"$p_base")"; judge 'stop_hook_active -> no output' no "$out"

helpers='[{"command":"/root/workspaces/tools/bin/code-channel run x","description":"helper 1"},{"command":"/root/workspaces/tools/bin/code-channel run y","description":"helper 2"}]'
run_hook "$(jq -c --argjson bg "$helpers" '.cwd = "/root/workspaces/projects/incidents" | .background_tasks = $bg' <<<"$p_base")"; judge 'incidents, 2 helpers -> no output' no "$out"

cg=$(awk '/^0::/{sub(/^0::/,"");print;exit}' /proc/self/cgroup)
mx=''; cu=''
if [[ -n $cg && -r "/sys/fs/cgroup$cg/memory.max" && -r "/sys/fs/cgroup$cg/memory.current" ]]; then
  mx=$(cat "/sys/fs/cgroup$cg/memory.max" 2>/dev/null)
  cu=$(cat "/sys/fs/cgroup$cg/memory.current" 2>/dev/null)
fi
if [[ $mx =~ ^[0-9]+$ && $cu =~ ^[0-9]+$ ]]; then
  capacity=$(( (mx - cu) / 713031680 )); [[ $capacity -lt 0 ]] && capacity=0
  run_hook "$p_base"
  reason=$(printf '%s' "$out" | jq -r '.reason // empty' 2>/dev/null)
  total=$((total + 1))
  if grep -q "capacity $capacity " <<<"$reason" && grep -q 'cgroup' <<<"$reason"; then
    echo 'ok block reason capacity from own cgroup'; ok=$((ok + 1))
  else
    echo "FAIL block reason capacity from own cgroup: reason=${reason:-<empty>}"
  fi
else
  echo 'SKIP cgroup (memory.max/memory.current not readable)'
fi

if [[ $ok == "$total" ]]; then
  echo "parallel-lock-test: PASS"
  exit 0
fi
echo "parallel-lock-test: FAIL $((total - ok))"
exit 1
