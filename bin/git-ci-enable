#!/usr/bin/env bash
set -u
case ${1:-} in -h|--help) echo "usage: git-ci-enable <worktree>  (добавляет минимальный CI workflow)"; exit 0;; esac
fail(){ echo "git-ci-enable: $*" >&2; exit 2; }
[[ $# -eq 1 ]] || fail 'usage: git-ci-enable <worktree>'
wt=$1
[[ -d $wt ]] || fail "не каталог: $wt"
git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "не git worktree: $wt"

dir="$wt/.github/workflows"
for f in "$dir"/*.yml "$dir"/*.yaml; do
  [[ -f $f ]] || continue
  grep -Eq '^\s*pull_request:' "$f" && { echo 'ci:present'; exit 0; }
done

mkdir -p "$dir"
path="$dir/min-ci.yml"
cat > "$path" <<'EOF'
name: min-ci
on:
  pull_request:
permissions:
  contents: read
jobs:
  min-ci:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: conflict markers
        run: |
          if git grep -nE '^(<<<<<<<|>>>>>>>) ' -- . ; then
            echo "::error::tracked files contain conflict markers"
            exit 1
          fi
      - name: gitleaks
        run: docker run --rm -v "$PWD:/repo" ghcr.io/gitleaks/gitleaks:v8.30.1 git /repo --redact --no-banner --log-opts="origin/${{ github.base_ref }}..HEAD"
EOF
echo "ci:added $path"
exit 0
