#!/usr/bin/env bash
set -u
fail(){ echo "git-ci-enable: $*" >&2; exit 2; }
[[ $# -eq 1 ]] || fail 'usage: git-ci-enable <worktree>'
wt=$1
[[ -d $wt ]] || fail "не каталог: $wt"
git -C "$wt" rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "не git worktree: $wt"

dir="$wt/.github/workflows"
for f in "$dir"/*.yml "$dir"/*.yaml; do
  [[ -f $f ]] || continue
  grep -Eq '^\s*pull_request:' "$f" && { echo 'ci:present'; exit 0; }
done

mkdir -p "$dir"
path="$dir/min-ci-caller.yml"
cat > "$path" <<'EOF'
name: min-ci
on:
  pull_request:
permissions:
  contents: read
jobs:
  min-ci:
    uses: arwoxbx24/agent-contour/.github/workflows/min-ci.yml@main
EOF
echo "ci:added $path"
exit 0
