#!/usr/bin/env bash
# ponytail: bash+jq hook glue; upgrade path = shared jq module if siblings grow
set -u

if [[ ${1:-} == --help ]]; then
  echo "usage: bin/lead-hint [--help]"
  echo "PreToolUse/PostToolUse/UserPromptSubmit/Stop hook for the lead Claude Code session only."
  echo "Reads one hook JSON object from stdin. With a non-empty .agent_id prints nothing."
  echo "PreToolUse: at LEAD_HINT_MAX (default 8) or more own investigative calls since the"
  echo "owner message or last helper run denies the tool (strict: LEAD_HINT_STRICT=1)."
  echo "PostToolUse: at LEAD_HINT_MAX-1 (default 7) or more counted calls since the owner"
  echo "message or last helper run prints a hint naming 'code-channel audit'. UserPromptSubmit: prints the"
  echo "helper-share line for .transcript_path (last 2000 lines)."
  echo "Stop: blocks when the last main-session assistant text asks the owner a question."
  echo "Bad input/other events: no output. Always exits 0."
  exit 0
fi

payload=$(cat 2>/dev/null) || exit 0
[[ -n $payload ]] || exit 0
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$payload" || exit 0

agent_id=$(jq -r '.agent_id // empty' <<<"$payload" 2>/dev/null) || exit 0
event=$(jq -r '.hook_event_name // empty' <<<"$payload" 2>/dev/null) || exit 0
# Subagent/Workflow calls get only the PreToolUse code-lock (see below).
[[ -n $agent_id && $event != PreToolUse ]] && exit 0
transcript_path=$(jq -r '.transcript_path // empty' <<<"$payload" 2>/dev/null) || exit 0
[[ -n $transcript_path || $event == PreToolUse ]] || exit 0

# Backwards transcript scan shared by Pre/PostToolUse: stops at the first record
# matching the jq predicate $2 and sums the per-record `calls` def $1. Prints
# the count (empty on failure).
scan_calls() {
  tac -- "$transcript_path" 2>/dev/null | jq -R -n --arg helper_re "$helper_re" '
    def is_owner:
      (.type == "user"
       and ((.message.content | type) == "string")
       and (((.origin.kind) // "human") == "human"))
      or (.type == "attachment" and .attachment.humanTurn == true);
    def is_helper_run:
      .type == "assistant" and (.isSidechain != true)
      and any(.message.content[]?;
              .type == "tool_use" and .name == "Bash"
              and ((.input.command // "") | test($helper_re)));
    def user_text:
      (.message.content // "")
      | if type == "string" then .
        elif type == "array" then (map(select(.type == "text") | .text) | join("\n"))
        else "" end;
    def is_task_notification:
      .type == "user"
      and ((user_text) | test("<task-notification>")
           and test("<status>\\s*(completed|failed|killed)\\s*</status>"));
    def is_doc_read:
      (.name == "Read")
      and ((.input.file_path // "") | test("\\.(md|txt)$"; "i"));
    def first_word:
      [scan("\\S+")]
      | until((.[0] // "") as $h
              | ((["command","builtin","exec","env","nohup"] | index($h)) == null);
              .[1:])
      | ((.[0] // "") | split("/") | last);
    def gh_readonly:
      test("^\\s*gh\\s+(pr\\s+(view|list|checks)|run\\s+(view|list))(\\s|$)");
    def git_readonly:
      test("^\\s*(([A-Za-z_][A-Za-z0-9_]*=[^\\s]*|command|builtin|exec|env|nohup)\\s+)*([^\\s=]*/)?git\\s+(grep|show|log|diff|blame)(\\s|$)");
    def has_shell_op:
      test("[;&|$()<>`\\n]");
    def investigative_bash:
      (.input.command // "") as $cmd
      | ($cmd | first_word) as $word
      | if ($cmd | test($helper_re)) then false
        elif (($cmd | gh_readonly) and (($cmd | has_shell_op) | not)) then false
        elif ((["grep","rg","find","ls","cat","head","tail","sed","wc","gh","awk","jq","sort","uniq","diff","tree","xargs","less","more","stat","du","file","strings"] | index($word)) != null) then true
        elif $word == "git" then ($cmd | git_readonly)
        else
          ($cmd | test("(^|[^A-Za-z0-9])(pytest|jest|vitest|mocha|bats|tests?)([^A-Za-z0-9]|$)"))
        end;
    def calls: '"$1"';
    [ label $out |
      (foreach inputs as $line ({n: 0, stop: false};
         (try ($line | fromjson) catch null) as $v
         | if .stop then .
           elif ($v | type) != "object" then .
           elif ($v | '"$2"') then .stop = true
           else .n += ($v | calls) end;
         if .stop then ., break $out else . end) | .n)
    ] | last // 0
  ' 2>/dev/null
}

# Validated LEAD_HINT_MAX (default 8).
hint_max() {
  local max=${LEAD_HINT_MAX:-8}
  [[ $max =~ ^[0-9]+$ ]] || max=8
  printf '%s\n' "$max"
}

# $1 calls, $2 limit: "ge" denies at the limit, "gt" hints only above it.
limit_reached() {
  case $3 in
    ge) (( $1 >= $2 )) ;;
    gt) (( $1 > $2 )) ;;
    *) return 1 ;;
  esac
}

# Counted-call jq program and stop window shared by PreToolUse and PostToolUse.
calls_count='
      if (.type == "assistant" and (.isSidechain != true)) then
        reduce (.message.content[]? | select(.type == "tool_use")) as $tool (0;
          if $tool.name == "Bash" then
            (if ($tool | investigative_bash) then . + 1 else . end)
          elif ((["Read","Grep","Glob","WebFetch","WebSearch"] | index($tool.name)) != null) then
            (if ($tool | is_doc_read) then . else . + 1 end)
          else . end)
      else 0 end'
count_window='is_owner or is_helper_run or is_task_notification'

# Helper launch: first word after optional env assignments and shell prefixes.
helper_re='^[[:space:]]*(([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*|command|builtin|exec|env|nohup)[[:space:]]+)*(code-channel|sdk-agent|([^[:space:]=]*/)?bin/(code-channel|sdk-agent))([[:space:]]|$)'
# Read-only git subcommands that count as investigation (owner 25.10, F3).
git_read_re='^[[:space:]]*(([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*|command|builtin|exec|env|nohup)[[:space:]]+)*([^[:space:]=]*/)?git[[:space:]]+(grep|show|log|diff|blame)([[:space:]]|$)'

lead_norm_path() {
  local p=$1 part out=''
  local -a parts=() kept=()
  IFS='/' read -ra parts <<<"$p"
  for part in "${parts[@]}"; do
    case $part in
      ''|.) ;;
      ..) (( ${#kept[@]} > 0 )) && unset 'kept[-1]' ;;
      *) kept+=("$part") ;;
    esac
  done
  for part in "${kept[@]}"; do out+="/$part"; done
  [[ -n $out ]] || out=/
  printf '%s' "$out"
}

out_ok() {
  local target=$1 norm
  [[ -n $target ]] || return 1
  [[ $target == /dev/null ]] && return 0
  [[ $target == /* ]] || return 1
  norm=$(lead_norm_path "$target")
  [[ $norm == /tmp || $norm == /tmp/* ]]
}

lead_allowlist() {
  local cmd=$1 bg=$2
  local i len c nxt prev seg quote=''
  local -a segs=()
  seg=''
  prev=''
  len=${#cmd}
  for (( i=0; i<len; i++ )); do
    c=${cmd:i:1}
    nxt=${cmd:i+1:1}
    if [[ $quote == "'" ]]; then
      [[ $c == "'" ]] && quote=''
      seg+=$c
      prev=$c
      continue
    fi
    if [[ $c == \\ ]]; then
      # bash: a backslash outside single quotes escapes the next char.
      seg+=$c
      if [[ -n $nxt ]]; then seg+=$nxt; prev=$nxt; i=$((i+1)); else prev=$c; fi
      continue
    fi
    if [[ $quote == '"' ]]; then
      if [[ $c == '`' ]]; then
        printf '%s' 'lead allowlist (owner 26.10): command substitution and backticks are not allowed outside single quotes; move the work to code-channel'
        return 0
      fi
      if [[ $c == '$' || $c == '<' || $c == '>' ]] && [[ $nxt == '(' ]]; then
        printf '%s' 'lead allowlist (owner 26.10): process substitution is not allowed; move the work to code-channel'
        return 0
      fi
      [[ $c == '"' ]] && quote=''
      seg+=$c
      prev=$c
      continue
    fi
    case $c in
      "'"|'"') quote=$c; seg+=$c ;;
      '`')
        printf '%s' 'lead allowlist (owner 26.10): command substitution and backticks are not allowed outside single quotes; move the work to code-channel'
        return 0 ;;
      '$'|'<'|'>')
        if [[ $nxt == '(' ]]; then
          printf '%s' 'lead allowlist (owner 26.10): process substitution is not allowed; move the work to code-channel'
          return 0
        fi
        seg+=$c ;;
      ';'|$'\n') segs+=("$seg"); seg='' ;;
      '&')
        if [[ $nxt == '&' ]]; then
          segs+=("$seg"); seg=''; i=$((i+1))
        elif [[ $nxt == '>' || $prev == '>' || $prev == '<' ]]; then
          seg+=$c
        else
          segs+=("$seg"); seg=''
        fi ;;
      '|')
        segs+=("$seg"); seg=''
        [[ $nxt == '|' || $nxt == '&' ]] && i=$((i+1)) ;;
      *) seg+=$c ;;
    esac
    prev=$c
  done
  segs+=("$seg")

  local s nt k ch nx cur inw q op target base first idx found tset flag archive cdir norm git_out positionals
  local -a tok typ
  for s in "${segs[@]}"; do
    [[ -n ${s//[[:space:]]/} ]] || continue
    tok=(); typ=()
    cur=''; inw=0; q=''
    len=${#s}
    for (( k=0; k<len; k++ )); do
      ch=${s:k:1}; nx=${s:k+1:1}
      if [[ $q == "'" ]]; then
        if [[ $ch == "'" ]]; then q=''; else cur+=$ch; fi
        continue
      fi
      if [[ $ch == \\ ]]; then
        # bash: a backslash outside single quotes escapes the next char.
        if [[ -n $nx ]]; then cur+=$nx; k=$((k+1)); else cur+=$ch; fi
        inw=1
        continue
      fi
      if [[ $q == '"' ]]; then
        if [[ $ch == '"' ]]; then q=''; else cur+=$ch; fi
        continue
      fi
      case $ch in
        ' '|$'\t')
          if (( inw )); then tok+=("$cur"); typ+=(word); cur=''; inw=0; fi ;;
        "'"|'"') q=$ch; inw=1 ;;
        '>')
          if (( inw )) && [[ $cur =~ ^[0-9]+$ ]]; then
            op="${cur}>"; [[ $nx == '>' ]] && { op="${cur}>>"; k=$((k+1)); }
            tok+=("$op"); typ+=(redir); cur=''; inw=0
          else
            if (( inw )); then tok+=("$cur"); typ+=(word); cur=''; inw=0; fi
            op='>'; [[ $nx == '>' ]] && { op='>>'; k=$((k+1)); }
            tok+=("$op"); typ+=(redir)
          fi ;;
        '<')
          if (( inw )); then tok+=("$cur"); typ+=(word); cur=''; inw=0; fi
          op='<'; [[ $nx == '<' ]] && { op='<<'; k=$((k+1)); }
          tok+=("$op"); typ+=(redir) ;;
        '&')
          if [[ $nx == '>' ]]; then
            if (( inw )); then tok+=("$cur"); typ+=(word); cur=''; inw=0; fi
            op='&>'; k=$((k+1)); [[ ${s:k+1:1} == '>' ]] && { op='&>>'; k=$((k+1)); }
            tok+=("$op"); typ+=(redir)
          else
            cur+=$ch; inw=1
          fi ;;
        *) cur+=$ch; inw=1 ;;
      esac
    done
    if (( inw )); then tok+=("$cur"); typ+=(word); fi
    nt=${#tok[@]}
    (( nt > 0 )) || continue

    for (( k=0; k<nt; k++ )); do
      [[ ${typ[k]} == redir ]] || continue
      op=${tok[k]}; target=${tok[k+1]:-}
      case $op in
        '>'|'>>'|'&>'|'&>>'|[0-9]*'>')
          [[ $target =~ ^\&[0-9]+$ ]] && continue
          out_ok "$target" && continue ;;
      esac
      printf '%s' 'lead allowlist (owner 26.10): the lead redirects only to /dev/null or /tmp (normalised); everything else goes to code-channel'
      return 0
    done

    idx=0; found=''
    while (( idx < nt )); do
      if [[ ${typ[idx]} == redir ]]; then idx=$((idx+2)); continue; fi
      first=${tok[idx]}
      if [[ $first =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then idx=$((idx+1)); continue; fi
      case $first in
        command|builtin|exec|env|nohup) idx=$((idx+1)); continue ;;
        time)
          idx=$((idx+1))
          while (( idx < nt )) && [[ ${tok[idx]} == -* ]]; do idx=$((idx+1)); done
          continue ;;
        timeout)
          idx=$((idx+1))
          while (( idx < nt )); do
            case ${tok[idx]} in
              -s|--signal|-k|--kill-after) idx=$((idx+2)) ;;
              -*) idx=$((idx+1)) ;;
              *) idx=$((idx+1)); break ;;
            esac
          done
          continue ;;
      esac
      found=$first; break
    done
    [[ -n $found ]] || continue
    base=${found##*/}
    if [[ $found == */* && $found != /root/workspaces/tools/bin/* ]]; then
      printf '%s' 'lead allowlist (owner 26.10): the lead runs allowlisted tools bare or as /root/workspaces/tools/bin/<name>; send other paths to code-channel'
      return 0
    fi

    # Write lock, not an ops ban (owner 26.10, T2): interpreters, shells and
    # editors can write anything, so they stay denied whatever else is listed.
    case $base in
      python|python*|node|nodejs|perl|ruby|php|php*|bash|sh|zsh|dash|deno|bun|pwsh|npx|opencode|codex|claude|gemini|kimi|patch|ed|vi|vim|nano|tee|uv|pre-commit|systemd-run)
        printf '%s' 'lead allowlist (owner 26.10): interpreters, shells, editors, patch, tee, code runners and agent CLIs stay denied; move the work to code-channel'
        return 0 ;;
    esac

    if [[ $base == code-channel || $base == sdk-agent ]]; then
      if [[ $bg != true ]]; then
        fgarg=${tok[idx+1]:-}
        if [[ $base == code-channel && ( $fgarg == --help || $fgarg == -h || $fgarg == --plan ) ]] ||
           [[ $base == sdk-agent && $fgarg == --help ]]; then
          continue
        fi
        printf '%s' 'lead allowlist (owner 26.10): the lead starts code-channel/sdk-agent only in background; run it in background (tool_input.run_in_background=true)'
        return 0
      fi
      continue
    fi

    # 2a: every executable in tools/bin is a sanctioned wrapper (bare name or
    # /root/workspaces/tools/bin/<name>).
    if [[ -x /root/workspaces/tools/bin/$base ]]; then
      continue
    fi

    case $base in
      sort)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -o|--output)
              out_ok "${tok[k+1]:-}" || {
                printf '%s' 'lead allowlist (owner 26.10): sort -o writes only into /tmp'
                return 0; }
              k=$((k+1)) ;;
            -o?*)
              out_ok "${tok[k]#-o}" || {
                printf '%s' 'lead allowlist (owner 26.10): sort -o writes only into /tmp'
                return 0; } ;;
            --output=*)
              out_ok "${tok[k]#*=}" || {
                printf '%s' 'lead allowlist (owner 26.10): sort -o writes only into /tmp'
                return 0; } ;;
          esac
        done ;;
      uniq)
        positionals=0
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -f|--skip-fields|-s|--skip-chars|-w|--check-chars) k=$((k+1)) ;;
            --skip-fields=*|--skip-chars=*|--check-chars=*|-f?*|-s?*|-w?*) ;;
            -*) ;;
            *)
              positionals=$((positionals+1))
              if (( positionals == 2 )); then
                out_ok "${tok[k]}" || {
                  printf '%s' 'lead allowlist (owner 26.10): uniq IN OUT writes only into /tmp'
                  return 0; }
              fi ;;
          esac
        done ;;
      bd|goal-check|test-once|git-sync|safe-delete|tmux-send|channel-canary|where|ls|cat|grep|wc|jq|head|tail|cut|sort|uniq|tr|pgrep|date|echo|printf|pwd|cd|stat|test|true) ;;
      find)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -exec*|-execdir*|-delete|-ok*)
              printf '%s' 'lead allowlist (owner 26.10): find with -exec/-delete/-ok is not allowed for the lead'
              return 0 ;;
            -fls|-fprint*)
              out_ok "${tok[k+1]:-}" || {
                printf '%s' 'lead allowlist (owner 26.10): find -fls/-fprint writes only into /tmp'
                return 0; }
              k=$((k+1)) ;;
          esac
        done ;;
      git)
        gidx=$((idx+1))
        while (( gidx < nt )); do
          case ${tok[gidx]} in
            -C|--git-dir|-c) gidx=$((gidx+2)) ;;
            --git-dir=*|--work-tree=*) gidx=$((gidx+1)) ;;
            *) break ;;
          esac
        done
        op=${tok[gidx]:-}
        case $op in
          status|log|diff|show|ls-files|rev-parse|fetch|format-patch|archive) ;;
          worktree)
            case ${tok[gidx+1]:-} in
              list) ;;
              add)
                target=${tok[gidx+2]:-}
                if [[ $target == /* ]]; then
                  norm=$(lead_norm_path "$target")
                  if [[ $norm == /tmp || $norm == /tmp/* || $norm =~ ^/root/workspaces/[^/]+/\.worktrees(/|$) ]]; then :
                  else
                    printf '%s' 'lead allowlist (owner 26.10): git worktree add writes only under /root/workspaces/*/.worktrees or /tmp'
                    return 0
                  fi
                fi ;;
              *) printf '%s' 'lead allowlist (owner 26.10): git worktree allows only list|add'
                 return 0 ;;
            esac ;;
          branch)
            for (( k=gidx+1; k<nt; k++ )); do
              case ${tok[k]} in
                -d|-D|-m|-M|-d*|-D*|-m*|-M*)
                  printf '%s' 'lead allowlist (owner 26.10): git branch -d/-D/-m/-M is not allowed for the lead'
                  return 0 ;;
              esac
            done ;;
          *)
            printf '%s' 'lead allowlist (owner 26.10): git subcommand is not allowlisted (status, log, diff, show, ls-files, rev-parse, fetch, worktree list|add, branch, format-patch|archive to /tmp); send delivery to code-channel'
            return 0 ;;
        esac
        case $op in
          diff|log|show|format-patch|archive)
            git_out=0
            for (( k=gidx+1; k<nt; k++ )); do
              case ${tok[k]} in
                --output=*|--output-directory=*)
                  git_out=1
                  out_ok "${tok[k]#*=}" || {
                    printf '%s' 'lead allowlist (owner 26.10): git output files write only into /tmp'
                    return 0; } ;;
                --output|--output-directory|-o)
                  git_out=1
                  out_ok "${tok[k+1]:-}" || {
                    printf '%s' 'lead allowlist (owner 26.10): git output files write only into /tmp'
                    return 0; }
                  k=$((k+1)) ;;
                -o?*)
                  git_out=1
                  out_ok "${tok[k]#-o}" || {
                    printf '%s' 'lead allowlist (owner 26.10): git output files write only into /tmp'
                    return 0; } ;;
              esac
            done
            if [[ $op == format-patch ]] && (( ! git_out )); then
              printf '%s' 'lead allowlist (owner 26.10): git format-patch needs -o under /tmp'
              return 0
            fi ;;
        esac ;;
      gh)
        if [[ ${tok[idx+1]:-} != pr ]]; then
          printf '%s' 'lead allowlist (owner 26.10): gh allows only pr view|checks|list|diff|create|merge'
          return 0
        fi
        case ${tok[idx+2]:-} in
          view|checks|list|diff|create|merge) ;;
          *) printf '%s' 'lead allowlist (owner 26.10): gh allows only pr view|checks|list|diff|create|merge'
             return 0 ;;
        esac ;;
      # Operations and reads stay allowed (owner 26.10, T2).
      pm2|systemctl|journalctl|uptime|du|df|free|ps|ss|lsof|file|diff|md5sum|sha256sum|basename|dirname|realpath|readlink|transcribe|gitleaks) ;;
      # Ops/read tools used by the lead in the last 7 days with count >= 3
      # (T2 fix 2, step 2c), none of them a DENY class.
      b24|mc|yc|railway|snap|apt|apt-get|apt-mark|apt-cache|dpkg|dpkg-query|crontab|sqlite3|trivy|nc|ffmpeg|ffprobe|cmp|paste|getent|pstree|prlimit|man|whois|repowise|pdfinfo|pdftoppm|pdftotext|seq|hostname|ufw|sysctl|kill|iconv|zgrep|chmod|chrome|which) ;;
      # Filesystem writes (T2 fix 2): allowed only into /dev/null or /tmp.
      mkdir|rm|touch|truncate)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -*) ;;
            *) out_ok "${tok[k]}" || {
                 printf '%s' 'lead allowlist (owner 26.10): filesystem writes go only into /tmp; send repo edits to code-channel'
                 return 0; } ;;
          esac
        done ;;
      mktemp)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -p|--tmpdir) target=${tok[k+1]:-}; k=$((k+1)) ;;
            -p?*) target=${tok[k]#-p} ;;
            --tmpdir=*) target=${tok[k]#*=} ;;
            -*) continue ;;
            *) target=${tok[k]} ;;
          esac
          [[ $target == /* ]] || continue
          out_ok "$target" || {
            printf '%s' 'lead allowlist (owner 26.10): mktemp writes only into /tmp; send repo edits to code-channel'
            return 0; }
        done ;;
      mv)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -t|--target-directory) target=${tok[k+1]:-}; k=$((k+1)) ;;
            --target-directory=*) target=${tok[k]#*=} ;;
            -*) continue ;;
            *) target=${tok[k]} ;;
          esac
          out_ok "$target" || {
            printf '%s' 'lead allowlist (owner 26.10): mv writes/removes only inside /tmp; send repo edits to code-channel'
            return 0; }
        done ;;
      install|ln)
        target=''; tset=0
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -t) target=${tok[k+1]:-}; tset=1; k=$((k+1)) ;;
            -t?*) target=${tok[k]#-t}; tset=1 ;;
            --target-directory) target=${tok[k+1]:-}; tset=1; k=$((k+1)) ;;
            --target-directory=*) target=${tok[k]#*=}; tset=1 ;;
            -*) ;;
            *) (( tset )) || target=${tok[k]} ;;
          esac
        done
        out_ok "$target" || {
          printf '%s' 'lead allowlist (owner 26.10): install/ln write only into /tmp; send repo edits to code-channel'
          return 0; } ;;
      dd)
        target=''; tset=0
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            of=*) target=${tok[k]#of=}; tset=1 ;;
          esac
        done
        if (( tset )); then
          out_ok "$target" || {
            printf '%s' 'lead allowlist (owner 26.10): dd writes only into /tmp; send repo edits to code-channel'
            return 0; }
        fi ;;
      tar)
        target=''; cdir=''; archive=''; tset=0
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -C|--directory) cdir=${tok[k+1]:-}; k=$((k+1)) ;;
            --directory=*) cdir=${tok[k]#*=} ;;
            --extract|--get) tset+=x ;;
            --create) tset+=c ;;
            --append) tset+=r ;;
            --update) tset+=u ;;
            --list) tset+=t ;;
            --*) ;;
            -*)
              target=${tok[k]#-}
              case $target in *t*) tset+=t ;; esac
              case $target in *x*) tset+=x ;; esac
              case $target in *c*) tset+=c ;; esac
              case $target in *r*) tset+=r ;; esac
              case $target in *u*) tset+=u ;; esac ;;
            *) [[ -n $archive ]] || archive=${tok[k]} ;;
          esac
        done
        if [[ $tset == *t* && $tset != *x* && $tset != *c* && $tset != *r* && $tset != *u* ]]; then :
        else
          out_ok "$archive" || {
            printf '%s' 'lead allowlist (owner 26.10): tar writes only archives inside /tmp; send repo edits to code-channel'
            return 0; }
          if [[ $tset == *x* || $tset == *r* || $tset == *u* ]]; then
            out_ok "$cdir" || {
              printf '%s' 'lead allowlist (owner 26.10): tar extraction writes only into /tmp (-C /tmp)'
              return 0; }
          fi
        fi ;;
      ssh) ;;
      docker)
        case ${tok[idx+1]:-} in
          ps|logs|inspect|images) ;;
          compose)
            case ${tok[idx+2]:-} in
              ps|logs) ;;
              *) printf '%s' 'lead allowlist (owner 26.10): docker compose allows only ps|logs'
                 return 0 ;;
            esac ;;
          *) printf '%s' 'lead allowlist (owner 26.10): docker allows only ps|logs|inspect|compose ps|compose logs|images'
             return 0 ;;
        esac ;;
      curl)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -T|--upload-file|-T?*|--upload-file=*|-[A-Za-z]*T*|-O|--remote-name|--remote-name-all|-[A-Za-z]*O*)
              printf '%s' 'lead allowlist (owner 26.10): curl upload (-T) and remote-name (-O) writes are not allowed'
              return 0 ;;
            -o|--output|--output-dir)
              out_ok "${tok[k+1]:-}" || {
                printf '%s' 'lead allowlist (owner 26.10): curl -o writes only into /tmp'
                return 0; }
              k=$((k+1)) ;;
            -o?*)
              out_ok "${tok[k]#-o}" || {
                printf '%s' 'lead allowlist (owner 26.10): curl -o writes only into /tmp'
                return 0; } ;;
            -[A-Za-z]*o*)
              flag=${tok[k]#-}
              target=${flag#*o}
              if [[ -z $target ]]; then target=${tok[k+1]:-}; k=$((k+1)); fi
              out_ok "$target" || {
                printf '%s' 'lead allowlist (owner 26.10): curl -o writes only into /tmp'
                return 0; } ;;
            --output=*|--output-dir=*)
              out_ok "${tok[k]#*=}" || {
                printf '%s' 'lead allowlist (owner 26.10): curl -o writes only into /tmp'
                return 0; } ;;
          esac
        done ;;
      wget)
        target=''
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -O|--output-document) target=${tok[k+1]:-}; k=$((k+1)) ;;
            -O?*) target=${tok[k]#-O} ;;
            --output-document=*) target=${tok[k]#*=} ;;
          esac
        done
        if [[ -z $target ]]; then
          printf '%s' 'lead allowlist (owner 26.10): wget needs -O /tmp/... or -q -O -'
          return 0
        fi
        if [[ $target != - ]] && ! out_ok "$target"; then
          printf '%s' 'lead allowlist (owner 26.10): wget -O writes only into /tmp (or -)'
          return 0
        fi ;;
      xargs)
        target=''
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -I|-n|-P|-L|-s|-d|-a|-E|--max-args|--max-procs|--delimiter|--arg-file|--replace) k=$((k+1)) ;;
            -*) ;;
            *) target=${tok[k]}; break ;;
          esac
        done
        base=${target##*/}
        case $base in
          bd|ls|cat|grep|jq|head|tail|wc|sort|uniq|cut|du|file|stat|diff|md5sum|sha256sum|basename|dirname|realpath|readlink|tr|date|echo|printf|pgrep|ps) ;;
          *)
            if [[ -x /root/workspaces/tools/bin/$base && $base != code-channel && $base != sdk-agent ]]; then :
            else
              printf '%s' 'lead allowlist (owner 26.10): xargs runs only an allowlisted non-interpreter command'
              return 0
            fi ;;
        esac ;;
      tmux)
        case ${tok[idx+1]:-} in
          list-*|display-message|capture-pane) ;;
          *) printf '%s' 'lead allowlist (owner 26.10): tmux allows only list-*, display-message, capture-pane'
             return 0 ;;
        esac ;;
      npm|pnpm)
        case ${tok[idx+1]:-} in
          run|test|ls|ci|install|view|outdated) ;;
          *) printf '%s' 'lead allowlist (owner 26.10): npm/pnpm allows only run,test,ls,ci,install,view,outdated (never exec/x/dlx)'
             return 0 ;;
        esac ;;
      sed)
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -i*|--in-place*)
              printf '%s' 'lead allowlist (owner 26.10): sed -i is not allowed; send file edits to code-channel'
              return 0 ;;
          esac
        done ;;
      cp)
        target=''; tset=0
        for (( k=idx+1; k<nt; k++ )); do
          case ${tok[k]} in
            -t) target=${tok[k+1]:-}; tset=1; k=$((k+1)) ;;
            -t?*) target=${tok[k]#-t}; tset=1 ;;
            --target-directory) target=${tok[k+1]:-}; tset=1; k=$((k+1)) ;;
            --target-directory=*) target=${tok[k]#*=}; tset=1 ;;
            -*) ;;
            *) (( tset )) || target=${tok[k]} ;;
          esac
        done
        if [[ -z $target ]] || ! out_ok "$target"; then
          printf '%s' 'lead allowlist (owner 26.10): cp writes only into /tmp; send code edits to code-channel'
          return 0
        fi ;;
      *)
        printf '%s' 'lead runs only the allowlist; send work to code-channel in background'
        return 0 ;;
    esac
  done
  return 0
}


case $event in
  PreToolUse)
    [[ ${LEAD_HINT_STRICT:-1} == 0 ]] && exit 0
    tool_name=$(jq -r '.tool_name // empty' <<<"$payload" 2>/dev/null) || exit 0
    tool_cmd=$(jq -r '(.tool_input | if type == "object" then .command // empty else empty end)' <<<"$payload" 2>/dev/null) || exit 0

    # Code lock (owner 24.10). Decided by the normalised absolute target path
    # only (session cwd does not matter): code/config writes under
    # /root/workspaces are denied. A non-string path or a relative path with no
    # cwd cannot be resolved and is denied (fail closed). No Bash heuristics.
    if jq -e '
      (.cwd // "") as $cwd
      | (.tool_name as $n
        | (["Edit","Write","MultiEdit","NotebookEdit"] | index($n)) != null)
      and ((try (if (.tool_input | type) == "object" then (.tool_input.file_path // .tool_input.notebook_path // "") else null end) catch null) as $p
        | if ($p | type) != "string" then true
          else
            ((if ($p | startswith("/")) then $p
              elif ($cwd | type) != "string" or $cwd == "" then null
              else ($cwd + "/" + $p) end) as $abs
            | if $abs == null then true
              else ($abs
                | split("/")
                | reduce .[] as $s ([];
                    if $s == "" or $s == "." then .
                    elif $s == ".." then .[:-1]
                    else . + [$s] end)
                | "/" + join("/") + "/") as $norm
                | (($norm | startswith("/root/workspaces/tools/state/")))
                  or (($p | test("\\.(md|txt)$"; "i") | not)
                      and ($norm | startswith("/root/workspaces/")))
              end)
          end)
    ' >/dev/null 2>&1 <<<"$payload"; then
      if [[ -n $agent_id ]] && jq -e 'type == "array" and length > 0' >/dev/null 2>&1 \
        < <(timeout 3 bd -C /root/workspaces/projects list -l channel-down --status open --json 2>/dev/null); then
        exit 0
      fi
      jq -cn --arg reason 'lead-hint code-lock (owner 24.10): the lead session (any cwd under /root) edits only .md/.txt; send code and config to /root/workspaces/tools/bin/code-channel auto <worktree> <TZ>' \
        '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}' \
        2>/dev/null || exit 0
      exit 0
    fi

    [[ -n $agent_id ]] && exit 0

    # Session-scoped run lock (owner 24.10, F3): the lead session (any cwd under
    # /root) does not run script files under /root/workspaces; tools/bin
    # wrappers stay allowed.
    if jq -e '
      def under_ws:
        . == "/root/workspaces" or startswith("/root/workspaces/");
      def under_ws_path($p; $cwd):
        if ($p | startswith("/")) then ($p | under_ws) else ($cwd | under_ws) end;
      def sanctioned:
        startswith("/root/workspaces/tools/bin/");
      .cwd as $cwd
      | (($cwd // "") | (. == "/root" or startswith("/root/")))
        and .tool_name == "Bash"
        and (([ (.tool_input.command // "") | scan("\\S+") ]) as $w
          | (($w | length) >= 1)
            and (($w[0] | sanctioned) | not)
            and (($w | length) < 2 or (($w[1] | sanctioned) | not))
            and (($w[0] | split("/") | last) as $f
              | ((["sh","bash","python3","python","node"] | index($f)) != null
                 and ($w | length) >= 2
                 and (($w[1] | startswith("-")) | not)
                 and under_ws_path($w[1]; $cwd))
                or ((["pytest","make","cargo"] | index($f)) != null
                    and ($cwd | under_ws))
                or ($f == "go" and (($w[1] // "") == "test") and ($cwd | under_ws))
                or (($w[0] | startswith("./")) and ($cwd | under_ws))
                or ((["npm","pnpm","yarn"] | index($f)) != null
                    and ((["test","run"] | index($w[1] // "")) != null)
                    and ($cwd | under_ws))))
    ' >/dev/null 2>&1 <<<"$payload"; then
      jq -cn --arg reason 'lead-run-lock (owner 24.10): the lead does not run scripts; route: /root/workspaces/tools/bin/code-channel auto|audit <worktree> <TZ>' \
        '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}' \
        2>/dev/null || exit 0
      exit 0
    fi

    if [[ -z $agent_id && $tool_name == Bash ]]; then
      hard_bg=$(jq -r '(.tool_input | if type == "object" then .run_in_background else false end) | if . == true then "true" else "false" end' <<<"$payload" 2>/dev/null) || hard_bg=false
      hard_reason=$(lead_allowlist "$tool_cmd" "$hard_bg")
      if [[ -n $hard_reason ]]; then
        jq -cn --arg reason "$hard_reason" \
          '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}' \
          2>/dev/null || exit 0
        exit 0
      fi
    fi

    case $tool_name in
      Read|Grep)
        if jq -e '
          def code_path:
            test("\\.(py|js|ts|tsx|sh|mjs|cjs|go|rb)$"; "i")
            or (test("(^|/)bin/") and ((split("/") | last | test("\\.")) | not));
          [ .tool_input.file_path?, .tool_input.path?, .tool_input.glob? ]
          | map(select(type == "string" and length > 0))
          | any(code_path)
        ' >/dev/null 2>&1 <<<"$payload"; then
          jq -cn --arg reason 'lead-strict: the main agent does not read code (owner 24.10: 2% — specs, TZ, tasks only); route: code-channel audit' \
            '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$reason}}' \
            2>/dev/null || exit 0
          exit 0
        fi
        ;;
    esac

    investigative=0
    case $tool_name in
      Read)
        path=$(jq -r '.tool_input.file_path // empty' <<<"$payload" 2>/dev/null) || exit 0
        [[ ${path,,} =~ \.(md|txt)$ ]] || investigative=1
        ;;
      Grep|Glob|WebFetch|WebSearch) investigative=1 ;;
      Bash)
        # A helper launch is allowed and never counted, even over the limit.
        [[ $tool_cmd =~ $helper_re ]] && exit 0
        read -ra cmd_words <<<"$tool_cmd"
        wi=0
        while (( wi < ${#cmd_words[@]} )); do
          case ${cmd_words[wi]} in
            command|builtin|exec|env|nohup) wi=$((wi + 1)) ;;
            *) break ;;
          esac
        done
        first=${cmd_words[wi]:-}
        first=${first##*/}
        case $first in
          grep|rg|find|ls|cat|head|tail|sed|wc|gh|awk|jq|sort|uniq|diff|tree|xargs|less|more|stat|du|file|strings) investigative=1 ;;
          git) [[ $tool_cmd =~ $git_read_re ]] && investigative=1 ;;
        esac
        [[ $tool_cmd =~ (^|[^A-Za-z0-9])(pytest|jest|vitest|mocha|bats|tests?)([^A-Za-z0-9]|$) ]] && investigative=1
        shell_op_re='[;&|$()<>`]'
        if (( investigative )) && [[ $tool_cmd =~ ^[[:space:]]*gh[[:space:]]+(pr[[:space:]]+(view|list|checks)|run[[:space:]]+(view|list))([[:space:]]|$) ]] \
          && ! [[ $tool_cmd =~ $shell_op_re ]] && [[ $tool_cmd != *$'\n'* ]]; then
          investigative=0
        fi
        ;;
    esac
    (( investigative )) || exit 0
    [[ -f $transcript_path && -r $transcript_path ]] || exit 0

    # Scan backwards and stop at the first boundary (owner message or helper run),
    # so jq breaks early and tac dies by SIGPIPE on an 18 MB transcript.
    count=$(scan_calls "$calls_count" "$count_window") || exit 0
    [[ $count =~ ^[0-9]+$ ]] || exit 0

    max=$(hint_max)
    limit_reached "$count" "$max" ge || exit 0

    jq -cn --arg count "$count" --arg max "$max" \
      '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:("lead-strict: " + $count + " own investigative calls since the owner message or last helper run (limit " + $max + "). Write a TZ file and run /root/workspaces/tools/bin/code-channel audit|auto <project> <tz.md> in the background; after the helper run you may check its result.")}}' \
      2>/dev/null || exit 0
    ;;

  PostToolUse)
    [[ -f $transcript_path && -r $transcript_path ]] || exit 0

    # A lone helper launch in its assistant message is nudged to start the rest
    # of the ready units now; parallel launches (2+) get no nudge. Never denies.
    tool_name=$(jq -r '.tool_name // empty' <<<"$payload" 2>/dev/null) || exit 0
    tool_cmd=$(jq -r '.tool_input.command // empty' <<<"$payload" 2>/dev/null) || exit 0
    if [[ $tool_name == Bash && $tool_cmd =~ $helper_re ]]; then
      helpers=$(tac -- "$transcript_path" 2>/dev/null | jq -R -n --arg re "$helper_re" '
        first(inputs
          | (try fromjson catch null)
          | objects
          | select(.type == "assistant" and (.isSidechain != true)
                   and any(.message.content[]?; .type == "tool_use" and .name == "Bash"))
          | [ .message.content[]? | select(.type == "tool_use" and .name == "Bash")
              | (.input.command // "") | select(test($re)) ] | length
        ) // 0
      ' 2>/dev/null)
      if [[ $helpers == 1 ]]; then
        jq -cn '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:"lead-hint: 1 helper stream running. Start every other ready independent unit now in parallel (PARALLEL HELPERS N=min(8,K)); waiting is forbidden."}}' \
          2>/dev/null || exit 0
        exit 0
      fi
    fi

    # Same counted-call program and window as the PreToolUse deny.
    count=$(scan_calls "$calls_count" "$count_window") || exit 0
    [[ $count =~ ^[0-9]+$ ]] || exit 0

    max=$(hint_max)
    (( count >= max - 1 )) || exit 0
    shown=$count
    (( shown > max )) && shown=$max
    next=$((max + 1))

    jq -cn --arg count "$shown" --arg max "$max" --arg next "$next" \
      '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:("lead-hint: " + $count + " of " + $max + " counted calls used since the owner message or last helper run; call " + $next + " will be denied — start the helper (code-channel audit|auto) now.")}}' \
      2>/dev/null || exit 0
    ;;

  UserPromptSubmit)
    [[ -f $transcript_path && -r $transcript_path ]] || exit 0
    helper=${HELPER_SHARE:-/root/workspaces/tools/bin/helper-share}
    tailf=$(mktemp "${TMPDIR:-/tmp}/lead-hint-tail.XXXXXX" 2>/dev/null) || exit 0
    trap 'rm -f "$tailf"' EXIT
    tail -n 2000 "$transcript_path" >"$tailf" 2>/dev/null || exit 0
    helper_out=$("$helper" --session "$tailf" 2>/dev/null) || exit 0
    line=$(printf '%s\n' "$helper_out" | head -n1)
    [[ -n $line ]] || exit 0

    jq -cn --arg text "$line" \
      '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$text}}' \
      2>/dev/null || exit 0
    ;;

  Stop)
    [[ ${LEAD_HINT_STRICT:-0} == 0 ]] && exit 0
    [[ -f $transcript_path && -r $transcript_path ]] || exit 0

    # Text of the last main-session assistant line (backwards scan, stops at once).
    text=$(tac -- "$transcript_path" 2>/dev/null | jq -R -rn '
      [ label $out |
        (foreach inputs as $line ({text: null, stop: false};
           (try ($line | fromjson) catch null) as $v
           | if .stop then .
             elif ($v | type) != "object" then .
             elif ($v.type == "assistant" and ($v.isSidechain != true)) then
               ([ $v.message.content[]? | select(.type == "text") | .text ] | join("\n")) as $t
               | if ($t | length) > 0 then {text: $t, stop: true} else . end
             else . end;
           if .stop then .text, break $out else empty end) )
      ] | last // empty
    ' 2>/dev/null) || exit 0
    [[ -n $text ]] || exit 0

    # Quoted text is a quote, not a question to the owner: drop fenced blocks,
    # inline code spans and «…»/"…" quoted spans before both checks.
    text=$(jq -rn --arg t "$text" '
      $t
      | gsub("(?s)```.*?```"; "")
      | gsub("`[^`]*`"; "")
      | gsub("«[^»]*»"; "")
      | gsub("\"[^\"]*\""; "")
    ' 2>/dev/null) || exit 0
    [[ -n $text ]] || exit 0

    reason_owner='lead-strict: the owner is not a developer and gave a standing order: no questions, no choices, no delegation to the owner (24.10). Make the decision yourself, record a one-line ADR in bd, do the step (bd/git/gh/safe-delete are your own sanctioned steps, never a reason to stop) and continue to the goal. Only a physical step (login, key) may be handed to the owner.'
    reason_wait='lead-hint: waiting is forbidden (owner 24.10). Launch every other ready independent unit now in one message (PARALLEL HELPERS N=min(8,K)); if nothing independent remains, end with the result, not a wait announcement.'
    match_reason=
    if jq -en --arg t "$text" \
      --arg re 'жду|ожида(ю|ем|ние)|дожд(у|усь|ёмся)|подожд|waiting for|wait for|проверю[^.]*когда|когда придёт уведомление|after the notification' \
      '($t | split("\n") | map(select(test("\\S")))) | last // ""
       | test($re; "i")' \
      >/dev/null 2>&1; then
      match_reason=$reason_wait
    elif jq -en --arg t "$text" \
      '$t | test("ответьте|NEEDS INPUT|выберите|какой вариант|что делаем\\?|как поступ|подтвердите|разрешите|делать ли|продолжать\\?|ваше слово|на ваше усмотрение|решать вам|скажите,? (что|как|какой)|одним словом"; "i")' \
      >/dev/null 2>&1; then
      match_reason=$reason_owner
    elif jq -en --arg t "$text" \
      '($t | split("\n") | map(select(test("\\S")))) as $lines
       | ($lines | length) > 0
       and (($lines[-1] | gsub("^\\s+|\\s+$"; "")) | endswith("?") or endswith("？"))' \
      >/dev/null 2>&1; then
      match_reason=$reason_owner
    fi

    counter_dir=/tmp/lead-hint-stop
    sid=$(jq -r '.session_id // empty' <<<"$payload" 2>/dev/null | tr -cd 'A-Za-z0-9_-')
    [[ -n $sid ]] || sid=unknown
    cfile=$counter_dir/$sid
    mkdir -p "$counter_dir" 2>/dev/null || exit 0

    prev=0
    [[ -f $cfile ]] && prev=$(cat -- "$cfile" 2>/dev/null)
    [[ $prev =~ ^[0-9]+$ ]] || prev=0

    if [[ -z $match_reason ]]; then
      printf '0\n' >"$cfile" 2>/dev/null
      exit 0
    fi

    # Loop ceiling: block at most three times per session, then let the stop through.
    if (( prev >= 3 )); then
      printf '0\n' >"$cfile" 2>/dev/null
      exit 0
    fi
    printf '%d\n' $((prev + 1)) >"$cfile" 2>/dev/null

    jq -cn --arg reason "$match_reason" \
      '{decision:"block",reason:$reason}' 2>/dev/null || exit 0
    ;;
esac

exit 0
