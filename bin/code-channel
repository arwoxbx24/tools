#!/usr/bin/env bash
set +x
set -uo pipefail
case ${1:-} in -h|--help) printf '%s\n' 'usage: code-channel <form> <project> <tz> [--model provider/model]  (runs the selected code or audit provider)' 'конфиг: config/code-channel.json; справка: docs/code-channel.md'; exit 0;; esac
# spec:035: only this invocation's temporary files are cleaned; no stale-file sweep.
fail() { printf 'code-channel: %s\n' "$*" >&2; }
root=$(cd -- "$(dirname -- "$0")/.." && pwd) || exit 3
config=${CODE_CHANNEL_CONFIG:-"$root/config/code-channel.json"}
jq -e '(.ladder | type == "array") and ([.ladder[].id] | length == (unique | length)) and all(.ladder[]; (.id | type == "string") and (.enabled | type == "boolean") and (.model | type == "string") and ((.resume_model? // "") | type == "string") and ((.key? // "") | type == "string") and ((.secret? // "") | type == "string") and ((.base? // "") | type == "string") and ((.effort? // "") | type == "string") and ((.audit_model? // "") | type == "string") and ((.alt_models? // []) | type == "array" and all(.[]; type == "string")))' "$config" >/dev/null 2>&1 || { fail "конфиг $config не читается"; exit 3; }
opencfg_rel=$(jq -er '.opencode_config // ""' "$config") || exit 3
if [[ -n $opencfg_rel ]]; then
    [[ $opencfg_rel == /* ]] && opencfg=$opencfg_rel || opencfg=$root/$opencfg_rel
    [[ -r $opencfg ]] || { fail "нет файла opencode_config: $opencfg"; exit 3; }
    export OPENCODE_CONFIG=$opencfg
fi
if [[ $# == 1 && $1 == --plan ]]; then
    jq -r '.ladder[] | select(.enabled) | ([.id, (.model | if . == "" then "-" else . end), ((.effort // "") | if . == "" then "-" else . end)] + (if ((.audit_model // "") != "") then ["audit=" + .audit_model] else [] end)) | join(" ")' "$config"
    exit 0
fi
[[ -z ${CODE_CHANNEL_ACTIVE:-} ]] || { fail 'рекурсия запрещена (CODE_CHANNEL_ACTIVE)'; exit 30; }
S=${CODE_CHANNEL_STATE:-/root/workspaces/tools/state/code-channel}
mkdir -p "$S" || exit 3
write_block() {
    local until=$1 streak=$2 code=$3 tmp
    tmp=$(mktemp "$S/bitrixgpt.block.XXXXXX") || exit 3
    printf '%s %s %s\n' "$until" "$streak" "$code" > "$tmp"
    mv -f -- "$tmp" "$S/bitrixgpt.block"
}
save_fail() {
    local code=$1 resphdr=$2 respbody=$3
    {
        printf 'code: %s\n' "$code"
        printf 'body (first 2000 bytes):\n'
        head -c 2000 -- "$respbody" | grep -Eavi 'key|token|authorization|cookie'
        printf '\n'
    } > "$S/bitrixgpt-last-fail.txt"
    chmod 600 "$S/bitrixgpt-last-fail.txt"
}
entry_for() { jq -cer --arg id "$1" '.ladder[] | select(.id == $id)' "$config"; }
resume_idle_limit=$(jq -er '.resume_idle_limit // 1' "$config") || exit 3
[[ $resume_idle_limit =~ ^[1-9][0-9]*$ ]] || { fail "неверный resume_idle_limit: $resume_idle_limit"; exit 3; }
[[ $# == 3 || $# == 5 ]] || { fail 'usage: form project tz [--model provider/model]'; exit 3; }
form=$1; project=$2; tz=$3; override=${5:-}
[[ $project == /* ]] || { fail 'project must be absolute path'; exit 3; }
self=$$
exclude=("$self")
p=$self
while [[ $p -ne 1 ]]; do
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    [[ -n $p ]] || break
    exclude+=("$p")
done
queue=("$self")
while [[ ${#queue[@]} -gt 0 ]]; do
    c=${queue[0]}
    queue=("${queue[@]:1}")
    while read -r d; do
        [[ -n $d ]] || continue
        exclude+=("$d")
        queue+=("$d")
    done < <(ps -eo pid=,ppid= 2>/dev/null | awk -v p="$c" '$2 == p {print $1}')
done
while read -r pid; do
    [[ -n $pid ]] || continue
    for e in "${exclude[@]}"; do
        [[ $pid == "$e" ]] && continue 2
    done
    fail "already running: $pid"
    exit 3
done < <(pgrep -f -- "code-channel .* $project( |$)" 2>/dev/null)
[[ -n $form && $project == /* && ( $# == 3 || $4 == --model ) && ( $# == 3 || -n $override ) ]] || exit 3
[[ $form == audit ]] && mode=audit || mode=code
case $form in
    1) form=bitrixgpt;;
    2) form=codex;;
    3) form=openrouter;;
esac
if [[ $form == auto || $form == audit ]]; then
    [[ -z $override ]] || exit 3
else
    enabled=$(entry_for "$form" | jq -r '.enabled') || exit 3
    [[ $enabled == true ]] || { fail "провайдер $form выключен в конфиге"; exit 3; }
fi
[[ -r $tz ]] || { fail 'нет файла ТЗ'; exit 3; }
prompt=$(cat -- "$tz") || exit 3
cd -- "$project" || exit 3
exec 9>"$S/worktree.$(printf '%s\n' "$PWD" | sha1sum | cut -c-16).lock" || exit 3
flock -n 9 || { fail "worktree занят другим запуском: $PWD"; exit 25; }
form_snap() { local s; s=$( { git rev-parse HEAD 2>/dev/null; git status --porcelain --untracked-files=all 2>/dev/null; git diff HEAD 2>/dev/null; git ls-files -z --others --exclude-standard 2>/dev/null | xargs -0 -r cksum 2>/dev/null; } ); [[ -z $s ]] && return 0; printf '%s\n' "$s" | cksum; }
cc_status() { git status --porcelain --untracked-files=all 2>/dev/null | cut -c4- | sed 's/.* -> //' | sort; }
cc_scope_check() {
    local allowed new p bads=()
    [[ $mode == code && $rc == 0 && $run == 0 ]] || return 0
    [[ ${cc_pre+x} == x ]] || return 0
    allowed=$(grep -m1 '^Files:' <<<"$prompt" | tr '\140' '\n' | sed -n '2~2p')
    [[ -n $allowed ]] || return 0
    new=$(cc_status)
    [[ -n $new ]] || return 0
    new=$(comm -13 <(printf '%s' "$cc_pre") <(printf '%s\n' "$new"))
    while IFS= read -r p; do
        [[ -n $p ]] || continue
        grep -Fqxq -- "$p" <<<"$allowed" || bads+=("$p")
    done <<<"$new"
    [[ ${#bads[@]} -eq 0 ]] || { printf 'out-of-scope: %s\n' "${bads[*]}" >&2; return 26; }
    return 0
}
run_form() (
    export CODE_CHANNEL_ACTIVE=1
    id=$1; start=$SECONDS; pre=-; run=-; hdr=; tmpjson=; resphdr=; respbody=; codetmp=
    IFS=$'\034' read -r model resume_model audit_model name secret base effort < <(entry_for "$id" | jq -r '[.model,.resume_model // "",.audit_model // "",.key // "",.secret // "",.base // "",.effort // ""] | join("\u001c")') || exit 3
    if [[ -n $override && $override != "$model" && $override != "$resume_model" && $override != "$audit_model" ]]; then
        entry_for "$id" | jq -e --arg m "$override" '((.alt_models? // []) | index($m)) != null' >/dev/null 2>&1 || {
            fail "модель не в конфиге: $override"
            exit 3
        }
    fi
    model=${override:-$model}
    if [[ $mode == audit && -z $override && -n $audit_model ]]; then model=$audit_model; fi
    id_run="cc-$(date +%s)-$$"
    write_journal() {
        local pa=$1 ma=$2 r=$3 session=$4
        local j=${CODE_CHANNEL_RUNS_LOG:-$S/runs.jsonl}
        mkdir -p -- "$(dirname -- "$j")"
        jq -nc --arg ts "$(date +%s)" --arg id "$id_run" --arg mode "$mode" --arg form "$id" \
            --arg pe "$provider" --arg pa "$pa" --arg ma "$ma" --argjson rc "$r" --arg session "$session" \
            '{ts:$ts,id:$id,mode:$mode,form:$form,provider_expected:$pe,provider_actual:$pa,model_actual:$ma,rc:$rc,session:$session}' \
            >>"$j"
    }
    reconcile() {
        local r=$1 pa= ma=
        if [[ $id == codex ]]; then
            local cur
            cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
            if [[ $cur != "$orig_branch" ]]; then
                git switch "$orig_branch" 2>/dev/null || true
                printf 'code-channel: форма codex сменила ветку, возвращено\n' >&2
            fi
            write_journal codex "" "$r" ""
            return 0
        fi
        local db=${CODE_CHANNEL_OPENCODE_DB:-/root/.local/share/opencode/opencode.db}
        local row session
        row=$(sqlite3 -readonly "$db" "select json_extract(model,'$.providerID')||'|'||json_extract(model,'$.id') from session where title='$id_run' order by time_created desc limit 1" 2>/dev/null)
        if [[ -z $row ]]; then
            row=$(sqlite3 -readonly "$db" "select json_extract(model,'$.providerID')||'|'||json_extract(model,'$.id') from session where directory='$project' and time_created >= $run_start_ms order by time_created desc limit 1" 2>/dev/null)
        fi
        pa=${row%%|*}
        ma=${row#*|}
        session=$(sqlite3 -readonly "$db" "select id from session where title='$id_run' order by time_created desc limit 1" 2>/dev/null)
        write_journal "$pa" "$ma" "$r" "$session"
        if [[ -z $pa || $pa != "$provider" ]]; then
            printf 'code-channel: сверка провайдера не прошла\n' >&2
            return 23
        fi
        return 0
    }
    finish() {
        rc=$?
        [[ -z $hdr ]] || unlink -- "$hdr"
        [[ -z $tmpjson ]] || unlink -- "$tmpjson"
        [[ -z $resphdr ]] || unlink -- "$resphdr"
        [[ -z $respbody ]] || unlink -- "$respbody"
        [[ -z $codetmp ]] || unlink -- "$codetmp"
        printf 'code-channel: mode=%s form=%s provider=%s model=%s precheck=%s run=%s t=%s\n' "$mode" "$id" "$provider" "$model" "$pre" "$run" "$((SECONDS-start))" >&2
        trap - EXIT; exit "$rc"
    }
    trap finish EXIT
    tool=opencode; [[ $id != codex ]] || tool=codex
    command -v "$tool" >/dev/null || { fail "нет инструмента $tool"; exit 3; }
    prompt=$(printf 'Ты уже исполнитель внутри code-channel: правь файлы сам; code-channel, opencode run, codex exec не вызывай\n\n%s' "$prompt")
    prompt=$(printf 'Не создавай и не переключай ветки; не делай git add и git commit — коммит делает оркестратор\n\n%s' "$prompt")
    prompt=$(printf 'Разведка кода — только через индекс: repowise (repowise context|symbol|risk <путь> --path <корень репо>) и codebase-memory; файл кода читай только перед его правкой\n\n%s' "$prompt")
    prompt=$(printf 'Не вызывай bd: трекер ведёт оркестратор\n\n%s' "$prompt")
    prompt=$(printf 'Scratch and temporary files go to /tmp only, never inside the worktree\n\n%s' "$prompt")
    prompt=$(printf 'Parallelize: when the task has 2 or more independent file sets, dispatch them at once to general subagents via the Task tool in one message, one file set per subagent, never the same file to two subagents; then check the combined result yourself\n\n%s' "$prompt")
    if [[ $id == codex ]]; then
        provider=codex
        [[ -z $override || $model == ?*/?* ]] || exit 15
        orig_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        codex_args=(-c "model_reasoning_effort=\"$effort\"")
        [[ -z $model ]] || codex_args+=(-m "$model")
        started=$SECONDS
        if [[ $mode == audit ]]; then
            timeout 1800 codex exec -p quota-terra "${codex_args[@]}" -s read-only "$prompt"; run=$?
        else
            gcd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
            add_dir=()
            [[ -n $gcd ]] && add_dir+=(--add-dir "$gcd")
            codetmp=$(mktemp "${TMPDIR:-/tmp}/code-channel-codex-XXXXXX") || exit 3
            codex_before=$(form_snap)
            timeout 1800 codex exec -p quota-terra "${codex_args[@]}" -s workspace-write "${add_dir[@]}" \
                -c sandbox_workspace_write.network_access=true "$prompt" 2> >(tee -- "$codetmp" >&2); run=$?
            if [[ $run != 0 ]] && grep -q -- 'Read-only file system' "$codetmp"; then
                if [[ $(form_snap) != "$codex_before" ]]; then
                    printf 'code-channel: форма codex: git только для чтения, правки есть\n' >&2
                    run=0
                else
                    printf 'code-channel: form=codex среда: read-only\n' >&2
                    exit 24
                fi
            fi
        fi
        [[ $run == 0 || $run == 124 || $((SECONDS-started)) -gt 30 ]] || exit 21
        reconcile "$run"; exit $?
    fi
    [[ $model == ?*/?* ]] || exit 15
    provider=${model%%/*}
    mid=${model#*/}
    if [[ -n $name ]]; then
        command -v curl >/dev/null || { fail 'нет инструмента curl'; exit 3; }
        secrets_root=${CODE_CHANNEL_SECRETS_ROOT:-/root/workspaces/secrets}
        f=${CODE_CHANNEL_SECRET_OVERRIDE:-}
        if [[ -z $f ]]; then
            for cand in "$secrets_root/projects/$secret.env" "$secrets_root/services/$secret.env"; do
                [[ -r $cand ]] && { f=$cand; break; }
            done
        fi
        [[ -r $f ]] || { fail "нет секрета $name"; exit 5; }
        val=$(sed -n "s/^\\(export \\)\\{0,1\\}${name}=//p" "$f" | head -1 | tr -d "\\\"'")
        [[ -n $val && $val != *$'\r'* && $val != *$'\n'* ]] || { fail "нет секрета $name"; exit 5; }
        export "$name=$val"
        umask 077
        hdr=$(mktemp "${TMPDIR:-/tmp}/code-channel-hdr-XXXXXX") || exit 3
        tmpjson=$(mktemp "${TMPDIR:-/tmp}/code-channel-json-XXXXXX") || exit 3
        printf 'Authorization: Bearer %s\n' "$val" > "$hdr" || exit 3
        unset val
        [[ $id == openrouter ]] && endpoint="${CODE_CHANNEL_BASEURL_OVERRIDE:-$base}/key" || endpoint="${CODE_CHANNEL_BASEURL_OVERRIDE:-$base}/models"
        pre=$(curl -sS -m 5 -o "$tmpjson" -w '%{http_code}' -H @"$hdr" "$endpoint")
        rc=$?
        [[ $rc == 0 ]] || exit 14
        case $pre in 200) ;; 401|403) exit 11;; 429) exit 12;; 402) exit 13;; 5??) exit 14;; 4??) exit 11;; *) exit 14;; esac
        [[ $id != openrouter ]] || jq -e '.data.limit_remaining == null or ((.data.limit_remaining | type) == "number" and .data.limit_remaining > 0)' "$tmpjson" >/dev/null 2>&1 || exit 13
        if [[ $id == openrouter ]]; then
            usage=$(jq -r '.data.usage_daily // empty' "$tmpjson" 2>/dev/null)
            if [[ -z $usage || ! $usage =~ ^[0-9]+([.][0-9]+)?$ ]]; then
                printf 'code-channel: нет usage_daily, форма openrouter пропущена\n' >&2
                exit 13
            fi
            stop=${OR_DAILY_STOP:-4}
            [[ $stop =~ ^[0-9]+([.][0-9]+)?$ ]] || { stop=4; printf 'code-channel: OR_DAILY_STOP не число, по умолчанию 4\n' >&2; }
            if awk "BEGIN{exit !($usage >= $stop)}"; then
                printf 'code-channel: usage_daily=%s >= stop=%s, форма openrouter пропущена\n' "$usage" "$stop" >&2
                exit 13
            fi
        fi
        config_opencode=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.jsonc
        ids=$(jq -Rs --arg id "$id" 'gsub("(?m)^\\s*//[^\\n]*"; "") | gsub(",\\s*(?<end>[}\\]])"; .end) | fromjson | if $id == "bitrixgpt" then .provider.bitrixgpt.models | keys else .provider.openrouter.whitelist end' "$config_opencode" 2>/dev/null) || exit 15
        jq -e --arg id "$mid" 'index($id) != null' <<<"$ids" >/dev/null 2>&1 || exit 15
    fi
    if [[ $id == bitrixgpt ]]; then
        resphdr=$(mktemp "${TMPDIR:-/tmp}/code-channel-resphdr-XXXXXX") || exit 3
        respbody=$(mktemp "${TMPDIR:-/tmp}/code-channel-respbody-XXXXXX") || exit 3
        payload=$(printf '{"model":"%s","messages":[{"role":"user","content":"ok"}],"max_tokens":1}' "$mid")
        ccode=$(curl -sS -m 20 -D "$resphdr" -o "$respbody" -w '%{http_code}' \
            -H @"$hdr" -H 'Content-Type: application/json' -d "$payload" \
            "${CODE_CHANNEL_BASEURL_OVERRIDE:-$base}/chat/completions")
        rc=$?
        [[ $rc == 0 ]] || exit 14
        case $ccode in
            200)
                [[ -f $S/bitrixgpt.block ]] && rm -f -- "$S/bitrixgpt.block"
                ;;
            429)
                retry=$(awk 'tolower($1)=="retry-after:"{print $2}' "$resphdr" | tr -d '\r')
                [[ $retry =~ ^[0-9]+$ ]] || retry=60
                write_block "$(( $(date +%s) + retry ))" 0 429
                save_fail "$ccode" "$resphdr" "$respbody"
                exit 12
                ;;
            402)
                prev=0
                [[ -f $S/bitrixgpt.block ]] && read -r _ prev _ < "$S/bitrixgpt.block" 2>/dev/null
                [[ $prev =~ ^[0-9]+$ ]] || prev=0
                streak=$((prev + 1))
                until=$(( $(date +%s) + 900 * (2 ** (streak - 1)) ))
                now=$(date +%s)
                [[ $until -gt $(( now + 21600 )) ]] && until=$(( now + 21600 ))
                write_block "$until" "$streak" 402
                save_fail "$ccode" "$resphdr" "$respbody"
                exit 13
                ;;
            *)
                case $ccode in 401|403) exit 11;; 5??) exit 14;; 4??) exit 11;; *) exit 14;; esac
                ;;
        esac
    fi
    run_start_ms=$(date +%s%3N)
    db=${CODE_CHANNEL_OPENCODE_DB:-/root/.local/share/opencode/opencode.db}
    oc_args=() oc_prompt=
    if [[ $mode == audit ]]; then
        timeout 1800 opencode run --agent audit --title "$id_run" -m "$model" "$prompt" < /dev/null; run=$?
    else
        oc_args=(--title "$id_run") oc_prompt=$prompt
        idle=0
        seg_before=$(form_snap)
        cc_pre=$(cc_status)
        id_sid_sql="select id from session where title='$id_run' order by time_created desc limit 1"
        while :; do
            timeout 1800 opencode run "${oc_args[@]}" -m "$model" "$oc_prompt" < /dev/null; run=$?
            [[ $run == 0 ]] && break
            sid=$(sqlite3 -readonly "$db" "$id_sid_sql" 2>/dev/null)
            [[ -n $sid ]] || break
            seg_after=$(form_snap)
            if [[ $seg_after == "$seg_before" ]]; then
                idle=$((idle + 1))
                if (( idle >= resume_idle_limit )); then break; fi
            else
                idle=0
            fi
            printf 'code-channel: сбой rc=%s, продолжаю сессию %s (простоев подряд %s/%s)\n' "$run" "$sid" "$idle" "$resume_idle_limit" >&2
            seg_before=$seg_after oc_args=(--session "$sid") oc_prompt='Продолжи задачу из этой сессии с места остановки и доведи её до конца.'
        done
    fi
    reconcile "$run"; rc=$?
    [[ $rc != 0 ]] && exit "$rc"
    cc_scope_check || exit $?
    exit "$run"
)
if [[ $form != auto && $form != audit ]]; then
    run_form "$form"
    exit $?
fi
mapfile -t ladder < <(jq -r '.ladder[] | select(.enabled) | .id' "$config")
[[ ${#ladder[@]} -gt 0 ]] || exit 3
for i in "${!ladder[@]}"; do
    id=${ladder[$i]}
    if [[ $id == bitrixgpt && -f $S/bitrixgpt.block ]]; then
        read -r blk_until _ blk_code < "$S/bitrixgpt.block"
        if [[ $blk_until =~ ^[0-9]+$ ]] && (( blk_until > $(date +%s) )); then
            printf 'code-channel: form=bitrixgpt пропуск: лимит bitrixgpt до %s (%s)\n' \
                "$(date -d "@$blk_until" +%H:%M)" "$blk_code" >&2
            continue
        fi
    fi
    before=$(form_snap)
    run_form "$id"; rc=$?
    case $rc in 3|5|15|22|24|124) exit "$rc";; esac
    if [[ $rc == 0 ]]; then
        after=$(form_snap)
        if [[ $mode == audit ]]; then
            if [[ $after != "$before" ]]; then
                printf 'code-channel: mode=audit form=%s изменено рабочее дерево — отчёт не принят\n' "$id" >&2
                exit 22
            fi
            exit 0
        elif [[ -n $before || -n $after ]] && [[ $after == "$before" ]]; then
            printf 'code-channel: form=%s rc=0 без изменений\n' "$id" >&2
            (( i + 1 == ${#ladder[@]} )) && exit 16
            rc=1
        else
            exit 0
        fi
    fi
    (( i + 1 == ${#ladder[@]} )) && exit "$rc"
    printf 'code-channel: switch %s→%s rc=%s\n' "$id" "${ladder[$((i + 1))]}" "$rc" >&2
done
