#!/usr/bin/env bash
set +x
set -uo pipefail
usage() { printf '%s\n' 'usage: code-channel <go|sdk|auto|audit> <project> <tz> [--model provider/model]  (runs the selected code or audit worker)' '       code-channel use <sdk|go> "<owner quote>"  (switch the active channel instantly; writes state and appends to use.log)' '       code-channel delivery <worktree> <TZ>  (helper may test, git add FILE: lines, commit, push claude/*|codex/*, open and merge a PR)' 'exit 27: loop-guard — одна строка вывода повторилась LOOP_REPEAT_LIMIT раз, запуск остановлен' 'exit 28: switch-lock — активный канал не включён в лестнице' 'exit 29: TZ Test: line STALLED in test-once; exit 31: TZ Test: line failed after the helper' 'exit 32: обе формы упали по доказательствам — permit в state/code-channel/permit.json (env CODE_CHANNEL_PERMIT)' 'env CODE_CHANNEL_LOOP_LIMIT: LOOP_REPEAT_LIMIT, порог повторов строки (по умолчанию 30)' 'env CODE_CHANNEL_PERMIT: путь к permit.json (по умолчанию state/code-channel/permit.json)' 'конфиг: config/code-channel.json; справка: docs/code-channel.md'; }
case ${1:-} in -h|--help) usage; exit 0;; delivery) [[ ${2:-} == -h || ${2:-} == --help ]] && { usage; exit 0; };; esac
# spec:035: only this invocation's temporary files are cleaned; no stale-file sweep.
fail() { printf 'code-channel: %s\n' "$*" >&2; }
root=$(cd -- "$(dirname -- "$0")/.." && pwd) || exit 3
config=${CODE_CHANNEL_CONFIG:-"$root/config/code-channel.json"}
sdk_agent=$root/bin/sdk-agent
if [[ -n ${CODE_CHANNEL_TEST_LOG:-} ]]; then sdk_agent=${CODE_CHANNEL_SDK_AGENT:-$sdk_agent}; fi
helper_scope=$root/bin/helper-scope
# helpers must use the default node (/usr/local/bin/node), not a caller's old nvm entry
strip_nvm_path() {
    local IFS=: p out=()
    for p in $1; do
        [[ $p == /root/.nvm/versions/node/*/bin ]] || out+=("$p")
    done
    printf '%s' "${out[*]}"
}
export PATH=$(strip_nvm_path "${PATH:-}")
jq -e '(.ladder | type == "array") and ([.ladder[].id] | length == (unique | length)) and all(.ladder[]; (.id | type == "string") and (.enabled | type == "boolean") and (.model | type == "string") and ((.resume_model? // "") | type == "string") and ((.key? // "") | type == "string") and ((.secret? // "") | type == "string") and ((.base? // "") | type == "string") and ((.effort? // "") | type == "string") and ((.audit_model? // "") | type == "string") and ((.fallback_model? // "") | type == "string"))' "$config" >/dev/null 2>&1 || { fail "конфиг $config не читается"; exit 3; }
en=$(jq -r '[.ladder[] | select(.enabled)] | length' "$config") || exit 3
[[ $en -gt 0 ]] || { fail "ladder must have at least one enabled entry, found 0"; exit 28; }
S=${CODE_CHANNEL_STATE:-/root/workspaces/tools/state/code-channel}
if [[ ${1:-} == use ]]; then
    uid=${2:-} uquote=${3:-}
    [[ $# == 3 && -n $uid && -n $uquote ]] || { fail 'usage: code-channel use <sdk|go> "<owner quote>"'; exit 2; }
    [[ $uid == go || $uid == sdk ]] || { fail "switch-lock: канал $uid не go/sdk"; exit 28; }
    jq -e --arg id "$uid" 'any(.ladder[]; .id == $id and .enabled)' "$config" >/dev/null 2>&1 || { fail "канал $uid не включён в лестнице"; exit 2; }
    mkdir -p "$S" || exit 3
    printf '%s\n' "$uid" > "$S/active" || exit 3
    printf '%s %s %s\n' "$(date +%F)" "$uid" "$uquote" >> "$S/use.log" || exit 3
    printf 'active=%s\n' "$uid"
    exit 0
fi
active=
[[ -r $S/active ]] && active=$(<"$S/active")
if [[ -z $active ]] || ! jq -e --arg id "$active" 'any(.ladder[]; .id == $id and .enabled)' "$config" >/dev/null 2>&1; then
    active=$(jq -r 'if (.switch | type) == "object" then (.switch.channel // empty) else empty end' "$config") || exit 3
fi
jq -e --arg id "$active" 'any(.ladder[]; .id == $id and .enabled)' "$config" >/dev/null 2>&1 || { fail "switch-lock: активный канал '${active:-}' не включён в лестнице"; exit 28; }
opencfg_rel=$(jq -er '.opencode_config // ""' "$config") || exit 3
if [[ -n $opencfg_rel ]]; then
    [[ $opencfg_rel == /* ]] && opencfg=$opencfg_rel || opencfg=$root/$opencfg_rel
    [[ -r $opencfg ]] || { fail "нет файла opencode_config: $opencfg"; exit 3; }
    export OPENCODE_CONFIG=$opencfg
fi
if [[ $# == 1 && $1 == --plan ]]; then
    jq -r --arg id "$active" '.ladder[] | select(.id == $id) | "\(.id) \(.model)"' "$config"
    exit 0
fi
[[ -z ${CODE_CHANNEL_ACTIVE:-} ]] || { fail 'рекурсия запрещена (CODE_CHANNEL_ACTIVE)'; exit 30; }
mkdir -p "$S" || exit 3
entry_for() { jq -cer --arg id "$1" '.ladder[] | select(.id == $id)' "$config"; }
resume_idle_limit=$(jq -er '.resume_idle_limit // 1' "$config") || exit 3
[[ $resume_idle_limit =~ ^[1-9][0-9]*$ ]] || { fail "неверный resume_idle_limit: $resume_idle_limit"; exit 3; }
[[ $# == 3 || $# == 5 ]] || { fail 'usage: form project tz [--model provider/model]'; exit 3; }
form=$1; project=$2; tz=$3; override=${5:-}
[[ $project == /* ]] || { fail 'project must be absolute path'; exit 3; }
[[ -n $form && $project == /* && ( $# == 3 || $4 == --model ) && ( $# == 3 || -n $override ) ]] || exit 3
[[ $form == audit ]] && mode=audit || mode=code
case $form in
    go|sdk|auto|audit|delivery) ;;
    *) fail "провайдер $form не в лестнице (go, sdk)"; exit 3;;
esac
if [[ $form == auto || $form == audit || $form == delivery ]]; then
    [[ -z $override ]] || exit 3
else
    enabled=$(entry_for "$form" | jq -r '.enabled') || exit 3
    [[ $enabled == true ]] || { fail "провайдер $form выключен в конфиге"; exit 3; }
    [[ $form != sdk || -z $override ]] || exit 3
fi
[[ -r $tz ]] || { fail 'нет файла ТЗ'; exit 3; }
prompt=$(cat -- "$tz") || exit 3
tz_abs=$(realpath -- "$tz") || exit 3
while IFS= read -r p; do
    [[ -n $p ]] || continue
    [[ $(realpath -m -- "$project/$p") == "$tz_abs" ]] && { fail "ТЗ в собственном Files: $p"; exit 3; }
done < <(grep -m1 '^Files:' <<<"$prompt" | tr '\140' '\n' | sed -n '2~2p')
cd -- "$project" || exit 3
lockf="$S/worktree.$(printf '%s\n' "$PWD" | sha1sum | cut -c-16).lock"
exec 9>>"$lockf" || exit 3
if ! flock -n 9; then
    holder=$(head -n1 -- "$lockf" 2>/dev/null | tr -cd '0-9')
    hcmd=
    [[ $holder =~ ^[0-9]+$ ]] && hcmd=$(tr '\0' ' ' <"/proc/$holder/cmdline" 2>/dev/null)
    fail "worktree занят другим запуском: $PWD lock=$lockf pid=${holder:-?} cmd=${hcmd:-?}"
    exit 25
fi
printf '%s\n' "$$" > "$lockf"
form_snap() { local s; s=$( { git rev-parse HEAD 2>/dev/null; git status --porcelain --untracked-files=all 2>/dev/null; git diff HEAD 2>/dev/null; git ls-files -z --others --exclude-standard 2>/dev/null | xargs -0 -r cksum 2>/dev/null; } ); [[ -z $s ]] && return 0; printf '%s\n' "$s" | cksum; }
cc_status() { git status --porcelain --untracked-files=all 2>/dev/null | cut -c4- | sed 's/.* -> //' | sort; }
cc_scope_check() {
    local allowed new p bads=()
    [[ $mode == code && $rc == 0 && $run == 0 ]] || return 0
    [[ ${cc_pre+x} == x ]] || return 0
    allowed=$(grep -m1 '^Files:' <<<"$prompt" | tr '\140' '\n' | sed -n '2~2p')
    [[ -n $allowed ]] || return 0
    new=$(cc_status)
    [[ -n $new ]] || return 0
    new=$(comm -13 <(printf '%s' "$cc_pre") <(printf '%s\n' "$new"))
    while IFS= read -r p; do
        [[ -n $p ]] || continue
        grep -Fqxq -- "$p" <<<"$allowed" || bads+=("$p")
    done <<<"$new"
    [[ ${#bads[@]} -eq 0 ]] || { printf 'out-of-scope: %s\n' "${bads[*]}" >&2; return 26; }
    return 0
}
LOOP_REPEAT_LIMIT=${CODE_CHANNEL_LOOP_LIMIT:-30}
loop_filter() {
    local pf=$1 hit=$2 line t key n pid
    local -A seen=()
    while IFS= read -r line || [[ -n $line ]]; do
        printf '%s\n' "$line"
        t=${line#"${line%%[![:space:]]*}"}
        t=${t%"${t##*[![:space:]]}"}
        [[ -n $t ]] || continue
        key=$t
        n=$(( ${seen["$key"]:-0} + 1 ))
        seen["$key"]=$n
        if (( n >= LOOP_REPEAT_LIMIT )) && [[ ! -s $hit ]]; then
            printf 'code-channel: loop-guard: line repeated %s times: %s\n' "$n" "${t:0:120}" >"$hit"
            pid=$(<"$pf")
            [[ -z $pid ]] || kill -TERM -- "-$pid" 2>/dev/null
            break
        fi
    done
}
guarded() {
    local pf hit r
    pf=$(mktemp "${TMPDIR:-/tmp}/code-channel-loop-XXXXXX") || exit 3
    hit=$pf.hit
    : >"$hit"
    setsid bash -c 'echo $$ >"$1"; shift; exec "$@"' _ "$pf" "$@" | loop_filter "$pf" "$hit"
    r=${PIPESTATUS[0]}
    if [[ -s $hit ]]; then
        cat -- "$hit" 2>/dev/null >&3 || cat -- "$hit" >&2
        unlink -- "$pf"; unlink -- "$hit"
        exit 27
    fi
    unlink -- "$pf"; unlink -- "$hit"
    return "$r"
}
tz_test() {
    local line r
    [[ $mode == audit ]] && return 0
    line=$(grep -m1 '^Test: ' -- "$tz_abs") || return 0
    "$root/bin/test-once" "$project" bash -c "${line#Test: }"; r=$?
    printf 'code-channel: test rc=%s\n' "$r" >&2
    case $r in 0) return 0;; 29) exit 29;; *) exit 31;; esac
}
run_sdk() {
    local sub=code r outf
    [[ $mode == audit ]] && sub=read
    cc_pre=$(cc_status)
    outf=$(mktemp "${TMPDIR:-/tmp}/code-channel-sdkout-XXXXXX") || exit 3
    CODE_CHANNEL_ACTIVE=1 guarded "$sdk_agent" "$sub" "$PWD" "$tz_abs" | tee -- "$outf"; r=${PIPESTATUS[0]}
    printf 'code-channel: mode=%s form=sdk rc=%s\n' "$mode" "$r" >&2
    if [[ $r == 0 ]]; then
        rc=0 run=0
        cc_scope_check || { local s=$?; unlink -- "$outf"; exit "$s"; }
        if [[ $mode == code && ! -s $outf && $(cc_status) == "$cc_pre" ]]; then
            unlink -- "$outf"
            fail 'worker made no change and no report'
            exit 17
        fi
        unlink -- "$outf"
        return 0
    fi
    unlink -- "$outf"
    return "$r"
}
run_form() (
    export CODE_CHANNEL_ACTIVE=1
    id=$1; [[ $id == go || $id == sdk ]] || { fail "switch-lock: канал '${id}' не go/sdk"; exit 28; }
    start=$SECONDS; pre=-; run=-; hdr=; tmpjson=; resphdr=; respbody=; codetmp=; oc_out=; oc_err=; pfile=
    retries=0 primary_model= used_fallback=0
    IFS=$'\034' read -r model resume_model audit_model fallback_model name secret base effort < <(entry_for "$id" | jq -r '[.model,.resume_model // "",.audit_model // "",.fallback_model // "",.key // "",.secret // "",.base // "",.effort // ""] | join("\u001c")') || exit 3
    if [[ -n $override && $override != "$model" ]]; then
        fail "модель не в конфиге: $override"
        exit 3
    fi
    model=${override:-$model}
    if [[ $mode == audit && -z $override && -n $audit_model ]]; then model=$audit_model; fi
    id_run="cc-$(date +%s)-$$"
    write_journal() {
        local pa=$1 ma=$2 r=$3 session=$4
        local j=${CODE_CHANNEL_RUNS_LOG:-$S/runs.jsonl}
        mkdir -p -- "$(dirname -- "$j")"
        jq -nc --arg ts "$(date +%s)" --arg id "$id_run" --arg mode "$mode" --arg form "$id" \
            --arg pe "$provider" --arg pa "$pa" --arg ma "$ma" --argjson rc "$r" --arg session "$session" --argjson retries "${retries:-0}" \
            '{ts:$ts,id:$id,mode:$mode,form:$form,provider_expected:$pe,provider_actual:$pa,model_actual:$ma,rc:$rc,session:$session,retries:$retries}' \
            >>"$j"
    }
    reconcile() {
        local r=$1 pa= ma=
        local db=${CODE_CHANNEL_OPENCODE_DB:-/root/.local/share/opencode/opencode.db}
        local row session
        row=$(sqlite3 -readonly "$db" "select json_extract(model,'$.providerID')||'|'||json_extract(model,'$.id') from session where title='$id_run' order by time_created desc limit 1" 2>/dev/null)
        if [[ -z $row ]]; then
            row=$(sqlite3 -readonly "$db" "select json_extract(model,'$.providerID')||'|'||json_extract(model,'$.id') from session where directory='$project' and time_created >= $run_start_ms order by time_created desc limit 1" 2>/dev/null)
        fi
        pa=${row%%|*}
        ma=${row#*|}
        session=$(sqlite3 -readonly "$db" "select id from session where title='$id_run' order by time_created desc limit 1" 2>/dev/null)
        write_journal "$pa" "$ma" "$r" "$session"
        if [[ -z $pa || $pa != "$provider" ]]; then
            printf 'code-channel: сверка провайдера не прошла\n' >&2
            return 23
        fi
        if [[ $ma != "${model#*/}" ]]; then
            printf 'code-channel: сверка модели не прошла: ожидалась %s, факт %s\n' "${model#*/}" "$ma" >&2
            return 23
        fi
        return 0
    }
    finish() {
        rc=$?
        [[ -z $oc_out ]] || unlink -- "$oc_out"
        [[ -z $oc_err ]] || unlink -- "$oc_err"
        [[ -z $pfile ]] || unlink -- "$pfile"
        printf 'code-channel: mode=%s form=%s provider=%s model=%s retries=%s precheck=%s run=%s t=%s\n' "$mode" "$id" "$provider" "$model" "$retries" "$pre" "$run" "$((SECONDS-start))" >&2
        trap - EXIT; exit "$rc"
    }
    trap finish EXIT
    tool=opencode
    command -v "$tool" >/dev/null || { fail "нет инструмента $tool"; exit 3; }
    prompt=$(printf 'Ты уже исполнитель внутри code-channel: правь файлы сам; code-channel, opencode run, codex exec не вызывай\n\n%s' "$prompt")
    if [[ ${delivery:-} == 1 ]]; then
        prompt=$(printf 'Delivery mode: inside the worktree you may run only: the TZ test command; `git add` of files named in the TZ `FILE:` lines; `git commit -F <file>`; one `git push -u origin <branch>` where <branch> is the worktree current branch and matches claude/* or codex/*; `gh pr create --base main --body-file <file>`; `gh pr merge <N> --merge --delete-branch` (repo with squash only: `--squash`). Return the PR number, `gh pr view <N> --json state` output and the test output verbatim. Forbidden: force push, `--no-verify`, push to main, branch delete, `gh pr edit|comment`, any file outside `FILE:`.\n\n%s' "$prompt")
    else
        prompt=$(printf 'Не создавай и не переключай ветки; не делай git add и git commit — коммит делает оркестратор\n\n%s' "$prompt")
    fi
    prompt=$(printf 'Разведка кода — только через индекс: repowise (repowise context|symbol|risk <путь> --path <корень репо>) и codebase-memory; файл кода читай только перед его правкой\n\n%s' "$prompt")
    prompt=$(printf 'Не вызывай bd: трекер ведёт оркестратор\n\n%s' "$prompt")
    prompt=$(printf 'Scratch and temporary files go to /tmp only, never inside the worktree\n\n%s' "$prompt")
    prompt=$(printf 'Tests: code-channel runs the TZ Test: line once after you finish via /root/workspaces/tools/bin/test-once; do not re-run tests in a loop\n\n%s' "$prompt")
    prompt=$(printf 'Parallelize: when the task has 2 or more independent file sets, dispatch them at once to general subagents via the Task tool in one message, one file set per subagent, never the same file to two subagents; then check the combined result yourself\n\n%s' "$prompt")
    [[ $model == ?*/?* ]] || exit 15
    provider=${model%%/*}
    mid=${model#*/}
    run_start_ms=$(date +%s%3N)
    db=${CODE_CHANNEL_OPENCODE_DB:-/root/.local/share/opencode/opencode.db}
    oc_args=() oc_prompt=
    pfile=$(mktemp "${TMPDIR:-/tmp}/code-channel-prompt-XXXXXX") || exit 3
    if [[ $mode == audit ]]; then
        printf '%s' "$prompt" >"$pfile"
        guarded "$helper_scope" timeout 1800 opencode run --agent audit --title "$id_run" -m "$model" < "$pfile"; run=$?
    else
        oc_args=(--title "$id_run") oc_prompt=$prompt
        idle=0
        primary_model=$model
        retry_sleep=${CC_RETRY_SLEEP:-15}
        [[ $retry_sleep =~ ^[0-9]+$ ]] || retry_sleep=15
        oc_out=$(mktemp "${TMPDIR:-/tmp}/code-channel-oc-XXXXXX") || exit 3
        oc_err=$(mktemp "${TMPDIR:-/tmp}/code-channel-ocerr-XXXXXX") || exit 3
        seg_before=$(form_snap)
        cc_pre=$(cc_status)
        id_sid_sql="select id from session where title='$id_run' order by time_created desc limit 1"
        while :; do
            printf '%s' "$oc_prompt" >"$pfile"
            guarded "$helper_scope" timeout 1800 env OPENCODE_DISABLE_MODELS_FETCH=1 OPENCODE_DISABLE_AUTOUPDATE=1 opencode --pure run "${oc_args[@]}" --agent developer -m "$model" < "$pfile" 2>"$oc_err" | tee "$oc_out"; run=${PIPESTATUS[0]}
            cat -- "$oc_err" >&2
            [[ $run != 27 ]] || exit 27
            [[ $run == 0 ]] && break
            fresh=1; [[ ${oc_args[0]:-} != --session ]] || fresh=0
            if [[ $fresh == 1 ]] && { [[ $run == 124 ]] || grep -q 'Upstream request failed:' "$oc_err"; }; then
                if [[ $used_fallback == 0 ]]; then
                    if (( retries < 2 )); then
                        retries=$((retries + 1))
                        printf 'code-channel: сбой провайдера rc=%s, повтор %s/2 через %ss\n' "$run" "$retries" "$((retry_sleep * retries))" >&2
                        sleep $((retry_sleep * retries))
                        continue
                    fi
                    if [[ -n $fallback_model && $fallback_model != "$primary_model" ]]; then
                        used_fallback=1
                        model=$fallback_model
                        printf 'code-channel: запасная модель %s — причина: сбой провайдера %s\n' "$fallback_model" "$primary_model" >&2
                        continue
                    fi
                fi
                printf 'code-channel: канал %s недоступен — доказательство для failover (rc, stderr, время)\n' "$id" >&2
                break
            fi
            grep -q 'Upstream request failed:' "$oc_err" && { printf 'code-channel: отказ провайдера, без продолжения сессии\n' >&2; break; }
            sid=$(sqlite3 -readonly "$db" "$id_sid_sql" 2>/dev/null)
            [[ -n $sid ]] || break
            seg_after=$(form_snap)
            if [[ $seg_after == "$seg_before" ]]; then
                idle=$((idle + 1))
                if (( idle >= resume_idle_limit )); then break; fi
            else
                idle=0
            fi
            printf 'code-channel: сбой rc=%s, продолжаю сессию %s (простоев подряд %s/%s)\n' "$run" "$sid" "$idle" "$resume_idle_limit" >&2
            seg_before=$seg_after oc_args=(--session "$sid") oc_prompt='Продолжи задачу из этой сессии с места остановки и доведи её до конца.'
        done
    fi
    reconcile "$run"; rc=$?
    [[ $rc != 0 ]] && exit "$rc"
    cc_scope_check || exit $?
    exit "$run"
)
if [[ $form == sdk ]]; then
    run_sdk; rc=$?; [[ $rc == 0 ]] && tz_test; exit "$rc"
fi
if [[ $form == delivery ]]; then
    delivery=1
    id=$(jq -r '[.ladder[] | select(.enabled) | .id] | map(select(. != "sdk")) | .[0] // empty' "$config") || exit 3
    [[ -n $id ]] || { fail 'no delivery channel (only sdk enabled)'; exit 3; }
    [[ $id == go ]] || { fail "delivery: канал '${id}' не go/sdk"; exit 28; }
    run_form "$id"; rc=$?; [[ $rc == 0 ]] && tz_test; exit "$rc"
fi
if [[ $form == go ]]; then
    run_form go; rc=$?; [[ $rc == 0 ]] && tz_test; exit "$rc"
fi
if [[ $form == audit ]]; then
    before=$(form_snap)
    if [[ $active == sdk ]]; then run_sdk; rc=$?; else run_form "$active"; rc=$?; fi
    if [[ $(form_snap) != "$before" ]]; then
        printf 'code-channel: mode=audit form=%s изменено рабочее дерево — отчёт не принят\n' "$active" >&2
        exit 22
    fi
    exit "$rc"
fi
run_worker() {
    if [[ $1 == sdk ]]; then run_sdk; else run_form "$1"; fi
}
run_capture() {
    local id=$1 ef=$2 errf
    errf=$ef.stderr
    : >"$ef"; : >"$errf"
    run_worker "$id" 2>"$errf" | tee -a -- "$ef"
    local r=${PIPESTATUS[0]}
    cat -- "$errf" >&2
    return "$r"
}
provider_failure() {
    local r=$1 f=$2
    [[ $r == 124 ]] && return 0
    grep -q 'Upstream request failed:' "$f" 2>/dev/null && return 0
    return 1
}
canary_bin=${CODE_CHANNEL_CANARY:-$root/bin/channel-canary}
run_canary() {
    local w=$1 d out c
    d=$(mktemp -d "${TMPDIR:-/tmp}/code-channel-canary-XXXXXX") || return 3
    mkdir -p -- "$d/state" "$d/project" || { rm -rf -- "$d"; return 3; }
    printf '%s\n' "$w" >"$d/state/active" || { rm -rf -- "$d"; return 3; }
    out=$(CODE_CHANNEL="$root/bin/code-channel" CODE_CHANNEL_STATE="$d/state" "$canary_bin" "$d/project" 2>&1); c=$?
    rm -rf -- "$d"
    printf '%s\n' "$out"
    return "$c"
}
write_permit() {
    local g=$1 s=$2 dir=$3 canary=$4
    local permit=${CODE_CHANNEL_PERMIT:-$S/permit.json} lines tmp
    [[ -n $canary ]] || return 3
    lines=$(grep -h . "$dir"/*.err.stderr 2>/dev/null | tail -n 20)
    mkdir -p -- "$(dirname -- "$permit")" || return 3
    tmp=$(mktemp -- "${permit}.tmp.XXXXXX") || return 3
    if ! jq -n --argjson rc 32 --argjson go_rc "$g" --argjson sdk_rc "$s" \
            --argjson ts "$(date +%s)" --arg canary "$canary" --arg err "$lines" \
            --arg worktree "$PWD" --arg tz "$tz_abs" \
            '{rc:$rc,go_rc:$go_rc,sdk_rc:$sdk_rc,stderr:($err|split("\n")|map(select(length>0))),canary:$canary,ts:$ts,worktree:$worktree,tz:$tz}' \
            >"$tmp"; then
        rm -f -- "$tmp"; return 3
    fi
    mv -f -- "$tmp" "$permit" || { rm -f -- "$tmp"; return 3; }
    return 0
}
auto_success() {
    local dir=$1 after
    rm -f -- "${CODE_CHANNEL_PERMIT:-$S/permit.json}" 2>/dev/null || true
    after=$(form_snap)
    if [[ $mode == audit ]]; then
        if [[ $after != "$before" ]]; then
            printf 'code-channel: mode=audit изменено рабочее дерево — отчёт не принят\n' >&2
            rm -rf -- "$dir"; exit 22
        fi
        rm -rf -- "$dir"; exit 0
    fi
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [[ -z $(git status --porcelain 2>/dev/null) ]]; then
        fail 'empty run (rc 0, no diff)'
        rm -rf -- "$dir"; exit 16
    fi
    rm -rf -- "$dir"; tz_test; exit 0
}
auto_run() {
    local start other r r2 dir g=-1 s=-1 canary_out c
    start=$active
    if [[ $start == sdk ]] && ! grep -q '^FILE:' -- "$tz_abs" && ! grep -q '^Files:' -- "$tz_abs"; then
        printf 'code-channel: route sdk->go (TZ has no FILE lines)\n' >&2
        start=go
    fi
    case $start in
        go) other=sdk;;
        sdk) other=go;;
        *) fail "auto: активный канал '${start:-}' не go/sdk"; exit 28;;
    esac
    dir=$(mktemp -d "${TMPDIR:-/tmp}/code-channel-auto-XXXXXX") || exit 3
    rm -f -- "${CODE_CHANNEL_PERMIT:-$S/permit.json}" 2>/dev/null || true
    before=$(form_snap)
    run_capture "$start" "$dir/$start.err"; r=$?
    [[ $r != 0 ]] || auto_success "$dir"
    if ! provider_failure "$r" "$dir/$start.err.stderr"; then
        printf 'code-channel: no evidence %s rc=%s — без переключения\n' "$start" "$r" >&2
        rm -rf -- "$dir"
        exit "$r"
    fi
    canary_out=$(run_canary "$start"); c=$?
    if [[ $c != 1 ]]; then
        printf 'code-channel: no evidence %s rc=%s canary_rc=%s — без переключения\n' "$start" "$r" "$c" >&2
        rm -rf -- "$dir"
        exit "$r"
    fi
    printf 'code-channel: evidence %s rc=%s — передаю %s один раз\n' "$start" "$r" "$other" >&2
    run_capture "$other" "$dir/$other.err"; r2=$?
    [[ $start == go ]] && g=$r || s=$r
    [[ $other == go ]] && g=$r2 || s=$r2
    [[ $r2 != 0 ]] || auto_success "$dir"
    if ! provider_failure "$r2" "$dir/$other.err.stderr"; then
        printf 'code-channel: no evidence %s rc=%s — без переключения\n' "$other" "$r2" >&2
        rm -rf -- "$dir"
        exit "$r2"
    fi
    canary_out=$(run_canary "$other"); c=$?
    if [[ $c != 1 ]]; then
        printf 'code-channel: no evidence %s rc=%s canary_rc=%s — без переключения\n' "$other" "$r2" "$c" >&2
        rm -rf -- "$dir"
        exit "$r2"
    fi
    write_permit "$g" "$s" "$dir" "$canary_out" || { rm -rf -- "$dir"; exit 3; }
    rm -rf -- "$dir"
    exit 32
}
auto_run
