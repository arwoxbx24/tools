#!/usr/bin/env bash
set +x
set -uo pipefail
# spec:035: only this invocation's temporary files are cleaned; no stale-file sweep.
fail() { printf 'code-channel: %s\n' "$*" >&2; }
S=${CODE_CHANNEL_STATE:-/root/workspaces/tools/state/code-channel}
mkdir -p "$S" || exit 3
write_block() {
    local until=$1 streak=$2 code=$3 tmp
    tmp=$(mktemp "$S/bitrixgpt.block.XXXXXX") || exit 3
    printf '%s %s %s\n' "$until" "$streak" "$code" > "$tmp"
    mv -f -- "$tmp" "$S/bitrixgpt.block"
}
save_fail() {
    local code=$1 resphdr=$2 respbody=$3
    {
        printf 'code: %s\n' "$code"
        printf 'body (first 2000 bytes):\n'
        head -c 2000 -- "$respbody" | grep -Eavi 'key|token|authorization|cookie'
        printf '\n'
    } > "$S/bitrixgpt-last-fail.txt"
    chmod 600 "$S/bitrixgpt-last-fail.txt"
}
[[ $# == 3 || $# == 5 ]] || { fail 'usage: form project tz [--model provider/model]'; exit 3; }
form=$1; project=$2; tz=$3; override=${5:-}
[[ $form == audit ]] && mode=audit || mode=code
[[ $form =~ ^(1|2|3|auto|audit)$ && $project == /* && ( $# == 3 || $4 == --model ) ]] || exit 3
[[ -r $tz ]] || { fail 'нет файла ТЗ'; exit 3; }
prompt=$(cat -- "$tz") || exit 3
cd -- "$project" || exit 3
run_form() (
    n=$1; start=$SECONDS; pre=-; run=-; hdr=; tmpjson=; resphdr=; respbody=
    id="cc-$(date +%s)-$$"
    case $n in
        1) provider=bitrixgpt; name=VIBECODE_API_KEY; secret=vibecode; base=https://vibecode.bitrix24.tech/v1; model=bitrixgpt/bitrix/bitrixgpt-5.6-agent;;
        2) provider=codex;;
        3) provider=openrouter; name=OPENROUTER_API_KEY; secret=openrouter; base=https://openrouter.ai/api/v1; model=openrouter/deepseek/deepseek-v4-flash;;
    esac
    write_journal() {
        local pa=$1 ma=$2 r=$3
        local j=${CODE_CHANNEL_RUNS_LOG:-$S/runs.jsonl}
        mkdir -p -- "$(dirname -- "$j")"
        jq -nc --arg ts "$(date +%s)" --arg id "$id" --arg mode "$mode" --arg form "$n" \
            --arg pe "$provider" --arg pa "$pa" --arg ma "$ma" --argjson rc "$r" \
            '{ts:$ts,id:$id,mode:$mode,form:$form,provider_expected:$pe,provider_actual:$pa,model_actual:$ma,rc:$rc}' \
            >>"$j"
    }
    reconcile() {
        local r=$1 pa= ma=
        if [[ $n == 2 ]]; then
            local cur
            cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
            if [[ $cur != "$orig_branch" ]]; then
                git switch "$orig_branch" 2>/dev/null || true
                printf 'code-channel: форма 2 сменила ветку, возвращено\n' >&2
            fi
            write_journal codex "" "$r"
            return 0
        fi
        local db=${CODE_CHANNEL_OPENCODE_DB:-/root/.local/share/opencode/opencode.db}
        local row
        row=$(sqlite3 -readonly "$db" "select json_extract(model,'$.providerID')||'|'||json_extract(model,'$.id') from session where title='$id' order by time_created desc limit 1" 2>/dev/null)
        if [[ -z $row ]]; then
            row=$(sqlite3 -readonly "$db" "select json_extract(model,'$.providerID')||'|'||json_extract(model,'$.id') from session where directory='$project' and time_created >= $run_start_ms order by time_created desc limit 1" 2>/dev/null)
        fi
        pa=${row%%|*}
        ma=${row#*|}
        write_journal "$pa" "$ma" "$r"
        if [[ -z $pa || $pa != "$provider" ]]; then
            printf 'code-channel: сверка провайдера не прошла\n' >&2
            return 23
        fi
        return 0
    }
    finish() {
        rc=$?
        [[ -z $hdr ]] || unlink -- "$hdr"
        [[ -z $tmpjson ]] || unlink -- "$tmpjson"
        [[ -z $resphdr ]] || unlink -- "$resphdr"
        [[ -z $respbody ]] || unlink -- "$respbody"
        printf 'code-channel: mode=%s form=%s provider=%s precheck=%s run=%s t=%s\n' "$mode" "$n" "$provider" "$pre" "$run" "$((SECONDS-start))" >&2
        trap - EXIT; exit "$rc"
    }
    trap finish EXIT
    for tool in curl jq; do command -v "$tool" >/dev/null || { fail "нет инструмента $tool"; exit 3; }; done
    tool=opencode; [[ $n != 2 ]] || tool=codex
    command -v "$tool" >/dev/null || { fail "нет инструмента $tool"; exit 3; }
    if [[ $n == 2 ]]; then
        orig_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
        prompt=$(printf 'Не создавай и не переключай ветки; пиши и коммить только в текущую ветку\n\n%s' "$prompt")
        started=$SECONDS
        if [[ $mode == audit ]]; then
            timeout 590 codex exec -p quota-terra -s read-only "$prompt"; run=$?
        else
            timeout 590 codex exec -p quota-terra -s workspace-write "$prompt"; run=$?
        fi
        [[ $run == 0 || $run == 124 || $((SECONDS-started)) -gt 30 ]] || exit 21
        reconcile "$run"; exit $?
    fi
    secrets_root=${CODE_CHANNEL_SECRETS_ROOT:-/root/workspaces/secrets}
    f=${CODE_CHANNEL_SECRET_OVERRIDE:-}
    if [[ -z $f ]]; then
        for cand in "$secrets_root/projects/$secret.env" "$secrets_root/services/$secret.env"; do
            [[ -r $cand ]] && { f=$cand; break; }
        done
    fi
    [[ -r $f ]] || { fail "нет секрета $name"; exit 5; }
    val=$(sed -n "s/^\(export \)\{0,1\}${name}=//p" "$f" | head -1 | tr -d "\"'")
    [[ -n $val && $val != *$'\r'* && $val != *$'\n'* ]] || { fail "нет секрета $name"; exit 5; }
    export "$name=$val"
    umask 077
    hdr=$(mktemp "${TMPDIR:-/tmp}/code-channel-hdr-XXXXXX") || exit 3
    tmpjson=$(mktemp "${TMPDIR:-/tmp}/code-channel-json-XXXXXX") || exit 3
    printf 'Authorization: Bearer %s\n' "$val" > "$hdr" || exit 3
    unset val
    case $n in
        3) endpoint="${CODE_CHANNEL_BASEURL_OVERRIDE:-$base}/key";;
        *) endpoint="${CODE_CHANNEL_BASEURL_OVERRIDE:-$base}/models";;
    esac
    pre=$(curl -sS -m 5 -o "$tmpjson" -w '%{http_code}' -H @"$hdr" "$endpoint")
    rc=$?
    [[ $rc == 0 ]] || exit 14
    case $pre in 200) ;; 401|403) exit 11;; 429) exit 12;; 402) exit 13;; 5??) exit 14;; 4??) exit 11;; *) exit 14;; esac
    [[ $n != 3 ]] || jq -e '.data.limit_remaining == null or ((.data.limit_remaining | type) == "number" and .data.limit_remaining > 0)' "$tmpjson" >/dev/null 2>&1 || exit 13
    model=${override:-$model}
    [[ $model == "$provider/"* ]] || exit 15
    mid=${model#*/}
    config=${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.jsonc
    ids=$(jq -Rs --argjson n "$n" 'gsub("(?m)^\\s*//[^\\n]*"; "") | gsub(",\\s*(?<end>[}\\]])"; .end) | fromjson | if $n == 1 then .provider.bitrixgpt.models | keys else .provider.openrouter.whitelist end' "$config" 2>/dev/null) || exit 15
    jq -e --arg id "$mid" 'index($id) != null' <<<"$ids" >/dev/null 2>&1 || exit 15
    if [[ $n == 1 ]]; then
        resphdr=$(mktemp "${TMPDIR:-/tmp}/code-channel-resphdr-XXXXXX") || exit 3
        respbody=$(mktemp "${TMPDIR:-/tmp}/code-channel-respbody-XXXXXX") || exit 3
        payload=$(printf '{"model":"%s","messages":[{"role":"user","content":"ok"}],"max_tokens":1}' "$mid")
        ccode=$(curl -sS -m 20 -D "$resphdr" -o "$respbody" -w '%{http_code}' \
            -H @"$hdr" -H 'Content-Type: application/json' -d "$payload" \
            "${CODE_CHANNEL_BASEURL_OVERRIDE:-$base}/chat/completions")
        rc=$?
        [[ $rc == 0 ]] || exit 14
        case $ccode in
            200)
                [[ -f $S/bitrixgpt.block ]] && rm -f -- "$S/bitrixgpt.block"
                ;;
            429)
                retry=$(awk 'tolower($1)=="retry-after:"{print $2}' "$resphdr" | tr -d '\r')
                [[ $retry =~ ^[0-9]+$ ]] || retry=60
                write_block "$(( $(date +%s) + retry ))" 0 429
                save_fail "$ccode" "$resphdr" "$respbody"
                exit 12
                ;;
            402)
                prev=0
                [[ -f $S/bitrixgpt.block ]] && read -r _ prev _ < "$S/bitrixgpt.block" 2>/dev/null
                [[ $prev =~ ^[0-9]+$ ]] || prev=0
                streak=$((prev + 1))
                until=$(( $(date +%s) + 900 * (2 ** (streak - 1)) ))
                now=$(date +%s)
                [[ $until -gt $(( now + 21600 )) ]] && until=$(( now + 21600 ))
                write_block "$until" "$streak" 402
                save_fail "$ccode" "$resphdr" "$respbody"
                exit 13
                ;;
            *)
                case $ccode in 401|403) exit 11;; 5??) exit 14;; 4??) exit 11;; *) exit 14;; esac
                ;;
        esac
    fi
    run_start_ms=$(date +%s%3N)
    if [[ $mode == audit ]]; then
        timeout 590 opencode run --agent audit --title "$id" -m "$model" "$prompt"; run=$?
    else
        timeout 590 opencode run --title "$id" -m "$model" "$prompt"; run=$?
    fi
    reconcile "$run"; exit $?
)
if [[ $form =~ ^[123]$ ]]; then run_form "$form"; exit $?; fi
form_snap() { local s; s=$( { git rev-parse HEAD 2>/dev/null; git status --porcelain 2>/dev/null; git diff HEAD 2>/dev/null; } ); [[ -z $s ]] && return 0; printf '%s\n' "$s" | cksum; }
delivery_proof() {
    local prev_head=$1 prev_branch=$2 cur_head cur_branch porcelain lsout nlines r_hash r_ref
    cur_head=$(git rev-parse HEAD 2>/dev/null || true)
    cur_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [[ -z $prev_head || -z $cur_head || $prev_head == "$cur_head" ]]; then
        printf 'code-channel: form=%s rc=0 но HEAD не продвинулся (%s→%s)\n' "$n" "${prev_head:--}" "${cur_head:--}" >&2
        return 24
    fi
    if ! porcelain=$(git status --porcelain 2>/dev/null); then
        printf 'code-channel: form=%s rc=0 но git status не выполнен\n' "$n" >&2
        return 24
    fi
    if [[ -n $porcelain ]]; then
        printf 'code-channel: form=%s rc=0 но рабочее дерево нечисто\n' "$n" >&2
        return 24
    fi
    if [[ -z $prev_branch || $cur_branch != "$prev_branch" ]]; then
        printf 'code-channel: form=%s rc=0 но ветка сменилась (%s→%s)\n' "$n" "${prev_branch:--}" "${cur_branch:--}" >&2
        return 24
    fi
    if [[ $cur_branch != codex/* && $cur_branch != claude/* ]]; then
        printf 'code-channel: form=%s rc=0 но ветка не codex/* или claude/* (%s)\n' "$n" "$cur_branch" >&2
        return 24
    fi
    lsout=$(git ls-remote --exit-code origin "refs/heads/$cur_branch" 2>/dev/null) || {
        printf 'code-channel: form=%s rc=0 но удалённая ветка не достижима\n' "$n" >&2
        return 24
    }
    nlines=$(printf '%s\n' "$lsout" | grep -c -- .)
    r_ref=${lsout#*$'\t'}
    r_hash=${lsout%%$'\t'*}
    if [[ $nlines != 1 || $r_ref == "$lsout" || $r_hash != "$cur_head" || $r_ref != "refs/heads/$cur_branch" ]]; then
        printf 'code-channel: form=%s rc=0 но удалённая ветка не подтверждает HEAD точно\n' "$n" >&2
        return 24
    fi
    return 0
}
for n in 1 3 2; do
    if [[ $n == 1 && -f $S/bitrixgpt.block ]]; then
        read -r blk_until _ blk_code < "$S/bitrixgpt.block"
        if [[ $blk_until =~ ^[0-9]+$ ]] && (( blk_until > $(date +%s) )); then
            printf 'code-channel: form=1 пропуск: лимит bitrixgpt до %s (%s)\n' \
                "$(date -d "@$blk_until" +%H:%M)" "$blk_code" >&2
            continue
        fi
    fi
    before=$(form_snap)
    before_head=$(git rev-parse HEAD 2>/dev/null || true)
    before_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    run_form "$n"; rc=$?
    case $rc in 3|5|15) exit "$rc";; esac
    if [[ $rc == 0 ]]; then
        after=$(form_snap)
        if [[ $mode == audit ]]; then
            if [[ $after != "$before" ]]; then
                printf 'code-channel: mode=audit form=%s изменено рабочее дерево — отчёт не принят\n' "$n" >&2
                exit 22
            fi
            exit 0
        elif [[ -n $before || -n $after ]] && [[ $after == "$before" ]]; then
            printf 'code-channel: form=%s rc=0 без изменений\n' "$n" >&2
            [[ $n == 2 ]] && exit 16
            rc=1
        else
            delivery_proof "$before_head" "$before_branch"; prc=$?
            [[ $prc == 0 ]] || exit "$prc"
            exit "$rc"
        fi
    fi
    [[ $n == 2 ]] && exit "$rc"
    case $n in 1) nx=3;; 3) nx=2;; esac
    printf 'code-channel: switch %s→%s rc=%s\n' "$n" "$nx" "$rc" >&2
done
