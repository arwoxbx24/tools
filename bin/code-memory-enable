#!/usr/bin/env bash
set -eu
case ${1:-} in -h|--help) echo "usage: code-memory-enable [--untrack] <abs-project-path> | --template <hooks-dir>  (enables or removes code-memory tracking)"; exit 0;; esac

: "${CME_MIN_MEM_MB:=3072}"
: "${CME_MIN_SWAP_MB:=1024}"
: "${CME_PROJECTS_ROOT:=/root/workspaces/projects}"
: "${CME_CLIENTS_ROOT:=$CME_PROJECTS_ROOT/clients}"
: "${CME_TOOLS_ROOT:=/root/workspaces/tools}"
: "${CME_PARENT_REV:=}"
: "${CME_DENY:=/root/workspaces/tools/config/code-memory.deny}"
: "${CME_LOCK:=/tmp/code-memory.lock}"
: "${CME_SELF:="$0"}"
: "${CBM_MEM_BUDGET_MB:=2048}" "${CBM_WORKERS:=2}"
export CBM_MEM_BUDGET_MB CBM_WORKERS

case "$CME_SELF" in
  /*) ;;
  *)  CME_SELF="$(cd "$(dirname "$CME_SELF")" && pwd)/$(basename "$CME_SELF")" ;;
esac

ensure_stub() {
  local hook="$1" tmp
  mkdir -p "$(dirname "$hook")"
  if [ -f "$hook" ]; then
    tmp="$(mktemp)"
    awk '
      /# repowise-hook-start/ { s=1; next }
      /# repowise-hook-end/   { s=0; next }
      s { next }
      /codebase-memory-mcp cli index_repository/ { next }
      /# spec:082/ { next }
      { print }
    ' "$hook" > "$tmp"
    cp -f "$tmp" "$hook"
    rm -f "$tmp"
  else
    printf '#!/bin/sh\n' > "$hook"
  fi
  if ! grep -q '# code-memory-hook' "$hook" 2>/dev/null; then
    printf '%s\n%s\n' '' \
      "( setsid nice -n 19 $CME_SELF \"\$(git rev-parse --show-toplevel)\" >>/tmp/code-memory.log 2>&1 & ) # code-memory-hook" \
      >> "$hook"
  fi
  chmod +x "$hook"
}

untrack=0
case "${1:-}" in
  --template)
    if [ $# -lt 2 ]; then
      echo "usage: code-memory-enable --template <hooks-dir>" >&2
      exit 2
    fi
    exec 9>"$CME_LOCK"; flock 9
    ensure_stub "$2/post-commit"
    ensure_stub "$2/post-merge"
    exit 0
    ;;
  --untrack)
    if [ $# -lt 2 ]; then
      echo "usage: code-memory-enable --untrack <abs-project-path>" >&2
      exit 2
    fi
    untrack=1
    shift
    ;;
  "")
    echo "usage: code-memory-enable <abs-project-path>" >&2
    exit 2
    ;;
esac

path="$1"
base="$(basename "$path")"

run_enable() {
  mem_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
  : "${mem_kb:=0}"
  swap_kb="$(awk '/^SwapFree:/ {print $2}' /proc/meminfo)"
  : "${swap_kb:=0}"
  min_mem_kb=$(( CME_MIN_MEM_MB * 1024 ))
  min_swap_kb=$(( CME_MIN_SWAP_MB * 1024 ))
  if [ "$mem_kb" -lt "$min_mem_kb" ] || [ "$swap_kb" -lt "$min_swap_kb" ]; then
    echo "code-memory-enable: insufficient memory/swap (mem=${mem_kb}kB swap=${swap_kb}kB)" >&2
    exit 3
  fi

  exclude="$path/.git/info/exclude"
  if [ -d "$path/.git" ]; then
    : "${CME_EXCLUDE_SRC:=/root/.gitignore_global}"
    if [ ! -f "$CME_EXCLUDE_SRC" ]; then
      echo "code-memory-enable: exclude source not found: $CME_EXCLUDE_SRC" >&2
      exit 4
    fi
    if [ -L "$exclude" ]; then
      [ "$(readlink "$exclude")" = "$CME_EXCLUDE_SRC" ] || { echo "code-memory-enable: foreign symlink: $exclude -> $(readlink "$exclude")" >&2; exit 4; }
    elif [ -f "$exclude" ]; then
      foreign="$(awk '!/^#/ && NF {print}' "$exclude" || true)"
      [ -z "$foreign" ] || { echo "code-memory-enable: $exclude has existing rules:" >&2; printf '%s\n' "$foreign" >&2; exit 4; }
    fi
    mkdir -p "$path/.git/info"
    ln -sfn "$CME_EXCLUDE_SRC" "$exclude"
    ensure_stub "$path/.git/hooks/post-commit"
    ensure_stub "$path/.git/hooks/post-merge"
  fi

  repowise_bin="$(command -v repowise)"
  cbm_bin="$(command -v codebase-memory-mcp)"

  if [ -f "$path/.repowise/state.json" ]; then
    python3 - "$path" <<'PY'
import os, sys

try:
    import yaml
except Exception:
    sys.exit(0)

path = sys.argv[1]
cfg = os.path.join(path, ".repowise", "config.yaml")
if not os.path.exists(cfg):
    sys.exit(0)

with open(cfg) as f:
    data = yaml.safe_load(f) or {}
editor = data.setdefault("editor_files", {})
if not isinstance(editor, dict):
    editor = data["editor_files"] = {}
changed = editor.get("claude_md") is not False or editor.get("agents_md") is not False
editor["claude_md"] = False
editor["agents_md"] = False
if changed:
    with open(cfg, "w") as f:
        yaml.safe_dump(data, f, default_flow_style=False, sort_keys=False)
PY
    env -u OPENAI_API_KEY -u GEMINI_API_KEY -u OPENROUTER_API_KEY \
      nice -n 19 "$repowise_bin" update --index-only --no-workspace --no-agents "$path"
  else
    env -u OPENAI_API_KEY -u GEMINI_API_KEY -u OPENROUTER_API_KEY \
      nice -n 19 "$repowise_bin" init --no-workspace --no-prose --no-editor-setup --no-claude-md -y "$path"
  fi

  ma1="$(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo)"
  sf1="$(awk '/^SwapFree:/ {print int($2/1024)}' /proc/meminfo)"
  t0="$(date +%s)"
  nice -n 19 "$cbm_bin" cli index_repository --repo-path "$path" --mode moderate || { rc=$?; exit "$rc"; }
  t1="$(date +%s)"
  ma2="$(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo)"
  sf2="$(awk '/^SwapFree:/ {print int($2/1024)}' /proc/meminfo)"

  mem_min=$(( ma1 < ma2 ? ma1 : ma2 ))
  swap_min=$(( sf1 < sf2 ? sf1 : sf2 ))
  sec=$(( t1 - t0 ))

  if [ -d "$path/.git" ]; then
    printf '%s hook=ok cbm=ok repowise=ok exclude=ok sec=%s mem_min=%s swap_free_min=%s\n' \
      "$base" "$sec" "$mem_min" "$swap_min"
  else
    printf '%s hook=none cbm=ok repowise=ok exclude=none sec=%s mem_min=%s swap_free_min=%s\n' \
      "$base" "$sec" "$mem_min" "$swap_min"
  fi
}

exec 9>"$CME_LOCK"
flock 9

if [ ! -d "$path" ]; then
  echo "code-memory-enable: not a directory: $path" >&2
  exit 2
fi

if [ "$path" = "$CME_PROJECTS_ROOT" ] && [ "$untrack" -eq 0 ]; then
  GIT_DIR_PROJECTS=$(. "$CME_TOOLS_ROOT/bin/git-auto-lib"; GA_PROJECTS="$path" ga_projects_gitdir)
  if [ -n "$CME_PARENT_REV" ]; then
    changed="$(git --git-dir="$GIT_DIR_PROJECTS" --work-tree="$path" diff-tree --no-commit-id --name-only -r -m --first-parent "$CME_PARENT_REV")"
  else
    changed="$(git --git-dir="$GIT_DIR_PROJECTS" --work-tree="$path" diff --name-only "HEAD@{1}" HEAD 2>/dev/null)" \
      || changed="$(git --git-dir="$GIT_DIR_PROJECTS" --work-tree="$path" diff-tree --no-commit-id --name-only -r -m --first-parent HEAD)"
  fi
  clients="$(printf '%s\n' "$changed" | sed -n 's#^clients/\([^/]*\)/.*$#\1#p' | sort -u)"
  for x in $clients; do
    if [ ! -f "$CME_CLIENTS_ROOT/$x/.repowise/state.json" ]; then continue; fi
    if [ -d "$CME_CLIENTS_ROOT/$x/.git" ]; then continue; fi
    if [ -f "$CME_DENY" ] && grep -xq "$x" "$CME_DENY"; then continue; fi
    path="$CME_CLIENTS_ROOT/$x"
    base="$x"
    ( run_enable ) || echo "$x failed rc=$?"
  done
  exit 0
fi

if [ "$(dirname "$path")" != "$CME_PROJECTS_ROOT" ] && [ "$(dirname "$path")" != "$CME_CLIENTS_ROOT" ] && [ "$path" != "$CME_TOOLS_ROOT" ]; then
  echo "skip: $path"
  exit 2
fi
if [ -f "$CME_DENY" ] && grep -xq "$base" "$CME_DENY"; then
  echo "skip: denied"
  exit 2
fi
if [ ! -d "$path/.git" ]; then
  if [ "$(dirname "$path")" != "$CME_CLIENTS_ROOT" ] || [ ! -f "$path/.repowise/state.json" ]; then
    echo "code-memory-enable: not a git worktree (no .git): $path" >&2
    exit 2
  fi
fi
case "$path" in
  *hh-scoring*) echo "code-memory-enable: blocklisted path: $path" >&2; exit 2 ;;
esac
[ "$path" = "/root/workspaces/projects" ] && { echo "code-memory-enable: forbidden path: $path" >&2; exit 2; }

if [ "$untrack" -eq 1 ]; then
  if [ ! -d "$path/.git" ]; then
    echo "$base untrack=skip no-.git"
    exit 0
  fi
  if ! git -C "$path" diff --cached --quiet; then
    echo "$base untrack=skip staged"
    exit 0
  fi
fi

run_enable

if [ "$untrack" -eq 1 ]; then
  git -C "$path" rm -r -q --cached --ignore-unmatch .repowise
  for f in .claude/CLAUDE.md; do
    if [ -f "$path/$f" ] && git -C "$path" ls-files --error-unmatch "$f" >/dev/null 2>&1; then
      git -C "$path" add -- "$f"
    fi
  done
  if git -C "$path" diff --cached --quiet; then
    untrack="clean"
  else
    git -C "$path" commit -q -m "chore(code-memory): untrack regenerable .repowise, sync .claude/CLAUDE.md (spec:086)"
    untrack="committed"
  fi
  printf '%s untrack=%s\n' "$base" "$untrack"
fi
