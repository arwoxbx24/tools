default_case() {
  local name=$1 want=$2 cwd=$3 cmd=$4 agent=${5:-} out rc dec
  out=$(jq -cn --arg cwd "$cwd" --arg cmd "$cmd" \
    '{hook_event_name:"PreToolUse",cwd:$cwd,tool_name:"Bash",tool_input:{command:$cmd}}' \
    | jq -c --arg a "$agent" 'if $a == "" then . else .agent_id = $a end' \
    | env -u LEAD_HINT_STRICT CODE_CHANNEL="$d/code-channel" HELPER_SHARE="$d/helper-share" "$dir/lead-hint"); rc=$?
  dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
  if [[ $rc == 0 && $want == deny && $dec == deny ]] || [[ $rc == 0 && $want == allow && -z $out ]]; then
    echo "PASS $name"; ok=$((ok+1))
  else
    echo "FAIL $name: rc=$rc out=$out"
  fi
}
default_case lead_default_git_status_allowed allow /root 'git status'
default_case lead_default_git_switch_denied deny /root 'git switch -c x'
default_case lead_default_tmp_script_denied deny /root 'bash /tmp/exp.txt'
default_case worker_default_tmp_script_allowed allow /root 'bash /tmp/exp.txt' sub

if [[ $ok == $total ]]; then
  echo "lead-hint-test: PASS $ok/$total"
  exit 0
fi
echo "lead-hint-test: FAIL $ok/$total"
exit 1
