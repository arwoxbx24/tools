  set -- $ca
  out=$(mk_pre_cwd "$tx_lock" /root/workspaces/projects Edit "{\"file_path\":\"$1\"}" \
    | jq -c '.agent_id="a1" | .agent_type="general-purpose"' | run_hook)
  dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
  reason=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
  if [[ $2 == deny && $dec == deny && $reason == "$reason_lock" ]] || [[ $2 == allow && -z $out ]]; then
    ca_ok=$((ca_ok+1))
  else
    ca_fail=$((ca_fail+1))
  fi
done
