{ mk_user; for _ in $(seq 8); do mk_read; done; } >"$tx_json"
out=$(mk_pre "$tx_json" Read '{"file_path":"/tmp/x/a.json"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 74: t_count_json_read Read a.json counted -> deny'; ok=$((ok+1))
else
  echo "FAIL 74: json read not counted rc=$rc out=$out"
fi

