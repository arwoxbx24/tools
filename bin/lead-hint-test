tx_lock=$d/txlock.jsonl
{ mk_user; printf '%s\n' '{"type":"user","isMeta":true,"message":{"role":"user","content":"A session-scoped Stop hook is now active with condition: \"test\". ..."}}'; } >"$tx_lock"
reason_lock='lead-hint code-lock (owner 24.10): the lead session (any cwd under /root) edits only .md/.txt; send code and config to /root/workspaces/tools/bin/code-channel auto <worktree> <TZ>'
codelock_case() {
  local num=$1 label=$2 want=$3 cwd=$4 name=$5 input=$6 agent=${7:-} want_reason=${8:-$reason_lock} out rc dec reason
  out=$(mk_pre_cwd "$tx_lock" "$cwd" "$name" "$input" \
    | jq -c --arg a "$agent" 'if $a == "" then . else .agent_id = $a end' | run_hook); rc=$?
  dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
  reason=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
  if [[ $want == deny ]]; then
    if [[ $rc == 0 && $dec == deny && $reason == "$want_reason" ]]; then
      echo "PASS $num: $label"; ok=$((ok+1)); return
    fi
  elif [[ $rc == 0 && -z $out ]]; then
    echo "PASS $num: $label"; ok=$((ok+1)); return
  fi
  echo "FAIL $num: rc=$rc out=$out"
}

