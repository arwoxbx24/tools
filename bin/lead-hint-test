reason_runlock='lead-run-lock (owner 24.10): the lead does not run scripts; route: /root/workspaces/tools/bin/code-channel auto|audit <worktree> <TZ>'
runlock_case() {
  local num=$1 label=$2 want=$3 cwd=$4 name=$5 input=$6 out rc dec reason
  out=$(mk_pre_cwd "$tx_lock" "$cwd" "$name" "$input" | run_hook); rc=$?
  dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
  reason=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
  if [[ $want == deny ]]; then
    if [[ $rc == 0 && $dec == deny && $reason == "$reason_runlock" ]]; then
      echo "PASS $num: $label"; ok=$((ok+1)); return
    fi
  elif [[ $rc == 0 && -z $out ]]; then
    echo "PASS $num: $label"; ok=$((ok+1)); return
  fi
  echo "FAIL $num: rc=$rc out=$out"
}
runlock_case 72 't_runlock_deny_sh: Bash sh /tmp/u42/p.sh -> deny' deny \
  /root/workspaces/projects Bash '{"command":"sh /tmp/u42/p.sh"}'
runlock_case 73 't_runlock_allow_jq: Bash jq -n 1+1 -> allow' allow \
  /root/workspaces/projects Bash '{"command":"jq -n 1+1"}'

