{ mk_user; for _ in $(seq 8); do mk_bash 'gh pr merge 1 --merge'; done; } >"$tx32"
out=$(mk_pre "$tx32" Bash '{"command":"gh pr merge 1 --merge"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
