#!/usr/bin/env bash
set -u

dir=$(cd -- "$(dirname -- "$0")" && pwd)
d=$(mktemp -d /tmp/lead-hint-test.XXXXXX)
trap 'rm -rf "$d"' EXIT
ok=0
total=74
crdir=/tmp/lead-hint-stop
srun="lh-$$-$RANDOM"
clean_sid() { rm -f "$crdir/$1"; }

cat > "$d/code-channel" <<'STUB'
#!/usr/bin/env bash
[[ ${1:-} == --plan ]] || exit 1
echo 'stub-channel - audit=stub'
echo 'second line ignored'
STUB
chmod 755 "$d/code-channel"

cat > "$d/helper-share" <<'STUB'
#!/usr/bin/env bash
[[ ${1:-} == --session && -n ${2:-} ]] || exit 1
echo 'helper-share: 50% helpers=1 lead=1'
STUB
chmod 755 "$d/helper-share"

mk_read() {
  jq -cn '{type:"assistant",isSidechain:false,message:{content:[{type:"tool_use",name:"Read",input:{file_path:"/tmp/x"}}]}}'
}
mk_read_path() {
  jq -cn --arg p "$1" '{type:"assistant",isSidechain:false,message:{content:[{type:"tool_use",name:"Read",input:{file_path:$p}}]}}'
}
mk_user() {
  jq -cn '{type:"user",message:{content:"owner message"}}'
}
mk_attach() {
  jq -cn '{type:"attachment",attachment:{humanTurn:true,prompt:"owner message",origin:{kind:"human"}}}'
}
mk_notice() {
  jq -cn '{type:"user",origin:{kind:"task-notification"},message:{content:"task finished"}}'
}
mk_notify() {
  jq -cn '{type:"user",origin:{kind:"task-notification"},message:{content:"<task-notification>\n<status>completed</status>\n</task-notification>"}}'
}
mk_killed() {
  jq -cn '{type:"user",origin:{kind:"task-notification"},message:{content:"<task-notification>\n<status>killed</status>\n</task-notification>"}}'
}
mk_bash() {
  jq -cn --arg c "$1" '{type:"assistant",isSidechain:false,message:{content:[{type:"tool_use",name:"Bash",input:{command:$c}}]}}'
}
mk_bash2() {
  jq -cn --arg c1 "$1" --arg c2 "$2" '{type:"assistant",isSidechain:false,message:{content:[{type:"tool_use",name:"Bash",input:{command:$c1}},{type:"tool_use",name:"Bash",input:{command:$c2}}]}}'
}
mk_pre() {
  jq -cn --arg tp "$1" --arg name "$2" --argjson input "$3" \
    '{hook_event_name:"PreToolUse",transcript_path:$tp,tool_name:$name,tool_input:$input}'
}
mk_pre_cwd() {
  jq -cn --arg tp "$1" --arg cwd "$2" --arg name "$3" --argjson input "$4" \
    '{hook_event_name:"PreToolUse",transcript_path:$tp,cwd:$cwd,tool_name:$name,tool_input:$input}'
}
mk_text() {
  jq -cn --arg t "$1" '{type:"assistant",isSidechain:false,message:{content:[{type:"text",text:$t}]}}'
}
mk_stop() {
  jq -cn --arg tp "$1" --arg sid "${2:-}" \
    '{hook_event_name:"Stop",transcript_path:$tp} + (if $sid == "" then {} else {session_id:$sid} end)'
}
run_hook() {
  CODE_CHANNEL="$d/code-channel" HELPER_SHARE="$d/helper-share" "$dir/lead-hint"
}
ctx_of() {
  jq -r '.hookSpecificOutput.additionalContext // empty' <<<"$1" 2>/dev/null
}
event_of() {
  jq -r '.hookSpecificOutput.hookEventName // empty' <<<"$1" 2>/dev/null
}

tx1=$d/tx1.jsonl
{ mk_user; for _ in $(seq 9); do mk_read; done; } >"$tx1"
out=$(jq -cn --arg tp "$tx1" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
ctx=$(ctx_of "$out"); ev=$(event_of "$out")
if [[ $rc == 0 && $ev == PostToolUse && $ctx == 'lead-hint: 8 of 8 counted calls used since the owner message or last helper run; call 9 will be denied — start the helper (code-channel audit|auto) now.' ]]; then
  echo 'PASS 1: PostToolUse 9 Reads -> hint'; ok=$((ok+1))
else
  echo "FAIL 1: rc=$rc out=$out"
fi

out=$(jq -cn --arg tp "$tx1" '{hook_event_name:"PostToolUse",transcript_path:$tp,agent_id:"x"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 2: agent_id present -> empty'; ok=$((ok+1))
else
  echo "FAIL 2: rc=$rc out=$out"
fi

tx3=$d/tx3.jsonl
{ mk_user; for _ in $(seq 7); do mk_read; done; } >"$tx3"
out=$(jq -cn --arg tp "$tx3" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
ctx=$(ctx_of "$out"); ev=$(event_of "$out")
if [[ $rc == 0 && $ev == PostToolUse && $ctx == 'lead-hint: 7 of 8 counted calls used since the owner message or last helper run; call 9 will be denied — start the helper (code-channel audit|auto) now.' ]]; then
  echo 'PASS 3: PostToolUse 7 Reads -> hint 7 of 8'; ok=$((ok+1))
else
  echo "FAIL 3: rc=$rc out=$out"
fi

tx4=$d/tx4.jsonl
{ for _ in $(seq 8); do mk_read; done; mk_user; mk_read; mk_read; } >"$tx4"
out=$(jq -cn --arg tp "$tx4" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 4: old-turn Reads not counted -> empty'; ok=$((ok+1))
else
  echo "FAIL 4: rc=$rc out=$out"
fi

out=$(jq -cn --arg tp "$tx1" '{hook_event_name:"UserPromptSubmit",transcript_path:$tp}' | run_hook); rc=$?
ctx=$(ctx_of "$out"); ev=$(event_of "$out")
if [[ $rc == 0 && $ev == UserPromptSubmit && $ctx == 'helper-share: 50% helpers=1 lead=1' ]]; then
  echo 'PASS 5: UserPromptSubmit -> helper-share line'; ok=$((ok+1))
else
  echo "FAIL 5: rc=$rc out=$out"
fi

help_out=$("$dir/lead-hint" --help); help_rc=$?
if [[ $help_rc == 0 && $help_out == usage:* ]]; then
  echo 'PASS 6: --help rc 0'; ok=$((ok+1))
else
  echo "FAIL 6: rc=$help_rc out=$help_out"
fi

tx7=$d/tx7.jsonl
{ mk_attach; for _ in $(seq 9); do mk_read; done; mk_notice; } >"$tx7"
out=$(jq -cn --arg tp "$tx7" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
ctx=$(ctx_of "$out"); ev=$(event_of "$out")
if [[ $rc == 0 && $ev == PostToolUse && $ctx == 'lead-hint: 8 of 8 counted calls used since the owner message or last helper run; call 9 will be denied — start the helper (code-channel audit|auto) now.' ]]; then
  echo 'PASS 7: attachment owner + 9 Reads -> hint'; ok=$((ok+1))
else
  echo "FAIL 7: rc=$rc out=$out"
fi

reason_deny='lead-strict: 9 own investigative calls since the owner message or last helper run (limit 8). Write a TZ file and run /root/workspaces/tools/bin/code-channel audit|auto <project> <tz.md> in the background; after the helper run you may check its result.'
out=$(mk_pre "$tx1" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
ev=$(event_of "$out")
reason=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $ev == PreToolUse && $dec == deny && $reason == "$reason_deny" ]]; then
  echo 'PASS 8: PreToolUse 9 Reads -> deny'; ok=$((ok+1))
else
  echo "FAIL 8: rc=$rc out=$out"
fi

tx9=$d/tx9.jsonl
{ mk_user; for _ in $(seq 9); do mk_read; done; mk_bash 'bin/code-channel audit proj tz.md'; mk_read; } >"$tx9"
out=$(mk_pre "$tx9" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 9: helper run resets count -> empty'; ok=$((ok+1))
else
  echo "FAIL 9: rc=$rc out=$out"
fi

out=$(mk_pre "$tx1" Read '{"file_path":"/tmp/x"}' | jq -c '.agent_id="x"' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 10: PreToolUse agent_id -> empty'; ok=$((ok+1))
else
  echo "FAIL 10: rc=$rc out=$out"
fi

out=$(mk_pre "$tx1" Read '{"file_path":"/tmp/x"}' | CODE_CHANNEL="$d/code-channel" HELPER_SHARE="$d/helper-share" LEAD_HINT_STRICT=0 "$dir/lead-hint"); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 11: LEAD_HINT_STRICT=0 -> empty'; ok=$((ok+1))
else
  echo "FAIL 11: rc=$rc out=$out"
fi

out=$(mk_pre "$tx1" Bash '{"command":"git status"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 12: PreToolUse Bash git status -> empty'; ok=$((ok+1))
else
  echo "FAIL 12: rc=$rc out=$out"
fi

tx13=$d/tx13.jsonl
{ mk_user; mk_text 'Ответьте одним словом: Закрывай / Стоп'; } >"$tx13"
reason_stop='lead-strict: the owner is not a developer and gave a standing order: no questions, no choices, no delegation to the owner (24.10). Make the decision yourself, record a one-line ADR in bd, do the step (bd/git/gh/safe-delete are your own sanctioned steps, never a reason to stop) and continue to the goal. Only a physical step (login, key) may be handed to the owner.'
sid13="$srun-13"; clean_sid "$sid13"
out=$(mk_stop "$tx13" "$sid13" | run_hook); rc=$?
dec=$(jq -r '.decision // empty' <<<"$out" 2>/dev/null)
reason=$(jq -r '.reason // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == block && $reason == "$reason_stop" ]]; then
  echo 'PASS 13: Stop owner question -> block'; ok=$((ok+1))
else
  echo "FAIL 13: rc=$rc out=$out"
fi

sid14="$srun-14"; clean_sid "$sid14"
out=$(mk_stop "$tx13" "$sid14" | jq -c '.stop_hook_active=true' | run_hook); rc=$?
dec=$(jq -r '.decision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == block ]]; then
  echo 'PASS 14: Stop stop_hook_active question -> block'; ok=$((ok+1))
else
  echo "FAIL 14: rc=$rc out=$out"
fi

tx15=$d/tx15.jsonl
{ mk_user; mk_text 'DONE: PR 5 MERGED'; } >"$tx15"
sid15="$srun-15"; clean_sid "$sid15"
out=$(mk_stop "$tx15" "$sid15" | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 15: Stop DONE text -> empty'; ok=$((ok+1))
else
  echo "FAIL 15: rc=$rc out=$out"
fi

sid16="$srun-16"; clean_sid "$sid16"
out=$(mk_stop "$tx13" "$sid16" | jq -c '.agent_id="x"' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 16: Stop agent_id -> empty'; ok=$((ok+1))
else
  echo "FAIL 16: rc=$rc out=$out"
fi

sid17="$srun-17"; clean_sid "$sid17"
blocks=0
for _ in 1 2 3; do
  out=$(mk_stop "$tx13" "$sid17" | jq -c '.stop_hook_active=true' | run_hook)
  dec=$(jq -r '.decision // empty' <<<"$out" 2>/dev/null)
  [[ $dec == block ]] && blocks=$((blocks+1))
done
if [[ $blocks == 3 ]]; then
  echo 'PASS 17: repeated stop_hook_active 1-3 -> block'; ok=$((ok+1))
else
  echo "FAIL 17: blocks=$blocks"
fi

out=$(mk_stop "$tx13" "$sid17" | jq -c '.stop_hook_active=true' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 18: repeated stop_hook_active 4th -> empty'; ok=$((ok+1))
else
  echo "FAIL 18: rc=$rc out=$out"
fi

tx19=$d/tx19.jsonl
{ mk_user; mk_text 'PR готов. Сливать PR?'; } >"$tx19"
sid19="$srun-19"; clean_sid "$sid19"
out=$(mk_stop "$tx19" "$sid19" | run_hook); rc=$?
dec=$(jq -r '.decision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == block ]]; then
  echo 'PASS 19: last line question -> block'; ok=$((ok+1))
else
  echo "FAIL 19: rc=$rc out=$out"
fi

tx20=$d/tx20.jsonl
{ mk_user; mk_text $'Is this ok?\nDONE'; } >"$tx20"
sid20="$srun-20"; clean_sid "$sid20"
out=$(mk_stop "$tx20" "$sid20" | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 20: question in middle line -> empty'; ok=$((ok+1))
else
  echo "FAIL 20: rc=$rc out=$out"
fi

big=$d/big.jsonl
pad=$(printf '%*s' 100000 '' | tr ' ' 'x')
{
  for _ in $(seq 190); do
    printf '{"type":"assistant","isSidechain":false,"message":{"content":[{"type":"text","text":"%s"}]}}\n' "$pad"
  done
  mk_user
  for _ in $(seq 9); do mk_read; done
  mk_text 'DONE: PR 5 MERGED'
} >"$big"
big_bytes=$(wc -c <"$big")
perf_max=0
time_run() {
  local name=$1 payload=$2 t0 t1 ms
  t0=$(date +%s%N)
  printf '%s' "$payload" | run_hook >/dev/null 2>&1
  t1=$(date +%s%N)
  ms=$(( (t1 - t0) / 1000000 ))
  printf 'perf %s: %d ms (transcript %d bytes)\n' "$name" "$ms" "$big_bytes"
  (( ms > perf_max )) && perf_max=$ms
  return 0
}
time_run PreToolUse "$(mk_pre "$big" Read '{"file_path":"/tmp/x"}')"
time_run PostToolUse "$(jq -cn --arg tp "$big" '{hook_event_name:"PostToolUse",transcript_path:$tp}')"
time_run Stop "$(mk_stop "$big")"
if (( perf_max <= 500 )); then
  echo 'PASS 21: perf all events <= 500 ms'; ok=$((ok+1))
else
  echo "FAIL 21: perf max ${perf_max} ms"
fi

tx22=$d/tx22.jsonl
{ mk_user; mk_text $'ИТОГ: замок работает.\nAC3: текст `Ответьте одним словом: Закрывай / Стоп` → block=1\nВладелец подтвердил цель.\n✅ DONE'; } >"$tx22"
sid22="$srun-22"; clean_sid "$sid22"
out=$(mk_stop "$tx22" "$sid22" | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 22: Stop phrase quoted in backticks -> empty'; ok=$((ok+1))
else
  echo "FAIL 22: rc=$rc out=$out"
fi

tx23=$d/tx23.jsonl
{ mk_user; mk_text $'Отчёт: правило запрещает «ответьте одним словом».\nDONE'; } >"$tx23"
sid23="$srun-23"; clean_sid "$sid23"
out=$(mk_stop "$tx23" "$sid23" | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 23: Stop phrase inside «…» -> empty'; ok=$((ok+1))
else
  echo "FAIL 23: rc=$rc out=$out"
fi

sid24="$srun-24"; clean_sid "$sid24"
out=$(mk_stop "$tx13" "$sid24" | run_hook); rc=$?
dec=$(jq -r '.decision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == block ]]; then
  echo 'PASS 24: Stop plain owner phrase -> block'; ok=$((ok+1))
else
  echo "FAIL 24: rc=$rc out=$out"
fi

tx25=$d/tx25.jsonl
{ mk_user; mk_text $'Отчёт готов.\n`a?`'; } >"$tx25"
sid25="$srun-25"; clean_sid "$sid25"
out=$(mk_stop "$tx25" "$sid25" | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 25: Stop question only inside code -> empty'; ok=$((ok+1))
else
  echo "FAIL 25: rc=$rc out=$out"
fi

tx_doc=$d/txdoc.jsonl
{ mk_user; } >"$tx_doc"
reason_code='lead-strict: the main agent does not read code (owner 24.10: 2% — specs, TZ, tasks only); route: code-channel audit'
out=$(mk_pre "$tx_doc" Read '{"file_path":"/tmp/a.py"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
reason=$(jq -r '.hookSpecificOutput.permissionDecisionReason // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny && $reason == "$reason_code" ]]; then
  echo 'PASS 26: main Read .py -> deny'; ok=$((ok+1))
else
  echo "FAIL 26: rc=$rc out=$out"
fi

out=$(mk_pre "$tx_doc" Read '{"file_path":"/tmp/a.py"}' | jq -c '.agent_id="x"' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 27: helper Read .py -> empty'; ok=$((ok+1))
else
  echo "FAIL 27: rc=$rc out=$out"
fi

out=$(mk_pre "$tx_doc" Read '{"file_path":"/tmp/notes.md"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 28: main Read .md -> no deny'; ok=$((ok+1))
else
  echo "FAIL 28: rc=$rc out=$out"
fi

tx_md=$d/txmd.jsonl
{ mk_user; for _ in $(seq 9); do mk_read_path /tmp/notes.md; done; } >"$tx_md"
out=$(jq -cn --arg tp "$tx_md" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 29: 9 doc Reads not counted -> empty'; ok=$((ok+1))
else
  echo "FAIL 29: rc=$rc out=$out"
fi

tx30=$d/tx30.jsonl
{ mk_user; for _ in $(seq 8); do mk_read; done; } >"$tx30"
out=$(mk_pre "$tx30" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 30: 9th counted call -> deny'; ok=$((ok+1))
else
  echo "FAIL 30: rc=$rc out=$out"
fi

tx31=$d/tx31.jsonl
{ mk_user; for _ in $(seq 7); do mk_read; done; } >"$tx31"
out=$(mk_pre "$tx31" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 31: 8th counted call -> allow'; ok=$((ok+1))
else
  echo "FAIL 31: rc=$rc out=$out"
fi

tx32=$d/tx32.jsonl
{ mk_user; for _ in $(seq 8); do mk_bash 'gh pr merge 1 --merge'; done; } >"$tx32"
out=$(mk_pre "$tx32" Bash '{"command":"gh pr merge 1 --merge"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 32: Bash gh counted -> deny'; ok=$((ok+1))
else
  echo "FAIL 32: rc=$rc out=$out"
fi

tx33=$d/tx33.jsonl
{ mk_user; for _ in $(seq 4); do mk_bash 'bd show x'; done; } >"$tx33"
out=$(mk_pre "$tx33" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 33: Bash bd not counted -> empty'; ok=$((ok+1))
else
  echo "FAIL 33: rc=$rc out=$out"
fi

tx34=$d/tx34.jsonl
{ mk_user; for _ in $(seq 5); do mk_read; done; mk_notify; mk_read; } >"$tx34"
out=$(mk_pre "$tx34" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 34: completed task-notification resets count -> empty'; ok=$((ok+1))
else
  echo "FAIL 34: rc=$rc out=$out"
fi

tx35=$d/tx35.jsonl
{ mk_user; for _ in $(seq 9); do mk_read; done; } >"$tx35"
out=$(mk_pre "$tx35" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 35: no notification -> deny stays'; ok=$((ok+1))
else
  echo "FAIL 35: rc=$rc out=$out"
fi

tx36=$d/tx36.jsonl
{ mk_user; for _ in $(seq 9); do mk_read; done; \
  mk_text $'<task-notification>\n<status>completed</status>\n</task-notification>'; } >"$tx36"
out=$(mk_pre "$tx36" Read '{"file_path":"/tmp/x"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 36: notification text in assistant message does not reset -> deny'; ok=$((ok+1))
else
  echo "FAIL 36: rc=$rc out=$out"
fi

tx37=$d/tx37.jsonl
{ mk_user; for _ in $(seq 4); do mk_read; done; } >"$tx37"
out=$(mk_pre "$tx37" Bash '{"command":"gh pr view 386 --json state"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 37: read-only gh pr view exempt -> empty'; ok=$((ok+1))
else
  echo "FAIL 37: rc=$rc out=$out"
fi

tx38=$d/tx38.jsonl
{ mk_user; for _ in $(seq 8); do mk_read; done; } >"$tx38"
out=$(mk_pre "$tx38" Bash '{"command":"gh pr merge 1 --merge"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 38: counted gh pr merge after 8 -> deny'; ok=$((ok+1))
else
  echo "FAIL 38: rc=$rc out=$out"
fi

tx39=$d/tx39.jsonl
{ mk_user; for _ in $(seq 7); do mk_bash 'rg foo'; done; } >"$tx39"
out=$(jq -cn --arg tp "$tx39" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
ctx=$(ctx_of "$out"); ev=$(event_of "$out")
if [[ $rc == 0 && $ev == PostToolUse && $ctx == *"7 of 8"* ]]; then
  echo 'PASS 39: PostToolUse 7 counted -> hint 7 of 8'; ok=$((ok+1))
else
  echo "FAIL 39: rc=$rc out=$out"
fi

tx40=$d/tx40.jsonl
{ mk_user; for _ in $(seq 2); do mk_read; done; } >"$tx40"
out=$(jq -cn --arg tp "$tx40" '{hook_event_name:"PostToolUse",transcript_path:$tp}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 40: PostToolUse 2 counted -> empty'; ok=$((ok+1))
else
  echo "FAIL 40: rc=$rc out=$out"
fi

tx41=$d/tx41.jsonl
{ mk_user; for _ in $(seq 8); do mk_bash 'gh pr view 1 && gh pr merge 1 --merge'; done; } >"$tx41"
out=$(mk_pre "$tx41" Bash '{"command":"gh pr view 1 && gh pr merge 1 --merge"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 41: gh view && gh merge counted -> deny'; ok=$((ok+1))
else
  echo "FAIL 41: rc=$rc out=$out"
fi

tx42=$d/tx42.jsonl
{ mk_user; for _ in $(seq 8); do mk_bash 'gh pr view 1; gh pr merge 1'; done; } >"$tx42"
out=$(mk_pre "$tx42" Bash '{"command":"gh pr view 1; gh pr merge 1"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 42: gh view ; gh merge counted -> deny'; ok=$((ok+1))
else
  echo "FAIL 42: rc=$rc out=$out"
fi

tx43=$d/tx43.jsonl
{ mk_user; for _ in $(seq 4); do mk_bash 'gh pr view 1'; done; } >"$tx43"
out=$(mk_pre "$tx43" Bash '{"command":"gh pr view 1"}' | run_hook); rc=$?
if [[ $rc == 0 && -z $out ]]; then
  echo 'PASS 43: plain gh pr view not counted -> empty'; ok=$((ok+1))
else
  echo "FAIL 43: rc=$rc out=$out"
fi

tx44=$d/tx44.jsonl
