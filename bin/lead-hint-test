fi

tx42=$d/tx42.jsonl
{ mk_user; for _ in $(seq 8); do mk_bash 'gh pr view 1; gh pr merge 1'; done; } >"$tx42"
out=$(mk_pre "$tx42" Bash '{"command":"gh pr view 1; gh pr merge 1"}' | run_hook); rc=$?
dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
if [[ $rc == 0 && $dec == deny ]]; then
  echo 'PASS 42: gh view ; gh merge counted -> deny'; ok=$((ok+1))
else
  echo "FAIL 42: rc=$rc out=$out"
fi

