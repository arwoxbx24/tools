hard_case() {
  local num=$1 label=$2 want=$3 cmd=$4 bg=${5:-false} cwd=${6:-/root/workspaces/projects}
  local out rc dec
  out=$(jq -cn --arg cwd "$cwd" --arg cmd "$cmd" --arg bg "$bg" \
    '{hook_event_name:"PreToolUse",cwd:$cwd,tool_name:"Bash",tool_input:{command:$cmd,run_in_background:($bg=="true")}}' \
    | run_hook); rc=$?
  dec=$(jq -r '.hookSpecificOutput.permissionDecision // empty' <<<"$out" 2>/dev/null)
  if [[ $want == deny ]]; then
    if [[ $rc == 0 && $dec == deny ]]; then
      echo "PASS $num: $label"; ok=$((ok+1)); return
    fi
  elif [[ $rc == 0 && -z $out ]]; then
    echo "PASS $num: $label"; ok=$((ok+1)); return
  fi
  echo "FAIL $num: rc=$rc out=$out"
}

