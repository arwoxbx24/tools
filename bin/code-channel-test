  env OPENCODE_RC=124 SQLITE_SESSION_ID=session-123 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
CC_CONFIG=$goaudit check go_model_override_ok '[[ $rc == 0 ]] && grep -Fq -- "-m opencode-go/mimo-v2.6-flash" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz" --model opencode-go/mimo-v2.6-flash
CC_CONFIG=$go check go_stdin_prompt_file '[[ $rc == 0 ]] && grep -Eq -- "^stdin=.*code-channel-prompt-" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
CC_CONFIG=$ocfg check opencode_config_env '[[ $rc == 0 ]] && grep -Fxq -- "env OPENCODE_CONFIG=$root/config/opencode-channel.json" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
lock=$tmp/state/worktree.$(printf '%s\n' "$project" | sha1sum | cut -c-16).lock
exec 8>"$lock"
flock -n 8
CC_CONFIG=$go check worktree_busy_rc25 '[[ $rc == 25 ]] && grep -Fq -- "worktree занят другим запуском" "$tmp/err" && [[ ! -s $log ]]' \
  "$root/bin/code-channel" go "$project" "$tz"
flock -u 8
