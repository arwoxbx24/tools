printf '%s\n' '{"switch":{"channel":"a","owner_word":"w"},"ladder":[{"id":"a","enabled":true,"model":"x/y","owner_word":"w"},{"id":"b","enabled":false,"model":"x/z"}]}' >"$cg_good"
printf '%s\n' '{"switch":{"channel":"sdk","owner_word":"x"},"ladder":[{"id":"sdk","enabled":true,"model":"x/y","owner_word":"x"}]}' >"$cg_sdk"
out=$(cgrun "$cg_blank" --plan); rc=$?
[[ $rc == 0 && $out == a\ * ]] && ((cg_ok++))
out=$(cgrun "$cg_mis" auto "$project" "$tz"); rc=$?
[[ $rc == 28 && $out == *switch-lock* ]] && ((cg_ok++))
out=$(cgrun "$cg_good" --plan); rc=$?
[[ $rc == 0 && $(wc -l <<<"$out") == 1 && $out == a\ * ]] && ((cg_ok++))
out=$(cgrun "$cg_sdk" delivery "$project" "$tz"); rc=$?
