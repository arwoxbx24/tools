printf '%s\n' 'test' 'Test: /bin/false' >"$tzfail"
CC_CONFIG=$go check tz_test_rc31 '[[ $rc == 31 ]] && grep -Fq -- "test rc=1" "$tmp/err"' \
  env TEST_ONCE_DIR="$tmp/to-fail" OPENCODE_RC=0 OPENCODE_TOUCH=tz-fail.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tzfail"
git -C "$project" clean -fdq

CC_CONFIG=$go check prompt_no_git_commit '[[ $rc == 0 ]] && grep -Fq -- "не делай git add и git commit" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
CC_CONFIG=$go check prompt_repowise '[[ $rc == 0 ]] && grep -Fq -- "только через индекс: repowise" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
CC_CONFIG=$go check prompt_injections '[[ $rc == 0 ]] && grep -Fq -- "Parallelize: when the task has 2 or more independent file sets" "$log" && grep -Fq -- "Не вызывай bd: трекер ведёт оркестратор" "$log" && grep -Fq -- "Scratch and temporary files go to /tmp only" "$log" && grep -Fq -- "Ты уже исполнитель внутри code-channel" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

