  env OPENCODE_RC=0 OPENCODE_TOUCH=.agent-work/added.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
CC_CONFIG=$go check go_final_line 'grep -Eq "^code-channel: mode=code .* model=opencode-go/mimo-v2.6-flash retries=0 precheck=" "$tmp/err"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

