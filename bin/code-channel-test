#!/usr/bin/env bash
set -u

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/cc-test.XXXXXX")
nogit=$(mktemp -d /tmp/cc-nogit.XXXXXX)
trap 'rm -rf -- "$tmp" "$nogit"' EXIT
bin=$tmp/bin project=$tmp/project tz=$tmp/tz log=$tmp/args.log runs=$tmp/runs.jsonl tlog=$tmp/timeout.args permit=$tmp/permit.json
go=$tmp/go.json goaudit=$tmp/goaudit.json goidle=$tmp/goidle.json goalt=$tmp/goalt.json resume=$tmp/resume.json ocfg=$tmp/ocfg.json sdkgo=$tmp/sdkgo.json gosdk=$tmp/gosdk.json
mkdir -p "$bin" "$project" "$tmp/state"
git -C "$project" init -q
git -C "$project" config user.email test@example.invalid
git -C "$project" config user.name test
printf 'base\n' >"$project/base"
printf 'FILE: bin/x\ntest\n' >"$tz"
git -C "$project" add base
git -C "$project" commit -qm init
mkdir -p "$tmp/config/opencode"
printf '%s\n' '{"provider":{"opencode-go":{"options":{"timeout":false}}}}' >"$tmp/config/opencode/opencode.jsonc"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}]}' >"$go"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash","audit_model":"opencode-go/mimo-v2.6-flash"}]}' >"$goaudit"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"resume_idle_limit":3,"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}]}' >"$goidle"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash","alt_models":["opencode-go/deepseek-v4.1-flash"]}]}' >"$goalt"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash","resume_model":"opencode-go/mimo-v2.6-resume"}]}' >"$resume"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}],"opencode_config":"config/opencode-channel.json"}' >"$ocfg"
printf '%s\n' '{"switch":{"channel":"sdk","owner_word":"test"},"ladder":[{"id":"sdk","enabled":true,"model":"claude-haiku-5-5"},{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}]}' >"$sdkgo"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"},{"id":"sdk","enabled":true,"model":"claude-haiku-5-5"}]}' >"$gosdk"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/deepseek-v4.1-flash","resume_model":"opencode-go/deepseek-v4.1-flash","audit_model":"opencode-go/deepseek-v4.1-flash","fallback_model":"opencode-go/deepseek-v4-pro"}]}' >"$tmp/repogo.json"

printf '%s\n' '#!/usr/bin/env bash' 'printf "opencode active=%s %s\\n" "${CODE_CHANNEL_ACTIVE:-}" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "env OPENCODE_CONFIG=%s\\n" "${OPENCODE_CONFIG:-}" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "env OPENCODE_DISABLE_MODELS_FETCH=%s\\n" "${OPENCODE_DISABLE_MODELS_FETCH:-}" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "env OPENCODE_DISABLE_AUTOUPDATE=%s\\n" "${OPENCODE_DISABLE_AUTOUPDATE:-}" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "env OPENCODE_DISABLE_CLAUDE_CODE=%s\\n" "${OPENCODE_DISABLE_CLAUDE_CODE:-}" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "PATH=%s\\n" "$PATH" >>"$CODE_CHANNEL_TEST_LOG"' 'if [[ ${OPENCODE_STDIN_COPY:-} ]]; then cat >"$OPENCODE_STDIN_COPY"; else cat >>"$CODE_CHANNEL_TEST_LOG"; printf "\\n" >>"$CODE_CHANNEL_TEST_LOG"; fi' 'printf "stdin=%s\\n" "$(readlink /proc/$$/fd/0)" >>"$CODE_CHANNEL_TEST_LOG"' '[[ ${OPENCODE_SLEEP:-} ]] && sleep "$OPENCODE_SLEEP"' '[[ ${OPENCODE_OUT:-} ]] && printf "%s\n" "$OPENCODE_OUT"' 'printf "REPORT\\n"' '[[ ${OPENCODE_ERR:-} ]] && printf "%s\n" "$OPENCODE_ERR" >&2' '[[ ${OPENCODE_TOUCH:-} ]] && mkdir -p -- "$(dirname -- "$CODE_CHANNEL_TEST_PROJECT/$OPENCODE_TOUCH")" && printf x >"$CODE_CHANNEL_TEST_PROJECT/$OPENCODE_TOUCH"' 'rc=${OPENCODE_RC:-0}' 'if [[ ${OPENCODE_SEQUENCE:-} ]]; then IFS=, read -ra seq <<<"$OPENCODE_SEQUENCE"; n=$(grep -c "^opencode " "$CODE_CHANNEL_TEST_LOG"); rc=${seq[$((n - 1))]:-$rc}; fi' 'exit "$rc"' >"$bin/opencode"
printf '%s\n' '#!/usr/bin/env bash' 'printf "%s\n" "${CC_CANARY_OUT:-channel-canary: down (stub)}"' 'exit "${CC_CANARY_RC:-0}"' >"$bin/channel-canary-stub"
printf '%s\n' '#!/usr/bin/env bash' 'if [[ $* == *"select id from session"* ]]; then printf "%s\n" "${SQLITE_SESSION_ID:-}"; else printf "%s\n" "${SQLITE_RESULT:-opencode-go|mimo-v2.6-flash}"; fi' >"$bin/sqlite3"
printf '%s\n' '#!/usr/bin/env bash' 'printf "sdk-agent %s\\n" "$*" >>"$CODE_CHANNEL_TEST_LOG"' '[[ ${SDK_TOUCH:-} ]] && printf x >"$CODE_CHANNEL_TEST_PROJECT/$SDK_TOUCH"' '[[ ${SDK_ERR:-} ]] && printf "%s\n" "$SDK_ERR" >&2' 'exit "${SDK_RC:-0}"' >"$bin/sdk-agent-fake"
for f in "$go" "$goaudit" "$goidle" "$goalt" "$resume" "$ocfg" "$sdkgo" "$gosdk" "$tmp/repogo.json"; do
  jq '.ladder |= map(.owner_word = "test")' "$f" >"$f.t" && mv -f -- "$f.t" "$f"
  for fid in $(jq -r '.ladder[].id' "$f"); do
    jq --arg one "$fid" '.ladder |= map(.enabled = (.id == $one) | if .enabled then .owner_word = "test" else . end) | .switch = {channel: $one, owner_word: "test"}' "$f" >"$f.$fid"
  done
done
chmod +x "$bin/opencode" "$bin/sqlite3" "$bin/sdk-agent-fake" "$bin/channel-canary-stub"
export CODE_CHANNEL_CANARY=$bin/channel-canary-stub

ok=0 fails=0
check() {
  local n=$1 want=$2 out err rc ov
  local -a env_args=("TMPDIR=$tmp" "PATH=$bin:$PATH" "XDG_CONFIG_HOME=$tmp/config" "CODE_CHANNEL_TEST_LOG=$log" "CODE_CHANNEL_TEST_PROJECT=$project" "CODE_CHANNEL_STATE=$tmp/state" "CODE_CHANNEL_RUNS_LOG=$runs" "CODE_CHANNEL_PERMIT=$permit" "CC_RETRY_SLEEP=0")
  shift 2
  local cfg=$go one=${CC_ONE:-} a prev=
  [[ ! ${CC_CONFIG+x} ]] || cfg=$CC_CONFIG
  if [[ -z $one ]]; then
    for a in "$@"; do
      if [[ $prev == */code-channel ]]; then
        case $a in go|sdk|auto|audit|delivery|--plan|--help) [[ $a == go || $a == sdk ]] && one=$a;; *) ;; esac
        break
      fi
      prev=$a
    done
  fi
  if [[ -n $cfg ]]; then
    [[ -n $one ]] || one=$(jq -r '[.ladder[] | select(.enabled) | .id][0] // ""' "$cfg")
    [[ ! -f $cfg.$one ]] || cfg=$cfg.$one
    env_args+=("CODE_CHANNEL_CONFIG=$cfg")
  fi
  : >"$log"
  : >"$runs"
  : >"$permit"
  out=$(env -u CODE_CHANNEL_ACTIVE "${env_args[@]}" "$@" 2>"$tmp/err")
  rc=$?; err=$(<"$tmp/err")
  if eval "$want"; then echo "PASS $n"; ((ok++)); else echo "FAIL $n: rc=$rc out=$out err=$err log=$(<"$log") runs=$(<"$runs")"; ((fails++)); fi
}

check audit_go_agent '[[ $rc == 0 && $out == *REPORT* ]] && grep -Fq -- "--agent audit" "$log" && grep -Fq -- "-m opencode-go/mimo-v2.6-flash" "$log"' \
  "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check audit_changes_rc22 '[[ $rc == 22 ]]' env OPENCODE_TOUCH=audit-change "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check usage_bash_n '[[ $rc == 0 ]]' bash -c 'bash -n "$1"' _ "$root/bin/code-channel"
check go_developer_agent '[[ $rc == 0 && $out == *REPORT* ]] && grep -Fq -- "--agent developer" "$log" && ! grep -Fq -- "--agent audit" "$log"' \
  env OPENCODE_TOUCH=go-dev "$root/bin/code-channel" go "$project" "$root/AGENTS.md"
check audit_mode_stderr '[[ $err == *mode=audit* ]]' "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check auto_model_override_rejected '[[ $rc == 3 ]] && [[ ! -s $log ]]' \
  "$root/bin/code-channel" auto "$project" "$root/AGENTS.md" --model x/y
check recursion_rc30 '[[ $rc == 30 && ! -s $log ]]' \
  env CODE_CHANNEL_ACTIVE=1 "$root/bin/code-channel" auto "$project" "$tz"
check project_must_be_absolute '[[ $rc == 3 && $err == *"project must be absolute path"* ]]' \
  "$root/bin/code-channel" auto rel/path "$tz"

check go_no_provider_mismatch '[[ $rc == 0 ]] && [[ $err != *"сверка провайдера не прошла"* ]]' \
