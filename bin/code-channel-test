#!/usr/bin/env bash
set -u

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d "$root/.code-channel-test.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT
bin=$tmp/bin project=$tmp/project secret=$tmp/secret.env log=$tmp/args.log runs=$tmp/runs.jsonl
mkdir -p "$bin" "$project" "$tmp/state"
printf 'VIBECODE_API_KEY=x\nOPENROUTER_API_KEY=x\n' >"$secret"
git -C "$project" init -q
git -C "$project" config user.email test@example.invalid
git -C "$project" config user.name test
printf 'base\n' >"$project/base"
git -C "$project" add base
git -C "$project" commit -qm init
mkdir -p "$tmp/secrets/services"
printf 'OPENROUTER_API_KEY=x\n' >"$tmp/secrets/services/openrouter.env"
mkdir -p "$tmp/bitrix-secrets/services" "$tmp/config/opencode" "$tmp/config-allow/opencode"
printf 'VIBECODE_API_KEY=x\n' >"$tmp/bitrix-secrets/services/vibecode.env"
printf '%s\n' '{"provider":{"bitrixgpt":{"models":{"bitrix/bitrixgpt-5.6-agent":{}}},"openrouter":{"whitelist":["other/model"]}}}' >"$tmp/config/opencode/opencode.jsonc"
printf '%s\n' '{"provider":{"bitrixgpt":{"models":{"bitrix/bitrixgpt-5.6-agent":{}}},"openrouter":{"whitelist":["deepseek/deepseek-v4-flash"]}}}' >"$tmp/config-allow/opencode/opencode.jsonc"

printf '%s\n' '#!/usr/bin/env bash' 'printf "curl %s\\n" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'out=' 'url=${!#}' 'while [[ $# -gt 0 ]]; do' '  [[ $1 == -o ]] && { out=$2; shift 2; continue; }' '  shift' 'done' 'if [[ $url == */key ]]; then' '  if [[ ${CURL_USAGE_DAILY:-0.4} == none ]]; then' '    body="{\"data\":{\"limit_remaining\":${CURL_LIMIT_REMAINING:-1}}}"' '  else' '    body="{\"data\":{\"limit_remaining\":${CURL_LIMIT_REMAINING:-1},\"usage_daily\":${CURL_USAGE_DAILY:-0.4}}}"' '  fi' '  printf "%s\n" "$body" >"$out"' '  printf "%s" "${CURL_KEY_CODE:-${CURL_CODE:-200}}"' 'elif [[ $url == */chat/completions ]]; then' '  printf "%s\n" "insecure api_key=secret token=x authorization=y cookie=z" >"$out"' '  printf "%s" "${CURL_CHAT_CODE:-200}"' 'else' '  printf "%s\n" "{\"data\":[{\"id\":\"bitrix/bitrixgpt-5.6-agent\"},{\"id\":\"deepseek/deepseek-v4-flash\"}]}" >"$out"' '  printf "%s" "${CURL_CODE:-200}"' 'fi' >"$bin/curl"
printf '%s\n' '#!/usr/bin/env bash' 'printf "opencode %s\\n" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "REPORT\\n"' '[[ ${OPENCODE_TOUCH:-} ]] && printf x >"$CODE_CHANNEL_TEST_PROJECT/$OPENCODE_TOUCH"' 'exit "${OPENCODE_RC:-0}"' >"$bin/opencode"
printf '%s\n' '#!/usr/bin/env bash' 'printf "codex %s\\n" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "REPORT\\n"' '[[ ${CODEX_SWITCH_BRANCH:-} ]] && git -C "$CODE_CHANNEL_TEST_PROJECT" switch -c "codex/x-branch"' '[[ ${CODEX_ERR:-} ]] && printf "%s\n" "$CODEX_ERR" >&2' 'exit "${CODEX_RC:-0}"' >"$bin/codex"
printf '%s\n' '#!/usr/bin/env bash' 'printf "%s\n" "${SQLITE_RESULT:-bitrixgpt|bitrix/bitrixgpt-5.6-agent}"' >"$bin/sqlite3"
chmod +x "$bin/curl" "$bin/opencode" "$bin/codex" "$bin/sqlite3"

ok=0
check() {
  local n=$1 want=$2 out err rc ov
  local -a env_args=("TMPDIR=$tmp" "PATH=$bin:$PATH" "XDG_CONFIG_HOME=$tmp/config-allow" "CODE_CHANNEL_TEST_LOG=$log" "CODE_CHANNEL_TEST_PROJECT=$project" "CODE_CHANNEL_STATE=$tmp/state" "CODE_CHANNEL_RUNS_LOG=$runs")
  shift 2
  : >"$log"
  : >"$runs"
  ov=${CC_OVERRIDE-$secret}
  [[ -n $ov ]] && env_args+=("CODE_CHANNEL_SECRET_OVERRIDE=$ov")
  [[ -n ${CC_ROOT:-} ]] && env_args+=("CODE_CHANNEL_SECRETS_ROOT=$CC_ROOT")
  out=$(env "${env_args[@]}" "$@" 2>"$tmp/err")
  rc=$?; err=$(<"$tmp/err")
  if eval "$want"; then echo "PASS $n"; ((ok++)); else echo "FAIL $n: rc=$rc out=$out err=$err log=$(<"$log")"; fi
}

check 1 '[[ $rc == 0 && $out == *REPORT* ]] && grep -Fq -- "--agent audit" "$log"' \
  "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 2 '[[ $rc == 22 ]]' env OPENCODE_TOUCH=audit-change "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 3 '[[ $rc == 0 && $(grep -c -- /models "$log") == 1 ]] && grep -Fq -- /key "$log" && grep -Fq -- "-s read-only" "$log"' \
  env CURL_CODE=401 "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 4 '[[ $rc == 0 ]] && ! grep -Fq -- "--agent" "$log"' \
  env OPENCODE_TOUCH=auto-change "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
check 5 '[[ $err == *mode=audit* ]]' "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 6 'bash -n "$root/bin/code-channel"' bash -c 'bash -n "$1"' _ "$root/bin/code-channel"
CC_OVERRIDE='' CC_ROOT="$tmp/secrets" check 7 '[[ $rc == 0 && $out == *REPORT* ]] && ! grep -Fq -- "нет секрета" "$tmp/err" && grep -Fq -- /key "$log"' \
  env SQLITE_RESULT='openrouter|deepseek/deepseek-v4-flash' "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
CC_OVERRIDE='' CC_ROOT="$tmp/bitrix-secrets" check 8 '[[ $rc == 5 ]] && ! grep -q "^codex " "$log"' \
  env CURL_CODE=401 "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
CC_OVERRIDE='' CC_ROOT="$tmp/secrets" check 9 '[[ $rc == 11 ]] && grep -Fq -- /key "$log"' \
  env CURL_CODE=401 XDG_CONFIG_HOME="$tmp/config-allow" "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
CC_OVERRIDE='' CC_ROOT="$tmp/secrets" check 10 '[[ $rc == 15 ]]' \
  env XDG_CONFIG_HOME="$tmp/config" "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md" --model openrouter/deepseek/deepseek-v4-flash

check 11 '[[ $rc == 0 ]] && grep -q '"'"'provider_actual":"bitrixgpt"'"'"' "$runs" && grep -q '"'"'"rc":0'"'"' "$runs" && grep -Eq '"'"'cc-[0-9]+-[0-9]+'"'"' "$runs"' \
  env SQLITE_RESULT='bitrixgpt|bitrix/bitrixgpt-5.6-agent' "$root/bin/code-channel" 1 "$project" "$root/AGENTS.md"
check 12 '[[ $rc == 23 ]] && grep -Fq -- "сверка провайдера не прошла" "$tmp/err" && grep -q '"'"'provider_actual":"anthropic"'"'"' "$runs"' \
  env SQLITE_RESULT='anthropic|claude-sonnet' "$root/bin/code-channel" 1 "$project" "$root/AGENTS.md"
check 13 '[[ $rc == 12 ]] && [[ $(stat -c %a "$tmp/state/bitrixgpt-last-fail.txt") == 600 ]] && [[ $(grep -ci '"'"'api_key'"'"' "$tmp/state/bitrixgpt-last-fail.txt") == 0 ]]' \
  env CURL_CHAT_CODE=429 "$root/bin/code-channel" 1 "$project" "$root/AGENTS.md"
orig=$(git -C "$project" rev-parse --abbrev-ref HEAD)
check 14 '[[ $rc == 0 ]] && [[ $(git -C "$project" rev-parse --abbrev-ref HEAD) == "$orig" ]] && grep -Fq -- "форма 2 сменила ветку, возвращено" "$tmp/err" && grep -q '"'"'provider_actual":"codex"'"'"' "$runs"' \
  env CODEX_SWITCH_BRANCH=1 CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"

gcd=$(git -C "$project" rev-parse --path-format=absolute --git-common-dir)
check 15 '[[ $rc == 0 ]] && grep -Fq -- "--add-dir '"$gcd"'" "$log" && grep -Fq -- "-c sandbox_workspace_write.network_access=true" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"
check 16 '[[ $rc == 0 ]] && grep -Fq -- "-c sandbox_workspace_write.network_access=true Не вызывай bd: трекер ведёт оркестратор" "$log" && grep -Fq -- "Не создавай и не переключай ветки; пиши и коммить только в текущую ветку" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"
check 17 '[[ $rc == 24 ]] && grep -Fq -- "form=2 среда: read-only" "$tmp/err"' \
  env CODEX_ERR='Read-only file system' CODEX_RC=1 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"

git -C "$project" clean -fdq
check 18 '[[ $rc == 13 && $err == *4.2* && $err == *4* ]] && ! grep -q "opencode" "$log"' \
  env CURL_USAGE_DAILY=4.2 "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
check 19 'grep -Fq -- "codex " "$log" && ! grep -q "opencode" "$log" && [[ $err == *"форма 3 пропущена"* ]]' \
  env CURL_CODE=401 CURL_KEY_CODE=200 CURL_USAGE_DAILY=4.2 "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
check 20 '[[ $rc == 0 ]] && grep -Fq -- /key "$log" && grep -Fq -- "opencode" "$log"' \
  env SQLITE_RESULT='openrouter|deepseek/deepseek-v4-flash' CURL_USAGE_DAILY=0.4 "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
check 21 '[[ $rc == 13 && $err == *"нет usage_daily"* ]]' \
  env CURL_USAGE_DAILY=none "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"

[[ $ok == 21 ]] && echo 'PASS 21/21'
