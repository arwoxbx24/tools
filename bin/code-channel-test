sn_ok=0 sn_i=0
for sw in '' '"switch":null,' '"switch":false,' '"switch":{"channel":"a"},' '"switch":{"channel":"a","owner_word":""},' '"switch":{"channel":"a","owner_word":"  "},' '"switch":{"channel":"b","owner_word":"w"},' '"switch":{"channel":"a","owner_word":"w"},'; do
  ((sn_i++))
  sn_cfg=$tmp/sn-$sn_i.json
  if ((sn_i == 8)); then
    printf '%s\n' "{${sw}\"ladder\":[{\"id\":\"a\",\"enabled\":true,\"model\":\"x/y\",\"owner_word\":\"w\"},{\"id\":\"b\",\"enabled\":true,\"model\":\"x/z\",\"owner_word\":\"w\"}]}" >"$sn_cfg"
  else
    printf '%s\n' "{${sw}\"ladder\":[{\"id\":\"a\",\"enabled\":true,\"model\":\"x/y\",\"owner_word\":\"w\"},{\"id\":\"b\",\"enabled\":false,\"model\":\"x/z\"}]}" >"$sn_cfg"
  fi
  if ((sn_i == 4 || sn_i == 5 || sn_i == 6 || sn_i == 8)); then
    out=$(cgrun "$sn_cfg" --plan); rc=$?
    [[ $rc == 0 && $out == a\ * ]] && ((sn_ok++))
  else
    out=$(cgrun "$sn_cfg" auto "$project" "$tz"); rc=$?
    [[ $rc == 28 && $out == *switch-lock* ]] && ((sn_ok++))
  fi
done
