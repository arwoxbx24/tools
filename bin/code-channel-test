  env OPENCODE_STDIN_COPY="$stdin_audit" SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" audit "$project" "$tzbig"
git -C "$project" clean -fdq
tztest=$tmp/tz-test.sh tztestfile=$tmp/tz-test-file tzcount=$tmp/tz-count
printf '%s\n' '#!/usr/bin/env bash' 'echo TZTEST-RAN' "echo ran >>$tzcount" >"$tztest"
chmod +x "$tztest"
printf '%s\n' 'test' "Test: $tztest" >"$tztestfile"
CC_CONFIG=$go check tz_test_rc0 '[[ $rc == 0 && $(wc -l <"$tzcount") == 1 ]] && grep -Fq -- TZTEST-RAN <<<"$out" && grep -Fq -- "code-channel: test rc=0" "$tmp/err"' \
  env TEST_ONCE_DIR="$tmp/to-state" OPENCODE_RC=0 OPENCODE_TOUCH=tz-touched.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tztestfile"
git -C "$project" clean -fdq
rm -f -- "$tzcount"
CC_CONFIG=$go check tz_test_absent '[[ $rc == 0 && ! -s "$tzcount" ]] && ! grep -Fq -- "code-channel: test rc=" "$tmp/err"' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=tz-none.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
git -C "$project" clean -fdq
rm -f -- "$tzcount"
CC_CONFIG=$go check tz_test_prompt '[[ $rc == 0 ]] && grep -Fq -- "via /root/workspaces/tools/bin/test-once" "$log"' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=tz-prompt.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
