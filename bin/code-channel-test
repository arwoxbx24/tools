printf '3\n%s\n' "$(date +%s)" >"$tmp/to-stall/fail/$pair"
CC_CONFIG=$go check tz_test_rc29 '[[ $rc == 29 ]] && grep -Fq -- "test rc=29" "$tmp/err"' \
  env TEST_ONCE_DIR="$tmp/to-stall" OPENCODE_RC=0 OPENCODE_TOUCH=tz-stall.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tzstall"
git -C "$project" clean -fdq
