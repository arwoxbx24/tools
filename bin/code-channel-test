#!/usr/bin/env bash
set -u

root=$(cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d "$root/.code-channel-test.XXXXXX")
nogit=$(mktemp -d /tmp/cc-nogit.XXXXXX)
trap 'rm -rf -- "$tmp" "$nogit"' EXIT
bin=$tmp/bin project=$tmp/project tz=$tmp/tz secret=$tmp/secret.env log=$tmp/args.log runs=$tmp/runs.jsonl tlog=$tmp/timeout.args
legacy=$tmp/legacy.json disabled=$tmp/disabled.json go=$tmp/go.json ladder=$tmp/ladder.json resume=$tmp/resume.json codexone=$tmp/codexone.json gocodex=$tmp/gocodex.json goaudit=$tmp/goaudit.json ocfg=$tmp/ocfg.json goidle=$tmp/goidle.json goalt=$tmp/goalt.json sdkgo=$tmp/sdkgo.json
mkdir -p "$bin" "$project" "$tmp/state"
printf 'VIBECODE_API_KEY=x\nOPENROUTER_API_KEY=x\n' >"$secret"
git -C "$project" init -q
git -C "$project" config user.email test@example.invalid
git -C "$project" config user.name test
printf 'base\n' >"$project/base"
printf 'test\n' >"$tz"
git -C "$project" add base
git -C "$project" commit -qm init
mkdir -p "$tmp/secrets/services"
printf 'OPENROUTER_API_KEY=x\n' >"$tmp/secrets/services/openrouter.env"
mkdir -p "$tmp/bitrix-secrets/services" "$tmp/config/opencode" "$tmp/config-allow/opencode"
printf 'VIBECODE_API_KEY=x\n' >"$tmp/bitrix-secrets/services/vibecode.env"
printf '%s\n' '{"provider":{"bitrixgpt":{"models":{"bitrix/bitrixgpt-5.6-agent":{}}},"openrouter":{"whitelist":["other/model"]}}}' >"$tmp/config/opencode/opencode.jsonc"
printf '%s\n' '{"provider":{"bitrixgpt":{"models":{"bitrix/bitrixgpt-5.6-agent":{}}},"openrouter":{"whitelist":["deepseek/deepseek-v4-flash"]}}}' >"$tmp/config-allow/opencode/opencode.jsonc"
printf '%s\n' '{"switch":{"channel":"bitrixgpt","owner_word":"test"},"ladder":[{"id":"bitrixgpt","enabled":true,"model":"bitrixgpt/bitrix/bitrixgpt-5.6-agent","key":"VIBECODE_API_KEY","secret":"vibecode","base":"https://vibecode.bitrix24.tech/v1"},{"id":"openrouter","enabled":true,"model":"openrouter/deepseek/deepseek-v4-flash","key":"OPENROUTER_API_KEY","secret":"openrouter","base":"https://openrouter.ai/api/v1"},{"id":"codex","enabled":true,"model":"","effort":"high"}]}' >"$legacy"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"},{"id":"openrouter","enabled":false,"model":"openrouter/deepseek/deepseek-v4-flash","key":"OPENROUTER_API_KEY","secret":"openrouter","base":"https://openrouter.ai/api/v1"},{"id":"codex","enabled":true,"model":"","effort":"high"}]}' >"$disabled"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}]}' >"$go"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash","resume_model":"opencode-go/mimo-v2.6-resume"}]}' >"$resume"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"},{"id":"codex","enabled":true,"model":"","effort":"high"},{"id":"openrouter","enabled":true,"model":"openrouter/deepseek/deepseek-v4-flash","key":"OPENROUTER_API_KEY","secret":"openrouter","base":"https://openrouter.ai/api/v1"}]}' >"$ladder"
printf '%s\n' '{"switch":{"channel":"codex","owner_word":"test"},"ladder":[{"id":"codex","enabled":true,"model":"","effort":"high"}]}' >"$codexone"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"},{"id":"codex","enabled":true,"model":"","effort":"high"}]}' >"$gocodex"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash","audit_model":"opencode-go/mimo-v2.6-flash"}]}' >"$goaudit"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash","alt_models":["opencode-go/deepseek-v4.1-flash"]}]}' >"$goalt"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}],"opencode_config":"config/opencode-channel.json"}' >"$ocfg"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"resume_idle_limit":3,"ladder":[{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}]}' >"$goidle"
printf '%s\n' '{"switch":{"channel":"sdk","owner_word":"test"},"ladder":[{"id":"sdk","enabled":true,"model":"claude-haiku-5-5"},{"id":"go","enabled":true,"model":"opencode-go/mimo-v2.6-flash"}]}' >"$sdkgo"
printf '%s\n' '{"switch":{"channel":"go","owner_word":"test"},"ladder":[{"id":"go","enabled":true,"model":"opencode-go/deepseek-v4.1-flash","resume_model":"opencode-go/deepseek-v4.1-flash","audit_model":"opencode-go/deepseek-v4.1-flash","fallback_model":"opencode-go/deepseek-v4-pro"}]}' >"$tmp/repogo.json"

printf '%s\n' '#!/usr/bin/env bash' 'printf "curl %s\\n" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'out=' 'url=${!#}' 'while [[ $# -gt 0 ]]; do' '  [[ $1 == -o ]] && { out=$2; shift 2; continue; }' '  shift' 'done' 'if [[ $url == */key ]]; then' '  if [[ ${CURL_USAGE_DAILY:-0.4} == none ]]; then' '    body="{\"data\":{\"limit_remaining\":${CURL_LIMIT_REMAINING:-1}}}"' '  else' '    body="{\"data\":{\"limit_remaining\":${CURL_LIMIT_REMAINING:-1},\"usage_daily\":${CURL_USAGE_DAILY:-0.4}}}"' '  fi' '  printf "%s\n" "$body" >"$out"' '  printf "%s" "${CURL_KEY_CODE:-${CURL_CODE:-200}}"' 'elif [[ $url == */chat/completions ]]; then' '  printf "%s\n" "insecure api_key=secret token=x authorization=y cookie=z" >"$out"' '  printf "%s" "${CURL_CHAT_CODE:-200}"' 'else' '  printf "%s\n" "{\"data\":[{\"id\":\"bitrix/bitrixgpt-5.6-agent\"},{\"id\":\"deepseek/deepseek-v4-flash\"}]}" >"$out"' '  printf "%s" "${CURL_CODE:-200}"' 'fi' >"$bin/curl"
printf '%s\n' '#!/usr/bin/env bash' 'printf "opencode active=%s %s\\n" "${CODE_CHANNEL_ACTIVE:-}" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "env OPENCODE_CONFIG=%s\\n" "${OPENCODE_CONFIG:-}" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "PATH=%s\\n" "$PATH" >>"$CODE_CHANNEL_TEST_LOG"' 'if [[ ${OPENCODE_STDIN_COPY:-} ]]; then cat >"$OPENCODE_STDIN_COPY"; else cat >>"$CODE_CHANNEL_TEST_LOG"; printf "\\n" >>"$CODE_CHANNEL_TEST_LOG"; fi' 'printf "stdin=%s\\n" "$(readlink /proc/$$/fd/0)" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "REPORT\\n"' '[[ ${OPENCODE_ERR:-} ]] && printf "%s\n" "$OPENCODE_ERR" >&2' '[[ ${OPENCODE_TOUCH:-} ]] && mkdir -p -- "$(dirname -- "$CODE_CHANNEL_TEST_PROJECT/$OPENCODE_TOUCH")" && printf x >"$CODE_CHANNEL_TEST_PROJECT/$OPENCODE_TOUCH"' 'rc=${OPENCODE_RC:-0}' 'if [[ ${OPENCODE_SEQUENCE:-} ]]; then IFS=, read -ra seq <<<"$OPENCODE_SEQUENCE"; n=$(grep -c "^opencode " "$CODE_CHANNEL_TEST_LOG"); rc=${seq[$((n - 1))]:-$rc}; fi' 'exit "$rc"' >"$bin/opencode"
printf '%s\n' '#!/usr/bin/env bash' 'printf "codex active=%s %s\\n" "${CODE_CHANNEL_ACTIVE:-}" "$*" >>"$CODE_CHANNEL_TEST_LOG"' 'printf "REPORT\\n"' '[[ ${CODEX_SWITCH_BRANCH:-} ]] && git -C "$CODE_CHANNEL_TEST_PROJECT" switch -c "codex/x-branch"' '[[ ${CODEX_TOUCH:-} ]] && printf x >"$CODE_CHANNEL_TEST_PROJECT/$CODEX_TOUCH"' '[[ ${CODEX_ERR:-} ]] && printf "%s\n" "$CODEX_ERR" >&2' 'exit "${CODEX_RC:-0}"' >"$bin/codex"
printf '%s\n' '#!/usr/bin/env bash' 'if [[ $* == *"select id from session"* ]]; then printf "%s\n" "${SQLITE_SESSION_ID:-}"; else printf "%s\n" "${SQLITE_RESULT:-bitrixgpt|bitrix/bitrixgpt-5.6-agent}"; fi' >"$bin/sqlite3"
printf '%s\n' '#!/usr/bin/env bash' 'printf "sdk-agent %s\\n" "$*" >>"$CODE_CHANNEL_TEST_LOG"' '[[ ${SDK_TOUCH:-} ]] && printf x >"$CODE_CHANNEL_TEST_PROJECT/$SDK_TOUCH"' 'exit "${SDK_RC:-0}"' >"$bin/sdk-agent-fake"
for f in "$legacy" "$disabled" "$go" "$resume" "$ladder" "$codexone" "$gocodex" "$goaudit" "$goalt" "$ocfg" "$goidle" "$sdkgo" "$tmp/repogo.json"; do
  jq '.ladder |= map(if .enabled then .owner_word = "test" else . end)' "$f" >"$f.t" && mv -f -- "$f.t" "$f"
  for fid in $(jq -r '.ladder[].id' "$f"); do
    jq --arg one "$fid" '.ladder |= map(.enabled = (.id == $one) | if .enabled then .owner_word = "test" else . end) | .switch = {channel: $one, owner_word: "test"}' "$f" >"$f.$fid"
  done
done
chmod +x "$bin/curl" "$bin/opencode" "$bin/codex" "$bin/sqlite3" "$bin/sdk-agent-fake"

ok=0
check() {
  local n=$1 want=$2 out err rc ov
  local -a env_args=("TMPDIR=$tmp" "PATH=$bin:$PATH" "XDG_CONFIG_HOME=$tmp/config-allow" "CODE_CHANNEL_TEST_LOG=$log" "CODE_CHANNEL_TEST_PROJECT=$project" "CODE_CHANNEL_STATE=$tmp/state" "CODE_CHANNEL_RUNS_LOG=$runs" "CC_RETRY_SLEEP=0")
  shift 2
  local cfg=$legacy one=${CC_ONE:-} a prev=
  [[ ! ${CC_CONFIG+x} ]] || cfg=$CC_CONFIG
  if [[ -z $one ]]; then
    for a in "$@"; do
      if [[ $prev == */code-channel ]]; then
        case $a in 1) one=bitrixgpt;; 2) one=codex;; 3) one=openrouter;; auto|audit|delivery|--plan|--help) ;; *) one=$a;; esac
        break
      fi
      prev=$a
    done
  fi
  if [[ -n $cfg ]]; then
    [[ -n $one ]] || one=$(jq -r '[.ladder[] | select(.enabled) | .id][0] // ""' "$cfg")
    [[ ! -f $cfg.$one ]] || cfg=$cfg.$one
    env_args+=("CODE_CHANNEL_CONFIG=$cfg")
  fi
  : >"$log"
  : >"$runs"
  ov=${CC_OVERRIDE-$secret}
  [[ -n $ov ]] && env_args+=("CODE_CHANNEL_SECRET_OVERRIDE=$ov")
  [[ -n ${CC_ROOT:-} ]] && env_args+=("CODE_CHANNEL_SECRETS_ROOT=$CC_ROOT")
  out=$(env -u CODE_CHANNEL_ACTIVE "${env_args[@]}" "$@" 2>"$tmp/err")
  rc=$?; err=$(<"$tmp/err")
  if eval "$want"; then echo "PASS $n"; ((ok++)); else echo "FAIL $n: rc=$rc out=$out err=$err log=$(<"$log") branch=$(git -C "$project" branch --show-current) runs=$(<"$runs")"; fi
}

check 1 '[[ $rc == 0 && $out == *REPORT* ]] && grep -Fq -- "--agent audit" "$log"' \
  "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 2 '[[ $rc == 22 ]]' env OPENCODE_TOUCH=audit-change "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
CC_ONE=codex check 3 '[[ $rc == 0 ]] && grep -Fq -- "-s read-only" "$log"' \
  env CURL_CODE=401 "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 4 '[[ $rc == 0 ]] && ! grep -Fq -- "--agent" "$log"' \
  env OPENCODE_TOUCH=auto-change "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
check 5 '[[ $err == *mode=audit* ]]' "$root/bin/code-channel" audit "$project" "$root/AGENTS.md"
check 6 'bash -n "$root/bin/code-channel"' bash -c 'bash -n "$1"' _ "$root/bin/code-channel"
CC_OVERRIDE='' CC_ROOT="$tmp/secrets" check 7 '[[ $rc == 0 && $out == *REPORT* ]] && ! grep -Fq -- "нет секрета" "$tmp/err" && grep -Fq -- /key "$log"' \
  env SQLITE_RESULT='openrouter|deepseek/deepseek-v4-flash' "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
CC_ONE=openrouter CC_OVERRIDE='' CC_ROOT="$tmp/bitrix-secrets" check 8 '[[ $rc == 5 ]] && ! grep -q "^codex " "$log"' \
  env CURL_CODE=401 "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
CC_OVERRIDE='' CC_ROOT="$tmp/secrets" check 9 '[[ $rc == 11 ]] && grep -Fq -- /key "$log"' \
  env CURL_CODE=401 XDG_CONFIG_HOME="$tmp/config-allow" "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
CC_OVERRIDE='' CC_ROOT="$tmp/secrets" check 10 '[[ $rc == 15 ]]' \
  env XDG_CONFIG_HOME="$tmp/config" "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md" --model openrouter/deepseek/deepseek-v4-flash

check 11 '[[ $rc == 0 ]] && grep -q '"'"'provider_actual":"bitrixgpt"'"'"' "$runs" && grep -q '"'"'"rc":0'"'"' "$runs" && grep -Eq '"'"'cc-[0-9]+-[0-9]+'"'"' "$runs"' \
  env SQLITE_RESULT='bitrixgpt|bitrix/bitrixgpt-5.6-agent' "$root/bin/code-channel" 1 "$project" "$root/AGENTS.md"
check 12 '[[ $rc == 23 ]] && grep -Fq -- "сверка провайдера не прошла" "$tmp/err" && grep -q '"'"'provider_actual":"anthropic"'"'"' "$runs"' \
  env SQLITE_RESULT='anthropic|claude-sonnet' "$root/bin/code-channel" 1 "$project" "$root/AGENTS.md"
check 13 '[[ $rc == 12 ]] && [[ $(stat -c %a "$tmp/state/bitrixgpt-last-fail.txt") == 600 ]] && [[ $(grep -ci '"'"'api_key'"'"' "$tmp/state/bitrixgpt-last-fail.txt") == 0 ]]' \
  env CURL_CHAT_CODE=429 "$root/bin/code-channel" 1 "$project" "$root/AGENTS.md"
orig=$(git -C "$project" rev-parse --abbrev-ref HEAD)
check 14 '[[ $rc == 0 ]] && [[ $(git -C "$project" rev-parse --abbrev-ref HEAD) == "$orig" ]] && grep -Fq -- "форма codex сменила ветку, возвращено" "$tmp/err" && grep -q '"'"'provider_actual":"codex"'"'"' "$runs"' \
  env CODEX_SWITCH_BRANCH=1 CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"

gcd=$(git -C "$project" rev-parse --path-format=absolute --git-common-dir)
check 15 '[[ $rc == 0 ]] && grep -Fq -- "--add-dir '"$gcd"'" "$log" && grep -Fq -- "-c sandbox_workspace_write.network_access=true" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"
check 16 '[[ $rc == 0 ]] && grep -Fq -- "-c sandbox_workspace_write.network_access=true Parallelize: when the task has 2 or more independent file sets, dispatch them at once to general subagents via the Task tool in one message, one file set per subagent, never the same file to two subagents; then check the combined result yourself" "$log" && grep -Fq -- "Не вызывай bd: трекер ведёт оркестратор" "$log" && grep -Fq -- "Не создавай и не переключай ветки; не делай git add и git commit — коммит делает оркестратор" "$log" && grep -Fq -- "Ты уже исполнитель внутри code-channel: правь файлы сам; code-channel, opencode run, codex exec не вызывай" "$log" && grep -Fq -- "Scratch and temporary files go to /tmp only, never inside the worktree" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"
git -C "$project" clean -fdq
check 17 '[[ $rc == 24 ]] && grep -Fq -- "form=codex среда: read-only" "$tmp/err"' \
  env CODEX_ERR='Read-only file system' CODEX_RC=1 "$root/bin/code-channel" 2 "$project" "$root/AGENTS.md"

git -C "$project" clean -fdq
check 18 '[[ $rc == 13 && $err == *4.2* && $err == *4* ]] && ! grep -q "opencode" "$log"' \
  env CURL_USAGE_DAILY=4.2 "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
CC_ONE=openrouter check 19 '[[ $rc == 13 && $err == *"форма openrouter пропущена"* ]] && ! grep -q "^opencode " "$log"' \
  env CURL_CODE=401 CURL_KEY_CODE=200 CURL_USAGE_DAILY=4.2 "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
check 20 '[[ $rc == 0 ]] && grep -Fq -- /key "$log" && grep -Fq -- "opencode" "$log"' \
  env SQLITE_RESULT='openrouter|deepseek/deepseek-v4-flash' CURL_USAGE_DAILY=0.4 "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"
check 21 '[[ $rc == 13 && $err == *"нет usage_daily"* ]]' \
  env CURL_USAGE_DAILY=none "$root/bin/code-channel" 3 "$project" "$root/AGENTS.md"

CC_CONFIG=$tmp/repogo.json check 22 '[[ $rc == 0 && $out == $'"'"'go opencode-go/deepseek-v4.1-flash - audit=opencode-go/deepseek-v4.1-flash'"'"' ]]' \
  "$root/bin/code-channel" --plan
CC_ONE=codex CC_CONFIG=$disabled check 23 '[[ $rc == 16 ]] && ! grep -Fq -- /models "$log" && grep -Fq -- "codex " "$log"' \
  env OPENCODE_RC=1 bash -c 'plan=$("$1" --plan) || exit $?; [[ $plan != *openrouter* ]] || exit 90; "$1" auto "$2" "$3"' _ "$root/bin/code-channel" "$project" "$root/AGENTS.md"
CC_ONE=go CC_CONFIG=$disabled check 24 '[[ $rc == 3 ]] && [[ ! -s $log ]]' \
  "$root/bin/code-channel" openrouter "$project" "$root/AGENTS.md"
CC_CONFIG=$go check 25 '[[ $rc == 0 ]] && [[ $err != *"сверка провайдера не прошла"* ]]' \
  env SQLITE_RESULT='opencode-go|mimo-v2.6-flash' OPENCODE_TOUCH=go-change "$root/bin/code-channel" go "$project" "$root/AGENTS.md"
CC_CONFIG=$ladder check 26 '[[ $rc == 23 ]]' \
  env OPENCODE_RC=1 CODEX_RC=1 "$root/bin/code-channel" auto "$project" "$root/AGENTS.md"
check 27 '[[ $rc == 3 ]] && [[ ! -s $log ]]' \
  "$root/bin/code-channel" auto "$project" "$root/AGENTS.md" --model x/y

check 28 '[[ $rc == 30 && ! -s $log ]]' \
  env CODE_CHANNEL_ACTIVE=1 "$root/bin/code-channel" auto "$project" "$tz"
check 29 '[[ $rc == 0 ]] && grep -Fq -- "-p quota-terra -c model_reasoning_effort=\"high\"" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$tz"
check 30 '[[ $rc == 0 ]] && ! grep -Eq -- "(^| )-m( |$)" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" 2 "$project" "$tz"
CC_ONE=codex CC_CONFIG=$ladder check 31 '[[ $rc == 0 ]] && grep -Fq -- "codex active=1" "$log"' \
  env OPENCODE_RC=1 CODEX_RC=0 CODEX_TOUCH=active-change "$root/bin/code-channel" auto "$project" "$tz"
git -C "$project" clean -fdq
check 32 '[[ $rc == 0 && $err == *"форма codex: git только для чтения, правки есть"* && $err != *"среда: read-only"* ]]' \
  env CODEX_ERR='Read-only file system' CODEX_RC=1 CODEX_TOUCH=codex-change "$root/bin/code-channel" 2 "$project" "$tz"
CC_ONE=codex CC_CONFIG=$disabled check 33 '[[ $rc == 0 ]]' \
  env OPENCODE_RC=1 CODEX_RC=0 "$root/bin/code-channel" auto "$nogit" "$tz"
CC_ONE=go CC_CONFIG=$disabled check 34 '[[ $rc == 3 && $err == *"выключен в конфиге"* ]]' \
  "$root/bin/code-channel" 3 "$project" "$tz"
check 35 '[[ $rc == 3 && $err == *"модель не в конфиге: other/model"* && ! -s $log ]]' \
  "$root/bin/code-channel" 1 "$project" "$tz" --model other/model
CC_CONFIG=$resume check 36 '[[ $rc == 124 && $(grep -c "^opencode " "$log") == 3 ]] && ! grep -q -- "--session" "$log" && grep -Fq -- "канал go недоступен" "$tmp/err"' \
  env OPENCODE_RC=124 SQLITE_SESSION_ID=session-123 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
CC_CONFIG=$go check 37 '[[ $rc == 124 && $(grep -c "^opencode " "$log") == 3 ]]' \
  env OPENCODE_RC=124 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

printf '%s\n' '#!/usr/bin/env bash' "printf '%s\n' \"\$1\" >>\"$tlog\"" 'shift; exec "$@"' >"$bin/timeout"
chmod +x "$bin/timeout"
: >"$tlog"
CC_CONFIG=$resume check 38 '[[ $rc == 0 ]] && [[ $(grep -cx 1800 "$tlog") == 2 ]]' \
  env OPENCODE_SEQUENCE=124,0 SQLITE_SESSION_ID=session-123 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
: >"$tlog"
CC_CONFIG=$go check 39 '[[ $rc == 0 ]] && grep -qx 1800 "$tlog"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

check 40 '[[ $rc == 3 && $err == *"project must be absolute path"* ]]' \
  "$root/bin/code-channel" auto rel/path "$tz"

CC_CONFIG=$go check 41 '[[ $rc == 0 ]] && grep -Fq -- "не делай git add и git commit" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

CC_CONFIG=$go check 42 '[[ $rc == 0 ]] && grep -Fq -- "только через индекс: repowise" "$log"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

CC_CONFIG=$codexone check 43 '[[ $rc == 0 ]] && grep -Fq -- "только через индекс: repowise" "$log"' \
  env CODEX_RC=0 "$root/bin/code-channel" codex "$project" "$tz"

CC_CONFIG=$gocodex check 44 '[[ $rc == 124 ]] && ! grep -q "^codex " "$log" && [[ $err != *switch* ]]' \
  env OPENCODE_RC=124 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" auto "$project" "$tz"

mkdir -p "$project/.agent-work"
printf 'old\n' >"$project/.agent-work/old.txt"
CC_CONFIG=$go check 45 '[[ $rc == 0 ]] && [[ -f "$project/.agent-work/added.txt" ]] && ! grep -Fq -- "без изменений" "$tmp/err"' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=.agent-work/added.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

CC_CONFIG=$go check 46 'grep -Eq "^code-channel: mode=code .* model=opencode-go/mimo-v2.6-flash retries=0 precheck=" "$tmp/err"' \
  env OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"

git -C "$project" clean -fdq
mkdir -p "$project/.agent-work"
printf 'orig\n' >"$project/.agent-work/untracked.txt"
CC_CONFIG=$go check 47 '[[ $rc == 0 ]] && ! grep -Fq -- "без изменений" "$tmp/err"' \
