  env OPENCODE_RC=0 OPENCODE_TOUCH=.agent-work/untracked.txt SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" auto "$project" "$tz"

CC_ONE=go CC_CONFIG=$go check pipe_run_ok '[[ $rc == 0 ]] && ! grep -Fq -- "already running" "$tmp/err"' \
  env OPENCODE_TOUCH=pipe-change.txt OPENCODE_RC=0 SQLITE_RESULT='opencode-go|mimo-v2.6-flash' bash -c 'set -o pipefail; "$1" go "$2" "$3" | cat' _ "$root/bin/code-channel" "$project" "$tz"

CC_CONFIG=$goaudit check audit_go_model '[[ $rc == 0 ]] && grep -Fq -- "--agent audit" "$log" && grep -Fq -- "-m opencode-go/mimo-v2.6-flash" "$log"' \
  env SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" audit "$project" "$tz"
CC_CONFIG=$goaudit check go_uses_model '[[ $rc == 0 ]] && grep -Fq -- "-m opencode-go/mimo-v2.6-flash" "$log" && ! grep -q "audit-free" "$log"' \
  env SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tz"
