  env OPENCODE_RC=0 OPENCODE_TOUCH=worktree-tmp/a SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tzfiles"
git -C "$project" clean -fdq
CC_CONFIG=$go check in_scope_ok '[[ $rc == 0 ]]' \
  env OPENCODE_RC=0 OPENCODE_TOUCH=bin/x SQLITE_RESULT='opencode-go|mimo-v2.6-flash' "$root/bin/code-channel" go "$project" "$tzfiles"

CC_CONFIG=$sdkgo check sdk_auto_success '[[ $rc == 0 ]] && grep -Fq -- "sdk-agent code" "$log" && ! grep -q "^opencode " "$log"' \
  env SDK_TOUCH=sdk-made CODE_CHANNEL_SDK_AGENT="$bin/sdk-agent-fake" "$root/bin/code-channel" auto "$project" "$tz"
rm -f -- "$project/sdk-made"
