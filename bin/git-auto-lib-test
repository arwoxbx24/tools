#!/usr/bin/env bash
set -u
bin=$(cd -- "$(dirname -- "$0")" && pwd)
source "$bin/git-auto-lib"
d=$(mktemp -d)
export GA_LOCK_DIR="$d/locks"
mkdir -p "$GA_LOCK_DIR"
sum=0
trap 'rm -rf "$d"' EXIT
pass(){ echo "PASS $1"; sum=$((sum+1)); }
fail(){ echo "FAIL $1"; }

# T1: registry
proj="$d/projects"
mkdir -p "$proj/clients/tools" "$proj/.worktrees/x" "$proj/node_modules"
for r in a clients/b clients/tools/c node_modules/d; do git init -q -b main "$proj/$r"; done
git -C "$proj/a" config user.email t@t
git -C "$proj/a" config user.name t
git -C "$proj/a" commit -q --allow-empty -m init
git -C "$proj/a" branch -M main
git -C "$proj/a" worktree add -q -b wt "$proj/.worktrees/x/a-1" main
export GA_PROJECTS="$proj"
export GA_TOOLS="$d/tools"
export GA_CONTOUR_GITDIR="$d/contour.git"
export GA_CONTOUR_WT="$d/contour-wt"
names=$(ga_roots | cut -f1)
ok=1
for n in projects a clients/b clients/tools/c; do grep -qx "$n" <<<"$names" || ok=0; done
grep -qE 'worktrees|node_modules' <<<"$names" && ok=0
[[ $ok == 1 ]] && pass T1 || fail "T1: $names"

# T2: contour bare git_dir + separate work_tree
mkdir -p "$GA_CONTOUR_WT"
git init -q --bare "$GA_CONTOUR_GITDIR"
(
	ga_ctx contour || exit 1
	[[ $GIT_DIR == "$GA_CONTOUR_GITDIR" && $GIT_WORK_TREE == "$GA_CONTOUR_WT" && $GA_LIVE == "$GA_CONTOUR_WT" ]] || exit 1
	git status -uno >/dev/null 2>&1 || exit 1
) && pass T2 || fail T2

# T3: slug
git -C "$proj/a" remote add origin git@github.com:o/r.git
s1=$(ga_roots | awk -F '\t' '$1=="a"{print $4; exit}')
s2=$(ga_roots | awk -F '\t' '$1=="clients/b"{print $4; exit}')
[[ $s1 == o/r && $s2 == - ]] && pass T3 || fail "T3: $s1 $s2"

# T4: ga_repo_of worktree
r4=$(ga_repo_of "$proj/.worktrees/x/a-1")
[[ $r4 == a ]] && pass T4 || fail "T4: got=$r4"

# T5: ga_skip_reason
ok=1
[[ $(ga_skip_reason clients/stroyremont) == allowlist ]] || ok=0
[[ $(ga_skip_reason hh-scoring) == hh-scoring ]] || ok=0
[[ -z $(ga_skip_reason a) ]] || ok=0
[[ $ok == 1 ]] && pass T5 || fail T5

# T6a: second holder times out -> 75, <=2s
ga_lock a 1 sleep 3 & bg=$!
sleep 0.5
t0=$(date +%s%N)
ga_lock a 1 sleep 3 2>/dev/null; rc=$?
t1=$(date +%s%N)
wait "$bg"
el=$(((t1-t0)/1000000))
[[ $rc == 75 && $el -le 2000 ]] && pass T6a || fail "T6a: rc=$rc el=$el"

# T6b: nested same-name -> no flock wait
ga_lock a 1 bash -c '
	source "$0"
	t0=$(date +%s%N)
	ga_lock a 0 sleep 1; rc=$?
	t1=$(date +%s%N)
	[[ $rc == 0 && $(((t1-t0)/1000000)) -le 2000 ]]
' "$bin/git-auto-lib" && pass T6b || fail T6b

# T7: ga_branch_unmerged
r7="$d/unmerged"
git init -q --bare -b main "$d/origin7.git"
git clone -q "$d/origin7.git" "$r7"
git -C "$r7" config user.email t@t
git -C "$r7" config user.name t
git -C "$r7" commit -q --allow-empty -m main
git -C "$r7" branch -M main
git -C "$r7" push -q origin main
git -C "$r7" checkout -q -b feat/new
printf 'x\n' >"$r7/newfile"
git -C "$r7" add newfile
git -C "$r7" commit -q -m new
export GIT_DIR="$r7/.git" GIT_WORK_TREE="$r7"
ga_branch_unmerged feat/new; ra=$?
[[ $ra == 0 ]] && pass T7a || fail "T7a: rc=$ra"
git checkout -q main
git merge -q --squash feat/new
git commit -q -m "sq new"
git push -q origin main
ga_branch_unmerged feat/new; rb=$?
git branch behind "$(git rev-parse main~1)"
ga_branch_unmerged behind; rc=$?
[[ $rb == 1 && $rc == 1 ]] && pass T7b || fail "T7b: rb=$rb rc=$rc"
git checkout -q -b live
printf 'live\n' >"$r7/newfile"
git commit -q -am live
git checkout -q main
printf 'main\n' >"$r7/newfile"
git commit -q -am main
git push -q origin main
ga_branch_unmerged live; rl=$?
git update-ref refs/delivered/x live
ga_branch_unmerged live; rd=$?
git update-ref -d refs/delivered/x
[[ $rl == 0 && $rd == 1 ]] && pass T7c || fail "T7c: rl=$rl rd=$rd"
unset GIT_DIR GIT_WORK_TREE

# T8a: broken/empty .git skipped
mkdir -p "$proj/broken/.git"
names=$(ga_roots | cut -f1)
grep -qx broken <<<"$names" && fail "T8a: broken present" || pass T8a

# T8b: real repo yes, linked worktree no
git init -q -b main "$proj/real"
git -C "$proj/real" config user.email t@t
git -C "$proj/real" config user.name t
git -C "$proj/real" commit -q --allow-empty -m init
git -C "$proj/real" worktree add -q -b rwt "$proj/real-wt"
names=$(ga_roots | cut -f1)
ok=1
grep -qx real <<<"$names" || ok=0
grep -qx real-wt <<<"$names" && ok=0
[[ $ok == 1 ]] && pass T8b || fail "T8b: $names"

# T8c: hh-scoring* skip
ok=1
[[ $(ga_skip_reason hh-scoring-dev) == hh-scoring ]] || ok=0
[[ $(ga_skip_reason x/hh-scoring-prod) == hh-scoring ]] || ok=0
[[ -z $(ga_skip_reason projects) ]] || ok=0
[[ $ok == 1 ]] && pass T8c || fail T8c

# T9: submodule root skipped, parent listed
git init -q -b main "$d/subsrc"
git -C "$d/subsrc" config user.email t@t
git -C "$d/subsrc" config user.name t
git -C "$d/subsrc" commit -q --allow-empty -m init
git init -q -b main "$proj/sup"
git -C "$proj/sup" config user.email t@t
git -C "$proj/sup" config user.name t
git -C "$proj/sup" commit -q --allow-empty -m init
git -C "$proj/sup" -c protocol.file.allow=always submodule add -q "$d/subsrc" sub
names=$(ga_roots | cut -f1)
ok=1
grep -qx sup <<<"$names" || ok=0
grep -qx 'sup/sub' <<<"$names" && ok=0
[[ $ok == 1 ]] && pass T9 || fail "T9: $names"

# T10: nested .git/.git skipped silently
mkdir -p "$proj/real/.git/.git"
err=$(ga_roots 2>&1 >/dev/null)
names=$(ga_roots 2>/dev/null | cut -f1)
[[ -z $err ]] && ! grep -qx 'real/.git' <<<"$names" && pass T10 || fail "T10: err=$err"

# T16: repo without workflows ("no checks reported", rc 1) -> 0 with the CI-free route line
mkdir -p "$d/noci"
git init -q -b main "$d/noci"
git -C "$d/noci" -c user.email=t@t -c user.name=t commit -q --allow-empty -m init
mkdir -p "$d/gh-noci"
cat > "$d/gh-noci/gh" <<'EOF'
#!/usr/bin/env bash
echo "no checks reported on the 'main' branch" >&2
exit 1
EOF
chmod +x "$d/gh-noci/gh"
out=$(cd "$d/noci" && PATH="$d/gh-noci:$PATH" GA_CI_BACKOFF=0 ga_ci_watch 7 x/rep 2>&1); rc=$?
[[ $rc == 0 && $out == *'no CI: merge on the test output in the PR body'* ]] && pass T16 || fail "T16: rc=$rc out=$out"

# T17: workflows present + "no checks reported" on every try -> non-zero, route line, no merge
mkdir -p "$d/ci/.github/workflows"
git init -q -b main "$d/ci"
printf 'on: push\n' > "$d/ci/.github/workflows/ci.yml"
git -C "$d/ci" add .github/workflows/ci.yml
git -C "$d/ci" -c user.email=t@t -c user.name=t commit -q -m ci
mkdir -p "$d/gh-pending"
cat > "$d/gh-pending/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_LOG"
echo "no checks reported on the 'main' branch" >&2
exit 1
EOF
chmod +x "$d/gh-pending/gh"
: > "$d/gh-pending.log"
out=$(cd "$d/ci" && GH_LOG="$d/gh-pending.log" PATH="$d/gh-pending:$PATH" GA_CI_BACKOFF=0 ga_ci_watch 7 x/rep 2>&1); rc=$?
[[ $rc != 0 && $out == *'CI not started after 3 tries: run gh pr checks 7 --watch later; do not merge'* ]] \
	&& [[ $(grep -c '^pr checks' "$d/gh-pending.log") -ge 2 ]] \
	&& ! grep -q '^pr merge' "$d/gh-pending.log" && pass T17 || fail "T17: rc=$rc out=$out"

# T18: real failed check (rc 1) keeps a non-zero rc
mkdir -p "$d/gh-fail"
cat > "$d/gh-fail/gh" <<'EOF'
#!/usr/bin/env bash
echo 'min-ci	fail	1m	https://example.test/job/1' >&2
exit 1
EOF
chmod +x "$d/gh-fail/gh"
PATH="$d/gh-fail:$PATH" GA_CI_BACKOFF=0 ga_ci_watch 7 x/rep >/dev/null 2>&1; rc=$?
[[ $rc != 0 ]] && pass T18 || fail "T18: rc=$rc"

[[ $sum == 18 ]]
