#!/bin/bash
# code-archive-drill: test restoration, verify refs count, check project presence

set -o pipefail
# Default environment
CA_ENV_FILE="${CA_ENV_FILE:-/root/workspaces/secrets/gitmirror.env}"
CA_GITHUB_BASE="${CA_GITHUB_BASE:-git@github.com:arwoxbx24}"
CA_GITLAB_BASE="${CA_GITLAB_BASE:-https://gitlab.com/arwox24-group}"
CA_REPOS_DIR="${CA_REPOS_DIR:-/home/gitmirror/repos}"
CA_STATE_DIR="${CA_STATE_DIR:-/home/gitmirror/state}"
CA_LOG="${CA_LOG:-/root/workspaces/system/services/gitmirror/code-archive.log}"

# Source environment
if [[ -f "$CA_ENV_FILE" ]]; then
  set -a; . "$CA_ENV_FILE"; set +a
fi

drill_dir="${CA_DRILL_DIR:-/root/workspaces/sandbox/test-archive-drill}"
name="${CA_DRILL_NAME:-}"

mask() { sed -E 's#(ghp_|gho_|github_pat_|glpat-|oauth2:)[^@ ]*#***#g'; }

# Build URL based on base (supports file://, https://, or git@)
build_url() {
  local base="$1" name="$2"
  if [[ "$base" == file://* ]]; then
    # File URL - use as-is with path
    echo "${base%/}/$name.git"
  elif [[ "$base" == https://* ]] || [[ "$base" == http://* ]]; then
    # HTTP URL
    echo "${base%/}/$name.git"
  elif [[ "$base" == git@* ]]; then
    # SSH URL
    echo "$base:$name.git"
  else
    # Treat as local path
    echo "$base/$name.git"
  fi
}

# Select name: explicit CA_DRILL_NAME or random from state/*.pushed_at
if [[ -z "$name" ]]; then
  mapfile -t pushed_at < <(ls -1 "$CA_STATE_DIR"/*.pushed_at 2>/dev/null | xargs -n1 basename -s .pushed_at || true)
  (( ${#pushed_at[@]} > 0 )) && name="$(printf '%s\n' "${pushed_at[@]}" | shuf -n1)" || true
fi

[[ -z "$name" ]] && { echo "drill:mismatch restore unknown" | mask; exit 1; }

# Cleanup trap
trap 'rm -rf "$drill_dir"' EXIT INT TERM

# Clone from GitLab
# HTTPS GitLab is a private project: prime askpass so clone/ls-remote read it non-interactively.
if [[ "$CA_GITLAB_BASE" == https://* ]]; then
  export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS="${CA_ASKPASS_CMD:-$(dirname "$0")/code-archive}" CA_ASKPASS=1
fi
gitlab_url=$(build_url "$CA_GITLAB_BASE" "$name")
if ! git clone -q --bare "$gitlab_url" "$drill_dir" 2>/dev/null; then
  echo "drill:mismatch restore $name" | mask
  exit 1
fi

# Verify HEAD matches GitHub
github_url=$(build_url "$CA_GITHUB_BASE" "$name")
gh_head=$(git ls-remote "$github_url" HEAD 2>/dev/null | awk '{print $1}' || true)
drill_head=$(git --git-dir="$drill_dir" rev-parse HEAD 2>/dev/null || true)
if [[ -z "$gh_head" ]] || [[ "$gh_head" != "$drill_head" ]]; then
  echo "drill:mismatch head $name" | mask
  exit 1
fi

# Check refs for each state entry
exit_code=0
for state_file in "$CA_STATE_DIR"/*.pushed_at; do
  [[ -f "$state_file" ]] || continue
  repo_name=$(basename "$state_file" .pushed_at)
  copy_dir="$CA_REPOS_DIR/$repo_name.git"

  # Check if local copy exists
  if [[ ! -d "$copy_dir" ]]; then
    echo "drill:missing $repo_name local" | mask
    rm -f "$state_file"
    exit_code=1
    continue
  fi

  # Count refs in local copy
  local_refs=$(( $(git --git-dir="$copy_dir" for-each-ref refs/heads 2>/dev/null | wc -l) + $(git --git-dir="$copy_dir" for-each-ref refs/tags 2>/dev/null | wc -l) ))

  # Count refs in GitLab (heads and tags, no ^{})
  repo_gitlab_url=$(build_url "$CA_GITLAB_BASE" "$repo_name")
  gitlab_refs=$(git ls-remote --heads --tags "$repo_gitlab_url" 2>/dev/null | grep -v '\^{}' | wc -l)

  # Compare with recorded refs
  recorded_refs=0
  if [[ -f "$CA_STATE_DIR/$repo_name.refs" ]]; then
    recorded_refs=$(cat "$CA_STATE_DIR/$repo_name.refs")
  fi

  if (( recorded_refs > 0 && local_refs < recorded_refs )); then
    echo "drill:mismatch refs-shrunk $repo_name" | mask
    exit_code=1
  fi

  # Update recorded refs
  echo "$gitlab_refs" > "$CA_STATE_DIR/$repo_name.refs"

  # Check if project exists in GitLab
  if ! git ls-remote --heads --tags "$repo_gitlab_url" >/dev/null 2>&1; then
    echo "drill:missing $repo_name gitlab" | mask
    rm -f "$state_file"
    exit_code=1
  fi
done

if (( exit_code == 0 )); then
  echo "drill:ok" | mask
fi

exit "$exit_code"
