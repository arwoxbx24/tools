#!/usr/bin/env bash
set -u
TOP="$(cd "$(dirname "$0")/.." && pwd)"
SANDBOX="/tmp/test-prepush-guard-$$"
rm -rf "$SANDBOX"
mkdir -p "$SANDBOX/empty-hooks" "$SANDBOX/hooks"
export SECRET_WARN_LOG="$SANDBOX/secret-warn.log"
ARGS="$SANDBOX/args.log"
REMOTE="$SANDBOX/remote.git"
R="$SANDBOX/repo"

# fake gitleaks: its body is rewritten before each push
fake() { printf '#!/bin/sh\n%s\n' "$1" > "$SANDBOX/gitleaks"; chmod 700 "$SANDBOX/gitleaks"; }

sed -e "s|/root/.local/bin/gitleaks|$SANDBOX/gitleaks|" "$TOP/git-hooks/dispatch" > "$SANDBOX/hooks/pre-push"
chmod 700 "$SANDBOX/hooks/pre-push"

git init -q --bare "$REMOTE"
git init -q "$R"
cd "$R" || { rm -rf "$SANDBOX"; exit 1; }
git config user.email t@example.com
git config user.name t
git config core.hooksPath "$SANDBOX/empty-hooks"
git remote add origin "$REMOTE"
echo base > f.txt
git add f.txt
git commit -qm base

PASS=0; FAIL=0
push() { git -c core.hooksPath="$SANDBOX/hooks" push -q origin "$1" >/dev/null 2>"$SANDBOX/err"; }
on_remote() { git --git-dir="$REMOTE" show-ref --verify --quiet "refs/heads/$1"; }

# A: gitleaks finds a leak -> push refused, ref absent on remote
fake 'echo "leaks found: 1" >&2; exit 1'
push HEAD:refs/heads/a; c=$?
if [ "$c" -ne 0 ] && ! on_remote a && grep -qF 'leaks found' "$SANDBOX/err" \
   && grep -qF 'gitleaks: push refused' "$SANDBOX/err"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[A] code=$c"
fi

# B: gitleaks clean, new branch -> push ok, args contain '--not --remotes'
rm -f "$ARGS"
fake "echo \"\$*\" >> \"$ARGS\""
push HEAD:refs/heads/b; c=$?
if [ "$c" -eq 0 ] && on_remote b && grep -qF -- '--not --remotes' "$ARGS"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[B] code=$c"
fi

# C: second commit on existing branch -> push ok, args contain '<old>..<new>'
OLD=$(git rev-parse HEAD)
echo two > g.txt
git add g.txt
git commit -qm two
NEW=$(git rev-parse HEAD)
rm -f "$ARGS"
fake "echo \"\$*\" >> \"$ARGS\""
push HEAD:refs/heads/b; c=$?
if [ "$c" -eq 0 ] && grep -qF "$OLD..$NEW" "$ARGS"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[C] code=$c"
fi

# D: fixture renderer + stale routes committed -> push refused, ref absent on remote
mkdir -p tools/ci .claude/rules
cat > tools/ci/render_routes.py <<'EOF'
import sys
out = sys.argv[sys.argv.index('--out') + 1]
if open(out).read() == 'fresh':
    sys.exit(0)
print('routes: permission-routes.md is stale', file=sys.stderr)
sys.exit(1)
EOF
echo '{}' > .claude/rules/routes.json
printf stale > .claude/rules/permission-routes.md
git add tools .claude
git commit -qm d
fake 'exit 0'
push HEAD:refs/heads/d; c=$?
if [ "$c" -ne 0 ] && ! on_remote d && grep -qF 'routes gate: push refused' "$SANDBOX/err"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[D] code=$c"
fi

# E: same fixture, fresh routes committed -> push ok, ref present on remote
printf fresh > .claude/rules/permission-routes.md
git add .claude
git commit -qm e
fake 'exit 0'
push HEAD:refs/heads/e; c=$?
if [ "$c" -eq 0 ] && on_remote e; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[E] code=$c"
fi

# F: fresh in the working tree, stale in the commit -> push refused (gate reads the commit)
printf stale > .claude/rules/permission-routes.md
git add .claude
git commit -qm f
printf fresh > .claude/rules/permission-routes.md
fake 'exit 0'
push HEAD:refs/heads/f; c=$?
if [ "$c" -ne 0 ] && ! on_remote f && grep -qF 'routes gate: push refused' "$SANDBOX/err"; then
    PASS=$((PASS+1))
else
    FAIL=$((FAIL+1)); echo "FAIL[F] code=$c"
fi

echo "PASS $PASS FAIL $FAIL"
cd "$TOP" && rm -rf "$SANDBOX"
[ "$FAIL" -eq 0 ]
