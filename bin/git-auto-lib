#!/usr/bin/env bash
# bin/git-auto-lib — sourced, defines ga_* helpers. No execution on source.

_ga_url_slug(){ # $1 git_dir $2 work_tree -> OWNER/REPO or -
	local u
	u=$(git --git-dir="$1" --work-tree="$2" config --get remote.origin.url 2>/dev/null) || { echo '-'; return 0; }
	u=${u%.git}
	case $u in
		git@github.com:*) u=${u#git@github.com:} ;;
		https://github.com/*) u=${u#https://github.com/} ;;
		*) echo '-'; return 0 ;;
	esac
	[[ $u == */* && -n ${u%%/*} ]] && echo "$u" || echo '-'
}

_ga_emit(){ # name git_dir work_tree
	printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$(_ga_url_slug "$2" "$3")"
	return 0
}

ga_projects_gitdir(){ # git dir of the projects repo; lives outside the work tree since dcfg-z4gtt
	local p=${GA_PROJECTS:-/root/workspaces/projects}
	[[ -e $p/.git ]] && echo "$p/.git" || echo "${GA_PROJECTS_GITDIR:-/root/workspaces/git-dirs/agent-contour.git}"
}

ga_roots(){
	local p=${GA_PROJECTS:-/root/workspaces/projects}
	local t=${GA_TOOLS:-/root/workspaces/tools}
	local cg=${GA_CONTOUR_GITDIR:-/root/workspaces/system/contour-config.git}
	local cw=${GA_CONTOUR_WT:-/root}
	local g rel name gd wt
	_ga_emit projects "$(ga_projects_gitdir)" "$p"
	_ga_emit tools "$t/.git" "$t"
	_ga_emit contour "$cg" "$cw"
	while IFS= read -r g; do
		rel=${g#"$p"/}
		name=${rel%.git}
		name=${name%/}
		[[ -n $name ]] || continue
		wt=${g%/.git}
		[[ -n $(git -C "$wt" rev-parse --show-superproject-working-tree 2>/dev/null) ]] && continue
		gd=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
		[[ $(realpath "$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null) == "$(realpath "$wt")" ]] || continue
		[[ $(git -C "$wt" rev-parse --path-format=absolute --git-dir 2>/dev/null) == "$gd" ]] || continue
		_ga_emit "$name" "$gd" "$wt"
	done < <(find "$p" -maxdepth 4 -name .git ! -path '*/\.worktrees/*' ! -path '*/node_modules/*' 2>/dev/null)
}

ga_ctx(){ # <name> — export GIT_DIR/GIT_WORK_TREE/GA_LIVE/GA_SLUG; missing -> 2
	local name=$1 line rest gd wt slug
	[[ -n $name ]] || return 2
	line=$(ga_roots | awk -F '\t' -v n="$name" '$1==n{print; exit}')
	[[ -n $line ]] || return 2
	IFS=$'\t' read -r rest gd wt slug <<< "$line"
	export GIT_DIR=$gd GIT_WORK_TREE=$wt GA_LIVE=$wt GA_SLUG=$slug
	return 0
}

ga_repo_of(){ # <path> — registry name of containing repo; none -> 2
	local p=$1 gd name gd2 wt slug
	[[ -n $p ]] || return 2
	gd=$(git -C "$p" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 2
	while IFS=$'\t' read -r name gd2 wt slug; do
		[[ $gd == "$gd2" ]] && { echo "$name"; return 0; }
	done < <(ga_roots)
	return 2
}

ga_beads_root(){ # <path> — dir holding .beads for the repo of <path>; none -> SHIP_POST_BEADS_ROOT
	local gd d name gd2 wt slug
	if gd=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
		d=$(dirname "$gd")
		while IFS=$'\t' read -r name gd2 wt slug; do
			[[ $gd == "$gd2" ]] && { d=$wt; break; }
		done < <(ga_roots)
	else
		d=$1
	fi
	while [[ -n $d && $d != / ]]; do [[ -d $d/.beads ]] && { echo "$d"; return 0; }; d=$(dirname "$d"); done
	echo "${SHIP_POST_BEADS_ROOT:-/root/workspaces/projects}"
}

ga_base(){ # <path> [local] — one line "<mode> <base> <prod>"; origin main/base undetermined -> 2
	local p=$1 local=${2:-} sym prod b
	[[ -n $p ]] || return 2
	if [[ $local == local ]]; then
		prod=$(git -C "$p" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
		prod=${prod#origin/}
		if [[ -z $prod ]]; then
			for b in main master; do
				git -C "$p" show-ref -q --verify refs/remotes/origin/$b 2>/dev/null && { prod=$b; break; }
			done
		fi
		[[ -n $prod ]] || return 2
		git -C "$p" show-ref -q --verify refs/remotes/origin/dev 2>/dev/null \
			&& printf 'two dev %s\n' "$prod" || printf 'one %s %s\n' "$prod" "$prod"
		return 0
	fi
	sym=$(git -C "$p" ls-remote --symref origin HEAD 2>/dev/null) || return 2
	sym=${sym%%$'\n'*}
	[[ $sym == 'ref: refs/heads/'*$'\t'HEAD ]] || return 2
	prod=${sym#'ref: refs/heads/'}; prod=${prod%%$'\t'*}
	git -C "$p" ls-remote --exit-code origin refs/heads/dev >/dev/null 2>&1
	case $? in
		0) printf 'two dev %s\n' "$prod"; return 0 ;;
		2) printf 'one %s %s\n' "$prod" "$prod"; return 0 ;;
		*) return 2 ;;
	esac
}

ga_skip_reason(){ # <name> -> allowlist|hh-scoring|''
	local seg=${1##*/}
	case $seg in
		stroyremont|client-video-transcription|auto-consultant-bot) echo allowlist ;;
		hh-scoring*) echo hh-scoring ;;
	esac
	return 0
}

ga_class(){ # <name> <mode> -> plain|staged|guarded
	if [[ $2 == two ]]; then
		echo staged
	elif [[ -n $(ga_skip_reason "$1") ]]; then
		echo guarded
	else
		echo plain
	fi
	return 0
}

gg_log(){ # $1 code $2 step
	printf '%s %s %s %s %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$name" "$branch" "$1" "$2" >> "$ship_log"
}
leave(){ gg_log "$1" "$2"; exit "$1"; }

ga_lock(){ # <name> <timeout_s> <cmd...>
	local name=$1 timeout=$2 hash lock
	shift 2
	hash=$(printf '%s' "$name" | sha1sum | cut -c1-12)
	lock="${GA_LOCK_DIR:-/run/lock}/git-auto-$hash.lock"
	if [[ ${GIT_AUTO_LOCK_HELD:-} == "$hash" ]]; then
		GIT_AUTO_LOCK_HELD=$hash "$@"
		return $?
	fi
	(
		flock -w "$timeout" 9 || { echo 'skip:locked' >&2; exit 75; }
		GIT_AUTO_LOCK_HELD=$hash "$@"
	) 9>"$lock"
	return $?
}

ga_billing_refused(){ # <slug> <check-run id>... — 0 if GitHub did not start a job for billing/quota (annotation text); 1 otherwise, and on any annotation read failure
	local slug=$1 id msg
	shift
	for id in "$@"; do
		msg=$(gh api "repos/$slug/check-runs/$id/annotations" --jq '.[].message' 2>/dev/null) || return 1
		grep -qE 'job was not started because recent account payments have failed|spending limit needs to be increased' <<<"$msg" && return 0
	done
	return 1
}

ga_ci_watch(){ # <num> <slug> [<head>] — no CI -> 0; CI not started after retries -> 40; other rc kept
	local num=$1 slug=$2 head=${3:-} out rc delay s wf
	local -a delays=(10 20 40)
	out=$(timeout "${GA_CI_CAP:-900}" gh pr checks "$num" -R "$slug" --watch 2>&1); rc=$?
	[[ $rc == 0 ]] && return 0
	[[ $out == *"no checks reported"* ]] || return "$rc"
	if [[ -n ${GA_CI_BACKOFF:-} ]]; then
		read -r -a delays <<< "$GA_CI_BACKOFF"
		if [[ ${#delays[@]} -eq 1 ]]; then
			s=${delays[0]}
			delays=( $((10*s)) $((20*s)) $((40*s)) )
		fi
	fi
	head=${head:-$(git rev-parse HEAD 2>/dev/null)}
	if [[ -n $head ]] && wf=$(git ls-tree -r --name-only "$head" .github/workflows 2>/dev/null); then
		[[ -n $wf ]] || { printf 'no CI: merge on the test output in the PR body\n'; return 0; }
	fi
	for delay in "${delays[@]}"; do
		sleep "$delay"
		out=$(timeout "${GA_CI_CAP:-900}" gh pr checks "$num" -R "$slug" --watch 2>&1); rc=$?
		[[ $rc == 0 ]] && return 0
		[[ $out == *"no checks reported"* ]] || return "$rc"
	done
	printf 'CI not started after 3 tries: run gh pr checks %s --watch later; do not merge\n' "$num" >&2
	return 40
}

ga_ci_wait(){ # pr <slug> <num> [<sha> [<since>]] | sha <slug> <sha> <branch> — 0 ok, 30 absent, 40 fail/timeout, 70 billing/quota
	local kind=$1 slug=$2 b ok bad
	case $kind in
		pr)
			local num=$3 sha=${4:-} since=${5:-} buckets deadline now runs ids rc
			deadline=$(( $(date +%s) + ${GA_CI_APPEAR:-60} ))
			while :; do
				if [[ -n $sha ]]; then
					if [[ -n $since ]]; then
						runs=$(gh run list -R "$slug" --commit "$sha" --event pull_request --json status,createdAt 2>/dev/null) || return 40
						jq -e --arg s "$since" '[.[]|select(.createdAt>=$s)]|length>0' <<<"$runs" >/dev/null 2>&1 && break
					else
						runs=$(gh run list -R "$slug" --commit "$sha" --event pull_request --json status 2>/dev/null) || return 40
						[[ $runs != '[]' ]] && break
					fi
				else
					buckets=$(gh pr checks "$num" -R "$slug" --json bucket -q '.[].bucket' 2>/dev/null)
					[[ -n $buckets ]] && break
				fi
				now=$(date +%s)
				(( now >= deadline )) && return 30
				sleep "${GA_CI_POLL:-15}"
			done
			ga_ci_watch "$num" "$slug" "$sha"; rc=$?
			[[ $rc == 0 ]] && return 0
			[[ $rc == 40 || $rc == 124 ]] && return 40
			buckets=$(gh pr checks "$num" -R "$slug" --json bucket -q '.[].bucket' 2>/dev/null) || return 40
			[[ -n $buckets ]] || return 40
			ok=1
			for b in $buckets; do
				[[ $b == pass || $b == skipping ]] || { ok=0; break; }
			done
			[[ $ok == 1 ]] && return 0
			bad=$(gh pr checks "$num" -R "$slug" --json name,bucket --jq '.[]|select(.bucket=="fail" or .bucket=="cancel")|.name' 2>/dev/null)
			[[ -n $bad ]] && printf '%s\n' "$bad" >&2
			ids=$(gh pr checks "$num" -R "$slug" --json bucket,link --jq '.[]|select(.bucket=="fail" or .bucket=="cancel")|.link' 2>/dev/null | sed -n 's#.*/job/\([0-9][0-9]*\)$#\1#p')
			ga_billing_refused "$slug" $ids && return 70
			return 40
			;;
		sha)
			local sha=$3 branch=$4 deadline now runs ids
			deadline=$(( $(date +%s) + ${GA_CI_CAP:-900} ))
			while :; do
				runs=$(gh run list -R "$slug" --commit "$sha" --branch "$branch" --json status,conclusion 2>/dev/null) || return 40
				if jq -e 'length>0 and all(.[]; .status=="completed") and all(.[]; .conclusion=="success")' <<<"$runs" >/dev/null 2>&1; then
					return 0
				fi
				now=$(date +%s)
				if jq -e 'length>0 and all(.[]; .status=="completed")' <<<"$runs" >/dev/null 2>&1; then
					ids=$(gh api "repos/$slug/commits/$sha/check-runs" --jq '.check_runs[]|select(.conclusion=="failure" or .conclusion=="cancelled")|.id' 2>/dev/null)
					ga_billing_refused "$slug" $ids && return 70
				fi
				(( now >= deadline )) && return 40
				sleep "${GA_CI_POLL:-15}"
			done
			;;
	esac
}

ga_branch_unmerged(){ # <branch> in current GIT_DIR — 0 if unmerged vs prod (ga_base, fallback main)
	local branch=$1 mb changed ref prod=main
	for ref in $(git for-each-ref --format='%(refname)' refs/delivered/); do
		git merge-base --is-ancestor "$branch" "$ref" && return 1
	done
	read -r _ _ prod <<< "$(ga_base "${GA_LIVE:-}" local 2>/dev/null)" 2>/dev/null || prod=main
	[[ -n ${prod:-} ]] || prod=main
	git rev-parse -q --verify refs/remotes/origin/$prod >/dev/null 2>&1 || return 1
	mb=$(git merge-base origin/$prod "$branch") || return 1
	changed=$(git diff --name-only "$mb" "$branch") || return 1
	[[ -n $changed ]] || return 1
	git diff --quiet origin/$prod "$branch" -- $changed
	(( $? == 0 )) && return 1 || return 0
}

ga_live_sync(){ # <name> <merge_sha> <merge_ms> [<pm2>] — пост-шаги ship; печатает <rc> <step>
	local name=$1 merge_sha=$2 merge_ms=$3 reload=${4:-} rc=0 step=live up
	"$bin/git-sync" "$name" >/dev/null
	"$bin/git-state" --live "$name" "$merge_sha" >/dev/null || { echo err:live >&2; rc=60; step=live; }
	if [[ -n $reload ]]; then
		pm2 startOrReload "${GA_ECOSYSTEM:-/root/workspaces/tools/ecosystem.config.js}" --only "$reload" >/dev/null
		up=$(pm2 jlist | jq -r --arg n "$reload" '.[]|select(.name==$n)|.pm2_env.pm_uptime')
		[[ ${up:-0} -gt $merge_ms ]] || { echo err:reload >&2; rc=60; step=reload; }
	fi
	printf '%s %s\n' "$rc" "$step"
}
