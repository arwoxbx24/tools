#!/usr/bin/env bash
# sdk-agent — the only route to the Claude Agent SDK engine (ask, code + read modes).
# TZ: docs/tz/2026-10-16-dcfg-sktr5-sdk-agent.md
set -uo pipefail

readonly MODEL="claude-haiku-5-5"
readonly ENGINE="/root/workspaces/tools/claude-agent-sdk-venv/lib/python3.12/site-packages/claude_agent_sdk/_bundled/claude"
readonly KEY_FILE="/root/workspaces/secrets/inbox/anthropic.env"
readonly RUNS_LOG="${SDK_AGENT_RUNS_LOG:-/root/workspaces/tools/sdk-agent/runs.jsonl}"
readonly DEFAULT_BUDGET="0.50"
readonly MAX_BUDGET="2.00"
readonly DAILY_CAP="3.00"
readonly MAX_FILE_BYTES=204800
readonly CODE_SCHEMA='{"type":"object","properties":{"files":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"content":{"type":"string"}},"required":["path","content"]}}},"required":["files"]}'

RESULT=""
BUDGET=""
EFFORT=""
SCHEMA=""
SYSFILE=""
POS=()

usage() {
cat <<'EOF'
usage: sdk-agent ask [--budget USD] [--effort low|medium|high] [--schema JSON] [--system-file FILE] PROMPT
       sdk-agent code [--budget USD] [--effort low|medium|high] WORKTREE TZ_FILE
       sdk-agent read [--budget USD] [--effort low|medium|high] WORKTREE TZ_FILE
       sdk-agent --help
code: model may read the whole worktree; TZ line "Check: <executable inside worktree> [args]" is run after writing, no shell (rc 7 on failure).
Runs the Claude Agent SDK engine with model claude-haiku-5-5 and an API key (never the subscription).
sdk-agent is a paid API program, not a Claude Code agent or subagent.
Budget: default 0.50 USD per run, ceiling 2.00 USD. Every result is appended to tools/sdk-agent/runs.jsonl.
Daily cap: 3.00 USD of runs (today, local time) across all modes.
EOF
}

die() {  # MESSAGE [RC]
  printf 'sdk-agent: %s\n' "$1" >&2
  exit "${2:-2}"
}

validate_budget() {
  local re='^[0-9]+(\.[0-9]+)?$'
  if [[ $1 =~ $re ]] && awk -v b="$1" -v max="$MAX_BUDGET" 'BEGIN { exit !(b + 0 > 0 && b + 0 <= max + 0) }'; then
    return 0
  fi
  die "refused: --budget $1 (allowed 0 < USD <= $MAX_BUDGET, e.g. --budget 0.10)"
}

validate_effort() {
  case "$1" in
    low|medium|high) ;;
    *) die "refused: --effort $1 (allowed low|medium|high, e.g. --effort low)" ;;
  esac
}

# Sets BUDGET EFFORT SCHEMA SYSFILE POS from the arguments of MODE.
parse_args() {
  local mode=$1
  shift
  BUDGET=$DEFAULT_BUDGET
  EFFORT=""
  SCHEMA=""
  SYSFILE=""
  POS=()
  while (( $# > 0 )); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --budget|--effort|--schema|--system-file)
        (( $# >= 2 )) || die "$1 needs a value"
        if [[ $mode != ask && ( $1 == --schema || $1 == --system-file ) ]]; then
          die "unknown option for $mode: $1"
        fi
        case "$1" in
          --budget) BUDGET=$2 ;;
          --effort) EFFORT=$2 ;;
          --schema) SCHEMA=$2 ;;
          --system-file) SYSFILE=$2 ;;
        esac
        shift 2
        ;;
      --)
        shift
        POS+=("$@")
        break
        ;;
      --*) die "unknown option: $1" ;;
      *)
        POS+=("$1")
        shift
        ;;
    esac
  done
}

# check_daily_cap BUDGET — refuses (exit 6) if spent today + BUDGET exceeds DAILY_CAP.
check_daily_cap() {
  local budget=$1 midnight spent
  midnight=$(date -d 'today 00:00' +%s)
  spent=0
  if [[ -e $RUNS_LOG ]]; then
    spent=$(jq -s --argjson m "$midnight" \
      '[.[] | select((.ts | type) == "number" and .ts >= $m) | (.total_cost_usd // 0)] | add // 0' "$RUNS_LOG") \
      || die "cannot read runs log: $RUNS_LOG" 6
  fi
  if awk -v s="$spent" -v b="$budget" -v c="$DAILY_CAP" 'BEGIN { exit !(s + b > c + 0) }'; then
    die "refused: daily cap $DAILY_CAP USD (spent $spent today)" 6
  fi
}

# run_engine EFFORT BUDGET PROMPT [SCHEMA] [SYSTEM_FILE] [TOOLS] [WORKDIR]
# TOOLS empty = no tools (--tools ""); otherwise comma-separated tool list with
# permission restrictions and WORKDIR as the only added directory.
# Checks the daily cap, loads the key (only here, after all argument checks), calls the engine,
# appends the JSON result to runs.jsonl (with ts) and sets RESULT.
run_engine() {
  local effort=$1 budget=$2 prompt=$3 schema=${4:-} sysfile=${5:-} tools=${6:-} workdir=${7:-.}
  check_daily_cap "$budget"
  [[ -r $KEY_FILE ]] || die "key file missing: $KEY_FILE" 3
  set -a
  . "$KEY_FILE"
  set +a

  local -a args=(-p --bare --model "$MODEL" --effort "$effort" --max-budget-usd "$budget")
  if [[ -n $tools ]]; then
    args+=(--tools "$tools" --allowedTools "${tools//,/ }" --permission-mode dontAsk --restricted --add-dir "$workdir")
  else
    args+=(--tools "")
  fi
  args+=(--no-session-persistence --output-format json)
  if [[ -n $schema ]]; then args+=(--json-schema "$schema"); fi
  if [[ -n $sysfile ]]; then args+=(--append-system-prompt-file "$sysfile"); fi

  RESULT=$(cd -- "$workdir" && "$ENGINE" "${args[@]}" "$prompt" < /dev/null) || true
  jq -e 'type == "object"' <<<"$RESULT" >/dev/null 2>&1 || die "engine returned no JSON result" 4
  jq -c --argjson ts "$(date +%s)" '. + {ts: $ts}' <<<"$RESULT" >> "$RUNS_LOG"
}

# Prints the run summary to stderr; exits 4 unless subtype is success.
finish() {
  local subtype cost
  subtype=$(jq -r '.subtype // "null"' <<<"$RESULT")
  cost=$(jq -r '.total_cost_usd // "null"' <<<"$RESULT")
  printf 'sdk-agent: subtype=%s cost_usd=%s\n' "$subtype" "$cost" >&2
  if [[ $subtype != success ]]; then exit 4; fi
}

cmd_ask() {
  parse_args ask "$@"
  EFFORT=${EFFORT:-low}
  validate_budget "$BUDGET"
  validate_effort "$EFFORT"
  (( ${#POS[@]} == 1 )) || die "ask needs exactly one PROMPT (see --help)"
  [[ -n ${POS[0]} ]] || die "PROMPT is empty"
  if [[ -n $SYSFILE && ! -r $SYSFILE ]]; then die "system file not readable: $SYSFILE"; fi

  run_engine "$EFFORT" "$BUDGET" "${POS[0]}" "$SCHEMA" "$SYSFILE"
  jq -r 'if .structured_output != null then (.structured_output | tojson) else (.result // "") end' <<<"$RESULT"
  finish
}

# check_path WORKTREE_REAL PATH — refuses (exit 2) unsafe TZ-listed paths.
check_path() {
  local wt=$1 p=$2 part base resolved
  local -a parts
  [[ $p != /* ]] || die "refused path: $p"
  IFS=/ read -r -a parts <<<"$p"
  for part in "${parts[@]}"; do
    case "$part" in
      ..|.git|.beads|.repowise|.ssh|secrets|node_modules) die "refused path: $p" ;;
    esac
  done
  base=${p##*/}
  case "$base" in
    .env*|*.pem|*.key|*secret*|auth.json) die "refused path: $p" ;;
  esac
  resolved=$(realpath -m -- "$wt/$p")
  [[ $resolved == "$wt"/* ]] || die "refused path: $p"
}

# open_worktree — from POS[0] (WORKTREE) and POS[1] (TZ_FILE) sets globals
# WT_REAL (realpath of the worktree root) and TZ (the TZ file). Refuses (exit 2) otherwise.
open_worktree() {
  local wt=${POS[0]}
  TZ=${POS[1]}

  [[ -d $wt ]] || die "worktree not found: $wt"
  local top
  WT_REAL=$(realpath -- "$wt")
  top=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || die "not a git worktree: $wt"
  [[ $top == "$WT_REAL" ]] || die "not a worktree root: $wt"

  [[ -r $TZ ]] || die "TZ file not readable: $TZ"
}

# refuse_check TEXT — U3.7: refused Check line, exit 7, nothing run.
refuse_check() {
  printf 'sdk-agent: refused check: %s\n' "$1" >&2
  exit 7
}

# run_check TEXT — runs TEXT as an argv array (no shell) inside WT_REAL and returns its rc.
# TEXT must be: <executable regular file inside the worktree> [args], split on spaces.
run_check() {
  local text=$1 real
  local -a words
  case $text in
    *[\;\&\|\$\`\<\>\(\)\\\'\"]* | *$'\n'*) refuse_check "$text" ;;
  esac
  IFS=' ' read -r -a words <<<"$text"
  (( ${#words[@]} >= 1 )) || refuse_check "$text"
  [[ ${words[0]} != /* ]] || refuse_check "$text"
  case "/${words[0]}/" in
    */../*) refuse_check "$text" ;;
  esac
  real=$(realpath -e -- "$WT_REAL/${words[0]}" 2>/dev/null) || refuse_check "$text"
  [[ $real == "$WT_REAL"/* && -f $real && -x $real ]] || refuse_check "$text"
  (cd -- "$WT_REAL" && "./${words[0]}" "${words[@]:1}")
}

cmd_code() {
  parse_args code "$@"
  EFFORT=${EFFORT:-medium}
  validate_budget "$BUDGET"
  validate_effort "$EFFORT"
  (( ${#POS[@]} == 2 )) || die "code needs WORKTREE and TZ_FILE (see --help)"
  open_worktree

  local -a files=()
  mapfile -t files < <({ sed -n -E 's/^FILE: (.+)$/\1/p' "$TZ"; grep -m1 '^Files:' "$TZ" | tr '\140' '\n' | sed -n '2~2p'; } | awk '!seen[$0]++')
  (( ${#files[@]} >= 1 && ${#files[@]} <= 20 )) || die "TZ must list 1..20 paths ('FILE: <path>' lines or a 'Files:' line) (found ${#files[@]})"

  local f
  for f in "${files[@]}"; do
    check_path "$WT_REAL" "$f"
    if [[ -f $WT_REAL/$f ]] && (( $(wc -c < "$WT_REAL/$f") > MAX_FILE_BYTES )); then
      die "file larger than 200 KB: $f"
    fi
  done

  local prompt body
  prompt="<task>
$(cat -- "$TZ")
</task>
"
  for f in "${files[@]}"; do
    if [[ -f $WT_REAL/$f ]]; then body=$(cat -- "$WT_REAL/$f"); else body="(new file)"; fi
    prompt+="<file path=\"$f\">
$body
</file>
"
  done
  prompt+="Return the FULL new content of each file you change, as JSON {\"files\":[{\"path\":...,\"content\":...}]}. Use only the paths listed above; do not change other files. You may read any file of the repository with Read, Grep, Glob."

  run_engine "$EFFORT" "$BUDGET" "$prompt" "$CODE_SCHEMA" "" "Read,Grep,Glob" "$WT_REAL"
  finish
  jq -e '.structured_output.files | type == "array"' <<<"$RESULT" >/dev/null 2>&1 \
    || die "engine returned no files array" 4

  # Output guard: every path must be exactly one of the allowed paths; write nothing otherwise.
  local -a out_paths=()
  mapfile -t out_paths < <(jq -r '.structured_output.files[].path' <<<"$RESULT")
  local op allowed
  for op in "${out_paths[@]}"; do
    allowed=0
    for f in "${files[@]}"; do
      if [[ $op == "$f" ]]; then allowed=1; fi
    done
    if (( allowed == 0 )); then
      printf 'sdk-agent: refused model path: %s\n' "$op" >&2
      exit 5
    fi
  done

  # Write each file: temp file inside the target directory, then mv.
  local n i target tmp
  n=$(jq '.structured_output.files | length' <<<"$RESULT")
  for (( i = 0; i < n; i++ )); do
    target="$WT_REAL/$(jq -r --argjson i "$i" '.structured_output.files[$i].path' <<<"$RESULT")"
    mkdir -p -- "$(dirname -- "$target")"
    tmp=$(mktemp -- "$target.tmp.XXXXXX")
    if [[ -e $target ]]; then chmod --reference="$target" "$tmp"; else chmod 644 "$tmp"; fi
    jq -j --argjson i "$i" '.structured_output.files[$i].content' <<<"$RESULT" > "$tmp"
    mv -f -- "$tmp" "$target"
  done

  git -C "$WT_REAL" diff --stat
  git -C "$WT_REAL" status --short

  # Validation: first TZ line starting with "Check: " runs inside the worktree (no shell).
  local check_line check_text rc=0
  check_line=$(grep -m1 '^Check: ' "$TZ") || check_line=""
  if [[ -n $check_line ]]; then
    check_text=${check_line#Check: }
    run_check "$check_text" || rc=$?
    printf 'sdk-agent: check rc=%s\n' "$rc" >&2
    (( rc == 0 )) || exit 7
  fi
}

cmd_read() {
  parse_args read "$@"
  EFFORT=${EFFORT:-medium}
  validate_budget "$BUDGET"
  validate_effort "$EFFORT"
  (( ${#POS[@]} == 2 )) || die "read needs WORKTREE and TZ_FILE (see --help)"
  open_worktree

  local prompt
  prompt="$(cat -- "$TZ")

Answer from the repository files; you may only read (Read, Grep, Glob). Reply with the answer text."

  run_engine "$EFFORT" "$BUDGET" "$prompt" "" "" "Read,Grep,Glob" "$WT_REAL"
  jq -r '.result // ""' <<<"$RESULT"
  finish
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ask) shift; cmd_ask "$@" ;;
    code) shift; cmd_code "$@" ;;
    read) shift; cmd_read "$@" ;;
    "") usage >&2; exit 2 ;;
    *) die "unknown mode: $1 (see --help)" ;;
  esac
}

main "$@"
