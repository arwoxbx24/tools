#!/usr/bin/env bash
# sdk-agent — the only route to the Claude Agent SDK engine (ask, code + read modes).
# TZ: docs/tz/2026-10-16-dcfg-sktr5-sdk-agent.md
set -uo pipefail

readonly MODEL="claude-haiku-5-5"
readonly ENGINE="/root/workspaces/tools/claude-agent-sdk-venv/lib/python3.12/site-packages/claude_agent_sdk/_bundled/claude"
readonly KEY_FILE="/root/workspaces/secrets/inbox/anthropic.env"
readonly ENGINE_HOME="/root/workspaces/tools/sdk-agent/engine-home"
if [[ ${SDK_AGENT_TEST:-} == 1 ]]; then
  readonly RUNS_LOG="${SDK_AGENT_RUNS_LOG:-/root/workspaces/tools/sdk-agent/runs.jsonl}"
  readonly TEST_ENGINE="${SDK_AGENT_ENGINE:-}"
  readonly DAILY_CAP="${SDK_AGENT_TEST_CAP:-7.00}"
else
  readonly RUNS_LOG="/root/workspaces/tools/sdk-agent/runs.jsonl"
  readonly TEST_ENGINE=""
  readonly DAILY_CAP="7.00"
fi
readonly DEFAULT_BUDGET="0.50"
readonly MAX_BUDGET="2.00"
readonly MAX_FILE_BYTES=204800
readonly TOOLS_CODE="Read,Grep,Glob,Skill"
readonly TOOLS_READ="Read,Grep,Glob,Skill,WebSearch,WebFetch"
readonly MCP_CONFIG='{"mcpServers":{"repowise":{"type":"stdio","command":"/root/.local/bin/repowise","args":["mcp","--no-workspace"]}}}'
readonly CODE_SCHEMA='{"type":"object","properties":{"edits":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"old":{"type":"string"},"new":{"type":"string"}},"required":["path","old","new"]}}},"required":["edits"]}'

RESULT=""
BUDGET=""
EFFORT=""
SCHEMA=""
SYSFILE=""
JSONOUT=0
POS=()
FILES=()
KEY_VARS=()

usage() {
cat <<'EOF'
usage: sdk-agent ask [--budget USD] [--effort low|medium|high|xhigh|max] [--schema JSON] [--system-file FILE] [--json] PROMPT
       sdk-agent code [--budget USD] [--effort low|medium|high|xhigh|max] WORKTREE TZ_FILE
       sdk-agent read [--budget USD] [--effort low|medium|high|xhigh|max] [--json] WORKTREE TZ_FILE
       sdk-agent cap --json
       sdk-agent --help
code: model may read the whole worktree and returns exact edits (path, old, new) to listed files; TZ line "Check: <executable inside worktree> [args]" is run after writing, no shell (rc 7 on failure); the Check executable must not be a listed file.
--json (ask, read): print the whole engine result JSON instead of the text.
Runs the Claude Agent SDK engine with model claude-haiku-5-5 and an API key (never the subscription).
Engine config dir: tools/sdk-agent/engine-home (no login stored there).
sdk-agent is a paid API program, not a Claude Code agent or subagent.
Budget: default 0.50 USD per run, ceiling 2.00 USD. Every result is appended to tools/sdk-agent/runs.jsonl.
Daily cap: 7.00 USD of runs (today, local time) across all modes.
EOF
}

die() {  # MESSAGE [RC]
  printf 'sdk-agent: %s\n' "$1" >&2
  exit "${2:-2}"
}

validate_budget() {
  local re='^[0-9]+(\.[0-9]+)?$'
  if [[ $1 =~ $re ]] && awk -v b="$1" -v max="$MAX_BUDGET" 'BEGIN { exit !(b + 0 > 0 && b + 0 <= max + 0) }'; then
    return 0
  fi
  die "refused: --budget $1 (allowed 0 < USD <= $MAX_BUDGET, e.g. --budget 0.10)"
}

validate_effort() {
  case "$1" in
    low|medium|high|xhigh|max) ;;
    *) die "refused: --effort $1 (allowed low|medium|high|xhigh|max, e.g. --effort low)" ;;
  esac
}

# Sets BUDGET EFFORT SCHEMA SYSFILE JSONOUT POS from the arguments of MODE.
parse_args() {
  local mode=$1
  shift
  BUDGET=$DEFAULT_BUDGET
  EFFORT=""
  SCHEMA=""
  SYSFILE=""
  JSONOUT=0
  POS=()
  while (( $# > 0 )); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --json)
        if [[ $mode == code ]]; then die "unknown option for $mode: $1"; fi
        JSONOUT=1
        shift
        ;;
      --budget|--effort|--schema|--system-file)
        (( $# >= 2 )) || die "$1 needs a value"
        if [[ $mode != ask && ( $1 == --schema || $1 == --system-file ) ]]; then
          die "unknown option for $mode: $1"
        fi
        case "$1" in
          --budget) BUDGET=$2 ;;
          --effort) EFFORT=$2 ;;
          --schema) SCHEMA=$2 ;;
          --system-file) SYSFILE=$2 ;;
        esac
        shift 2
        ;;
      --)
        shift
        POS+=("$@")
        break
        ;;
      --*) die "unknown option: $1" ;;
      *)
        POS+=("$1")
        shift
        ;;
    esac
  done
}

# reservation_dead RUN_ID — rc 0 when nothing of the run lives: its lock is free, or it has no lock and its pid is gone.
reservation_dead() {
  local run_id=$1 lock="$RUNS_LOG.inflight.d/$1.lock" pid=${1%%-*}
  if [[ -e $lock ]]; then
    flock -n "$lock" true
  else
    [[ $pid =~ ^[0-9]+$ && ! -e /proc/$pid ]]
  fi
}

# rule: a reservation counts while its run lives (lock held or pid alive); a dead run is folded into the ledger once.
# fold_dead_reservations — under RUNS_LOG.lock: each dead in-flight run goes to the ledger once as aborted and leaves the in-flight file.
fold_dead_reservations() {
  local inflight="$RUNS_LOG.inflight" line run_id ts budget cost source tmp
  local -a lines=()
  [[ -s $inflight ]] || return 0
  mapfile -t lines < "$inflight"
  for line in "${lines[@]}"; do
    run_id=$(jq -r '.run_id' <<<"$line")
    reservation_dead "$run_id" || continue
    ts=$(jq -c '.ts' <<<"$line")
    budget=$(jq -c '.budget' <<<"$line")
    cost=$budget
    source=upper-bound
    if [[ -e $RUNS_LOG.inflight.d/$run_id.lock && -e $RUNS_LOG.inflight.d/$run_id.out ]] \
      && jq -e '.total_cost_usd | type == "number"' "$RUNS_LOG.inflight.d/$run_id.out" >/dev/null 2>&1; then
      cost=$(jq -c '.total_cost_usd' "$RUNS_LOG.inflight.d/$run_id.out")
      source=result
    fi
    jq -cn --arg id "$run_id" --argjson ts "$ts" --argjson budget "$budget" --argjson cost "$cost" --arg src "$source" \
      '{subtype: "aborted", mode: "aborted", run_id: $id, ts: $ts, budget: $budget, total_cost_usd: $cost, cost_source: $src, models: [], workdir: "", usage: {}}' >> "$RUNS_LOG" \
      || die "cannot append runs log: $RUNS_LOG" 6
    tmp=$(mktemp -- "$inflight.tmp.XXXXXX") || die "cannot write in-flight file: $inflight" 6
    jq -c --arg id "$run_id" 'select(.run_id != $id)' "$inflight" > "$tmp" \
      && mv -f -- "$tmp" "$inflight" \
      || { rm -f -- "$tmp"; die "cannot update in-flight file: $inflight" 6; }
    rm -f -- "$RUNS_LOG.inflight.d/$run_id.lock" "$RUNS_LOG.inflight.d/$run_id.out"
  done
}

# cap_state — read-only (no lock, no writes): today's spent, live and dead in-flight reservations, and left, as JSON.
cap_state() {
  local midnight spent=0 rows run_id budget reserved aborted_bound
  local -a live=() dead=()
  midnight=$(date -d 'today 00:00' +%s)
  if [[ -e $RUNS_LOG ]]; then
    spent=$(jq -s --argjson m "$midnight" --argjson max "$MAX_BUDGET" \
      '[.[] | select((.ts | type) == "number" and .ts >= $m) | (.total_cost_usd // $max)] | add // 0' "$RUNS_LOG") \
      || die "cannot read runs log: $RUNS_LOG" 6
  fi
  if [[ -e $RUNS_LOG.inflight ]]; then
    rows=$(jq -r --argjson m "$midnight" \
      'select((.ts | type) == "number" and .ts >= $m) | [.run_id, .budget] | @tsv' "$RUNS_LOG.inflight") \
      || die "cannot read in-flight file: $RUNS_LOG.inflight" 6
    while IFS=$'\t' read -r run_id budget; do
      [[ -n $run_id ]] || continue
      if reservation_dead "$run_id"; then dead+=("$budget"); else live+=("$budget"); fi
    done <<<"$rows"
  fi
  reserved=$(jq -n '$ARGS.positional | map(tonumber) | add // 0' --args "${live[@]}") || die "cannot sum reservations" 6
  aborted_bound=$(jq -n '$ARGS.positional | map(tonumber) | add // 0' --args "${dead[@]}") || die "cannot sum reservations" 6
  jq -cn --argjson cap "$DAILY_CAP" --argjson spent "$spent" --argjson reserved "$reserved" \
    --argjson n "${#dead[@]}" --argjson bound "$aborted_bound" '
    def r: (. * 100 | round) / 100;
    {cap: ($cap | r), spent: ($spent | r), reserved: ($reserved | r), aborted: $n,
     aborted_bound: ($bound | r), left: ([0, $cap - $spent - $reserved - $bound] | max | r)}'
}

# check_daily_cap BUDGET — refuses (exit 6) if spent + reserved + aborted (cap_state) plus BUDGET exceeds DAILY_CAP.
check_daily_cap() {
  local budget=$1 state used
  state=$(cap_state) || exit 6
  used=$(jq -r '((.spent + .reserved + .aborted_bound) * 100 | round) / 100' <<<"$state")
  if awk -v u="$used" -v b="$budget" -v c="$DAILY_CAP" 'BEGIN { exit !(u + b > c + 0) }'; then
    die "refused: daily cap $DAILY_CAP USD (spent $used today)" 6
  fi
}

# run_engine MODE EFFORT BUDGET PROMPT [SCHEMA] [SYSTEM_FILE] [TOOLS] [WORKDIR]
# TOOLS empty = no tools (--tools ""); otherwise comma-separated tool list with
# permission restrictions, the repowise MCP server only and WORKDIR as the only added directory.
# Fail-closes the spend ledger, loads the key only for the engine call, checks the daily cap
# and reserves the budget in-flight under flock, runs the engine with no lock held, then appends a trimmed result
# (subtype, cost, ts, mode, models, workdir, usage: input/output/cache_read/cache_creation tokens) to runs.jsonl
# and releases the reservation, setting RESULT.
# Refuses (exit 4) when the engine used any model outside the pin.
run_engine() {
  local mode=$1 effort=$2 budget=$3 prompt=$4 schema=${5:-} sysfile=${6:-} tools=${7:-} workdir=${8:-.}
  local -a args=(-p --model "$MODEL" --effort "$effort" --max-budget-usd "$budget" --restricted --strict-mcp-config)
  if [[ -n $tools ]]; then
    args+=(--tools "$tools" --allowedTools "${tools//,/ } mcp__repowise" --permission-mode dontAsk --add-dir "$workdir" --mcp-config "$MCP_CONFIG")
  else
    args+=(--tools "")
  fi
  args+=(--no-session-persistence --output-format json --exclude-dynamic-system-prompt-sections)
  if [[ -n $schema ]]; then args+=(--json-schema "$schema"); fi
  if [[ -n $sysfile ]]; then args+=(--append-system-prompt-file "$sysfile"); fi
  if [[ ${SDK_AGENT_TEST:-} == 1 && ${SDK_AGENT_DRY_ARGS:-} == 1 ]]; then
    printf '%s\n' "${args[@]}"
    exit 0
  fi
  : >> "$RUNS_LOG" || die "runs log not writable: $RUNS_LOG" 6

  local engine=$ENGINE key_load=1
  local -a no_key=()
  if [[ -n $TEST_ENGINE ]]; then
    engine=$TEST_ENGINE
    key_load=0
    no_key=(-u ANTHROPIC_API_KEY)
  fi
  if (( key_load )); then
    [[ -r $KEY_FILE ]] || die "key file missing: $KEY_FILE" 3
    KEY_VARS=()
    mapfile -t KEY_VARS < <(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\2/p' "$KEY_FILE")
  fi

  mkdir -p -- "$ENGINE_HOME" || die "cannot create engine config dir: $ENGINE_HOME" 6
  if [[ -e $ENGINE_HOME/.credentials.json || -L $ENGINE_HOME/.credentials.json ]]; then
    die "refused: credentials found in $ENGINE_HOME" 6
  fi

  local lockfd runfd run_id tmp outf inflight="$RUNS_LOG.inflight"
  exec {lockfd}>"$RUNS_LOG.lock" || die "cannot open lock: $RUNS_LOG.lock" 6
  flock "$lockfd" || die "cannot lock: $RUNS_LOG.lock" 6
  fold_dead_reservations
  check_daily_cap "$budget"
  run_id="$$-$(date +%s%N)"
  jq -cn --arg id "$run_id" --argjson ts "$(date +%s)" --arg b "$budget" \
    '{run_id: $id, ts: $ts, budget: ($b | tonumber)}' >> "$inflight" \
    || die "cannot write in-flight file: $inflight" 6
  mkdir -p -- "$inflight.d" || die "cannot create run dir: $inflight.d" 6
  exec {runfd}>"$inflight.d/$run_id.lock" || die "cannot open run lock: $inflight.d/$run_id.lock" 6
  flock "$runfd" || die "cannot lock: $inflight.d/$run_id.lock" 6
  outf="$inflight.d/$run_id.out"
  flock -u "$lockfd"

  (cd -- "$workdir" && if (( key_load )); then set -a && . "$KEY_FILE" && set +a; fi && env -u ANTHROPIC_AUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX -u CLAUDE_CODE_USE_FOUNDRY -u ANTHROPIC_PROFILE "${no_key[@]}" CLAUDE_CONFIG_DIR="$ENGINE_HOME" "$engine" "${args[@]}" "Follow the task provided on stdin exactly." <<<"$prompt") > "$outf" || true
  RESULT=$(cat -- "$outf")

  jq -e 'type == "object"' <<<"$RESULT" >/dev/null 2>&1 || die "engine returned no JSON result" 4
  flock "$lockfd" || die "cannot lock: $RUNS_LOG.lock" 6
  jq -c --argjson ts "$(date +%s)" --arg mode "$mode" --arg workdir "$workdir" \
    '{subtype, total_cost_usd, ts: $ts, mode: $mode, models: ((.modelUsage // {}) | keys), workdir: $workdir, usage: ((.usage // {}) | {input_tokens, output_tokens, cache_read_input_tokens, cache_creation_input_tokens})}' <<<"$RESULT" >> "$RUNS_LOG" \
    || die "cannot append runs log: $RUNS_LOG" 6
  if [[ -e $inflight ]]; then
    tmp=$(mktemp -- "$inflight.tmp.XXXXXX") || die "cannot write in-flight file: $inflight" 6
    jq -c --arg id "$run_id" 'select(.run_id != $id)' "$inflight" > "$tmp" \
      && mv -f -- "$tmp" "$inflight" \
      || { rm -f -- "$tmp"; die "cannot update in-flight file: $inflight" 6; }
  fi
  rm -f -- "$inflight.d/$run_id.lock" "$inflight.d/$run_id.out"
  exec {runfd}>&-
  flock -u "$lockfd"
  if ! jq -e --arg m "$MODEL" '(.modelUsage // {}) | keys | all(. == $m)' <<<"$RESULT" >/dev/null 2>&1; then
    die "refused: model outside pin: $(jq -r '(.modelUsage // {}) | keys | join(",")' <<<"$RESULT")" 4
  fi
}

# Prints the run summary to stderr; exits 4 unless subtype is success.
finish() {
  local subtype cost cache_read cache_write
  subtype=$(jq -r '.subtype // "null"' <<<"$RESULT")
  cost=$(jq -r '.total_cost_usd // "null"' <<<"$RESULT")
  cache_read=$(jq -r '.usage.cache_read_input_tokens // "null"' <<<"$RESULT")
  cache_write=$(jq -r '.usage.cache_creation_input_tokens // "null"' <<<"$RESULT")
  printf 'sdk-agent: subtype=%s cost_usd=%s cache_read=%s cache_write=%s\n' "$subtype" "$cost" "$cache_read" "$cache_write" >&2
  if [[ $subtype != success ]]; then exit 4; fi
}

cmd_ask() {
  parse_args ask "$@"
  EFFORT=${EFFORT:-low}
  validate_budget "$BUDGET"
  validate_effort "$EFFORT"
  (( ${#POS[@]} == 1 )) || die "ask needs exactly one PROMPT (see --help)"
  [[ -n ${POS[0]} ]] || die "PROMPT is empty"
  if [[ -n $SYSFILE && ! -r $SYSFILE ]]; then die "system file not readable: $SYSFILE"; fi

  run_engine ask "$EFFORT" "$BUDGET" "${POS[0]}" "$SCHEMA" "$SYSFILE"
  if [[ $JSONOUT == 1 ]]; then
    printf '%s\n' "$RESULT"
  else
    jq -r 'if .structured_output != null then (.structured_output | tojson) else (.result // "") end' <<<"$RESULT"
  fi
  finish
}

# deny_relative DISPLAY RELPATH — refuses (exit 2) when RELPATH hits the denylist,
# matched case-insensitively on each component and on the base name.
deny_relative() {
  local display=$1 rel=$2 part base
  local -a parts
  IFS=/ read -r -a parts <<<"$rel"
  for part in "${parts[@]}"; do
    case "${part,,}" in
      ..|.git|.beads|.repowise|.ssh|secrets|node_modules|.github|.husky) die "refused path: $display" ;;
    esac
  done
  base=${rel##*/}
  case "${base,,}" in
    .env*|*.pem|*.key|*secret*|auth.json|.envrc|.npmrc|.netrc|id_rsa*|*.p12|.gitmodules) die "refused path: $display" ;;
  esac
}

# check_path WORKTREE_REAL PATH — refuses (exit 2) unsafe TZ-listed paths.
check_path() {
  local wt=$1 p=$2 part resolved rel cur
  local -a parts
  [[ $p != /* ]] || die "refused path: $p"

  # Refuse when any existing component is a symlink.
  cur=$wt
  IFS=/ read -r -a parts <<<"$p"
  for part in "${parts[@]}"; do
    [[ -n $part ]] || continue
    cur="$cur/$part"
    [[ -L $cur ]] && die "refused path: $p"
  done

  deny_relative "$p" "$p"

  resolved=$(realpath -m -- "$wt/$p")
  [[ $resolved == "$wt"/* ]] || die "refused path: $p"
  rel=${resolved#"$wt"/}
  deny_relative "$p" "$rel"
}

# open_worktree — from POS[0] (WORKTREE) and POS[1] (TZ_FILE) sets globals
# WT_REAL (realpath of the worktree root) and TZ (the TZ file). Refuses (exit 2) otherwise.
open_worktree() {
  local wt=${POS[0]}
  TZ=${POS[1]}

  [[ -d $wt ]] || die "worktree not found: $wt"
  local top
  WT_REAL=$(realpath -- "$wt")
  top=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || die "not a git worktree: $wt"
  [[ $top == "$WT_REAL" ]] || die "not a worktree root: $wt"

  [[ -r $TZ ]] || die "TZ file not readable: $TZ"
}

# load_listed — sets FILES to the TZ-listed paths (1..20), each checked by check_path and the size cap.
load_listed() {
  local f
  mapfile -t FILES < <({ sed -n -E 's/^FILE: (.+)$/\1/p' "$TZ"; grep -m1 '^Files:' "$TZ" | tr '\140' '\n' | sed -n '2~2p'; } | awk '!seen[$0]++')
  (( ${#FILES[@]} >= 1 && ${#FILES[@]} <= 20 )) || die "TZ must list 1..20 paths ('FILE: <path>' lines or a 'Files:' line) (found ${#FILES[@]})"

  for f in "${FILES[@]}"; do
    check_path "$WT_REAL" "$f"
    if [[ -f $WT_REAL/$f ]] && (( $(wc -c < "$WT_REAL/$f") > MAX_FILE_BYTES )); then
      die "file larger than 200 KB: $f"
    fi
  done
}

# refuse_check TEXT — U3.7: refused Check line, exit 7, nothing run.
refuse_check() {
  printf 'sdk-agent: refused check: %s\n' "$1" >&2
  exit 7
}

# validate_check TEXT — static validation of a Check line; refuses (exit 7) on
# metacharacters, absolute path, `..`, or a non-executable outside the worktree.
validate_check() {
  local text=$1 real
  local -a words
  case $text in
    *[\;\&\|\$\`\<\>\(\)\\\'\"]* | *$'\n'*) refuse_check "$text" ;;
  esac
  IFS=' ' read -r -a words <<<"$text"
  (( ${#words[@]} >= 1 )) || refuse_check "$text"
  [[ ${words[0]} != /* ]] || refuse_check "$text"
  case "/${words[0]}/" in
    */../*) refuse_check "$text" ;;
  esac
  real=$(realpath -e -- "$WT_REAL/${words[0]}" 2>/dev/null) || refuse_check "$text"
  [[ $real == "$WT_REAL"/* && -f $real && -x $real ]] || refuse_check "$text"
}

# run_check TEXT — runs the already-validated TEXT as an argv array (no shell) inside
# WT_REAL, with the API key (and every other key-file variable) stripped via env -u.
run_check() {
  local text=$1 v
  local -a words unset_args
  IFS=' ' read -r -a words <<<"$text"
  unset_args=(-u ANTHROPIC_API_KEY)
  for v in "${KEY_VARS[@]}"; do
    unset_args+=(-u "$v")
  done
  (cd -- "$WT_REAL" && env "${unset_args[@]}" "./${words[0]}" "${words[@]:1}")
}

# apply_edits — applies RESULT's .structured_output.edits to FILES (the TZ-listed paths).
# Every edit is validated in memory first (earlier edits of a file are applied before later ones);
# only when all pass is each changed file written once (temp file + mv). Otherwise exit 5, nothing written.
apply_edits() {
  local n i f op listed line p target tmp res
  local -a changes=()
  jq -e '.structured_output.edits | type == "array"' <<<"$RESULT" >/dev/null 2>&1 \
    || die "engine returned no edits array" 4
  jq -e 'all(.structured_output.edits[]; type == "object" and (.path | type) == "string" and (.old | type) == "string" and (.new | type) == "string")' <<<"$RESULT" >/dev/null 2>&1 \
    || die "refused model output: edits must be {path, old, new} strings" 5

  # Path guard per edit: must be a listed path and resolve under WT_REAL.
  n=$(jq '.structured_output.edits | length' <<<"$RESULT")
  for (( i = 0; i < n; i++ )); do
    op=$(jq -r --argjson i "$i" '.structured_output.edits[$i].path' <<<"$RESULT")
    listed=0
    for f in "${FILES[@]}"; do
      if [[ $op == "$f" ]]; then listed=1; fi
    done
    if (( listed == 0 )) || [[ $(realpath -m -- "$WT_REAL/$op") != "$WT_REAL"/* ]]; then
      printf 'sdk-agent: refused model path: %s\n' "$op" >&2
      exit 5
    fi
  done

  # Current state: every listed path -> its content (raw, trailing newline kept) or null when absent.
  # Kept in the temp file STATE_F, never in argv (a file over 128 KiB would hit MAX_ARG_STRLEN).
  STATE_F=$(mktemp -- "${TMPDIR:-/tmp}/sdk-agent-state.XXXXXX") || die "cannot write state file" 6
  trap 'rm -f -- "$STATE_F" "$STATE_F.next"' EXIT
  printf '{}\n' > "$STATE_F"
  for f in "${FILES[@]}"; do
    if [[ -f $WT_REAL/$f ]]; then
      jq -n --slurpfile ss "$STATE_F" --arg p "$f" --rawfile c "$WT_REAL/$f" '($ss[0]) + {($p): $c}' > "$STATE_F.next" || die "cannot read: $f" 6
    else
      jq -n --slurpfile ss "$STATE_F" --arg p "$f" '($ss[0]) + {($p): null}' > "$STATE_F.next" || die "cannot read: $f" 6
    fi
    mv -f -- "$STATE_F.next" "$STATE_F"
  done

  # Apply the edits in memory. old "" = create (file must not exist); otherwise old must occur exactly once.
  res=$(jq -c --slurpfile ss "$STATE_F" '
    def apply_one($st; $e):
      ($e.path) as $p
      | ($st[$p]) as $cur
      | if $e.old == "" then
          (if $cur != null then error("refused edit: file exists: \($p)") else $st + {($p): $e.new} end)
        elif $cur == null then error("refused edit: not found: \($p)")
        else ($cur | indices($e.old) | length) as $n
          | if $n == 0 then error("refused edit: not found: \($p)")
            elif $n > 1 then error("refused edit: old not unique: \($p)")
            else $st + {($p): ($cur | split($e.old) | join($e.new))} end
        end;
    ($ss[0]) as $s | try {ok: (reduce .structured_output.edits[] as $e ($s; apply_one(.; $e)))} catch {error: .}' <<<"$RESULT") \
    || die "cannot apply edits" 5
  if jq -e 'has("error")' <<<"$res" >/dev/null; then
    die "$(jq -r '.error' <<<"$res")" 5
  fi

  mapfile -t changes < <(jq -c --slurpfile ss "$STATE_F" '.ok | to_entries[] | select(.value != $ss[0][.key]) | {path: .key, content: .value}' <<<"$res")

  # Write each changed file once: temp file inside the target directory, then mv.
  for line in "${changes[@]}"; do
    p=$(jq -r '.path' <<<"$line")
    target="$WT_REAL/$p"
    mkdir -p -- "$(dirname -- "$target")"
    tmp=$(mktemp -- "$target.tmp.XXXXXX")
    if [[ -e $target ]]; then chmod --reference="$target" "$tmp"; else chmod 644 "$tmp"; fi
    jq -j '.content' <<<"$line" > "$tmp"
    mv -f -- "$tmp" "$target"
  done
}

cmd_code() {
  parse_args code "$@"
  EFFORT=${EFFORT:-medium}
  validate_budget "$BUDGET"
  validate_effort "$EFFORT"
  (( ${#POS[@]} == 2 )) || die "code needs WORKTREE and TZ_FILE (see --help)"
  open_worktree
  load_listed

  # Check line: read once, validate statically before the engine (rc 7, nothing written).
  local check_text="" check_line="" check_word_real listed_real f
  local -a pre_words=()
  check_line=$(grep -m1 '^Check: ' "$TZ") || check_line=""
  if [[ -n $check_line ]]; then
    check_text=${check_line#Check: }
    validate_check "$check_text"
    # U1: the Check executable must not be a listed file (the model could rewrite it before Check runs).
    IFS=' ' read -r -a pre_words <<<"$check_text"
    check_word_real=$(realpath -m -- "$WT_REAL/${pre_words[0]:-}")
    for f in "${FILES[@]}"; do
      listed_real=$(realpath -m -- "$WT_REAL/$f")
      if [[ $check_word_real == "$listed_real" ]]; then
        refuse_check "$check_text"
      fi
    done
  fi

  local prompt body
  prompt="<task>
$(cat -- "$TZ")
</task>
"
  for f in "${FILES[@]}"; do
    if [[ -f $WT_REAL/$f ]]; then body=$(cat -- "$WT_REAL/$f"); else body="(new file)"; fi
    prompt+="<file path=\"$f\">
$body
</file>
"
  done
  prompt+="Return only exact edits as JSON {\"edits\":[{\"path\":...,\"old\":...,\"new\":...}]}. \`old\` is an exact, unique fragment of the current file (include enough surrounding lines to be unique); \`new\` replaces it. To create a new file use old \"\" (only when the file does not exist). Do not touch lines the task does not ask for. Use only the paths listed above. You may use Read, Grep, Glob, Skill and the repowise MCP tools."

  run_engine code "$EFFORT" "$BUDGET" "$prompt" "$CODE_SCHEMA" "" "$TOOLS_CODE" "$WT_REAL"
  finish
  apply_edits

  git -C "$WT_REAL" diff --stat
  git -C "$WT_REAL" status --short

  # Run the Check line (already validated); refuse rc 7 on failure.
  local rc=0
  if [[ -n $check_text ]]; then
    run_check "$check_text"
    rc=$?
    printf 'sdk-agent: check rc=%s\n' "$rc" >&2
    (( rc == 0 )) || exit 7
  fi
}

# cmd_apply_edits WORKTREE TZ_FILE RESULT_JSON — test entry (SDK_AGENT_TEST=1 only): applies a prepared engine result.
cmd_apply_edits() {
  (( $# == 3 )) || die "--apply-edits needs WORKTREE TZ_FILE RESULT_JSON"
  POS=("$1" "$2")
  open_worktree
  load_listed
  RESULT=$(cat -- "$3") || die "cannot read: $3"
  apply_edits
}

cmd_read() {
  parse_args read "$@"
  EFFORT=${EFFORT:-medium}
  validate_budget "$BUDGET"
  validate_effort "$EFFORT"
  (( ${#POS[@]} == 2 )) || die "read needs WORKTREE and TZ_FILE (see --help)"
  open_worktree

  local prompt
  prompt="$(cat -- "$TZ")

Answer from the repository files; you may use Read, Grep, Glob, Skill, WebSearch, WebFetch and the repowise MCP tools. Reply with the answer text."

  run_engine read "$EFFORT" "$BUDGET" "$prompt" "" "" "$TOOLS_READ" "$WT_REAL"
  if [[ $JSONOUT == 1 ]]; then
    printf '%s\n' "$RESULT"
  else
    jq -r '.result // ""' <<<"$RESULT"
  fi
  finish
}

# cmd_cap --json — prints cap_state; reads only, no engine, no key load.
cmd_cap() {
  [[ $# -eq 1 && $1 == --json ]] || die "cap needs --json (see --help)"
  cap_state
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ask) shift; cmd_ask "$@" ;;
    code) shift; cmd_code "$@" ;;
    read) shift; cmd_read "$@" ;;
    cap) shift; cmd_cap "$@" ;;
    --apply-edits)
      shift
      [[ ${SDK_AGENT_TEST:-} == 1 ]] || die "unknown mode: --apply-edits (see --help)"
      cmd_apply_edits "$@"
      ;;
    "") usage >&2; exit 2 ;;
    *) die "unknown mode: $1 (see --help)" ;;
  esac
}

main "$@"
