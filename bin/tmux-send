#!/usr/bin/env bash
set -u

t(){ tmux ${TMUX_SEND_SOCKET:+-L "$TMUX_SEND_SOCKET"} "$@"; }

case ${1:-} in -h|--help) echo "usage: tmux-send <target> '<текст>' [--expect '<regex>']  (env TMUX_SEND_SOCKET, TMUX_SEND_SLEEP; до 3 повторов Enter, rc 0 — ожидание найдено, 1 — нет, 2 — ошибка tmux)"; exit 0;; esac
target=${1:-}
text=${2:-}
expect=Working
[[ ${3:-} == --expect ]] && expect=${4:-Working}

if [[ -z $target ]]; then
	echo "tmux-send: no target" >&2
	exit 2
fi

sleep_n=${TMUX_SEND_SLEEP:-2}
err=$(mktemp)
die(){ echo "tmux-send: $(<"$err")" >&2; exit 2; }
trap 'rm -f "$err"' EXIT

if [[ ! $target =~ ^[%@][0-9]+$ ]]; then
	if [[ $target == *:* ]]; then
		sess=${target%%:*}
		win=${target#*:}
	else
		sess=
		win=$target
	fi
	windows=$(t list-windows -a -F $'#{session_name}\t#{window_index}\t#{window_name}\t#{window_id}' 2>"$err") || die
	matches=()
	while IFS=$'\t' read -r session_name window_index window_name window_id; do
		if [[ -n $window_id && $win == "$window_name" ]] && [[ -z $sess || $sess == "$session_name" ]]; then
			matches+=("$window_id")
		fi
	done <<< "$windows"
	if ((${#matches[@]} == 0)); then
		while IFS=$'\t' read -r session_name window_index window_name window_id; do
			if [[ -n $window_id && $win == "$window_index" ]] && [[ -z $sess || $sess == "$session_name" ]]; then
				matches+=("$window_id")
			fi
		done <<< "$windows"
	fi
	if ((${#matches[@]} == 1)); then
		target=${matches[0]}
	elif ((${#matches[@]} > 1)); then
		echo "tmux-send: ambiguous target $target" >&2
		exit 2
	fi
fi

t send-keys -t "$target" -l "$text" 2>"$err" || die
t send-keys -t "$target" Enter 2>>"$err" || die

enters=0
pane=""
for i in 1 2 3; do
	sleep "$sleep_n"
	pane=$(t capture-pane -p -t "$target" 2>>"$err") || die
	if grep -qE -- "$expect" <<<"$pane"; then
		exit 0
	fi
	last=$(grep -v '^[[:space:]]*$' <<<"$pane" | tail -n1)
	if [[ $enters -lt 2 && $last == *"$text"* ]]; then
		t send-keys -t "$target" Enter 2>>"$err" || die
		((enters++))
	fi
done

echo "tmux-send: expect '$expect' not matched" >&2
tail -n 5 <<<"$pane" >&2
exit 1
