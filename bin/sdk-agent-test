#!/usr/bin/env bash
# sdk-agent-test — offline assertions for bin/sdk-agent (no network, no key).
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
ag="$here/sdk-agent"
TMP=$(mktemp -d /tmp/sdk-agent-test.XXXXXX)
trap 'rm -rf -- "$TMP"' EXIT

export SDK_AGENT_TEST=1
# the cases below were written for a 5.00 cap; the cap is 22.00 (owner 25.10), so tests override it (honoured only under SDK_AGENT_TEST)
export SDK_AGENT_TEST_CAP=5.00
# calls without their own ledger must not touch the live runs.jsonl (dcfg-a5bre)
export SDK_AGENT_RUNS_LOG="$TMP/default-runs.jsonl"

# stub engine: stands in for the paid engine; prints a success result that says whether it got the API key
stub="$TMP/stub-engine"
printf '%s\n' '#!/usr/bin/env bash' 'sleep "${STUB_SLEEP:-0}"' 'key=unset; [[ -n ${ANTHROPIC_API_KEY:-} ]] && key=set' 'printf '"'"'{"type":"result","subtype":"success","total_cost_usd":0,"modelUsage":{"claude-haiku-5-5":{}},"result":"%s"}\n'"'"' "$key"' > "$stub"
chmod +x "$stub"
export SDK_AGENT_ENGINE="$stub"
# existing cases must not depend on the host's free memory
printf 'MemAvailable: 8000000 kB\n' > "$TMP/meminfo-default"
export SDK_AGENT_MEMINFO="$TMP/meminfo-default"

pass=0
total=0
check() {  # DESCRIPTION CMD...
  local desc=$1
  shift
  total=$((total + 1))
  if "$@"; then
    pass=$((pass + 1))
  else
    echo "not ok $total: $desc" >&2
  fi
}

# expect_rc_err WANT_RC NEEDLE CMD... — rc must match and stderr must contain NEEDLE.
expect_rc_err() {
  local want=$1 needle=$2 err rc
  shift 2
  err=$("$@" 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq $want && $err == *"$needle"* ]]
}

help_rc0() { "$ag" --help >/dev/null 2>&1; }

help_first_line_usage() {
  local out
  out=$("$ag" --help 2>/dev/null) || return 1
  [[ ${out%%$'\n'*} == usage:* ]]
}

code_refuses_path() {  # TZ_LINE_PATH
  local tz="$TMP/tz-$RANDOM.md"
  printf 'FILE: %s\n' "$1" > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$TMP/wt" "$tz"
}

code_files_line_refuses_path() {
  local tz="$TMP/tz-files.md"
  printf 'Files: `../outside.txt`\n' > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$TMP/wt" "$tz"
}

check_listed_refused() {
  local wt="$TMP/wt-listed" tz="$TMP/tz-listed.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  printf '#!/usr/bin/env bash\nexit 0\n' > "$wt/t.sh"
  chmod +x "$wt/t.sh"
  printf 'Files: `t.sh`\nCheck: t.sh\n' > "$tz"
  expect_rc_err 7 "refused check" "$ag" code "$wt" "$tz"
}

daily_cap_refuses() {
  local log="$TMP/runs-cap.jsonl" now
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":2.5}\n{"ts":%s,"total_cost_usd":2.5}\n' "$now" "$now" > "$log"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

symlink_to_env_refused() {
  local wt="$TMP/wt-sym" tz="$TMP/tz-sym.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  ln -s .env "$wt/notes.md"
  printf 'FILE: notes.md\n' > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$wt" "$tz"
}

env_uppercase_refused() {
  local wt="$TMP/wt-envup" tz="$TMP/tz-envup.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  printf 'FILE: .ENV\n' > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$wt" "$tz"
}

check_metachar_refused() {
  local wt="$TMP/wt-meta" tz="$TMP/tz-meta.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  printf 'FILE: a.md\nCheck: echo hi; echo bye\n' > "$tz"
  expect_rc_err 7 "refused check" "$ag" code "$wt" "$tz"
}

unwritable_runs_log_refuses() {
  local blocker="$TMP/blocker" log="$TMP/blocker/runs.jsonl"
  : > "$blocker"
  expect_rc_err 6 "runs log not writable" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

runs_log_ignored_without_test_flag() {  # read-only cap --json: no engine, no key
  local log="$TMP/runs-ignored.jsonl" now out rc spent
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":3.33}\n' "$now" > "$log"
  out=$(env -u SDK_AGENT_TEST -u SDK_AGENT_TEST_CAP SDK_AGENT_RUNS_LOG="$log" "$ag" cap --json)
  rc=$?
  [[ $rc -eq 0 ]] || return 1
  spent=$(jq -r '.spent' <<<"$out")
  [[ $spent != 3.33 ]] || return 1
  out=$(env SDK_AGENT_TEST=1 SDK_AGENT_RUNS_LOG="$log" "$ag" cap --json) || return 1
  [[ $(jq -r '.spent' <<<"$out") == 3.33 ]]
}

cap_boundary_under_not_refused() {
  local log="$TMP/runs-under.jsonl" now err rc
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":4.50}\n' "$now" > "$log"
  err=$(env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi 2>&1 >/dev/null)
  rc=$?
  [[ $rc -ne 6 && $err != *"daily cap"* ]]
}

cap_boundary_over_refused() {
  local log="$TMP/runs-over.jsonl" now
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":4.51}\n' "$now" > "$log"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

cap_null_cost_counts_as_ceiling() {
  local log="$TMP/runs-null.jsonl" now
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":null}\n{"ts":%s,"total_cost_usd":2.60}\n' "$now" "$now" > "$log"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

# apply_setup DIR CONTENT EDITS_JSON — worktree DIR/wt with a.md=CONTENT (copy in DIR/orig.md),
# TZ DIR/tz.md listing a.md, engine result DIR/edits.json.
apply_setup() {
  local d=$1
  mkdir -p "$d/wt"
  git -C "$d/wt" init -q
  printf '%s' "$2" > "$d/wt/a.md"
  printf '%s' "$2" > "$d/orig.md"
  printf 'FILE: a.md\n' > "$d/tz.md"
  printf '%s' "$3" > "$d/edits.json"
}

# apply_refused DIR NEEDLE — applies DIR/edits.json; rc must be 5, stderr must contain NEEDLE,
# and a.md must stay byte-identical to DIR/orig.md.
apply_refused() {
  local d=$1 needle=$2 err rc
  err=$("$ag" --apply-edits "$d/wt" "$d/tz.md" "$d/edits.json" 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq 5 && $err == *"$needle"* ]] && cmp -s "$d/orig.md" "$d/wt/a.md"
}

apply_edit_once() {
  local d="$TMP/ae-once"
  apply_setup "$d" $'line1\nold line\nline3\n' '{"structured_output":{"edits":[{"path":"a.md","old":"old line","new":"NEW"}]}}'
  "$ag" --apply-edits "$d/wt" "$d/tz.md" "$d/edits.json" >/dev/null 2>&1 || return 1
  printf 'line1\nNEW\nline3\n' | cmp -s - "$d/wt/a.md"
}

apply_not_found() {
  local d="$TMP/ae-missing"
  apply_setup "$d" $'line1\nline2\n' '{"structured_output":{"edits":[{"path":"a.md","old":"absent","new":"x"}]}}'
  apply_refused "$d" "refused edit: not found: a.md"
}

apply_not_unique() {
  local d="$TMP/ae-twice"
  apply_setup "$d" $'x\nx\n' '{"structured_output":{"edits":[{"path":"a.md","old":"x","new":"y"}]}}'
  apply_refused "$d" "refused edit: old not unique: a.md"
}

apply_second_fails() {
  local d="$TMP/ae-second"
  apply_setup "$d" $'one\ntwo\n' '{"structured_output":{"edits":[{"path":"a.md","old":"one","new":"ONE"},{"path":"a.md","old":"nope","new":"z"}]}}'
  apply_refused "$d" "refused edit: not found: a.md"
}

apply_large_file() {  # a.md = 200 009 bytes (above 200 000, under the 204 800 cap); one unique edit at the end
  local d="$TMP/ae-large" before after
  apply_setup "$d" "seed" '{"structured_output":{"edits":[{"path":"a.md","old":"END-MARK","new":"END-REPLACED-LONGER"}]}}'
  { head -c 200000 /dev/zero | tr '\0' 'a'; printf '\nEND-MARK\n'; } > "$d/wt/a.md"
  before=$(stat -c %s "$d/wt/a.md")
  "$ag" --apply-edits "$d/wt" "$d/tz.md" "$d/edits.json" >/dev/null 2>&1 || return 1
  after=$(stat -c %s "$d/wt/a.md")
  [[ $((after - before)) -eq 11 ]] || return 1
  { head -c 200000 /dev/zero | tr '\0' 'a'; printf '\nEND-REPLACED-LONGER\n'; } | cmp -s - "$d/wt/a.md"
}

dry_args_exclude_dynamic() {
  local out rc
  out=$(env SDK_AGENT_DRY_ARGS=1 SDK_AGENT_RUNS_LOG="$TMP/runs-dry.jsonl" "$ag" ask --budget 0.5 hi)
  rc=$?
  [[ $rc -eq 0 ]] && grep -qx -- '--exclude-dynamic-system-prompt-sections' <<<"$out" && [[ ! -e $TMP/runs-dry.jsonl ]]
}

dry_args_ignored_without_test() {
  local out rc
  out=$(env -u SDK_AGENT_TEST SDK_AGENT_DRY_ARGS=1 "$ag" ask --budget 9 hi 2>/dev/null)
  rc=$?
  [[ $rc -eq 2 ]] && ! grep -qx -- '--exclude-dynamic-system-prompt-sections' <<<"$out"
}

inflight_empty() {  # LOG -- no reservation left in LOG.inflight
  [[ ! -s $1.inflight ]]
}

concurrent_asks_overlap() {
  local log="$TMP/runs-concurrent.jsonl" t0 t1 p1 p2 rc1 rc2
  t0=$(date +%s)
  STUB_SLEEP=3 SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi >/dev/null 2>&1 &
  p1=$!
  STUB_SLEEP=3 SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi >/dev/null 2>&1 &
  p2=$!
  wait "$p1"
  rc1=$?
  wait "$p2"
  rc2=$?
  t1=$(date +%s)
  [[ $rc1 -eq 0 && $rc2 -eq 0 ]] && (( t1 - t0 < 5 )) && inflight_empty "$log"
}

cap_counts_inflight() {
  local log="$TMP/runs-inflight.jsonl" now
  now=$(date +%s)
  printf '{"run_id":"x","ts":%s,"budget":4.60}\n' "$now" > "$log.inflight"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi \
    && [[ $(wc -l < "$log.inflight") -eq 1 ]]
}

engine_override_no_key() {
  local log="$TMP/runs-override.jsonl" out rc
  out=$(env ANTHROPIC_API_KEY=leak SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi 2>/dev/null)
  rc=$?
  [[ $rc -eq 0 && $out == unset ]] && inflight_empty "$log"
}

engine_override_test_only() {  # static: SDK_AGENT_ENGINE is read only inside the SDK_AGENT_TEST block
  local block
  block=$(sed -n '/^if \[\[ \${SDK_AGENT_TEST:-} == 1 \]\]; then$/,/^else$/p' "$ag")
  [[ $(grep -c 'SDK_AGENT_ENGINE' "$ag") -eq 1 && $block == *SDK_AGENT_ENGINE* ]]
}

large_prompt_on_stdin() {  # ~200 KB prompt reaches the engine on stdin intact; no argv limit error
  local stub_stdin="$TMP/stub-stdin" tz="$TMP/tz-big.md" copy="$TMP/stdin-big" log="$TMP/runs-big.jsonl" err rc
  cat > "$stub_stdin" <<'STUB'
#!/usr/bin/env bash
cat > "$STUB_STDIN_COPY"
printf '{"type":"result","subtype":"success","total_cost_usd":0,"modelUsage":{"claude-haiku-5-5":{}},"result":"ok"}\n'
STUB
  chmod +x "$stub_stdin"
  head -c 200000 /dev/zero | tr '\0' 'a' > "$tz"
  err=$(env SDK_AGENT_ENGINE="$stub_stdin" STUB_STDIN_COPY="$copy" SDK_AGENT_RUNS_LOG="$log" "$ag" read "$TMP/wt" "$tz" 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq 0 && $err != *"Argument list too long"* ]] && (( $(wc -c < "$copy") >= 200000 )) && head -c 200000 "$copy" | cmp -s - "$tz"
}

dead_pid_reservation_not_counted() {
  local log="$TMP/runs-dead.jsonl" d="$TMP/runs-dead.jsonl.inflight.d" now out
  now=$(date +%s)
  mkdir -p "$d"
  printf '{"run_id":"999999999-1","ts":%s,"budget":0.40}\n{"run_id":"999999998-2","ts":%s,"budget":0.50}\n' "$now" "$now" > "$log.inflight"
  printf '{"total_cost_usd":0.99}\n' > "$d/999999999-1.out"
  : > "$d/999999998-2.lock"
  printf '{"total_cost_usd":0.03}\n' > "$d/999999998-2.out"
  env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi >/dev/null 2>&1 || return 1
  inflight_empty "$log" || return 1
  jq -e -s 'any(.[]; .subtype == "aborted" and .run_id == "999999999-1" and .cost_source == "upper-bound" and .total_cost_usd == 0.4)' "$log" >/dev/null || return 1
  jq -e -s 'any(.[]; .subtype == "aborted" and .run_id == "999999998-2" and .cost_source == "result" and .total_cost_usd == 0.03)' "$log" >/dev/null || return 1
  out=$(env SDK_AGENT_RUNS_LOG="$log" "$ag" cap --json) || return 1
  [[ $(jq -r '.reserved' <<<"$out") == 0 ]] || return 1
  printf 'PASS dead_pid_reservation_not_counted\n'
}

orphan_engine_keeps_reservation() {
  local log="$TMP/runs-orphan.jsonl" d="$TMP/runs-orphan.jsonl.inflight.d" lock holder out i ok=1
  lock="$d/999999997-3.lock"
  mkdir -p "$d"
  printf '{"run_id":"999999997-3","ts":%s,"budget":4.00}\n' "$(date +%s)" > "$log.inflight"
  : > "$lock"
  flock "$lock" sleep 30 &
  holder=$!
  for i in $(seq 50); do flock -n "$lock" true || break; sleep 0.1; done
  out=$(env SDK_AGENT_RUNS_LOG="$log" "$ag" cap --json) || ok=0
  [[ $(jq -r '.reserved' <<<"$out") == 4 ]] || ok=0
  env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi >/dev/null 2>&1 || ok=0
  [[ $(wc -l < "$log.inflight") -eq 1 ]] || ok=0
  jq -e -s 'any(.[]; .subtype == "aborted") | not' "$log" >/dev/null || ok=0
  pkill -P "$holder" 2>/dev/null
  kill "$holder" 2>/dev/null
  wait "$holder" 2>/dev/null
  (( ok )) && printf 'PASS orphan_engine_keeps_reservation\n'
}

cap_json_readonly() {
  local log="$TMP/runs-ro.jsonl" before after out rc
  printf '{"ts":%s,"total_cost_usd":0.25}\n' "$(date +%s)" > "$log"
  printf '{"run_id":"x","ts":%s,"budget":0.30}\n' "$(date +%s)" > "$log.inflight"
  before=$(sha256sum "$log" "$log.inflight")
  out=$(env SDK_AGENT_RUNS_LOG="$log" "$ag" cap --json)
  rc=$?
  after=$(sha256sum "$log" "$log.inflight")
  [[ $rc -eq 0 && $before == "$after" ]] || return 1
  jq -e 'has("cap") and has("spent") and has("reserved") and has("aborted") and has("aborted_bound") and has("left")' <<<"$out" >/dev/null || return 1
  printf 'PASS cap_json_readonly\n'
}

cap_default_seven() {  # no SDK_AGENT_TEST_CAP: the product cap is 22.00
  local out
  out=$(env -u SDK_AGENT_TEST_CAP SDK_AGENT_RUNS_LOG="$TMP/runs-default.jsonl" "$ag" cap --json) || return 1
  [[ $(jq -r '.cap' <<<"$out") == 22 ]]
}

ledger_records_tz() {
  local tz="$TMP/tz-ledger.md" log="$TMP/runs-tz.jsonl"
  printf 'read only\n' > "$tz"
  env SDK_AGENT_ENGINE="$stub" SDK_AGENT_RUNS_LOG="$log" "$ag" read "$TMP/wt" "$tz" >/dev/null 2>&1
  [[ $(tail -1 "$log" | jq -r '.tz') == "$tz" ]]
}

ledger_records_model_usage() {
  local stub_usage="$TMP/stub-usage" log="$TMP/runs-mu.jsonl" log0="$TMP/runs-mu0.jsonl"
  printf '%s\n' '#!/usr/bin/env bash' "cat <<'EOF'" '{"type":"result","subtype":"success","total_cost_usd":0.01,"usage":{"input_tokens":3,"output_tokens":5,"cache_read_input_tokens":100,"cache_creation_input_tokens":40},"modelUsage":{"claude-haiku-5-5":{"inputTokens":7,"outputTokens":9,"cacheReadInputTokens":1200,"cacheCreationInputTokens":300,"costUSD":0.01,"contextWindow":200000}},"result":"ok"}' 'EOF' > "$stub_usage"
  chmod +x "$stub_usage"
  env SDK_AGENT_ENGINE="$stub_usage" SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi >/dev/null 2>&1
  [[ $(tail -1 "$log" | jq -c '.model_usage') == '{"claude-haiku-5-5":{"inputTokens":7,"outputTokens":9,"cacheReadInputTokens":1200,"cacheCreationInputTokens":300,"costUSD":0.01}}' ]] || return 1
  env SDK_AGENT_ENGINE="$stub" SDK_AGENT_RUNS_LOG="$log0" "$ag" ask --budget 0.5 hi >/dev/null 2>&1
  [[ $(wc -l < "$log0") -eq 1 ]] || return 1
  [[ $(tail -1 "$log0" | jq -c '.model_usage') == '{"claude-haiku-5-5":{"inputTokens":null,"outputTokens":null,"cacheReadInputTokens":null,"cacheCreationInputTokens":null,"costUSD":null}}' ]]
}

mkdir -p "$TMP/wt"
git -C "$TMP/wt" init -q

check "--help exits 0" help_rc0
check "--help first line starts with usage:" help_first_line_usage
check "--budget 5 -> rc 2 refused" expect_rc_err 2 refused "$ag" ask --budget 5 hi
check "--budget abc -> rc 2" expect_rc_err 2 refused "$ag" ask --budget abc hi
check "--effort extreme -> rc 2 refused" expect_rc_err 2 refused "$ag" ask --effort extreme hi
check "--effort max passes validation (fails on worktree)" expect_rc_err 2 "worktree not found" "$ag" code --effort max "$TMP/nope" "$TMP/tz.md"
check "code --json -> rc 2 refused" expect_rc_err 2 "unknown option for code" "$ag" code --json "$TMP/wt" "$TMP/tz.md"
check "FILE: ../x refused" code_refuses_path "../x"
check "FILE: .env refused" code_refuses_path ".env"
check "FILE: /etc/passwd refused" code_refuses_path "/etc/passwd"
check "FILE: secrets/a refused" code_refuses_path "secrets/a"
check "model is claude-haiku-5-5" bash -c '[[ $(grep -c claude-haiku-5-5 "$1") -ge 1 ]]' _ "$ag"
check "no other claude model names" bash -c '[[ $(grep -cE "claude-(sonnet|opus|fable)" "$1") -eq 0 ]]' _ "$ag"
check "daily cap refuses ask (rc 6)" daily_cap_refuses
check "Files: line ../outside.txt refused" code_files_line_refuses_path
check "Check: names a listed file -> refused check (rc 7)" check_listed_refused
check "read with no args -> rc 2" expect_rc_err 2 "read needs" "$ag" read
check "listed symlink notes.md -> .env refused" symlink_to_env_refused
check "listed .ENV refused (case-insensitive)" env_uppercase_refused
check "Check with metacharacter refused before engine (rc 7)" check_metachar_refused
check "unwritable SDK_AGENT_RUNS_LOG -> rc 6" unwritable_runs_log_refuses
check "SDK_AGENT_RUNS_LOG ignored without SDK_AGENT_TEST" runs_log_ignored_without_test_flag
check "cap boundary: 4.50 + 0.50 not refused" cap_boundary_under_not_refused
check "cap boundary: 4.51 + 0.50 -> rc 6" cap_boundary_over_refused
check "cap: null cost counts as 2.00" cap_null_cost_counts_as_ceiling
check "--apply-edits: one exact edit changes only that fragment" apply_edit_once
check "--apply-edits: old not found -> rc 5, file unchanged" apply_not_found
check "--apply-edits: old found twice -> rc 5, file unchanged" apply_not_unique
check "--apply-edits: 2nd edit fails -> rc 5, 1st not written" apply_second_fails
check "--apply-edits: 200 KB file, one edit at the end applied (no argv limit)" apply_large_file
check "dry args: engine always gets --exclude-dynamic-system-prompt-sections" dry_args_exclude_dynamic
check "dry args ignored without SDK_AGENT_TEST" dry_args_ignored_without_test
check "concurrent: two asks with a 3 s engine finish within 5 s" concurrent_asks_overlap
check "cap counts in-flight reservation: 4.60 reserved + 0.50 -> rc 6" cap_counts_inflight
check "engine override never gets the API key" engine_override_no_key
check "engine override ignored without SDK_AGENT_TEST (static)" engine_override_test_only
check "prompt of ~200 KB reaches the engine on stdin intact (no argv limit)" large_prompt_on_stdin
check "dead reservations folded once (legacy: upper-bound; lock-free .out: result), in-flight empty, reserved 0" dead_pid_reservation_not_counted
check "orphan engine holds its .lock: reservation stays counted, no ledger line" orphan_engine_keeps_reservation
check "cap --json is read-only: sha256 unchanged, rc 0, six keys" cap_json_readonly
check "cap default daily cap is 22.00 (no test override)" cap_default_seven
check "ledger entry records tz of the read run" ledger_records_tz
check "ledger entry records per-model usage (modelUsage tokens; empty entry -> nulls)" ledger_records_model_usage

mem_low_refused() {
  local f="$TMP/meminfo-low" log="$TMP/runs-mem.jsonl" err rc
  printf 'MemAvailable: 100000 kB\n' > "$f"
  err=$(env SDK_AGENT_MEMINFO="$f" SDK_AGENT_RUNS_LOG="$log" "$ag" ask hi 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq 8 && $err == *"sdk-agent: low memory 97 MB < 550 MB, run refused"* && ! -e $log ]]
}

mem_high_passes() {
  local f="$TMP/meminfo-high" out rc
  printf 'MemAvailable: 8000000 kB\n' > "$f"
  out=$(env SDK_AGENT_MEMINFO="$f" SDK_AGENT_DRY_ARGS=1 SDK_AGENT_RUNS_LOG="$TMP/runs-mem2.jsonl" "$ag" ask hi 2>/dev/null)
  rc=$?
  [[ $rc -eq 0 && -n $out ]]
}

mem_recent_alive_refused() {  # 1000 MB free + one recent alive reservation -> need 1100
  local f="$TMP/meminfo-1000" log="$TMP/runs-memrec.jsonl" err rc
  printf 'MemAvailable: 1024000 kB\n' > "$f"
  printf '{"run_id":"%s-1","ts":%s,"budget":0.50}\n' "$$" "$(date +%s)" > "$log.inflight"
  err=$(env SDK_AGENT_MEMINFO="$f" SDK_AGENT_RUNS_LOG="$log" "$ag" ask hi 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq 8 && $err == *"sdk-agent: low memory 1000 MB < 1100 MB, run refused"* && $(wc -l < "$log.inflight") -eq 1 ]]
}

mem_no_recent_passes() {  # 1000 MB free + no recent reservation -> passes the memory check
  local f="$TMP/meminfo-1000b" log="$TMP/runs-memnone.jsonl" err rc
  printf 'MemAvailable: 1024000 kB\n' > "$f"
  err=$(env SDK_AGENT_MEMINFO="$f" SDK_AGENT_RUNS_LOG="$log" "$ag" ask hi 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq 0 && $err != *"low memory"* ]]
}

mem0=$pass
check "low MemAvailable -> rc 8, message, no ledger" mem_low_refused
check "enough MemAvailable passes the memory check" mem_high_passes
check "1000 MB + one recent alive reservation -> rc 8, need 1100 MB" mem_recent_alive_refused
check "1000 MB + no recent reservation passes the memory check" mem_no_recent_passes
echo "sdk-mem ok=$((pass - mem0)) failed=$((4 - (pass - mem0)))"

echo "ok $pass/$total"
[[ $pass -eq $total ]]
if [[ $pass -eq $total ]]; then
  echo "PASS all"
  exit 0
fi
echo "FAIL: $pass/$total"
exit 1
