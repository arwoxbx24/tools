#!/usr/bin/env bash
# sdk-agent-test — offline assertions for bin/sdk-agent (no network, no key).
set -uo pipefail

here=$(cd "$(dirname "$0")" && pwd)
ag="$here/sdk-agent"
TMP=$(mktemp -d /tmp/sdk-agent-test.XXXXXX)
trap 'rm -rf -- "$TMP"' EXIT

export SDK_AGENT_TEST=1

pass=0
total=0
check() {  # DESCRIPTION CMD...
  local desc=$1
  shift
  total=$((total + 1))
  if "$@"; then
    pass=$((pass + 1))
  else
    echo "not ok $total: $desc" >&2
  fi
}

# expect_rc_err WANT_RC NEEDLE CMD... — rc must match and stderr must contain NEEDLE.
expect_rc_err() {
  local want=$1 needle=$2 err rc
  shift 2
  err=$("$@" 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq $want && $err == *"$needle"* ]]
}

help_rc0() { "$ag" --help >/dev/null 2>&1; }

help_first_line_usage() {
  local out
  out=$("$ag" --help 2>/dev/null) || return 1
  [[ ${out%%$'\n'*} == usage:* ]]
}

code_refuses_path() {  # TZ_LINE_PATH
  local tz="$TMP/tz-$RANDOM.md"
  printf 'FILE: %s\n' "$1" > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$TMP/wt" "$tz"
}

code_files_line_refuses_path() {
  local tz="$TMP/tz-files.md"
  printf 'Files: `../outside.txt`\n' > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$TMP/wt" "$tz"
}

check_listed_refused() {
  local wt="$TMP/wt-listed" tz="$TMP/tz-listed.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  printf '#!/usr/bin/env bash\nexit 0\n' > "$wt/t.sh"
  chmod +x "$wt/t.sh"
  printf 'Files: `t.sh`\nCheck: t.sh\n' > "$tz"
  expect_rc_err 7 "refused check" "$ag" code "$wt" "$tz"
}

daily_cap_refuses() {
  local log="$TMP/runs-cap.jsonl" now
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":2.5}\n{"ts":%s,"total_cost_usd":2.5}\n' "$now" "$now" > "$log"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

symlink_to_env_refused() {
  local wt="$TMP/wt-sym" tz="$TMP/tz-sym.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  ln -s .env "$wt/notes.md"
  printf 'FILE: notes.md\n' > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$wt" "$tz"
}

env_uppercase_refused() {
  local wt="$TMP/wt-envup" tz="$TMP/tz-envup.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  printf 'FILE: .ENV\n' > "$tz"
  expect_rc_err 2 "refused path" "$ag" code "$wt" "$tz"
}

check_metachar_refused() {
  local wt="$TMP/wt-meta" tz="$TMP/tz-meta.md"
  mkdir -p "$wt"
  git -C "$wt" init -q
  printf 'FILE: a.md\nCheck: echo hi; echo bye\n' > "$tz"
  expect_rc_err 7 "refused check" "$ag" code "$wt" "$tz"
}

unwritable_runs_log_refuses() {
  local blocker="$TMP/blocker" log="$TMP/blocker/runs.jsonl"
  : > "$blocker"
  expect_rc_err 6 "runs log not writable" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

runs_log_ignored_without_test_flag() {
  local log="$TMP/runs-ignored.jsonl" now err rc
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":10.0}\n' "$now" > "$log"
  err=$(env -u SDK_AGENT_TEST SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi 2>&1 >/dev/null)
  rc=$?
  [[ $rc -ne 6 && $err != *"daily cap"* ]]
}

cap_boundary_under_not_refused() {
  local log="$TMP/runs-under.jsonl" now err rc
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":4.50}\n' "$now" > "$log"
  err=$(env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi 2>&1 >/dev/null)
  rc=$?
  [[ $rc -ne 6 && $err != *"daily cap"* ]]
}

cap_boundary_over_refused() {
  local log="$TMP/runs-over.jsonl" now
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":4.51}\n' "$now" > "$log"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

cap_null_cost_counts_as_ceiling() {
  local log="$TMP/runs-null.jsonl" now
  now=$(date +%s)
  printf '{"ts":%s,"total_cost_usd":null}\n{"ts":%s,"total_cost_usd":2.60}\n' "$now" "$now" > "$log"
  expect_rc_err 6 "daily cap" env SDK_AGENT_RUNS_LOG="$log" "$ag" ask --budget 0.5 hi
}

# apply_setup DIR CONTENT EDITS_JSON — worktree DIR/wt with a.md=CONTENT (copy in DIR/orig.md),
# TZ DIR/tz.md listing a.md, engine result DIR/edits.json.
apply_setup() {
  local d=$1
  mkdir -p "$d/wt"
  git -C "$d/wt" init -q
  printf '%s' "$2" > "$d/wt/a.md"
  printf '%s' "$2" > "$d/orig.md"
  printf 'FILE: a.md\n' > "$d/tz.md"
  printf '%s' "$3" > "$d/edits.json"
}

# apply_refused DIR NEEDLE — applies DIR/edits.json; rc must be 5, stderr must contain NEEDLE,
# and a.md must stay byte-identical to DIR/orig.md.
apply_refused() {
  local d=$1 needle=$2 err rc
  err=$("$ag" --apply-edits "$d/wt" "$d/tz.md" "$d/edits.json" 2>&1 >/dev/null)
  rc=$?
  [[ $rc -eq 5 && $err == *"$needle"* ]] && cmp -s "$d/orig.md" "$d/wt/a.md"
}

apply_edit_once() {
  local d="$TMP/ae-once"
  apply_setup "$d" $'line1\nold line\nline3\n' '{"structured_output":{"edits":[{"path":"a.md","old":"old line","new":"NEW"}]}}'
  "$ag" --apply-edits "$d/wt" "$d/tz.md" "$d/edits.json" >/dev/null 2>&1 || return 1
  printf 'line1\nNEW\nline3\n' | cmp -s - "$d/wt/a.md"
}

apply_not_found() {
  local d="$TMP/ae-missing"
  apply_setup "$d" $'line1\nline2\n' '{"structured_output":{"edits":[{"path":"a.md","old":"absent","new":"x"}]}}'
  apply_refused "$d" "refused edit: not found: a.md"
}

apply_not_unique() {
  local d="$TMP/ae-twice"
  apply_setup "$d" $'x\nx\n' '{"structured_output":{"edits":[{"path":"a.md","old":"x","new":"y"}]}}'
  apply_refused "$d" "refused edit: old not unique: a.md"
}

apply_second_fails() {
  local d="$TMP/ae-second"
  apply_setup "$d" $'one\ntwo\n' '{"structured_output":{"edits":[{"path":"a.md","old":"one","new":"ONE"},{"path":"a.md","old":"nope","new":"z"}]}}'
  apply_refused "$d" "refused edit: not found: a.md"
}

dry_args_exclude_dynamic() {
  local out rc
  out=$(env SDK_AGENT_DRY_ARGS=1 SDK_AGENT_RUNS_LOG="$TMP/runs-dry.jsonl" "$ag" ask --budget 0.5 hi)
  rc=$?
  [[ $rc -eq 0 ]] && grep -qx -- '--exclude-dynamic-system-prompt-sections' <<<"$out" && [[ ! -e $TMP/runs-dry.jsonl ]]
}

dry_args_ignored_without_test() {
  local out rc
  out=$(env -u SDK_AGENT_TEST SDK_AGENT_DRY_ARGS=1 "$ag" ask --budget 9 hi 2>/dev/null)
  rc=$?
  [[ $rc -eq 2 ]] && ! grep -qx -- '--exclude-dynamic-system-prompt-sections' <<<"$out"
}

mkdir -p "$TMP/wt"
git -C "$TMP/wt" init -q

check "--help exits 0" help_rc0
check "--help first line starts with usage:" help_first_line_usage
check "--budget 5 -> rc 2 refused" expect_rc_err 2 refused "$ag" ask --budget 5 hi
check "--budget abc -> rc 2" expect_rc_err 2 refused "$ag" ask --budget abc hi
check "--effort extreme -> rc 2 refused" expect_rc_err 2 refused "$ag" ask --effort extreme hi
check "--effort max passes validation (fails on worktree)" expect_rc_err 2 "worktree not found" "$ag" code --effort max "$TMP/nope" "$TMP/tz.md"
check "code --json -> rc 2 refused" expect_rc_err 2 "unknown option for code" "$ag" code --json "$TMP/wt" "$TMP/tz.md"
check "FILE: ../x refused" code_refuses_path "../x"
check "FILE: .env refused" code_refuses_path ".env"
check "FILE: /etc/passwd refused" code_refuses_path "/etc/passwd"
check "FILE: secrets/a refused" code_refuses_path "secrets/a"
check "model is claude-haiku-5-5" bash -c '[[ $(grep -c claude-haiku-5-5 "$1") -ge 1 ]]' _ "$ag"
check "no other claude model names" bash -c '[[ $(grep -cE "claude-(sonnet|opus|fable)" "$1") -eq 0 ]]' _ "$ag"
check "daily cap refuses ask (rc 6)" daily_cap_refuses
check "Files: line ../outside.txt refused" code_files_line_refuses_path
check "Check: names a listed file -> refused check (rc 7)" check_listed_refused
check "read with no args -> rc 2" expect_rc_err 2 "read needs" "$ag" read
check "listed symlink notes.md -> .env refused" symlink_to_env_refused
check "listed .ENV refused (case-insensitive)" env_uppercase_refused
check "Check with metacharacter refused before engine (rc 7)" check_metachar_refused
check "unwritable SDK_AGENT_RUNS_LOG -> rc 6" unwritable_runs_log_refuses
check "SDK_AGENT_RUNS_LOG ignored without SDK_AGENT_TEST" runs_log_ignored_without_test_flag
check "cap boundary: 4.50 + 0.50 not refused" cap_boundary_under_not_refused
check "cap boundary: 4.51 + 0.50 -> rc 6" cap_boundary_over_refused
check "cap: null cost counts as 2.00" cap_null_cost_counts_as_ceiling
check "--apply-edits: one exact edit changes only that fragment" apply_edit_once
check "--apply-edits: old not found -> rc 5, file unchanged" apply_not_found
check "--apply-edits: old found twice -> rc 5, file unchanged" apply_not_unique
check "--apply-edits: 2nd edit fails -> rc 5, 1st not written" apply_second_fails
check "dry args: engine always gets --exclude-dynamic-system-prompt-sections" dry_args_exclude_dynamic
check "dry args ignored without SDK_AGENT_TEST" dry_args_ignored_without_test

echo "ok $pass/$total"
[[ $pass -eq $total ]]
