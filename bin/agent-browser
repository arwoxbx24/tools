#!/usr/bin/env bash
set -u
VENDOR_ROOT=/root/workspaces/tools/vendor/agent-browser
VENDOR_BIN="$VENDOR_ROOT/node_modules/.bin/agent-browser"
case ${1:-} in
	-h|--help)
		echo "usage: agent-browser <command> [args...]  (local agent-browser 0.39.0, Playwright Chromium, daemon idle 10 s)"
		echo "commands: open <url|file://>, snapshot, act, close --all, --version; daemon starts on first command, exits when idle"
		exit 0;;
	--version)
		echo "agent-browser 0.39.0"
		exit 0;;
esac
if [[ ! -x $VENDOR_BIN ]]; then
	npm install --prefix "$VENDOR_ROOT" agent-browser@0.39.0 || exit 1
fi
: "${AGENT_BROWSER_EXECUTABLE_PATH:=$(ls -1d /root/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | sort -V | tail -1)}"
export AGENT_BROWSER_EXECUTABLE_PATH
: "${AGENT_BROWSER_IDLE_TIMEOUT_MS:=10000}"
export AGENT_BROWSER_IDLE_TIMEOUT_MS
exec "$VENDOR_BIN" "$@"
