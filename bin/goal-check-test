#!/usr/bin/env bash
# goal-check-test — самотест bin/goal-check (TZ T1).
set -o pipefail
d=$(mktemp -d /tmp/goal-check-test.XXXXXX) || { echo "FAIL setup mktemp"; exit 1; }
trap 'rm -rf "$d"' EXIT
printf 'hello\n' > "$d/a.txt"
printf 'alpha\nbeta\n' > "$d/multi.txt"
gc="$(cd "$(dirname "$0")" && pwd)/goal-check"
passed=0

case_fail() { echo "FAIL $1 $2"; }

# 1) all-met
cat > "$d/1.txt" <<EOF
AC1: cat $d/a.txt => hello
AC2: grep -c hello $d/a.txt => >=1
EOF
out=$("$gc" --file "$d/1.txt"); rc=$?
last=$(printf '%s\n' "$out" | tail -n1)
if [ "$rc" -eq 0 ] && [ "$last" = "GOAL=MET" ]; then
  passed=$((passed+1)); echo "PASS all-met GOAL=MET rc=0"
else
  case_fail all-met "rc=$rc last=$last out=$out"
fi

# 2) one-fail
cat > "$d/2.txt" <<EOF
AC1: cat $d/a.txt => hello
AC2: cat $d/a.txt => absent-word
EOF
out=$("$gc" --file "$d/2.txt"); rc=$?
last=$(printf '%s\n' "$out" | tail -n1)
if [ "$rc" -eq 0 ] && [ "$last" = "GOAL=NOT_MET" ]; then
  passed=$((passed+1)); echo "PASS one-fail GOAL=NOT_MET rc=0"
else
  case_fail one-fail "rc=$rc last=$last out=$out"
fi

# 3) empty-output
cat > "$d/3.txt" <<EOF
AC1: find $d -name nomatch => <empty>
EOF
out=$("$gc" --file "$d/3.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1 PASS"* ]] && [[ $out == *"output=empty"* ]]; then
  passed=$((passed+1)); echo "PASS empty-output output=empty AC=PASS"
else
  case_fail empty-output "rc=$rc out=$out"
fi

# 4) unsafe-cmd
cat > "$d/4.txt" <<EOF
AC1: cat $d/a.txt; touch $d/pwned => hello
EOF
out=$("$gc" --file "$d/4.txt"); rc=$?
if [ "$rc" -eq 2 ] && [[ $out == *REFUSED* ]] && [ ! -e "$d/pwned" ]; then
  passed=$((passed+1)); echo "PASS unsafe-cmd refused rc=2"
else
  case_fail unsafe-cmd "rc=$rc out=$out"
fi

# 5) find-delete
cat > "$d/5.txt" <<EOF
AC1: find $d -name a.txt -delete => <empty>
EOF
out=$("$gc" --file "$d/5.txt"); rc=$?
if [ "$rc" -eq 2 ] && [ -e "$d/a.txt" ]; then
  passed=$((passed+1)); echo "PASS find-delete refused rc=2"
else
  case_fail find-delete "rc=$rc out=$out"
fi

# 6) tool-not-test
cat > "$d/6.txt" <<EOF
AC1: /root/workspaces/tools/bin/safe-delete tmp $d/a.txt => removed
EOF
out=$("$gc" --file "$d/6.txt"); rc=$?
if [ "$rc" -eq 2 ] && [[ $out == *REFUSED* ]] && [ -e "$d/a.txt" ]; then
  passed=$((passed+1)); echo "PASS tool-not-test refused rc=2"
else
  case_fail tool-not-test "rc=$rc out=$out"
fi

# 7) write-arg
cat > "$d/7.txt" <<EOF
AC1: git log --output=$d/out.txt => x
EOF
out=$("$gc" --file "$d/7.txt"); rc=$?
if [ "$rc" -eq 2 ] && [ ! -e "$d/out.txt" ]; then
  passed=$((passed+1)); echo "PASS write-arg refused rc=2"
else
  case_fail write-arg "rc=$rc out=$out"
fi

# 8) textconv
cat > "$d/8.txt" <<EOF
AC1: git log --textconv => x
EOF
out=$("$gc" --file "$d/8.txt"); rc=$?
if [ "$rc" -eq 2 ] && [[ $out == *REFUSED* ]]; then
  passed=$((passed+1)); echo "PASS textconv refused rc=2"
else
  case_fail textconv "rc=$rc out=$out"
fi

# 9) multi-line-match
cat > "$d/9.txt" <<EOF
AC1: cat $d/multi.txt => beta
EOF
out=$("$gc" --file "$d/9.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1 PASS rc=0 output=beta"* ]] && [[ $out == *"GOAL=MET"* ]]; then
  passed=$((passed+1)); echo "PASS multi-line-match output=beta"
else
  case_fail multi-line-match "rc=$rc out=$out"
fi

# 10) repeat *-test AC is cached
cat > "$d/10.txt" <<EOF
AC1: /root/workspaces/tools/bin/where-test => PASS
EOF
cat > "$d/10b.txt" <<EOF
AC1: /root/workspaces/tools/bin/where-test => cached rc=0
EOF
out1=$(TEST_ONCE_DIR=$d/to-state "$gc" --file "$d/10.txt"); rc1=$?
out2=$(TEST_ONCE_DIR=$d/to-state "$gc" --file "$d/10b.txt"); rc2=$?
if [ "$rc1" -eq 0 ] && [ "$rc2" -eq 0 ] && [[ $out1 == *GOAL=MET* ]] && [[ $out2 == *GOAL=MET* ]] && [[ $out1 != *cached* ]] && [[ $out2 == *"output=test-once: cached rc=0"* ]]; then
  passed=$((passed+1)); echo "PASS repeat-test cached"
else
  case_fail repeat-test-cached "rc1=$rc1 rc2=$rc2 out1=$out1 out2=$out2"
fi

# 11) other AC always runs
printf 'one\n' > "$d/live.txt"
cat > "$d/11.txt" <<EOF
AC1: cat $d/live.txt => two
EOF
out1=$(TEST_ONCE_DIR=$d/to-state "$gc" --file "$d/11.txt"); rc1=$?
printf 'two\n' > "$d/live.txt"
out2=$(TEST_ONCE_DIR=$d/to-state "$gc" --file "$d/11.txt"); rc2=$?
if [ "$rc1" -eq 0 ] && [ "$rc2" -eq 0 ] && [[ $out1 == *GOAL=NOT_MET* ]] && [[ $out2 == *GOAL=MET* ]] && [[ $out2 != *cached* ]]; then
  passed=$((passed+1)); echo "PASS other-ac-live"
else
  case_fail other-ac-live "rc1=$rc1 rc2=$rc2 out1=$out1 out2=$out2"
fi

# 12) rc-error-fail
cat > "$d/12.txt" <<EOF
AC1: ls $d/missing/tasks.md => tasks.md
EOF
out=$("$gc" --file "$d/12.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1 FAIL rc=2"* ]] && [[ $out == *GOAL=NOT_MET* ]]; then
  passed=$((passed+1)); echo "PASS rc-error-fail FAIL rc=2"
else
  case_fail rc-error-fail "rc=$rc out=$out"
fi

# 13) grep-zero-pass
printf 'alpha\n' > "$d/grep.txt"
cat > "$d/13.txt" <<EOF
AC1: grep -c zzz $d/grep.txt => 0
EOF
out=$("$gc" --file "$d/13.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1 PASS rc=1"* ]] && [[ $out == *GOAL=MET* ]]; then
  passed=$((passed+1)); echo "PASS grep-zero-pass PASS rc=1"
else
  case_fail grep-zero-pass "rc=$rc out=$out"
fi

# 14) shared-tracker
mkdir -p "$d/bin"
cat >"$d/bin/bd" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >"$d/bd-args"
printf '%s\n' '[{"acceptance_criteria":"AC1: cat $d/a.txt => hello"}]'
STUB
chmod 755 "$d/bin/bd"
out=$(cd /tmp && PATH="$d/bin:$PATH" "$gc" dcfg-zz1); rc=$?
last=$(printf '%s\n' "$out" | tail -n1)
if [ "$rc" -eq 0 ] && [ "$last" = "GOAL=MET" ] && grep -Fq -- '-C /root/workspaces/projects show dcfg-zz1' "$d/bd-args"; then
  passed=$((passed+1)); echo "PASS shared-tracker"
else
  case_fail shared-tracker "rc=$rc last=$last out=$out args=$(cat "$d/bd-args" 2>/dev/null)"
fi

# 15) suffix-labels
cat > "$d/15.txt" <<EOF
AC1a: cat $d/a.txt => hello
AC7b: cat $d/a.txt => hello
EOF
out=$("$gc" --file "$d/15.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1a PASS"* ]] && [[ $out == *"AC7b PASS"* ]] && [[ $out == *GOAL=MET* ]]; then
  passed=$((passed+1)); echo "PASS suffix-labels AC1a AC7b"
else
  case_fail suffix-labels "rc=$rc out=$out"
fi

# 16) unparsable AC line refused
cat > "$d/16.txt" <<EOF
AC1: cat $d/a.txt => hello
AC9b: cat $d/a.txt
EOF
out=$("$gc" --file "$d/16.txt"); rc=$?
if [ "$rc" -eq 2 ] && [[ $out == *"REFUSED AC9b reason=parse"* ]] && [[ $out == *GOAL=REFUSED* ]] && [[ $out != *"AC1 PASS"* ]]; then
  passed=$((passed+1)); echo "PASS unparsable-refused rc=2"
else
  case_fail unparsable-refused "rc=$rc out=$out"
fi

# 17) two ACs on the same *-test with different PASS names pass on cached run
cat > "$d/17.txt" <<EOF
AC1a: /root/workspaces/tools/bin/where-test => PASS 1
AC1b: /root/workspaces/tools/bin/where-test => PASS 5
EOF
out=$(TEST_ONCE_DIR=$d/to-replay "$gc" --file "$d/17.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1a PASS"* ]] && [[ $out == *"AC1b PASS"* ]] && [[ $out == *GOAL=MET* ]]; then
  passed=$((passed+1)); echo "PASS cached-test-output AC1a AC1b"
else
  case_fail cached-test-output "rc=$rc out=$out"
fi

# 18) numbered/colon PASS labels satisfy PASS <name>
printf 'PASS 1 other\nPASS 15 haiku_fallback_allowed\nPASS 100: lead_patch_denied\n' > "$d/pass.txt"
cat > "$d/18.txt" <<EOF
AC1a: cat $d/pass.txt => PASS haiku_fallback_allowed
AC1b: cat $d/pass.txt => PASS lead_patch_denied
EOF
out=$("$gc" --file "$d/18.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC1a PASS"* ]] && [[ $out == *"AC1b PASS"* ]] && [[ $out == *GOAL=MET* ]]; then
  passed=$((passed+1)); echo "PASS numbered-pass-labels AC1a AC1b"
else
  case_fail numbered-pass-labels "rc=$rc out=$out"
fi

# 19) closed_by_exclusion
mkdir -p "$d/bin-ok" "$d/bin-missing"
printf '#!/usr/bin/env bash\nexit 0\n' >"$d/bin-ok/bd"
printf '#!/usr/bin/env bash\nexit 1\n' >"$d/bin-missing/bd"
chmod 755 "$d/bin-ok/bd" "$d/bin-missing/bd"
quote='пункт два исключаю, делать не нужно'
printf '{"display":"%s","timestamp":2000}\n' "$quote" >"$d/owner.jsonl"
cat > "$d/ex.txt" <<EOF
AC1: test -d /tmp => <empty>
AC2: test -e /nonexistent-gc => <empty>
EXCLUDE AC2: atom=dcfg-zz2 owner=«$quote»
EOF
out=$(PATH="$d/bin-ok:$PATH" GOAL_CHECK_OWNER_LOG="$d/owner.jsonl" GOAL_CHECK_SINCE_MS=1000 "$gc" --file "$d/ex.txt"); rc=$?
last=$(printf '%s\n' "$out" | tail -n1)
if [ "$rc" -eq 0 ] && [ "$last" = "GOAL=CLOSED" ] && [[ $out == *"AC2 EXCLUDED atom=dcfg-zz2 owner=found"* ]]; then
  passed=$((passed+1)); echo "PASS closed_by_exclusion"
else
  case_fail closed_by_exclusion "rc=$rc last=$last out=$out"
fi

# 20) exclusion_without_atom_not_closed
cat > "$d/noatom.txt" <<EOF
AC1: test -d /tmp => <empty>
AC2: test -e /nonexistent-gc => <empty>
EXCLUDE AC2: owner=«$quote»
EOF
out20a=$(PATH="$d/bin-ok:$PATH" GOAL_CHECK_OWNER_LOG="$d/owner.jsonl" GOAL_CHECK_SINCE_MS=1000 "$gc" --file "$d/noatom.txt"); rc20a=$?
out20b=$(PATH="$d/bin-missing:$PATH" GOAL_CHECK_OWNER_LOG="$d/owner.jsonl" GOAL_CHECK_SINCE_MS=1000 "$gc" --file "$d/ex.txt"); rc20b=$?
if [ "$rc20a" -eq 0 ] && [ "$rc20b" -eq 0 ] && [[ $out20a == *"AC2 EXCLUDE_INVALID reason=no-atom"* ]] && [[ $out20a == *GOAL=NOT_MET* ]] && [[ $out20b == *"AC2 EXCLUDE_INVALID reason=atom-not-found"* ]] && [[ $out20b == *GOAL=NOT_MET* ]]; then
  passed=$((passed+1)); echo "PASS exclusion_without_atom_not_closed"
else
  case_fail exclusion_without_atom_not_closed "rc20a=$rc20a rc20b=$rc20b out20a=$out20a out20b=$out20b"
fi

# 21) exclusion_without_owner_quote_not_closed
printf '{"display":"совсем другой текст","timestamp":2000}\n' >"$d/owner-other.jsonl"
out=$(PATH="$d/bin-ok:$PATH" GOAL_CHECK_OWNER_LOG="$d/owner-other.jsonl" GOAL_CHECK_SINCE_MS=1000 "$gc" --file "$d/ex.txt"); rc=$?
if [ "$rc" -eq 0 ] && [[ $out == *"AC2 EXCLUDE_INVALID reason=quote-not-found"* ]] && [[ $out == *GOAL=NOT_MET* ]]; then
  passed=$((passed+1)); echo "PASS exclusion_without_owner_quote_not_closed"
else
  case_fail exclusion_without_owner_quote_not_closed "rc=$rc out=$out"
fi

# 22) exclusion_agent_text_not_closed
printf '{"display":"Here is a note offered by a side agent: %s","timestamp":2000}\n' "$quote" >"$d/owner-agent.jsonl"
printf '{"display":"%s [ts: 2026-10-27T07:59:33Z]","timestamp":2000}\n' "$quote" >"$d/owner-ts.jsonl"
printf '{"display":"%s","timestamp":500}\n' "$quote" >"$d/owner-old.jsonl"
ok=1; detail=""
for f in owner-agent owner-ts owner-old; do
  out=$(PATH="$d/bin-ok:$PATH" GOAL_CHECK_OWNER_LOG="$d/$f.jsonl" GOAL_CHECK_SINCE_MS=1000 "$gc" --file "$d/ex.txt"); rc=$?
  if [ "$rc" -ne 0 ] || [[ $out != *"AC2 EXCLUDE_INVALID reason=quote-not-found"* ]] || [[ $out != *GOAL=NOT_MET* ]]; then
    ok=0; detail="$detail $f rc=$rc out=$out"
  fi
done
if [ "$ok" -eq 1 ]; then
  passed=$((passed+1)); echo "PASS exclusion_agent_text_not_closed"
else
  case_fail exclusion_agent_text_not_closed "$detail"
fi

# 23) ac_timeout_override
cat > "$d/23.txt" <<EOF
AC1@1: tail -f /dev/null => x
EOF
t0=$SECONDS
out=$("$gc" --file "$d/23.txt"); rc=$?
el=$((SECONDS - t0))
if [ "$rc" -eq 1 ] && [[ $out == "AC1 FAIL rc=124"* ]] && [ "$el" -lt 10 ]; then
  passed=$((passed+1)); echo "PASS ac_timeout_override"
else
  case_fail ac_timeout_override "rc=$rc el=$el out=$out"
fi

# 24) refused_ac_is_not_an_answer
cat > "$d/24.txt" <<EOF
AC1: curl http://example.invalid => 200
EOF
out=$("$gc" --file "$d/24.txt"); rc=$?
last=$(printf '%s\n' "$out" | tail -n1)
if [ "$rc" -ne 0 ] && [[ $out == *"REFUSED AC1 reason=bad-command"* ]] && [ "$last" = "GOAL=REFUSED" ]; then
  passed=$((passed+1)); echo "PASS refused-ac rc=$rc GOAL=REFUSED"
else
  case_fail refused-ac "rc=$rc last=$last out=$out"
fi

# 25) budget-caps-timeouts-at-100s
cat > "$d/25.txt" <<EOF
AC1@60: tail -f /dev/null => x
AC2@60: tail -f /dev/null => x
AC3@60: tail -f /dev/null => x
EOF
t0=$SECONDS
out=$("$gc" --file "$d/25.txt"); rc=$?
el=$((SECONDS - t0))
last=$(printf '%s\n' "$out" | tail -n1)
if [ "$rc" -ne 0 ] && [[ $out == *"AC1 FAIL rc=124 expected=x"* ]] && [[ $out == *"AC2 FAIL rc=124 expected=x"* ]] && [[ $out == *"AC3 FAIL rc=124 budget"* ]] && [ "$last" = "GOAL=NOT_MET" ] && [ "$el" -lt 110 ]; then
  passed=$((passed+1)); echo "PASS budget-caps-timeouts-at-100s"
else
  case_fail budget-caps-timeouts-at-100s "rc=$rc el=$el last=$last out=$out"
fi

# 26) git -C <dir> and gh repo view are read-only and accepted
mkdir -p "$d/bin-gh"
cat >"$d/bin-gh/gh" <<'STUB'
#!/usr/bin/env bash
printf '{"visibility":"PRIVATE"}\n'
STUB
chmod 755 "$d/bin-gh/gh"
cat > "$d/26.txt" <<EOF
AC1: git -C /tmp log -1 => x
AC2: git -C /tmp branch --list x => x
AC3: gh repo view o/r --json visibility => PRIVATE
EOF
out=$(PATH="$d/bin-gh:$PATH" "$gc" --file "$d/26.txt"); rc=$?
ok=0
if [ "$rc" -eq 0 ] && [[ $out != *git-subcmd* ]] && [[ $out != *gh-subcmd* ]] && [[ $out == *"AC3 PASS"* ]]; then ok=1; fi
for c in "git -C /tmp push" "git -C /tmp commit" "gh repo delete o/r"; do
  printf 'AC1: %s => x\n' "$c" > "$d/26n.txt"
  outn=$(PATH="$d/bin-gh:$PATH" "$gc" --file "$d/26n.txt"); rcn=$?
  if [ "$rcn" -ne 2 ] || [[ $outn != *"REFUSED AC1 reason="* ]]; then ok=0; out="$out neg=$c rcn=$rcn outn=$outn"; fi
done
if [ "$ok" -eq 1 ]; then
  passed=$((passed+1)); echo "PASS git-C-and-gh-repo-view"
else
  case_fail git-C-and-gh-repo-view "rc=$rc out=$out"
fi

if [ "$passed" -eq 26 ]; then
  echo "PASS 26/26"
  exit 0
fi
echo "FAIL $passed/26"
exit 1
