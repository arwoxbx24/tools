#!/usr/bin/env bash
set -eu
case ${1:-} in -h|--help) echo "usage: ship-doc-check [base]  (CI-гейт: правка цепочки bin/ship* требует правки docs/ship-post-ARCHITECTURE.md; новый bin/<имя> требует строки в TOOLS-REGISTRY.md; рост существующего bin/<имя> больше 40 строк требует строки \"growth-ok: bin/<имя> <bd-id>\" в коммите)"; exit 0;; esac

growth_max=40
base=${1:-origin/main}
doc=docs/ship-post-ARCHITECTURE.md

changed=$(git diff --name-only "$base...HEAD")
if printf '%s\n' "$changed" | grep -Eq '^bin/(ship|ship-post|git-sync|git-auto-lib|git-state)$' \
  && ! printf '%s\n' "$changed" | grep -Fxq "$doc"; then
  echo 'ship-doc-check: цепочка изменена без docs/ship-post-ARCHITECTURE.md' >&2
  exit 1
fi

failed=0
while IFS= read -r added; do
  [[ -n $added ]] || continue
  name=${added#bin/}
  if ! grep -qF -e "\`$name\`" -e "bin/$name" TOOLS-REGISTRY.md 2>/dev/null; then
    echo "ship-doc-check: bin/$name добавлен без строки в TOOLS-REGISTRY.md" >&2
    failed=1
  fi
done < <(git diff --name-only --diff-filter=A "$base...HEAD" -- bin/)

while IFS=$'\t' read -r added deleted path; do
  [[ -n $added && $added != - ]] || continue
  net=$((added - deleted))
  if (( net > growth_max )) \
    && ! git log --format=%B "$base..HEAD" | grep -Eq "^growth-ok: ${path//./\\.} [a-z]+-[a-z0-9.]+"; then
    echo "ship-doc-check: $path вырос на +$net строк (лимит $growth_max); разделите правку или добавьте в коммит строку \"growth-ok: $path <bd-id ADR>\"" >&2
    failed=1
  fi
done < <(git diff --numstat --diff-filter=M "$base...HEAD" -- bin/)

while IFS= read -r anchor; do
  target=${anchor#\`}
  target=${target%\`}
  file=${target%%:*}
  function=${target#*:}
  if [[ ! -f $file ]] || ! grep -qE "^(function )?${function}\\(\\)" "$file"; then
    echo "ship-doc-check: $anchor" >&2
    failed=1
  fi
done < <(grep -oE '`bin/[[:alnum:]._-]+:[[:alpha:]_][[:alnum:]_]*`' "$doc" || true)

exit "$failed"
