#!/usr/bin/env bash
set -u
case ${1:-} in -h|--help) echo "usage: safe-delete [--bk <каталог>] <file|dir|worktree|tmp|cache|link|restore|purge|dup|repo-autodelete> <path>… | branch <repo> <branch>  (safely deletes and restores approved files or branches)"; exit 0;; esac
BK=${SAFE_DELETE_BK:-/root/workspaces/projects/.agent-work/backup}
GH=${SAFE_DELETE_GH:-true}
mkdir -p "$BK"
led=$BK/ledger.tsv
self=$(realpath -e "$(command -v -- "$0")") || exit 1
allow_git_under=
allow_tracked_under=
allow_tracked_segs=
sandbox=${SAFE_DELETE_SANDBOX:-/root/workspaces/sandbox}
force_copy=
ok_repowise=
declare -A nolink=() gblob=() grepo=() gmode=()
allow_client_wt=
client_pins=()
log_n=
log(){ { flock -x 9 || return 1; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$@" >>"$led" || return 1; log_n=$(wc -l <"$led"); log_n=${log_n//[[:space:]]/}; } 9>>"$led.lock"; }
log_batch(){ { flock -x 9 || return 1; local n; : >>"$led" || return 1; n=$(wc -l <"$led") || return 1; n=${n//[[:space:]]/}; printf '%s\n' "$@" >>"$led" || return 1; log_n=$((n+1)); } 9>>"$led.lock"; }
fail(){ echo "safe-delete: $*" >&2; exit 1; }
refuse(){ echo "safe-delete: $*" >&2; exit 2; }
repo_of(){ local u=$1; u=${u%.git}; [[ $u =~ ([^/:]+)/([^/]+)$ ]] && echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"; }
proc_state(){ local s; s=$(<"$1") || return 1; s=${s##*) }; s=${s%% *}; printf %s "$s"; }
self_contained(){
  local dir=$1 gd url gp rp found=0 repo_dir
  [[ ! -e $dir/.git ]] || [[ -d $dir/.git ]] || return 1
  git -C "$(dirname -- "$dir")" ls-files --error-unmatch -- "$(basename -- "$dir")" >/dev/null 2>&1 && return 1
  while IFS= read -r gd; do
    found=1
    if [[ -d $gd ]]; then
      if [[ ${gd##*/} == .git ]]; then repo_dir=$(dirname -- "$gd"); else repo_dir=$gd; fi
      while IFS= read -r url; do
        [[ $url == /* ]] || return 1
        rp=$(realpath -m -- "$url") || return 1
        [[ $rp == "$dir"/* ]] || return 1
      done < <(git --git-dir="$repo_dir" config --get-regexp '^remote\..*\.url$' 2>/dev/null | awk '{print $NF}')
    elif [[ -f $gd ]]; then
      gp=$(sed -n 's/^gitdir: //p' "$gd") || return 1
      [[ -n $gp ]] || return 1
      [[ $gp == /* ]] || return 1
      rp=$(realpath -m -- "$gp") || return 1
      [[ $rp == "$dir"/* ]] || return 1
    fi
  done < <(find "$dir" \( -name .git -o -name '*.git' \) \( -type d -o -type f \) -print 2>/dev/null | sort)
  [[ $found == 1 ]]
}
git_batch(){
  [[ -z $force_copy ]] || return 0
  local p d root rel rec rest val hh i
  local -A rd=() grp=() lm=() lt=() lf=() hd=()
  local -a rl=() hs=()
  for p in "$@"; do
    [[ -z ${nolink[$p]:-} && $p != *$'\n'* ]] || continue
    d=${p%/*}
    [[ -v rd[$d] ]] || rd[$d]=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null)
    root=${rd[$d]}; [[ -n $root ]] || continue
    rel=${p#"$root"/}; [[ $rel != "$p" ]] || continue
    grp[$root]+="$rel"$'\n'
  done
  for root in "${!grp[@]}"; do
    mapfile -t rl < <(printf %s "${grp[$root]}")
    lm=(); lt=(); lf=(); hd=()
    while IFS= read -r -d '' rec; do
      rel=${rec#*$'\t'}; rest=${rec:2}
      lm[$rel]=${rest%% *}; lt[$rel]=${rec:0:1}
    done < <(git -C "$root" ls-files -s -v -z -- "${rl[@]}")
    while IFS= read -r -d '' rel && IFS= read -r -d '' _ && IFS= read -r -d '' val; do
      [[ $val == lfs ]] && lf[$rel]=1
    done < <(printf '%s\0' "${rl[@]}" | git -C "$root" check-attr -z filter --stdin)
    mapfile -t hs < <(printf '%s\n' "${rl[@]}" | git -C "$root" hash-object --no-filters --stdin-paths)
    ((${#hs[@]} == ${#rl[@]})) || return 1
    while IFS= read -r -d '' rec; do
      rel=${rec#*$'\t'}; read -r _ _ hh <<< "${rec%%$'\t'*}"; hd[$rel]=$hh
    done < <(git -C "$root" ls-tree -z HEAD -- "${rl[@]}")
    for i in "${!rl[@]}"; do
      rel=${rl[i]}; hh=${hd[$rel]:-}
      [[ ${lm[$rel]:-} == 100644 || ${lm[$rel]:-} == 100755 ]] && [[ ${lt[$rel]:-} == H && -z ${lf[$rel]:-} && -n $hh && ${hs[i]} == "$hh" ]] || continue
      gblob[$root/$rel]=${hs[i]}; grepo[$root/$rel]=$root; gmode[$root/$rel]=${lm[$rel]}
    done
  done
}
check_path(){
  if [[ ${2:-} == link ]]; then p=$1; else p=$(realpath -e "$1") || refuse "нет пути: $1"; fi
  check_resolved "$p" "${2:-}"
}
check_resolved(){
  p=$1
  [[ $p == /etc/claude-code/* || $p == "$HOME"/.ssh/* || $p == "$HOME"/.claude/settings*.json ]] && refuse "запрещённый путь: $p"
  local gdirs=/root/workspaces/git-dirs
  [[ $p == "$gdirs"/* && ${p#"$gdirs"/}/ == *.git/* ]] && refuse "запрещённый сегмент: $p"
  if [[ ${2:-} != link ]]; then
    roots=${SAFE_DELETE_ROOTS:-/root/workspaces/projects:/root/workspaces/tools:/root/workspaces/sandbox:/home/gitmirror/state:/root/.claude/projects:/root/.local/share:/root/.local/state:/root/.cache:/root/.config:/root/.claude/skills}
    if [[ -n ${SAFE_DELETE_ROOTS:-} ]]; then
      IFS=: read -ra rts <<< "$roots"; for r in "${rts[@]}"; do [[ $r == /tmp/* ]] || refuse "корень не под /tmp: $r"; done
    fi
    okr=; IFS=: read -ra rts <<< "$roots"; for r in "${rts[@]}"; do [[ $p == "$r" || $p == "$r"/* ]] && { okr=1; break; }; done
    # бэкапы настроек пользователя: 14-дневная копия в BK сохраняет их восстановимыми
    [[ $p == "$HOME"/.claude/settings.json.bak* && $p != "$HOME"/.claude/*/* && -f $p && ! -L $p ]] && okr=1
    [[ $p == "$gdirs"/quarantine-* ]] && okr=1
    [[ $okr ]] || refuse "вне разрешённых корней: $p"
  fi
  for seg in secrets hh-scoring .codex .git .beads; do
    [[ $seg == .git && -n ${allow_git_under:-} && ( $p == "$allow_git_under" || $p == "$allow_git_under"/* ) ]] && continue
    [[ -n ${allow_tracked_under:-} && " $allow_tracked_segs " == *" $seg "* && ( $p == "$allow_tracked_under/$seg" || $p == "$allow_tracked_under/$seg"/* ) ]] && continue
    [[ $p == */"$seg" || $p == */"$seg"/* ]] && refuse "запрещённый сегмент: $p"
  done
  if [[ $p == */clients/* && $p != */clients/*/.agent-work/* ]]; then
    local cdir lw
    cdir=$p; [[ -d $p ]] || cdir=${p%/*}
    lw=$(cd "$cdir" 2>/dev/null && gd=$(realpath -e -- "$(git rev-parse --git-dir)") && gc=$(realpath -e -- "$(git rev-parse --git-common-dir)") && [[ $gd != "$gc" ]] && echo 1)
    [[ -n $allow_client_wt && ${2:-} != link && $lw == 1 ]] || refuse "запрещённый сегмент: $p"
    client_pins+=("$p")
  fi
  if [[ /$p/ == */.repowise*/* ]]; then case "
$ok_repowise
" in *"
$p
"*) ;;
    *) refuse "запрещённый сегмент: $p";; esac; fi
  [[ $p == "$BK" || $p == "$BK"/* ]] && refuse "файл под $BK: $p"
  [[ $p == "$self" ]] && refuse "запрещённый файл: $p"
  [[ ${p##*/} == .env* || ${p##*/} == *.pem || ${p##*/} == *.key ]] && refuse "запрещённый файл: $p"
  case ${p##*/} in auth.json|hosts.yml|credentials*|*token*) refuse "запрещённый файл: $p";; esac
  case $p in "$HOME"/.config/gh|"$HOME"/.config/gh/*|"$HOME"/.config/yandex-cloud|"$HOME"/.config/yandex-cloud/*|"$HOME"/.config/gcloud|"$HOME"/.config/gcloud/*) refuse "запрещённый сегмент: $p";; esac
}
client_pinned(){ local p; for p in "${client_pins[@]}"; do [[ -d $p || -n ${gblob[$p]:-} ]] || refuse "запрещённый сегмент: $p"; done; }
resolve_all(){
  rs=()
  (($#)) || return 0
  local r
  while IFS= read -r -d '' r; do rs+=("$r"); done < <(printf '%s\0' "$@" | xargs -0 -r realpath -e -z --)
  (( ${#rs[@]} == $# )) || refuse "нет пути"
}
batch_delete(){
  local p c d k i=0 gi=0 ci=0 gstart=0 dstart=0 a b same ref repo rec stamp lts cdir
  local -a pins=() cps=() fresh=() devs=() ss=() ds=() bs=() hs=() hd=() bl=()
  local -A upd=() gref=() copy=() out=()
  (($#)) || return 0
  stamp=$(date +%Y%m%d%H%M%S%N); lts=$(date +%Y-%m-%dT%H:%M:%S)
  for p in "$@"; do
    if [[ -z $force_copy && -n ${gblob[$p]:-} ]]; then
      ref="refs/safe-delete/$stamp-$i-${gblob[$p]:0:12}"; repo=${grepo[$p]}
      upd[$repo]+="create $ref ${gblob[$p]}"$'\n'; gref[$p]=$ref; pins+=("$p")
    else cps+=("$p"); fi
    i=$((i+1))
  done
  for repo in "${!upd[@]}"; do printf %s "${upd[$repo]}" | git -C "$repo" update-ref --stdin || return 1; done
  if ((${#pins[@]})); then
    for p in "${pins[@]}"; do printf -v rec '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$lts" git "$p" "${gblob[$p]}" "${grepo[$p]}" "${gref[$p]}" "${gmode[$p]}" -; bl+=("$rec"); done
    log_batch "${bl[@]}" || return 1; gstart=$log_n; bl=()
  fi
  if ((${#cps[@]})); then
    cdir="$BK/files/$(date +%Y%m%d)"; mkdir -p "$cdir" || return 1
    for p in "${cps[@]}"; do
      c="$cdir/${p#/}"
      if [[ -e $c || -L $c ]]; then c="$c.$(date +%H%M%S%N)"; mkdir -p "$(dirname -- "$c")" && cp -p -- "$p" "$c" || return 1
      else fresh+=("$p"); fi
      copy[$p]=$c; ss+=("$p"); ds+=("$c")
    done
    if ((${#fresh[@]})); then
      mapfile -t devs < <(stat -c %d -- "$cdir" "${fresh[@]}")
      same=1; for d in "${devs[@]}"; do [[ $d == "${devs[0]}" ]] || same=; done
      if [[ $same ]] && cp -p -l --parents -t "$cdir" -- "${fresh[@]}"; then :; else cp -p --parents -t "$cdir" -- "${fresh[@]}" || return 1; fi
    fi
    touch -- "${ds[@]}" || return 1
    mapfile -d '' hs < <(sha256sum -z -- "${ss[@]}")
    mapfile -d '' hd < <(sha256sum -z -- "${ds[@]}")
    for k in "${!ss[@]}"; do
      a=${hs[k]:-}; b=${hd[k]:-}
      [[ -n $b && ${a:0:64} == "${b:0:64}" ]] || fail "копия не совпала: ${ss[k]}"
      bs+=("${b:0:64}")
    done
    for k in "${!ss[@]}"; do printf -v rec '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$lts" file "${ss[k]}" - - "${ds[k]}" "${bs[k]}" backup-ok; bl+=("$rec"); done
    log_batch "${bl[@]}" || return 1; bl=()
  fi
  printf '%s\0' "$@" | xargs -0 -r rm -f -- || return 1
  if ((${#ss[@]})); then
    for k in "${!ss[@]}"; do printf -v rec '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$lts" file "${ss[k]}" - - "${ds[k]}" "${bs[k]}" deleted; bl+=("$rec"); done
    log_batch "${bl[@]}" || return 1; dstart=$log_n
  fi
  for p in "${pins[@]}"; do out[$p]="удалено: $p | основание: git ${gref[$p]} | восстановить: safe-delete restore $((gstart+gi))"; gi=$((gi+1)); done
  for p in "${cps[@]}"; do out[$p]="удалено: $p | основание: копия ${copy[$p]} | восстановить: safe-delete restore $((dstart+ci))"; ci=$((ci+1)); done
  for p in "$@"; do echo "${out[$p]}"; done
}
is_cache(){
  local p=$1 s; local -a segs
  [[ $p == "$HOME"/.cache/* ]] && return 0
  [[ $p == */wp-content/cache || $p == */wp-content/cache/* ]] && return 0
  IFS=/ read -ra segs <<< "$p"
  for s in "${segs[@]}"; do
    case $s in .cache|__pycache__|.pytest_cache|.mypy_cache|.ruff_cache|node_modules|.npm|.parcel-cache|.turbo) return 0;; esac
  done
  return 1
}
tracked_in(){
  local p=$1 d root rel
  d=$p; [[ -d $p ]] || d=${p%/*}
  root=$(git -C "$d" rev-parse --show-toplevel 2>/dev/null) || root=
  [[ -n $root ]] || return 1
  rel=${p#"$root"}; rel=${rel#/}; rel=${rel:-.}
  [[ -n $(git -C "$root" ls-files -z -- "$rel") ]]
}
cache_del(){
  local p lts rec
  local -a bl=()
  (($#)) || return 0
  rm -r -- "$@" || return 1
  lts=$(date +%Y-%m-%dT%H:%M:%S)
  for p in "$@"; do printf -v rec '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$lts" cache "$p" - - - - deleted; bl+=("$rec"); done
  log_batch "${bl[@]}" || return 1
  for p in "$@"; do echo "удалено: $p | основание: кэш, без копии"; done
}
[[ $# -ge 1 ]] || refuse 'usage: safe-delete [--bk <каталог>] <file|dir|worktree|tmp|cache|link|restore|purge|dup|repo-autodelete> <path>… | branch <repo> <branch>'
if [[ $1 == --bk ]]; then [[ $# -ge 3 ]] || refuse 'usage'; BK=$2; shift 2; mkdir -p "$BK"; led=$BK/ledger.tsv; fi
cmd=$1; shift
if [[ -n ${SAFE_DELETE_SANDBOX:-} ]]; then [[ $SAFE_DELETE_SANDBOX == /tmp/* ]] || refuse "корень не под /tmp: $SAFE_DELETE_SANDBOX"; fi
if [[ ( $cmd == dir || $cmd == worktree ) && $# -gt 1 ]]; then
  ok_n=0; failed_n=0
  for a in "$@"; do if "$self" --bk "$BK" "$cmd" "$a"; then ok_n=$((ok_n+1)); else failed_n=$((failed_n+1)); fi; done
  echo "итог: ok=$ok_n, failed=$failed_n"
  if ((failed_n == 0)); then exit 0; fi
  exit 2
fi

case "$cmd" in
  repo-autodelete)
    [[ $# -ge 1 ]] || refuse 'usage'; repo=$1
    old=$(gh repo view "$repo" --json deleteBranchOnMerge -q .deleteBranchOnMerge) || exit 1
    log repo "$repo" - - "deleteBranchOnMerge=$old" - start
    gh repo edit "$repo" --delete-branch-on-merge || exit 1
    now=$(gh repo view "$repo" --json deleteBranchOnMerge -q .deleteBranchOnMerge) || exit 1
    if [[ $now == true ]]; then log repo "$repo" - - "deleteBranchOnMerge=$old" - done; exit 0; fi
    exit 1
    ;;
  file)
    [[ $# -ge 1 ]] || refuse 'usage'
    allow_client_wt=1
    resolve_all "$@"
    declare -A seen=(); paths=(); i=0
    for raw in "$@"; do
      p=${rs[i]}; i=$((i+1))
      check_resolved "$p"
      [[ -f $p ]] || refuse "не обычный файл: $p"
      [[ ${seen[$p]:-} ]] && continue
      seen[$p]=1; paths+=("$p"); [[ -L $raw ]] && nolink[$p]=1
    done
    git_batch "${paths[@]}" || exit 1
    client_pinned
    batch_delete "${paths[@]}" || exit 1
    exit 0
    ;;
  cache)
    [[ $# -ge 1 ]] || refuse 'usage'
    mapfile -d '' rs < <(realpath -e -z -- "$@")
    (( ${#rs[@]} == $# )) || { for a in "$@"; do [[ -e $a ]] || refuse "нет пути: $a"; done; refuse "нет пути"; }
    declare -A seen=(); cps=()
    for p in "${rs[@]}"; do
      [[ ${seen[$p]:-} ]] && continue
      seen[$p]=1; check_resolved "$p"; is_cache "$p" || refuse "не кэш: $p"
      tracked_in "$p" && refuse "кэш под git: $p"
      cps+=("$p")
    done
    cache_del "${cps[@]}" || exit 1
    exit 0
    ;;
  tmp)
    [[ $# -ge 1 ]] || refuse 'usage'
    declare -A seen=(); paths=()
    for raw in "$@"; do
      p=$(realpath -e "$raw") || refuse "нет пути: $raw"
      [[ $p == /tmp/* && $p != /tmp ]] || refuse "вне /tmp: $p"
      [[ ${seen[$p]:-} ]] && continue
      seen[$p]=1; paths+=("$p")
    done
    rm -r -- "${paths[@]}" || exit 1
    lts=$(date +%Y-%m-%dT%H:%M:%S); bl=()
    for tp in "${paths[@]}"; do printf -v rec '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' "$lts" tmp "$tp" - - - - deleted; bl+=("$rec"); done
    log_batch "${bl[@]}" || exit 1
    for tp in "${paths[@]}"; do echo "удалено: $tp | основание: tmp, без копии"; done
    exit 0
    ;;
  dir)
    [[ $# -eq 1 ]] || refuse 'usage'; allow_client_wt=1; check_path "$1"; dir=$p; [[ -d $dir ]] || refuse "не каталог: $dir"
    if ((${#client_pins[@]} == 0)) && is_cache "$dir" && ! tracked_in "$dir"; then cache_del "$dir" || exit 1; exit 0; fi
    if [[ $dir == "$sandbox"/test-* && ${dir#"$sandbox"/} != */* ]]; then allow_git_under=$dir; force_copy=1
      for s in .beads .codex; do
        if [[ -e $dir/.git && -e $dir/$s && -n $(git -C "$dir" ls-files -- "$s") && -z $(git -C "$dir" status --porcelain --ignored -- "$s") ]]; then allow_tracked_segs+=" $s"; allow_tracked_under=$dir; fi
        if [[ -d $dir/$s && -z $(find "$dir/$s" ! -type d -print -quit) ]]; then allow_tracked_segs+=" $s"; allow_tracked_under=$dir; fi
      done
    elif [[ $dir == "$sandbox"/* && ${dir#"$sandbox"/} != */* && -d $dir/.git ]] && self_contained "$dir"; then allow_git_under=$dir; force_copy=1
    elif [[ ! -d $dir/.git ]] && self_contained "$dir"; then allow_git_under=$dir; else allow_git_under=; fi
    mapfile -d '' entries < <(find "$dir" -depth -print0); nl=(); for entry in "${entries[@]}"; do [[ -L $entry ]] || nl+=("$entry"); done
    resolve_all "${nl[@]}"; files=()
    for f in "${rs[@]}"; do check_resolved "$f"; [[ -f $f ]] && files+=("$f"); done
    git_batch "${files[@]}" || exit 1
    client_pinned
    batch_delete "${files[@]}" || exit 1
    mapfile -d '' links < <(find "$dir" -type l -print0)
    for link in "${links[@]}"; do
      [[ $link == "$dir" || $link == "$dir"/* ]] || refuse "ссылка вне dir: $link"
      t=$(readlink -- "$link") || exit 1
      log link "$link" - - "$t" - deleted || exit 1
      rm -- "$link" || exit 1
      echo "удалено: $link -> $t | основание: симлинк внутри dir, цель не тронута"
    done
    find "$dir" -depth -type d -empty -exec rmdir -- {} \;
    exit 0
    ;;
  worktree)
    [[ $# -eq 1 ]] || refuse 'usage'; check_path "$1"; wt=$p; [[ -d $wt ]] || refuse "не каталог: $wt"
    common=$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null) || refuse "не worktree: $wt"; [[ $common != .git ]] || refuse "не linked worktree: $wt"
    common=$(realpath -e "$common") || exit 1
    for cwd in /proc/[0-9]*/cwd; do pid=${cwd#/proc/}; pid=${pid%/cwd}; if ! used=$(readlink -- "$cwd"); then [[ ! -d /proc/$pid || $(proc_state "/proc/$pid/stat" 2>/dev/null) == Z ]] && continue; refuse "нечитаемый cwd процесса: $pid"; fi; [[ $used == "$wt" || $used == "$wt"/* ]] && refuse "процесс использует worktree: $pid"; done
    mapfile -d '' files < <({ git -C "$wt" ls-files -z --others; git -C "$wt" ls-files -z --modified; git -C "$wt" diff -z --name-only --cached HEAD; } | while IFS= read -r -d '' rel; do f=$wt/$rel; [[ -f $f && ! -L $f ]] && printf '%s\0' "$f"; done | sort -zu)
    ok_repowise=; for f in "${files[@]}"; do [[ $f == "$wt"/.repowise/* ]] && git -C "$wt" check-ignore -q -- "${f#"$wt"/}" 2>/dev/null && ok_repowise+="
$f"; done
    resolve_all "${files[@]}"; files=("${rs[@]}")
    git_batch "${files[@]}" || exit 1
    copies=(); for f in "${files[@]}"; do [[ -n ${gblob[$f]:-} ]] && continue; check_resolved "$f"; [[ -f $f ]] || refuse "не обычный файл: $f"; copies+=("$f"); done
    sha=$(git -C "$wt" rev-parse HEAD) || exit 1; ref="refs/safe-delete/wt-$(date +%Y%m%d%H%M%S%N)"
    git --git-dir="$common" update-ref "$ref" "$sha" || exit 1
    batch_delete "${copies[@]}" || exit 1
    git --git-dir="$common" worktree remove --force "$wt" || exit 1
    log worktree "$wt" "$sha" "$common" "$ref" - deleted || exit 1
    exit 0
    ;;
  link)
    [[ $# -ge 1 ]] || refuse 'usage'
    [[ -L $1 ]] || refuse "не симлинк: $1"
    p="$(realpath -e "$(dirname -- "$1")")/$(basename -- "$1")" || refuse "нет каталога: $1"
    check_path "$p" link
    live_ok=
    if [[ -e $1 ]]; then
      lroot=${SAFE_DELETE_LIVE_LINK_ROOT:-/root/workspaces/tools}
      lroot=$(realpath -m -- "$lroot") || exit 1
      if [[ -n ${SAFE_DELETE_LIVE_LINK_ROOT:-} ]]; then
        [[ $lroot == /tmp/* ]] || refuse "корень не под /tmp: $lroot"
      fi
      tp=$(realpath -e -- "$1") || refuse "симлинк живой: $1"
      if [[ $p == "$lroot" || $p == "$lroot"/* ]] && [[ $tp == "$lroot" || $tp == "$lroot"/* ]]; then
        live_ok=1
      else
        refuse "симлинк живой: $1"
      fi
    fi
    if [[ -z $live_ok ]]; then
      roots=${SAFE_DELETE_ROOTS:-/root/.claude/skills:/root/.claude/agents}
      if [[ -n ${SAFE_DELETE_ROOTS:-} ]]; then
        IFS=: read -ra rts <<< "$roots"
        for r in "${rts[@]}"; do [[ $r == /tmp/* ]] || refuse "корень не под /tmp: $r"; done
      fi
      okr=; IFS=: read -ra rts <<< "$roots"
      for r in "${rts[@]}"; do [[ $p == "$r" || $p == "$r"/* ]] && { okr=1; break; }; done
      [[ $okr ]] || refuse "вне разрешённых корней: $p"
    fi
    t=$(readlink -- "$p") || exit 1
    log link "$p" - - "$t" - backup-ok || exit 1
    rm -- "$p" || exit 1
    log link "$p" - - "$t" - deleted || exit 1
    echo "удалено: $p -> $t | основание: симлинк, цель не тронута | восстановить: safe-delete restore $log_n"
    exit 0
    ;;
  restore)
    [[ $# -ge 1 ]] || refuse 'usage'; N=$1
    [[ $N =~ ^[1-9][0-9]*$ ]] || refuse "некорректный N: $N"
    line=$(awk -v n="$N" 'NR==n' "$led"); [[ -n $line ]] || refuse "нет строки $N"
    typ=$(cut -f2 <<< "$line"); obj=$(cut -f3 <<< "$line")
    if [[ $typ == branch ]]; then
      repo=${obj%:*}; br=${obj#*:}; sha=$(cut -f4 <<< "$line"); tag=$(cut -f5 <<< "$line"); backup=$(cut -f6 <<< "$line")
      git -C "$repo" push -q origin "$sha:refs/heads/$br" 2>/dev/null \
        || { [[ $tag != - ]] && git -C "$repo" fetch -q origin "refs/tags/$tag" 2>/dev/null \
               || git -C "$repo" fetch -q "$backup" "refs/remotes/origin/$br"; \
             git -C "$repo" push -q origin "$sha:refs/heads/$br"; } || exit 1
      v=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}')
      [[ $v == "$sha" ]] || exit 1
      log branch "$obj" - "$tag" - - restored
    elif [[ $typ == file ]]; then
      cp=$(cut -f6 <<< "$line")
      [[ -e $obj ]] && refuse "исходный путь уже существует: $obj"
      [[ -e $cp || -L $cp ]] || refuse "копия истекла: $cp"
      mkdir -p "$(dirname -- "$obj")" || exit 1
      cp -p "$cp" "$obj" || exit 1
      log file "$obj" - - "$cp" - restored
    elif [[ $typ == git ]]; then
      blob=$(cut -f4 <<< "$line"); repo=$(cut -f5 <<< "$line"); ref=$(cut -f6 <<< "$line"); mode=$(cut -f7 <<< "$line")
      [[ -e $obj || -L $obj ]] && refuse "исходный путь уже существует: $obj"
      mkdir -p "$(dirname -- "$obj")" || exit 1
      git -C "$repo" cat-file blob "$blob" >"$obj" || exit 1
      [[ $mode == 100755 ]] && chmod +x "$obj"
      log git "$obj" "$blob" "$repo" "$ref" - restored
    elif [[ $typ == link ]]; then
      t=$(cut -f6 <<< "$line")
      [[ -e $obj || -L $obj ]] && refuse "исходный путь уже существует: $obj"
      ln -s -- "$t" "$obj" || exit 1
      log link "$obj" - - "$t" - restored || exit 1
    elif [[ $typ == worktree ]]; then
      sha=$(cut -f4 <<< "$line"); repo=$(cut -f5 <<< "$line"); ref=$(cut -f6 <<< "$line")
      [[ -e $obj || -L $obj ]] && refuse "исходный путь уже существует: $obj"
      git -C "$repo" worktree add "$obj" "$sha" || exit 1
      log worktree "$obj" "$sha" "$repo" "$ref" - restored
    else refuse "нельзя восстановить тип: $typ"; fi
    exit 0
    ;;
  dup)
    [[ $# -eq 2 ]] || refuse 'usage: safe-delete dup <copy> <orig-gitdir>'
    copy=$1; orig=$2
    [[ -f $copy && ! -L $copy ]] || refuse "не обычный файл: $copy"
    check_path "$copy"; copy=$p
    if [[ -n ${SAFE_DELETE_DUP_ROOT:-} ]]; then [[ $SAFE_DELETE_DUP_ROOT == /tmp/* ]] || refuse "корень не под /tmp: $SAFE_DELETE_DUP_ROOT"; fi
    dupr=$(realpath -m -- "${SAFE_DELETE_DUP_ROOT:-/root/workspaces/projects/.agent-work}") || exit 1
    [[ $copy == "$dupr"/* ]] || refuse "вне $dupr: $copy"
    [[ $copy == *.bundle || $copy == *.tar ]] || refuse "не .bundle/.tar: $copy"
    git --git-dir="$orig" rev-parse --git-dir >/dev/null 2>&1 && git --git-dir="$orig" fsck --connectivity-only >/dev/null 2>&1 || refuse "оригинал не прошёл fsck"
    if [[ $copy == *.bundle ]]; then
      ids=$(git --git-dir="$orig" bundle list-heads "$copy" 2>/dev/null | awk '{print $1}' | sort -u)
    else
      avail=$(df --output=avail -B1 /tmp | tail -1)
      (( avail >= 2*$(stat -c %s -- "$copy") )) || refuse "мало места в /tmp для проверки: $copy"
      tmpd=$(mktemp -d /tmp/safe-delete-dup.XXXXXX) || exit 1
      trap 'rm -rf "$tmpd"' EXIT
      tar -xf "$copy" -C "$tmpd" --no-same-owner >/dev/null 2>&1
      gds=()
      while IFS= read -r o; do [[ -f ${o%/objects}/HEAD ]] && gds+=("${o%/objects}"); done < <(find "$tmpd" -maxdepth 4 -type d -name objects)
      (( ${#gds[@]} == 1 )) || refuse "в архиве не один git-каталог: $copy"
      gd=${gds[0]}
      ids=$({ find "$gd" -type f \( -name packed-refs -o -path "$gd/refs/*" -o -path "$gd/logs/*" -o -name '*HEAD' \) -exec grep -hoE '\b[0-9a-f]{40}\b' {} + 2>/dev/null | grep -vE '^0{40}$'; git --git-dir="$gd" cat-file --batch-all-objects --batch-check='%(objectname)' 2>/dev/null; } | sort -u)
    fi
    [[ -n $ids ]] || refuse "в копии нет id объектов: $copy"
    n_ids=$(wc -l <<< "$ids"); n_ids=${n_ids//[[:space:]]/}
    chk=$(git --git-dir="$orig" cat-file --batch-check <<< "$ids" 2>/dev/null)
    miss=$(grep -c ' missing$' <<< "$chk")
    [[ $miss == 0 ]] || refuse "в оригинале нет $miss объектов копии"
    [[ $(wc -l <<< "$chk") == "$n_ids" ]] || refuse "проверка объектов не полная: $copy"
    size=$(stat -c %s -- "$copy") || exit 1
    rm -f -- "$copy" || exit 1
    log dup "$copy" "$orig" "$n_ids" - - purged-dup || exit 1
    echo "dup: removed $copy ($size bytes, $n_ids ids verified in $orig)"
    exit 0
    ;;
  purge)
    [[ -f $BK/ledger.tsv ]] || refuse 'нет ledger.tsv'
    n1=$(find "$BK" -maxdepth 1 -type f \( -name '*.bundle' -o -name '*.bundle.diff' \) -mtime +14 | wc -l)
    n2=0; [[ -d $BK/files ]] && n2=$(find "$BK/files" -type f -mtime +14 | wc -l)
    n=$((n1+n2))
    find "$BK" -maxdepth 1 -type f \( -name '*.bundle' -o -name '*.bundle.diff' \) -mtime +14 -delete
    if [[ -d $BK/files ]]; then
      find "$BK/files" -type f -mtime +14 -delete
      find "$BK/files" -mindepth 1 -type d -empty -delete
    fi
    log purge "$n" - - - - purged
    exit 0
    ;;
  branch)
    [[ $# -ge 2 ]] || refuse 'usage: safe-delete branch <repo> <branch>'
    repo=$1; br=$2
    git check-ref-format --branch "$br" >/dev/null || refuse "некорректное имя ветки: $br"
    [[ $br == -* || $br == refs/* || $br == heads/* || $br == *'*'* || $br == *'?'* || $br == *'['* ]] && refuse "некорректное имя ветки: $br"
    [[ $br == main || $br == master || $br == HEAD || $br == codex/* ]] && refuse "отказ по правилу: $br"
    if [[ $GH == true ]]; then
      url=$(git -C "$repo" remote get-url origin) || exit 1
      rr=$(repo_of "$url")
      [[ -n $rr ]] || refuse "не определён repo: $url"
      head_n=$(gh pr list --head "$br" --state open --repo "$rr" --json number -q '.[].number') || fail "gh pr list --head"
      base_n=$(gh pr list --base "$br" --state open --repo "$rr" --json number -q '.[].number') || fail "gh pr list --base"
      [[ -n $head_n || -n $base_n ]] && refuse "открытые PR для $br"
    elif [[ $GH == false ]]; then
      rp=$(realpath "$repo") || exit 1
      [[ $rp == /tmp/* ]] || refuse "repo не под /tmp: $repo"
    else
      refuse "некорректный SAFE_DELETE_GH: $GH"
    fi
    base=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD) || base=
    if [[ -z $base ]]; then
      for b in main master; do
        git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$b" >/dev/null && { base="origin/$b"; break; }
      done
    fi
    [[ -n $base ]] || refuse "нет основной ветки на origin: $repo"
    shah=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}') || exit 1
    if [[ -z $shah ]]; then
      sha=$(git -C "$repo" rev-parse --verify --quiet "refs/heads/$br") || sha=
      arch=$(git -C "$repo" ls-remote origin "refs/tags/archive/${br//\//-}-*" | awk -v s="$sha" '$1==s{print $1}') || exit 1
      if [[ -z $arch ]]; then
        git -C "$repo" merge-base --is-ancestor "$sha" "$base" 2>/dev/null || {
          [[ -n $sha && $GH == true ]] || refuse "нет на origin: $br"
          m=$(gh pr list --head "$br" --state merged --repo "$rr" --json headRefOid -q '.[].headRefOid') || fail "gh pr list --state merged"
          grep -qxF -- "$sha" <<<"$m" || {
            avail=$(df --output=avail -B1 "$BK" | tail -1)
            est=$(git -C "$repo" bundle create - "refs/heads/$br" --not "$base" 2>/dev/null | wc -c)
            (( avail >= 2*est )) || fail "мало места в $BK"
            kf="$BK/$(basename "$repo")-${br//\//-}-$(date +%Y%m%d%H%M%S).bundle"
            git -C "$repo" bundle create "$kf" "refs/heads/$br" --not "$base" >/dev/null 2>&1 || fail "bundle не создан: $kf"
            git -C "$repo" bundle verify "$kf" >/dev/null 2>&1 || fail "bundle не проверен: $kf"
            ks=$(sha256sum "$kf" | cut -d' ' -f1)
            echo "сохранено: $kf | восстановить: git -C $repo fetch $kf $br:$br"
            log branch "$(realpath "$repo"):$br" "$sha" - "$kf" "$ks" backup-ok || exit 1
          }; }
      fi
      git -C "$repo" update-ref -d "refs/heads/$br" "$sha" || exit 1
      log branch "$(realpath "$repo"):$br" "$sha" - - - deleted || exit 1
      exit 0
    fi
    sha=$shah
    git -C "$repo" fetch -q origin "$br" "${base#origin/}" || exit 1
    est=$(git -C "$repo" bundle create - "refs/remotes/origin/$br" --not "$base" 2>/dev/null | wc -c)
    avail=$(df --output=avail -B1 "$BK" | tail -1)
    (( avail >= 2*est )) || fail "мало места в $BK"
    tag="archive/${br//\//-}-$(date +%Y%m%d)"
    st=$(git -C "$repo" ls-remote origin "refs/tags/$tag" | awk -v r="refs/tags/$tag" '$2==r{print $1}') || exit 1
    [[ -n $st && $st != "$sha" ]] && tag="$tag-$(date +%H%M%S)"
    git -C "$repo" push -q origin "$sha:refs/tags/$tag" || exit 1
    f="$BK/$(basename "$repo")-${br//\//-}-$(date +%Y%m%d%H%M%S).bundle"
    if git -C "$repo" bundle create "$f" "refs/remotes/origin/$br" --not "$base" >/dev/null 2>&1; then
      git -C "$repo" bundle verify "$f" >/dev/null 2>&1 || exit 1
      backup=$f; bsum=$(sha256sum "$f" | cut -d' ' -f1)
    else backup=tag-only; bsum=-; fi
    git -C "$repo" diff --name-status "$base" "$sha" >"$f.diff" || true
    obj="$(realpath "$repo"):$br"
    log branch "$obj" "$sha" "$tag" "$backup" "$bsum" backup-ok
    git -C "$repo" push -q --force-with-lease="refs/heads/$br:$shah" origin ":refs/heads/$br" || exit 1
    left=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}')
    [[ -z $left ]] && { log branch "$obj" "$sha" "$tag" "$backup" "$bsum" deleted; exit 0; }
    exit 1
    ;;
  *) refuse 'usage' ;;
esac
