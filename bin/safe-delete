#!/usr/bin/env bash
set -u
BK=${SAFE_DELETE_BK:-/root/workspaces/projects/.agent-work/backup}
GH=${SAFE_DELETE_GH:-true}
mkdir -p "$BK"
led=$BK/ledger.tsv
log(){ printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$@" >>"$led"; }
fail(){ echo "safe-delete: $*" >&2; exit 1; }
refuse(){ echo "safe-delete: $*" >&2; exit 2; }
repo_of(){ local u=$1; u=${u%.git}; [[ $u =~ ([^/:]+)/([^/]+)$ ]] && echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"; }
[[ $# -ge 1 ]] || refuse 'usage: safe-delete [--bk <каталог>] <branch|file|restore|purge|repo-autodelete> …'
if [[ $1 == --bk ]]; then [[ $# -ge 3 ]] || refuse 'usage'; BK=$2; shift 2; mkdir -p "$BK"; led=$BK/ledger.tsv; fi
cmd=$1; shift

case "$cmd" in
  repo-autodelete)
    [[ $# -ge 1 ]] || refuse 'usage'; repo=$1
    old=$(gh repo view "$repo" --json deleteBranchOnMerge -q .deleteBranchOnMerge) || exit 1
    log repo "$repo" - - "deleteBranchOnMerge=$old" - start
    gh repo edit "$repo" --delete-branch-on-merge || exit 1
    now=$(gh repo view "$repo" --json deleteBranchOnMerge -q .deleteBranchOnMerge) || exit 1
    if [[ $now == true ]]; then log repo "$repo" - - "deleteBranchOnMerge=$old" - done; exit 0; fi
    exit 1
    ;;
  file)
    [[ $# -ge 1 ]] || refuse 'usage'
    p=$(realpath -e "$1") || refuse "нет файла: $1"; [[ -f $p ]] || refuse "не обычный файл: $p"
    roots=${SAFE_DELETE_ROOTS:-/root/workspaces/projects:/root/workspaces/tools:/root/workspaces/sandbox:/home/gitmirror/state}
    if [[ -n ${SAFE_DELETE_ROOTS:-} ]]; then
      IFS=: read -ra rts <<< "$roots"
      for r in "${rts[@]}"; do [[ $r == /tmp/* ]] || refuse "корень не под /tmp: $r"; done
    fi
    okr=; IFS=: read -ra rts <<< "$roots"
    for r in "${rts[@]}"; do [[ $p == "$r" || $p == "$r"/* ]] && { okr=1; break; }; done
    [[ $okr ]] || refuse "вне разрешённых корней: $p"
    for seg in secrets hh-scoring clients .codex .git .beads; do [[ $p == */"$seg" || $p == */"$seg"/* ]] && refuse "запрещённый сегмент: $p"; done
    [[ /$p/ == */.repowise*/* ]] && refuse "запрещённый сегмент: $p"
    [[ $p == "$BK" || $p == "$BK"/* ]] && refuse "файл под $BK: $p"
    [[ ${p##*/} == .env* ]] && refuse "запрещённый .env: $p"
    copy="$BK/files/$(date +%Y%m%d)/${p#/}"
    [[ -e $copy || -L $copy ]] && copy="$copy.$(date +%H%M%S%N)"
    mkdir -p "$(dirname -- "$copy")" || exit 1
    cp -p "$p" "$copy" || exit 1
    touch "$copy"
    cmp -s "$p" "$copy" || fail "копия не совпала: $p"
    b=$(sha256sum "$copy" | cut -d' ' -f1)
    log file "$p" - - "$copy" "$b" backup-ok
    rm -- "$p" || exit 1
    log file "$p" - - "$copy" "$b" deleted
    exit 0
    ;;
  restore)
    [[ $# -ge 1 ]] || refuse 'usage'; N=$1
    [[ $N =~ ^[1-9][0-9]*$ ]] || refuse "некорректный N: $N"
    line=$(awk -v n="$N" 'NR==n' "$led"); [[ -n $line ]] || refuse "нет строки $N"
    typ=$(cut -f2 <<< "$line"); obj=$(cut -f3 <<< "$line")
    if [[ $typ == branch ]]; then
      repo=${obj%:*}; br=${obj#*:}; sha=$(cut -f4 <<< "$line"); tag=$(cut -f5 <<< "$line"); backup=$(cut -f6 <<< "$line")
      git -C "$repo" push -q origin "$sha:refs/heads/$br" 2>/dev/null \
        || { [[ $tag != - ]] && git -C "$repo" fetch -q origin "refs/tags/$tag" 2>/dev/null \
               || git -C "$repo" fetch -q "$backup" "refs/remotes/origin/$br"; \
             git -C "$repo" push -q origin "$sha:refs/heads/$br"; } || exit 1
      v=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}')
      [[ $v == "$sha" ]] || exit 1
      log branch "$obj" - "$tag" - - restored
    elif [[ $typ == file ]]; then
      cp=$(cut -f6 <<< "$line")
      [[ -e $obj ]] && refuse "исходный путь уже существует: $obj"
      cp -p "$cp" "$obj" || exit 1
      log file "$obj" - - "$cp" - restored
    else refuse "нельзя восстановить тип: $typ"; fi
    exit 0
    ;;
  purge)
    [[ -f $BK/ledger.tsv ]] || refuse 'нет ledger.tsv'
    n1=$(find "$BK" -maxdepth 1 -type f \( -name '*.bundle' -o -name '*.bundle.diff' \) -mtime +14 | wc -l)
    n2=0; [[ -d $BK/files ]] && n2=$(find "$BK/files" -type f -mtime +14 | wc -l)
    n=$((n1+n2))
    find "$BK" -maxdepth 1 -type f \( -name '*.bundle' -o -name '*.bundle.diff' \) -mtime +14 -delete
    if [[ -d $BK/files ]]; then
      find "$BK/files" -type f -mtime +14 -delete
      find "$BK/files" -mindepth 1 -type d -empty -delete
    fi
    log purge "$n" - - - - purged
    exit 0
    ;;
  branch)
    [[ $# -ge 2 ]] || refuse 'usage'
    repo=$1; br=$2
    git check-ref-format --branch "$br" >/dev/null || refuse "некорректное имя ветки: $br"
    [[ $br == -* || $br == refs/* || $br == heads/* || $br == *'*'* || $br == *'?'* || $br == *'['* ]] && refuse "некорректное имя ветки: $br"
    [[ $br == main || $br == master || $br == HEAD || $br == codex/* ]] && refuse "отказ по правилу: $br"
    if [[ $GH == true ]]; then
      url=$(git -C "$repo" remote get-url origin) || exit 1
      rr=$(repo_of "$url")
      [[ -n $rr ]] || refuse "не определён repo: $url"
      head_n=$(gh pr list --head "$br" --state open --repo "$rr" --json number -q '.[].number') || fail "gh pr list --head"
      base_n=$(gh pr list --base "$br" --state open --repo "$rr" --json number -q '.[].number') || fail "gh pr list --base"
      [[ -n $head_n || -n $base_n ]] && refuse "открытые PR для $br"
    elif [[ $GH == false ]]; then
      rp=$(realpath "$repo") || exit 1
      [[ $rp == /tmp/* ]] || refuse "repo не под /tmp: $repo"
    else
      refuse "некорректный SAFE_DELETE_GH: $GH"
    fi
    shah=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}') || exit 1
    [[ -n $shah ]] || refuse "нет на origin: $br"; sha=$shah
    git -C "$repo" fetch -q origin "$br" main || exit 1
    est=$(git -C "$repo" bundle create - "refs/remotes/origin/$br" --not origin/main 2>/dev/null | wc -c)
    avail=$(df --output=avail -B1 "$BK" | tail -1)
    (( avail >= 2*est )) || fail "мало места в $BK"
    tag="archive/${br//\//-}-$(date +%Y%m%d)"
    st=$(git -C "$repo" ls-remote origin "refs/tags/$tag" | awk -v r="refs/tags/$tag" '$2==r{print $1}') || exit 1
    [[ -n $st && $st != "$sha" ]] && tag="$tag-$(date +%H%M%S)"
    git -C "$repo" push -q origin "$sha:refs/tags/$tag" || exit 1
    f="$BK/$(basename "$repo")-${br//\//-}-$(date +%Y%m%d%H%M%S).bundle"
    if git -C "$repo" bundle create "$f" "refs/remotes/origin/$br" --not origin/main >/dev/null 2>&1; then
      git -C "$repo" bundle verify "$f" >/dev/null 2>&1 || exit 1
      backup=$f; bsum=$(sha256sum "$f" | cut -d' ' -f1)
    else backup=tag-only; bsum=-; fi
    git -C "$repo" diff --name-status origin/main "$sha" >"$f.diff" || true
    obj="$(realpath "$repo"):$br"
    log branch "$obj" "$sha" "$tag" "$backup" "$bsum" backup-ok
    git -C "$repo" push -q --force-with-lease="refs/heads/$br:$shah" origin ":refs/heads/$br" || exit 1
    left=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}')
    [[ -z $left ]] && { log branch "$obj" "$sha" "$tag" "$backup" "$bsum" deleted; exit 0; }
    exit 1
    ;;
  *) refuse 'usage' ;;
esac
