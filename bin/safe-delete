#!/usr/bin/env bash
set -u
case ${1:-} in -h|--help) echo "usage: safe-delete [--bk <каталог>] <branch|file|dir|worktree|link|restore|purge|repo-autodelete> …  (safely deletes and restores approved files or branches)"; exit 0;; esac
BK=${SAFE_DELETE_BK:-/root/workspaces/projects/.agent-work/backup}
GH=${SAFE_DELETE_GH:-true}
mkdir -p "$BK"
led=$BK/ledger.tsv
self=$(realpath -e "$(command -v -- "$0")") || exit 1
log_n=
log(){ { flock -x 9 || return 1; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$@" >>"$led" || return 1; log_n=$(wc -l <"$led"); log_n=${log_n//[[:space:]]/}; } 9>>"$led.lock"; }
fail(){ echo "safe-delete: $*" >&2; exit 1; }
refuse(){ echo "safe-delete: $*" >&2; exit 2; }
repo_of(){ local u=$1; u=${u%.git}; [[ $u =~ ([^/:]+)/([^/]+)$ ]] && echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"; }
git_file(){
  local raw=$1 entry mark attr head
  p=$(realpath -e "$raw") || return 1
  git_repo=$(git -C "$(dirname -- "$p")" rev-parse --show-toplevel 2>/dev/null) || return 1
  [[ ! -L $raw ]] || return 1
  git_rel=${p#"$git_repo"/}; [[ $git_rel != "$p" ]] || return 1
  git -C "$git_repo" ls-files --error-unmatch -- "$git_rel" >/dev/null 2>&1 || return 1
  entry=$(git -C "$git_repo" ls-files -s -- "$git_rel") || return 1
  git_mode=${entry%% *}; [[ $git_mode == 100644 || $git_mode == 100755 ]] || return 1
  mark=$(git -C "$git_repo" ls-files -v -- "$git_rel") || return 1
  [[ ${mark:0:1} == H ]] || return 1
  attr=$(git -C "$git_repo" check-attr filter -- "$git_rel") || return 1
  [[ $attr != *': lfs'* ]] || return 1
  git_blob=$(git -C "$git_repo" hash-object --no-filters "$p") || return 1
  head=$(git -C "$git_repo" rev-parse "HEAD:$git_rel" 2>/dev/null) || return 1
  [[ $git_blob == "$head" ]]
}
check_path(){
  p=$(realpath -e "$1") || refuse "нет пути: $1"
  [[ $p == /etc/claude-code/* || $p == "$HOME"/.ssh/* || $p == "$HOME"/.claude/settings*.json ]] && refuse "запрещённый путь: $p"
  roots=${SAFE_DELETE_ROOTS:-/root/workspaces/projects:/root/workspaces/tools:/root/workspaces/sandbox:/home/gitmirror/state:/root/.claude/projects/-root-workspaces-projects/memory}
  if [[ -n ${SAFE_DELETE_ROOTS:-} ]]; then
    IFS=: read -ra rts <<< "$roots"; for r in "${rts[@]}"; do [[ $r == /tmp/* ]] || refuse "корень не под /tmp: $r"; done
  fi
  okr=; IFS=: read -ra rts <<< "$roots"; for r in "${rts[@]}"; do [[ $p == "$r" || $p == "$r"/* ]] && { okr=1; break; }; done
  [[ $okr ]] || refuse "вне разрешённых корней: $p"
  for seg in secrets hh-scoring .codex .git .beads; do [[ $p == */"$seg" || $p == */"$seg"/* ]] && refuse "запрещённый сегмент: $p"; done
  [[ $p == */clients/* && $p != */clients/*/.agent-work/* ]] && refuse "запрещённый сегмент: $p"
  [[ /$p/ == */.repowise*/* ]] && refuse "запрещённый сегмент: $p"
  [[ $p == "$BK" || $p == "$BK"/* ]] && refuse "файл под $BK: $p"
  [[ $p == "$self" ]] && refuse "запрещённый файл: $p"
  [[ ${p##*/} == .env* || ${p##*/} == *.pem || ${p##*/} == *.key ]] && refuse "запрещённый файл: $p"
}
check_file(){ check_path "$1"; [[ -f $p ]] || refuse "не обычный файл: $p"; }
delete_file(){
  check_file "$1"
  if git_file "$1"; then
    ref="refs/safe-delete/$(date +%Y%m%d%H%M%S%N)-${git_blob:0:12}"
    git -C "$git_repo" update-ref "$ref" "$git_blob" || return 1
    log git "$p" "$git_blob" "$git_repo" "$ref" "$git_mode" - || return 1
    awk -F '\t' -v n="$log_n" -v p="$p" -v b="$git_blob" -v r="$ref" -v m="$git_mode" 'NR==n && $2=="git" && $3==p && $4==b && $6==r && $7==m{ok=1} END{exit !ok}' "$led" || return 1
    rm -- "$p" || return 1
    echo "удалено: $p | основание: git $ref | восстановить: safe-delete restore $log_n"
    return 0
  fi
  copy="$BK/files/$(date +%Y%m%d)/${p#/}"
  [[ -e $copy || -L $copy ]] && copy="$copy.$(date +%H%M%S%N)"
  mkdir -p "$(dirname -- "$copy")" || return 1
  cp -p "$p" "$copy" || return 1; touch "$copy"; cmp -s "$p" "$copy" || fail "копия не совпала: $p"
  b=$(sha256sum "$copy" | cut -d' ' -f1)
  log file "$p" - - "$copy" "$b" backup-ok || return 1; rm -- "$p" || return 1
  log file "$p" - - "$copy" "$b" deleted || return 1
  echo "удалено: $p | основание: копия $copy | восстановить: safe-delete restore $log_n"
}
[[ $# -ge 1 ]] || refuse 'usage: safe-delete [--bk <каталог>] <branch|file|dir|worktree|link|restore|purge|repo-autodelete> …'
if [[ $1 == --bk ]]; then [[ $# -ge 3 ]] || refuse 'usage'; BK=$2; shift 2; mkdir -p "$BK"; led=$BK/ledger.tsv; fi
cmd=$1; shift

case "$cmd" in
  repo-autodelete)
    [[ $# -ge 1 ]] || refuse 'usage'; repo=$1
    old=$(gh repo view "$repo" --json deleteBranchOnMerge -q .deleteBranchOnMerge) || exit 1
    log repo "$repo" - - "deleteBranchOnMerge=$old" - start
    gh repo edit "$repo" --delete-branch-on-merge || exit 1
    now=$(gh repo view "$repo" --json deleteBranchOnMerge -q .deleteBranchOnMerge) || exit 1
    if [[ $now == true ]]; then log repo "$repo" - - "deleteBranchOnMerge=$old" - done; exit 0; fi
    exit 1
    ;;
  file)
    [[ $# -eq 1 ]] || refuse 'usage'; delete_file "$1" || exit 1; exit 0
    ;;
  dir)
    [[ $# -eq 1 ]] || refuse 'usage'; check_path "$1"; dir=$p; [[ -d $dir ]] || refuse "не каталог: $dir"
    mapfile -d '' entries < <(find "$dir" -depth -print0); for entry in "${entries[@]}"; do check_path "$entry"; done
    mapfile -d '' files < <(find "$dir" -type f -print0)
    for f in "${files[@]}"; do check_file "$f"; done
    for f in "${files[@]}"; do delete_file "$f" || exit 1; done
    find "$dir" -depth -type d -empty -exec rmdir -- {} \;
    exit 0
    ;;
  worktree)
    [[ $# -eq 1 ]] || refuse 'usage'; check_path "$1"; wt=$p; [[ -d $wt ]] || refuse "не каталог: $wt"
    common=$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null) || refuse "не worktree: $wt"; [[ $common != .git ]] || refuse "не linked worktree: $wt"
    common=$(realpath -e "$common") || exit 1; repo=$(dirname -- "$common")
    for cwd in /proc/[0-9]*/cwd; do pid=${cwd#/proc/}; pid=${pid%/cwd}; if ! used=$(readlink -- "$cwd"); then [[ ! -d /proc/$pid || $(awk '{print $3}' "/proc/$pid/stat" 2>/dev/null) == Z ]] && continue; refuse "нечитаемый cwd процесса: $pid"; fi; [[ $used == "$wt" || $used == "$wt"/* ]] && refuse "процесс использует worktree: $pid"; done
    mapfile -d '' files < <(find "$wt" -path "$wt/.git" -prune -o -type f -print0)
    for f in "${files[@]}"; do check_file "$f"; done
    sha=$(git -C "$wt" rev-parse HEAD) || exit 1; ref="refs/safe-delete/wt-$(date +%Y%m%d%H%M%S%N)"
    git -C "$repo" update-ref "$ref" "$sha" || exit 1
    for f in "${files[@]}"; do git_file "$f" || delete_file "$f" || exit 1; done
    git -C "$repo" worktree remove --force "$wt" || exit 1
    log worktree "$wt" "$sha" "$repo" "$ref" - deleted || exit 1
    exit 0
    ;;
  link)
    [[ $# -ge 1 ]] || refuse 'usage'
    [[ -L $1 ]] || refuse "не симлинк: $1"
    [[ ! -e $1 ]] || refuse "симлинк живой: $1"
    p="$(realpath -e "$(dirname -- "$1")")/$(basename -- "$1")" || refuse "нет каталога: $1"
    roots=${SAFE_DELETE_ROOTS:-/root/.claude/agents}
    if [[ -n ${SAFE_DELETE_ROOTS:-} ]]; then
      IFS=: read -ra rts <<< "$roots"
      for r in "${rts[@]}"; do [[ $r == /tmp/* ]] || refuse "корень не под /tmp: $r"; done
    fi
    okr=; IFS=: read -ra rts <<< "$roots"
    for r in "${rts[@]}"; do [[ $p == "$r" || $p == "$r"/* ]] && { okr=1; break; }; done
    [[ $okr ]] || refuse "вне разрешённых корней: $p"
    t=$(readlink -- "$p") || exit 1
    log link "$p" - - "$t" - backup-ok
    rm -- "$p" || exit 1
    log link "$p" - - "$t" - deleted
    exit 0
    ;;
  restore)
    [[ $# -ge 1 ]] || refuse 'usage'; N=$1
    [[ $N =~ ^[1-9][0-9]*$ ]] || refuse "некорректный N: $N"
    line=$(awk -v n="$N" 'NR==n' "$led"); [[ -n $line ]] || refuse "нет строки $N"
    typ=$(cut -f2 <<< "$line"); obj=$(cut -f3 <<< "$line")
    if [[ $typ == branch ]]; then
      repo=${obj%:*}; br=${obj#*:}; sha=$(cut -f4 <<< "$line"); tag=$(cut -f5 <<< "$line"); backup=$(cut -f6 <<< "$line")
      git -C "$repo" push -q origin "$sha:refs/heads/$br" 2>/dev/null \
        || { [[ $tag != - ]] && git -C "$repo" fetch -q origin "refs/tags/$tag" 2>/dev/null \
               || git -C "$repo" fetch -q "$backup" "refs/remotes/origin/$br"; \
             git -C "$repo" push -q origin "$sha:refs/heads/$br"; } || exit 1
      v=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}')
      [[ $v == "$sha" ]] || exit 1
      log branch "$obj" - "$tag" - - restored
    elif [[ $typ == file ]]; then
      cp=$(cut -f6 <<< "$line")
      [[ -e $obj ]] && refuse "исходный путь уже существует: $obj"
      [[ -e $cp || -L $cp ]] || refuse "копия истекла: $cp"
      mkdir -p "$(dirname -- "$obj")" || exit 1
      cp -p "$cp" "$obj" || exit 1
      log file "$obj" - - "$cp" - restored
    elif [[ $typ == git ]]; then
      blob=$(cut -f4 <<< "$line"); repo=$(cut -f5 <<< "$line"); ref=$(cut -f6 <<< "$line"); mode=$(cut -f7 <<< "$line")
      [[ -e $obj || -L $obj ]] && refuse "исходный путь уже существует: $obj"
      mkdir -p "$(dirname -- "$obj")" || exit 1
      git -C "$repo" cat-file blob "$blob" >"$obj" || exit 1
      [[ $mode == 100755 ]] && chmod +x "$obj"
      log git "$obj" "$blob" "$repo" "$ref" - restored
    elif [[ $typ == worktree ]]; then
      sha=$(cut -f4 <<< "$line"); repo=$(cut -f5 <<< "$line"); ref=$(cut -f6 <<< "$line")
      [[ -e $obj || -L $obj ]] && refuse "исходный путь уже существует: $obj"
      git -C "$repo" worktree add "$obj" "$sha" || exit 1
      log worktree "$obj" "$sha" "$repo" "$ref" - restored
    else refuse "нельзя восстановить тип: $typ"; fi
    exit 0
    ;;
  purge)
    [[ -f $BK/ledger.tsv ]] || refuse 'нет ledger.tsv'
    n1=$(find "$BK" -maxdepth 1 -type f \( -name '*.bundle' -o -name '*.bundle.diff' \) -mtime +14 | wc -l)
    n2=0; [[ -d $BK/files ]] && n2=$(find "$BK/files" -type f -mtime +14 | wc -l)
    n=$((n1+n2))
    find "$BK" -maxdepth 1 -type f \( -name '*.bundle' -o -name '*.bundle.diff' \) -mtime +14 -delete
    if [[ -d $BK/files ]]; then
      find "$BK/files" -type f -mtime +14 -delete
      find "$BK/files" -mindepth 1 -type d -empty -delete
    fi
    log purge "$n" - - - - purged
    exit 0
    ;;
  branch)
    [[ $# -ge 2 ]] || refuse 'usage'
    repo=$1; br=$2
    git check-ref-format --branch "$br" >/dev/null || refuse "некорректное имя ветки: $br"
    [[ $br == -* || $br == refs/* || $br == heads/* || $br == *'*'* || $br == *'?'* || $br == *'['* ]] && refuse "некорректное имя ветки: $br"
    [[ $br == main || $br == master || $br == HEAD || $br == codex/* ]] && refuse "отказ по правилу: $br"
    if [[ $GH == true ]]; then
      url=$(git -C "$repo" remote get-url origin) || exit 1
      rr=$(repo_of "$url")
      [[ -n $rr ]] || refuse "не определён repo: $url"
      head_n=$(gh pr list --head "$br" --state open --repo "$rr" --json number -q '.[].number') || fail "gh pr list --head"
      base_n=$(gh pr list --base "$br" --state open --repo "$rr" --json number -q '.[].number') || fail "gh pr list --base"
      [[ -n $head_n || -n $base_n ]] && refuse "открытые PR для $br"
    elif [[ $GH == false ]]; then
      rp=$(realpath "$repo") || exit 1
      [[ $rp == /tmp/* ]] || refuse "repo не под /tmp: $repo"
    else
      refuse "некорректный SAFE_DELETE_GH: $GH"
    fi
    shah=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}') || exit 1
    [[ -n $shah ]] || refuse "нет на origin: $br"; sha=$shah
    git -C "$repo" fetch -q origin "$br" main || exit 1
    est=$(git -C "$repo" bundle create - "refs/remotes/origin/$br" --not origin/main 2>/dev/null | wc -c)
    avail=$(df --output=avail -B1 "$BK" | tail -1)
    (( avail >= 2*est )) || fail "мало места в $BK"
    tag="archive/${br//\//-}-$(date +%Y%m%d)"
    st=$(git -C "$repo" ls-remote origin "refs/tags/$tag" | awk -v r="refs/tags/$tag" '$2==r{print $1}') || exit 1
    [[ -n $st && $st != "$sha" ]] && tag="$tag-$(date +%H%M%S)"
    git -C "$repo" push -q origin "$sha:refs/tags/$tag" || exit 1
    f="$BK/$(basename "$repo")-${br//\//-}-$(date +%Y%m%d%H%M%S).bundle"
    if git -C "$repo" bundle create "$f" "refs/remotes/origin/$br" --not origin/main >/dev/null 2>&1; then
      git -C "$repo" bundle verify "$f" >/dev/null 2>&1 || exit 1
      backup=$f; bsum=$(sha256sum "$f" | cut -d' ' -f1)
    else backup=tag-only; bsum=-; fi
    git -C "$repo" diff --name-status origin/main "$sha" >"$f.diff" || true
    obj="$(realpath "$repo"):$br"
    log branch "$obj" "$sha" "$tag" "$backup" "$bsum" backup-ok
    git -C "$repo" push -q --force-with-lease="refs/heads/$br:$shah" origin ":refs/heads/$br" || exit 1
    left=$(git -C "$repo" ls-remote origin "refs/heads/$br" | awk -v r="refs/heads/$br" '$2==r{print $1}')
    [[ -z $left ]] && { log branch "$obj" "$sha" "$tag" "$backup" "$bsum" deleted; exit 0; }
    exit 1
    ;;
  *) refuse 'usage' ;;
esac
