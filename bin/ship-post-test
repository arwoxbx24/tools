commit_candidate(){
 git -C "$wt" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: %s\nAgent: %s' "$wt/$tz" "$1" "${2:-codex}")"
}
test_broken_link(){
	setup_submit blk codex/dcfg-blk.1; commit_candidate dcfg-blk.1
	printf 'gitdir: /nonexistent/path\n' > "$wt/.git"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $out == *"skip $wt broken worktree link"* && $out != *'fatal:'* && $out == *' failed=0'* ]] && pass BL1 || fail BL1 "rc=$rc: $out"
	make_worktree "$d" wt2 codex/dcfg-blk.2
	w2="$d/.worktrees/codex/wt2"
	git -C "$w2" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-blk.2\nAgent: codex' "$w2/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(grep -c -- '--atom dcfg-blk.2 ' "$d/ship.calls") == 1 ]] && pass BL2 || fail BL2 "rc=$rc: $out"
	setup_submit blk3 codex/dcfg-blk.3; commit_candidate dcfg-blk.3
	gd_abs=$(sed -n 's/^gitdir: //p' "$wt/.git")
	printf 'gitdir: %s\n' "$(realpath --relative-to="$wt" "$gd_abs")" > "$wt/.git"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $out != *'broken worktree link'* && $(grep -c -- '--atom dcfg-blk.3 ' "$d/ship.calls") == 1 ]] && pass BL3 || fail BL3 "rc=$rc: $out"
}
