#!/usr/bin/env bash
set -u

bin=$(cd -- "$(dirname -- "$0")" && pwd)
d=$(mktemp -d)
trap 'rm -rf -- "$d"' EXIT

tool="$bin/ship-post"
ok=0

pass() { echo "PASS $1"; ok=$((ok + 1)); }
fail() { echo "FAIL $1: $2"; }

# Создаём origin и репо
git init -q --bare "$d/origin.git"
git -C "$d/origin.git" symbolic-ref HEAD refs/heads/main
git clone -q "$d/origin.git" "$d/repo"
git -C "$d/repo" config user.email t@t
git -C "$d/repo" config user.name t
printf 'base\n' > "$d/repo/base.txt"
git -C "$d/repo" add -A && git -C "$d/repo" commit -q -m base
git -C "$d/repo" push -q origin main && git -C "$d/repo" fetch -q origin

# Worktree A: с трейлерами ТЗ и Atom, вне origin/main
git -C "$d/repo" worktree add -q -b agent/x "$d/wt-a" origin/main
printf 'a\n' >> "$d/wt-a/base.txt"
git -C "$d/wt-a" add -A
git -C "$d/wt-a" commit -q -m 'task: worktree a' \
	--trailer 'ТЗ: docs/tz/TZ-TEST.md' --trailer 'Atom: dcfg-test.1' --trailer 'Agent: claude'

# Worktree B: без трейлера ТЗ, вне origin/main
git -C "$d/repo" worktree add -q -b agent/y "$d/wt-b" origin/main
printf 'b\n' >> "$d/wt-b/base.txt"
git -C "$d/wt-b" add -A
git -C "$d/wt-b" commit -q -m 'task: worktree b' \
	--trailer 'Atom: dcfg-test.2' --trailer 'Agent: claude'

mkdir -p "$d/bin"

cat > "$d/bin/ship" <<'EOF'
#!/usr/bin/env bash
printf 'mock ship: %s\n' "$*"
exit 0
EOF
chmod +x "$d/bin/ship"

cat > "$d/bin/bd" <<'EOF'
#!/usr/bin/env bash
printf 'bd %s\n' "$*" >> /dev/null
case $1 in
	create) echo 'new-issue-999' ;;
	reopen|add) ;;
esac
exit 0
EOF
chmod +x "$d/bin/bd"

export PATH="$d/bin:$PATH"
export SHIP_POST_REPOS="$d/repo"

# Тест: dry-run
out=$("$tool" --dry-run 2>/dev/null); rc=$?
out_escaped=$(printf '%s' "$out")

if grep -q 'ready' <<<"$out"; then pass 1; else fail 1 "нет ready: $(echo "$out_escaped" | head -1)"; fi
if grep -q 'skip' <<<"$out"; then pass 2; else fail 2 "нет skip"; fi
if echo "$out" | tail -1 | grep -q 'ok=0 failed=0 skip=1'; then pass 3; else fail 3 "summary != ok=0 failed=0 skip=1: $(echo "$out" | tail -1)"; fi
if [[ $rc == 0 ]]; then pass 4; else fail 4 "exit=$rc"; fi

if [[ $ok == 4 ]]; then echo "PASS $ok/4"; else echo "FAIL $ok/4"; fi