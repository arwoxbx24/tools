}

test_concurrent_repositories(){
 local first second out rc
 setup_submit first_repo codex/dcfg-first.1; commit_candidate dcfg-first.1; first="$d/repo"
 setup_submit second_repo codex/dcfg-second.1; commit_candidate dcfg-second.1; second="$d/repo"
 : > "$d/events"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_DELAY=2 TEST_REPOS="$first:$second" TEST_TIMEOUT=3; run_tool "$d" --watch 2>&1); rc=$?
 [[ $(wc -l < "$d/ship.calls") == 2 ]] && pass independent_repo_workers || fail independent_repo_workers "$out rc=$rc"
 [[ $(cat "$d/merged" | wc -l) == 2 ]] && pass workers_drained || fail workers_drained "$out rc=$rc"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex TEST_REPOS="$first:$second" TEST_TIMEOUT=2; run_tool "$d" --watch 2>&1)
 [[ $(wc -l < "$d/ship.calls") == 2 ]] && pass restart_no_duplicate || fail restart_no_duplicate "$out"
}

test_service_recovery(){
 local out rc key h receipt
 setup_submit api_recover codex/dcfg-api.1; commit_candidate dcfg-api.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_GH_FAIL=1; run_tool "$d" 2>&1)
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass api_recovers || fail api_recovers "$out"
 setup_submit note_recover claude/dcfg-note.1; commit_candidate dcfg-note.1 claude
 touch "$d/notes-down"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1)
 rm "$d/notes-down"; : > "$d/bd.calls"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && grep -q 'update dcfg-note.1.*delivered' "$d/bd.calls" && pass note_repaired_without_ship || fail note_repaired_without_ship "$out"
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); receipt="$d/state/receipts/$key/dcfg-note.1/$h"
 jq -e '.actor=="Claude Code" and .stage=="delivered" and (.timestamp|type)=="string"' "$receipt" >/dev/null && pass receipt_actor || fail receipt_actor missing
 setup_submit pending_recover codex/dcfg-pending.1; commit_candidate dcfg-pending.1
 : > "$d/events"; touch "$d/bd-down"
 (sleep 2; rm "$d/bd-down") & local repair=$!
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed TEST_TIMEOUT=5; run_tool "$d" --watch 2>&1); wait "$repair"
 [[ $(wc -l < "$d/ship.calls") == 1 ]] && pass pending_recovers || fail pending_recovers "$out"
}

test_recovery_boundaries(){
 local out rc key h rf count
 setup_submit registration codex/dcfg-reg.1; commit_candidate dcfg-reg.1
 touch "$d/dep-down"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 rm "$d/dep-down"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=open; run_tool "$d" 2>&1)
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-reg.1/$h"
 [[ -f $rf.failed.reported && $(grep -c '^.*|create ' "$d/bd.calls") == 1 && $(wc -l < "$d/ship.calls") == 1 ]] && pass failure_registration_resumes || fail failure_registration_resumes "$out"
 setup_submit ack_crash codex/dcfg-ack.1; commit_candidate dcfg-ack.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1)
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-ack.1/$h"
 rm "$rf.ack"; count=$(grep -c 'update.*receipt:' "$d/bd.calls")
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1)
 [[ -f $rf.ack && $(grep -c 'update.*receipt:' "$d/bd.calls") == "$count" ]] && pass ack_crash_no_duplicate_note || fail ack_crash_no_duplicate_note "$out"
 setup_submit scope codex/dcfg-scope.1; printf x > "$wt/x"
 out=$(export BEADS_ACTOR=Codex TEST_REPOS="$d/elsewhere"; submit dcfg-scope.1 "$tz" x 2>&1); rc=$?
 [[ $rc != 0 && $out == *'repository is not served'* && ! -s $d/bd.closes ]] && pass submit_scope_matches_courier || fail submit_scope_matches_courier "$out"
 setup_submit worker_death codex/dcfg-worker.1; : > "$d/events"
 cat > "$d/bin/sleep" <<'MOCKSLEEP'
#!/usr/bin/env bash
# Only the fixture's worker calls sleep through this PATH; journal uses /bin/sleep.
kill -KILL "$PPID"
MOCKSLEEP
 chmod +x "$d/bin/sleep"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress TEST_TIMEOUT=4; run_tool "$d" --watch 2>&1); rc=$?
 [[ $rc == 1 && $out == *'repository worker exited'* ]] && pass worker_death_observed || fail worker_death_observed "$out rc=$rc"
}

test_accepted_ship(){
 local out rc h after
 setup_submit accepted codex/dcfg-pin.1; commit_candidate dcfg-pin.1
 cp "$bin/ship" "$d/bin/ship-real"
 cat > "$d/bin/git-auto-lib" <<'MOCKLIB'
ga_repo_of(){ echo test; }
ga_skip_reason(){ :; }
ga_base(){ echo 'single main main'; }
ga_lock(){ shift 2; if (( $# )); then "$@"; fi; }
ga_ci_wait(){ return 0; }
ga_ctx(){ GA_SLUG=test/private; }
gg_log(){ :; }
leave(){ exit "$1"; }
MOCKLIB
 cat > "$d/bin/gh" <<'MOCKGH'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$SHIP_POST_TEST_DIR/gh.calls"
case "$1 $2" in
 'pr list') echo '{"number":1,"baseRefName":"main"}' ;;
 'pr view') echo merged-test ;;
esac
MOCKGH
 h=$(git -C "$wt" rev-parse HEAD)
 git -C "$wt" config core.hooksPath /root/workspaces/tools/git-hooks
 printf foreign > "$wt/foreign"
 out=$(env HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null SHIP_POST_TEST_DIR="$d" BEADS_ACTOR=Codex GA_LOG_DIR="$d/logs" GA_WT_ROOT="$d/.worktrees" "$d/bin/ship-real" "$wt" --atom dcfg-pin.1 --tz "$wt/$tz#U2" --handover --expected-head "$h" 2>&1); rc=$?
 [[ $rc == 10 && $out == *'accepted HEAD or worktree changed'* && $(git -C "$wt" rev-parse HEAD) == "$h" && -f $wt/foreign ]] && pass accepted_dirty_rejected || fail accepted_dirty_rejected "$out rc=$rc"
 rm "$wt/foreign"
 out=$(env HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null SHIP_POST_TEST_DIR="$d" BEADS_ACTOR=Codex BD_STATUS=closed GA_LOG_DIR="$d/logs" GA_WT_ROOT="$d/.worktrees" "$d/bin/ship-real" "$wt" --atom dcfg-pin.1 --tz "$wt/$tz#U2" --handover --expected-head "$h" 2>&1); rc=$?
 after=$(git --git-dir="$d/origin.git" rev-parse refs/heads/codex/dcfg-pin.1 2>/dev/null)
 [[ $rc == 0 && $after == "$h" ]] && grep -q -- "--match-head-commit $h" "$d/gh.calls" && pass accepted_exact_head_delivery || fail accepted_exact_head_delivery "$out rc=$rc remote=$after"
}

test_review_recovery(){
 local out rc key h rf before
 setup_submit dry_ack codex/dcfg-dryack.1; commit_candidate dcfg-dryack.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1)
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-dryack.1/$h"
 rm "$rf.ack"; : > "$d/bd.calls"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" --dry-run 2>&1)
 [[ ! -f $rf.ack ]] && ! grep -Eq '\|(update|reopen|create|dep) ' "$d/bd.calls" && pass dry_receipt_no_mutation || fail dry_receipt_no_mutation "$out"
 rm "$rf"; echo 40 > "$rf.failed"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" --dry-run 2>&1)
 ! grep -Eq '\|(update|reopen|create|dep) ' "$d/bd.calls" && pass dry_failure_no_mutation || fail dry_failure_no_mutation "$out"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=open; run_tool "$d" 2>&1)
 [[ -f $rf && $(wc -l < "$d/ship.calls") == 1 ]] && pass legacy_failure_merged_reconciled || fail legacy_failure_merged_reconciled "$out"
 setup_submit repeat_red codex/dcfg-red.1; commit_candidate dcfg-red.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 echo closed > "$d/status"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 [[ $(cat "$d/status") == open && $(grep -c '|reopen ' "$d/bd.calls") == 2 ]] && pass repeated_failure_reopens || fail repeated_failure_reopens "$out"
 setup_submit ci_transport codex/dcfg-ci.1; commit_candidate dcfg-ci.1; h=$(git -C "$wt" rev-parse HEAD)
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40 MOCK_PR_HEAD="$h"; run_tool "$d" 2>&1)
 ! grep -q '|reopen ' "$d/bd.calls" && pass pending_ci_retains_readiness || fail pending_ci_retains_readiness "$out"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_PR_HEAD="$h"; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/merged") == 1 ]] && pass ci_transport_recovers || fail ci_transport_recovers "$out"
 setup_submit partial_event codex/dcfg-partial.1; : > "$d/events"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress PARTIAL_EVENT=1 TEST_TIMEOUT=4; run_tool "$d" --watch 2>&1)
 [[ $(jq -r .seq "$d/state/cursor.json") == 1 && $out != *'malformed journal'* ]] && pass partial_event_retained || fail partial_event_retained "$out"
}

test_nested_repo(){
 local n=120 out rc sub_wt sub_tz no_ci_wt no_ci_tz excluded_wt excluded_tz before after ship_before receipt sha repo_name
 d="$root/nested"; make_repo "$d"
 git init -q --bare "$d/sub-origin.git"; git init -q -b main "$d/repo/sub"; git -C "$d/repo/sub" config user.email t@t; git -C "$d/repo/sub" config user.name t; git -C "$d/repo/sub" remote add origin "$d/sub-origin.git"
 mkdir -p "$d/repo/sub/docs/tz" "$d/repo/sub/.github/workflows"; printf '# TZ\n' > "$d/repo/sub/docs/tz/TZ-TEST.md"; printf 'on: pull_request\n' > "$d/repo/sub/.github/workflows/test.yml"
 git -C "$d/repo/sub" add -- docs/tz/TZ-TEST.md; git -C "$d/repo/sub" commit -q -m base
 git -C "$d/repo/sub" add -- .github/workflows/test.yml; git -C "$d/repo/sub" commit -q -m ci; git -C "$d/repo/sub" push -q -u origin main
 git -C "$d/repo/sub" worktree add -q -b claude/dcfg-nest.1 "$d/repo/sub/.worktrees/claude/nest"
 sub_wt="$d/repo/sub/.worktrees/claude/nest"; sub_tz='docs/tz/TZ-TEST.md'; make_mocks "$d"; printf x > "$sub_wt/file.txt"
 out=$(export BEADS_ACTOR=Claude BD_ASSIGNEE=Claude GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/sub"; run_tool "$d" --submit "$sub_wt" --atom dcfg-nest.1 --tz "$sub_tz#U2" --evidence evidence --files "$sub_tz" file.txt 2>&1); rc=$?
 assert_rc "N1 ($n)" 0 "$rc" "$out"; n=$((n + 1))
 : > "$d/bd.calls"; out=$(export BEADS_ACTOR=Claude BD_ASSIGNEE=Claude GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/sub"; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 ]] && grep -q 'show dcfg-nest.1 --json' "$d/bd.calls" && pass "N1 ($n)" || fail "N1 ($n)" "nested atom was not scanned: $out"; n=$((n + 1))
 git init -q --bare "$d/no-ci-origin.git"; git init -q -b main "$d/repo/no-ci"; git -C "$d/repo/no-ci" config user.email t@t; git -C "$d/repo/no-ci" config user.name t; git -C "$d/repo/no-ci" remote add origin "$d/no-ci-origin.git"
 mkdir -p "$d/repo/no-ci/docs/tz"; printf '# TZ\n' > "$d/repo/no-ci/docs/tz/TZ-TEST.md"
 git -C "$d/repo/no-ci" add -- docs/tz/TZ-TEST.md; git -C "$d/repo/no-ci" commit -q -m base; git -C "$d/repo/no-ci" push -q -u origin main
 git -C "$d/repo/no-ci" worktree add -q -b codex/dcfg-noci.1 "$d/repo/no-ci/.worktrees/codex/no-ci"
 no_ci_wt="$d/repo/no-ci/.worktrees/codex/no-ci"; no_ci_tz='docs/tz/TZ-TEST.md'; printf x > "$no_ci_wt/file.txt"; before=$(git -C "$no_ci_wt" rev-list --count HEAD)
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/no-ci"; run_tool "$d" --submit "$no_ci_wt" --atom dcfg-noci.1 --tz "$no_ci_tz#U2" --evidence evidence --files "$no_ci_tz" file.txt 2>&1); rc=$?; after=$(git -C "$no_ci_wt" rev-list --count HEAD)
 [[ $rc == 0 && $after -gt $before ]] && pass "N2 ($n)" || fail "N2 ($n)" "rc=$rc before=$before after=$after: $out"; n=$((n + 1))
	: > "$d/bd.calls"; ship_before=$(wc -l < "$d/ship.calls")
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/no-ci"; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == $((ship_before + 1)) ]] && pass "N2 ($n)" || fail "N2 ($n)" "no-CI scan did not call ship: $out"; n=$((n + 1))
 mkdir -p "$d/clients"; git init -q --bare "$d/excluded-origin.git"; git init -q -b main "$d/clients/stroyremont"; git -C "$d/clients/stroyremont" config user.email t@t; git -C "$d/clients/stroyremont" config user.name t; git -C "$d/clients/stroyremont" remote add origin "$d/excluded-origin.git"
 mkdir -p "$d/clients/stroyremont/docs/tz"; printf '# TZ\n' > "$d/clients/stroyremont/docs/tz/TZ-TEST.md"
 git -C "$d/clients/stroyremont" add -- docs/tz/TZ-TEST.md; git -C "$d/clients/stroyremont" commit -q -m base; git -C "$d/clients/stroyremont" push -q -u origin main
 repo_name=$(GA_PROJECTS="$d" bash -c '. "$1"; ga_repo_of "$2"' _ "$d/bin/git-auto-lib" "$d/clients/stroyremont")
 [[ $repo_name == clients/stroyremont ]] && pass "N3 ($n)" || fail "N3 ($n)" "ga_repo_of=$repo_name"; n=$((n + 1))
 git -C "$d/clients/stroyremont" worktree add -q -b codex/dcfg-excluded.1 "$d/clients/stroyremont/.worktrees/codex/excluded"
 excluded_wt="$d/clients/stroyremont/.worktrees/codex/excluded"; excluded_tz='docs/tz/TZ-TEST.md'; printf x > "$excluded_wt/file.txt"; before=$(git -C "$excluded_wt" rev-list --count HEAD)
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/clients/stroyremont"; run_tool "$d" --submit "$excluded_wt" --atom dcfg-excluded.1 --tz "$excluded_tz#U2" --evidence evidence --files "$excluded_tz" file.txt 2>&1); rc=$?; after=$(git -C "$excluded_wt" rev-list --count HEAD)
	[[ $rc == 0 && $out != *'repository excluded from courier'* ]] && pass "N3 ($n)" || fail "N3 ($n)" "rc=$rc before=$before after=$after: $out"
}

test_final_states(){
	local out rc key h a b rf
	setup_submit fs1 codex/dcfg-fs.1
	git -C "$wt" commit -q --allow-empty -m fs1 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.1\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.1/$h"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_OUT='pr:7\nprod:wait-owner no-ci'; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && jq -e -r '.stage+" "+.pr == "wait-owner 7"' "$rf" >/dev/null && grep -Fq 'ship-post: wait-owner' "$d/bd.calls" && pass '140 wait-owner' || fail '140 wait-owner' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass '141 wait-owner final' || fail '141 wait-owner final' "$out"

	setup_submit fs2 codex/dcfg-fs.2
	git -C "$wt" commit -q --allow-empty -m fs2 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.2\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.2/$h"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_OUT='prod:hold guarded test'; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && jq -e -r '.stage == "prod-hold"' "$rf" >/dev/null && grep -Fq 'prod-hold guarded' "$d/bd.calls" && pass '142 prod-hold' || fail '142 prod-hold' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass '143 prod-hold final' || fail '143 prod-hold final' "$out"

	setup_submit fs3 codex/dcfg-fs.3
	git -C "$wt" commit -q --allow-empty -m fs3 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.3\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.3/$h"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=50; run_tool "$d" 2>&1); rc=$?
	[[ $rc != 0 && $(wc -l < "$d/ship.calls") == 1 && $(<"$rf.failed") == 50 ]] && pass '144 code 50 recorded' || fail '144 code 50 recorded' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=50; run_tool "$d" 2>&1); rc=$?
	[[ $(wc -l < "$d/ship.calls") == 1 ]] && pass '145 code 50 final' || fail '145 code 50 final' "$out"

	setup_submit fs4 codex/dcfg-fs.4
	git -C "$wt" commit -q --allow-empty -m fs4 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.4\nAgent: codex' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=70; run_tool "$d" 2>&1)
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=70; run_tool "$d" 2>&1); rc=$?
	[[ $(wc -l < "$d/ship.calls") == 2 ]] && pass '146 code 70 retries' || fail '146 code 70 retries' "$out"

	setup_submit fs5 codex/dcfg-fs.5
	git -C "$wt" commit -q --allow-empty -m fs5 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.5\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.5/$h"
	mkdir -p "$(dirname "$rf")"; printf '{"stage":"wait-owner no-ci","local_sha":"%s"}\n' "$h" > "$rf"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_OUT='pr:9\nprod:wait-owner no-ci'; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && jq -e -r '.stage+" "+.pr == "wait-owner 9"' "$rf" >/dev/null && pass '147 legacy wait-owner retried' || fail '147 legacy wait-owner retried' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass '148 legacy now final' || fail '148 legacy now final' "$out"

	setup_submit fs6 codex/dcfg-fs.6
	git -C "$wt" commit -q --allow-empty -m fs6a -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.6\nAgent: codex' "$wt/$tz")"
	a=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
	mkdir -p "$d/state/inflight/$key"; printf '%s\n' "$a" > "$d/state/inflight/$key/dcfg-fs.6"
	git -C "$wt" commit -q --allow-empty -m fs6b -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.6\nAgent: codex' "$wt/$tz")"
	b=$(git -C "$wt" rev-parse HEAD)
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_PR_HEAD="$a"; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(tail -n 1 "$d/ship.calls") == *"--expected-head $b"* && $out != *'code=24'* ]] && pass '149 superseded ancestor' || fail '149 superseded ancestor' "$out"

	setup_submit fs7 codex/dcfg-fs.7
	git -C "$wt" commit -q --allow-empty -m fs7a -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.7\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); mkdir -p "$d/state/inflight/$key"; printf '%s\n' 0123456789abcdef0123456789abcdef01234567 > "$d/state/inflight/$key/dcfg-fs.7"
	git -C "$wt" commit -q --allow-empty -m fs7b -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.7\nAgent: codex' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ ! -s $d/ship.calls && $out == *'code=24'* ]] && pass '149b non-ancestor' || fail '149b non-ancestor' "$out"
}

if [[ ${SHIP_POST_TEST_GROUP:-all} == review ]]; then
 test_review_recovery
elif [[ ${SHIP_POST_TEST_GROUP:-all} == recovery ]]; then
 test_service_recovery; test_recovery_boundaries; test_accepted_ship; test_review_recovery
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == v4 ]]; then
	 test_final_states; test_nested_repo
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == u14 ]]; then
	 test_submit_conflict_preflight
else
	 test_dryrun_mocks; test_valid_actors; test_rejections; test_hook_and_retry; test_closed_retry; test_delivery; test_live_sync; test_watch; test_recovery; test_stream_errors; test_closed_skip_reason; test_concurrent_repositories; test_service_recovery; test_recovery_boundaries; test_accepted_ship; test_review_recovery; test_actor_alias; test_nested_repo; test_final_states; test_submit_conflict_preflight
fi
echo "checks=$checks failures=$failures"
[[ $failures == 0 ]]
