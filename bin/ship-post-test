test_watch_lock_released(){
 local out t m w a i
 setup_submit lockrel codex/dcfg-lockrel.1; commit_candidate dcfg-lockrel.1; : > "$d/events"
 ( export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_DELAY=6 TEST_TIMEOUT=12; run_tool "$d" --watch ) >"$d/a.log" 2>&1 & a=$!
 for i in $(seq 1 50); do [[ -s $d/ship.calls ]] && break; sleep 0.2; done
 t=$(pgrep -n -f "^timeout .*$d/bin/ship-post --watch"); m=$(pgrep -P "$t")
 w=$(pgrep -o -P "$m"); kill -TERM "$w" "$m"
 for i in $(seq 1 25); do kill -0 "$w" 2>/dev/null || break; sleep 0.2; done
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex TEST_TIMEOUT=2; run_tool "$d" --watch 2>&1)
 [[ -n $m && $out != *'watcher already active'* ]] && pass watch_lock_released || fail watch_lock_released "m=$m $out"
 wait "$a"
}

test_service_recovery(){
 local out rc key h receipt
 setup_submit api_recover codex/dcfg-api.1; commit_candidate dcfg-api.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_GH_FAIL=1; run_tool "$d" 2>&1)
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass api_recovers || fail api_recovers "$out"
 setup_submit note_recover claude/dcfg-note.1; commit_candidate dcfg-note.1 claude
 touch "$d/notes-down"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1)
 rm "$d/notes-down"; : > "$d/bd.calls"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && grep -q 'update dcfg-note.1.*delivered' "$d/bd.calls" && pass note_repaired_without_ship || fail note_repaired_without_ship "$out"
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); receipt="$d/state/receipts/$key/dcfg-note.1/$h"
 jq -e '.actor=="Claude Code" and .stage=="delivered" and (.timestamp|type)=="string"' "$receipt" >/dev/null && pass receipt_actor || fail receipt_actor missing
 setup_submit pending_recover codex/dcfg-pending.1; commit_candidate dcfg-pending.1
 : > "$d/events"; touch "$d/bd-down"
 (sleep 2; rm "$d/bd-down") & local repair=$!
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed TEST_TIMEOUT=5; run_tool "$d" --watch 2>&1); wait "$repair"
 [[ $(wc -l < "$d/ship.calls") == 1 ]] && pass pending_recovers || fail pending_recovers "$out"
}

test_recovery_boundaries(){
 local out rc key h rf count
 setup_submit registration codex/dcfg-reg.1; commit_candidate dcfg-reg.1
 touch "$d/dep-down"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 rm "$d/dep-down"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=open; run_tool "$d" 2>&1)
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-reg.1/$h"
 [[ -f $rf.failed.reported && $(grep -c '^.*|create ' "$d/bd.calls") == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass failure_registration_resumes || fail failure_registration_resumes "$out"
 setup_submit ack_crash codex/dcfg-ack.1; commit_candidate dcfg-ack.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1)
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-ack.1/$h"
 rm "$rf.ack"; count=$(grep -c 'update.*receipt:' "$d/bd.calls")
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1)
 [[ -f $rf.ack && $(grep -c 'update.*receipt:' "$d/bd.calls") == "$count" ]] && pass ack_crash_no_duplicate_note || fail ack_crash_no_duplicate_note "$out"
 setup_submit scope codex/dcfg-scope.1; printf x > "$wt/x"
 out=$(export BEADS_ACTOR=Codex TEST_REPOS="$d/elsewhere"; submit dcfg-scope.1 "$tz" x 2>&1); rc=$?
 [[ $rc != 0 && $out == *'repository is not served'* && ! -s $d/bd.closes ]] && pass submit_scope_matches_courier || fail submit_scope_matches_courier "$out"
 setup_submit worker_death codex/dcfg-worker.1; : > "$d/events"
 cat > "$d/bin/sleep" <<'MOCKSLEEP'
#!/usr/bin/env bash
# Only the fixture's worker calls sleep through this PATH; journal uses /bin/sleep.
kill -KILL "$PPID"
MOCKSLEEP
 chmod +x "$d/bin/sleep"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress TEST_TIMEOUT=4; run_tool "$d" --watch 2>&1); rc=$?
 [[ $rc == 1 && $out == *'repository worker exited'* ]] && pass worker_death_observed || fail worker_death_observed "$out rc=$rc"
}

test_accepted_ship(){
 local out rc h after
 setup_submit accepted codex/dcfg-pin.1; commit_candidate dcfg-pin.1
 cp "$bin/ship" "$d/bin/ship-real"
 cat > "$d/bin/git-auto-lib" <<'MOCKLIB'
ga_repo_of(){ echo test; }
ga_skip_reason(){ :; }
ga_base(){ echo 'single main main'; }
ga_lock(){ shift 2; if (( $# )); then "$@"; fi; }
ga_ci_wait(){ return 0; }
ga_ctx(){ GA_SLUG=test/private; }
gg_log(){ :; }
leave(){ exit "$1"; }
MOCKLIB
 cat > "$d/bin/gh" <<'MOCKGH'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$SHIP_POST_TEST_DIR/gh.calls"
case "$1 $2" in
 'pr list') echo '{"number":1,"baseRefName":"main"}' ;;
 'pr view') echo merged-test ;;
esac
MOCKGH
 h=$(git -C "$wt" rev-parse HEAD)
 git -C "$wt" config core.hooksPath /root/workspaces/tools/git-hooks
 printf foreign > "$wt/foreign"
 out=$(env HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null SHIP_POST_TEST_DIR="$d" BEADS_ACTOR=Codex GA_LOG_DIR="$d/logs" GA_WT_ROOT="$d/.worktrees" "$d/bin/ship-real" "$wt" --atom dcfg-pin.1 --tz "$wt/$tz#U2" --handover --expected-head "$h" 2>&1); rc=$?
 [[ $rc == 10 && $out == *'accepted HEAD or worktree changed'* && $(git -C "$wt" rev-parse HEAD) == "$h" && -f $wt/foreign ]] && pass accepted_dirty_rejected || fail accepted_dirty_rejected "$out rc=$rc"
 rm "$wt/foreign"
 out=$(env HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null SHIP_POST_TEST_DIR="$d" BEADS_ACTOR=Codex BD_STATUS=closed GA_LOG_DIR="$d/logs" GA_WT_ROOT="$d/.worktrees" "$d/bin/ship-real" "$wt" --atom dcfg-pin.1 --tz "$wt/$tz#U2" --handover --expected-head "$h" 2>&1); rc=$?
 after=$(git --git-dir="$d/origin.git" rev-parse refs/heads/codex/dcfg-pin.1 2>/dev/null)
 [[ $rc == 0 && $after == "$h" ]] && grep -q -- "--match-head-commit $h" "$d/gh.calls" && pass accepted_exact_head_delivery || fail accepted_exact_head_delivery "$out rc=$rc remote=$after"
}

test_review_recovery(){
 local out rc key h rf before
 setup_submit dry_ack codex/dcfg-dryack.1; commit_candidate dcfg-dryack.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" 2>&1)
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-dryack.1/$h"
 rm "$rf.ack"; : > "$d/bd.calls"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" --dry-run 2>&1)
 [[ ! -f $rf.ack ]] && ! grep -Eq '\|(update|reopen|create|dep) ' "$d/bd.calls" && pass dry_receipt_no_mutation || fail dry_receipt_no_mutation "$out"
 rm "$rf"; echo 40 > "$rf.failed"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed; run_tool "$d" --dry-run 2>&1)
 ! grep -Eq '\|(update|reopen|create|dep) ' "$d/bd.calls" && pass dry_failure_no_mutation || fail dry_failure_no_mutation "$out"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=open; run_tool "$d" 2>&1)
 [[ -f $rf && $(wc -l < "$d/ship.calls") == 1 ]] && pass legacy_failure_merged_reconciled || fail legacy_failure_merged_reconciled "$out"
 setup_submit repeat_red codex/dcfg-red.1; commit_candidate dcfg-red.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 echo closed > "$d/status"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 [[ $(cat "$d/status") == open && $(grep -c '|reopen ' "$d/bd.calls") == 2 ]] && pass repeated_failure_reopens || fail repeated_failure_reopens "$out"
 setup_submit ci_transport codex/dcfg-ci.1; commit_candidate dcfg-ci.1; h=$(git -C "$wt" rev-parse HEAD)
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_SHIP_RC=40 MOCK_PR_HEAD="$h"; run_tool "$d" 2>&1)
 ! grep -q '|reopen ' "$d/bd.calls" && pass pending_ci_retains_readiness || fail pending_ci_retains_readiness "$out"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed MOCK_PR_HEAD="$h"; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/merged") == 1 ]] && pass ci_transport_recovers || fail ci_transport_recovers "$out"
 setup_submit partial_event codex/dcfg-partial.1; : > "$d/events"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress PARTIAL_EVENT=1 TEST_TIMEOUT=4; run_tool "$d" --watch 2>&1)
 [[ $(jq -r .seq "$d/state/cursor.json") == 1 && $out != *'malformed journal'* ]] && pass partial_event_retained || fail partial_event_retained "$out"
}

test_nested_repo(){
 local n=120 out rc sub_wt sub_tz no_ci_wt no_ci_tz excluded_wt excluded_tz before after ship_before receipt sha repo_name
 d="$root/nested"; make_repo "$d"
 git init -q --bare "$d/sub-origin.git"; git init -q -b main "$d/repo/sub"; git -C "$d/repo/sub" config user.email t@t; git -C "$d/repo/sub" config user.name t; git -C "$d/repo/sub" remote add origin "$d/sub-origin.git"
 mkdir -p "$d/repo/sub/docs/tz" "$d/repo/sub/.github/workflows"; printf '# TZ\n' > "$d/repo/sub/docs/tz/TZ-TEST.md"; printf 'on: pull_request\n' > "$d/repo/sub/.github/workflows/test.yml"
 git -C "$d/repo/sub" add -- docs/tz/TZ-TEST.md; git -C "$d/repo/sub" commit -q -m base
 git -C "$d/repo/sub" add -- .github/workflows/test.yml; git -C "$d/repo/sub" commit -q -m ci; git -C "$d/repo/sub" push -q -u origin main
 git -C "$d/repo/sub" worktree add -q -b claude/dcfg-nest.1 "$d/repo/sub/.worktrees/claude/nest"
 sub_wt="$d/repo/sub/.worktrees/claude/nest"; sub_tz='docs/tz/TZ-TEST.md'; make_mocks "$d"; printf x > "$sub_wt/file.txt"
 out=$(export BEADS_ACTOR=Claude BD_ASSIGNEE=Claude GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/sub"; run_tool "$d" --submit "$sub_wt" --atom dcfg-nest.1 --tz "$sub_tz#U2" --evidence evidence --files "$sub_tz" file.txt 2>&1); rc=$?
 assert_rc "N1 ($n)" 0 "$rc" "$out"; n=$((n + 1))
 : > "$d/bd.calls"; out=$(export BEADS_ACTOR=Claude BD_ASSIGNEE=Claude GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/sub"; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 ]] && grep -q 'show dcfg-nest.1 --json' "$d/bd.calls" && pass "N1 ($n)" || fail "N1 ($n)" "nested atom was not scanned: $out"; n=$((n + 1))
 git init -q --bare "$d/no-ci-origin.git"; git init -q -b main "$d/repo/no-ci"; git -C "$d/repo/no-ci" config user.email t@t; git -C "$d/repo/no-ci" config user.name t; git -C "$d/repo/no-ci" remote add origin "$d/no-ci-origin.git"
 mkdir -p "$d/repo/no-ci/docs/tz"; printf '# TZ\n' > "$d/repo/no-ci/docs/tz/TZ-TEST.md"
 git -C "$d/repo/no-ci" add -- docs/tz/TZ-TEST.md; git -C "$d/repo/no-ci" commit -q -m base; git -C "$d/repo/no-ci" push -q -u origin main
 git -C "$d/repo/no-ci" worktree add -q -b codex/dcfg-noci.1 "$d/repo/no-ci/.worktrees/codex/no-ci"
 no_ci_wt="$d/repo/no-ci/.worktrees/codex/no-ci"; no_ci_tz='docs/tz/TZ-TEST.md'; printf x > "$no_ci_wt/file.txt"; before=$(git -C "$no_ci_wt" rev-list --count HEAD)
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/no-ci"; run_tool "$d" --submit "$no_ci_wt" --atom dcfg-noci.1 --tz "$no_ci_tz#U2" --evidence evidence --files "$no_ci_tz" file.txt 2>&1); rc=$?; after=$(git -C "$no_ci_wt" rev-list --count HEAD)
 [[ $rc == 0 && $after -gt $before ]] && pass "N2 ($n)" || fail "N2 ($n)" "rc=$rc before=$before after=$after: $out"; n=$((n + 1))
	: > "$d/bd.calls"; ship_before=$(wc -l < "$d/ship.calls")
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/repo/no-ci"; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == $((ship_before + 1)) ]] && pass "N2 ($n)" || fail "N2 ($n)" "no-CI scan did not call ship: $out"; n=$((n + 1))
 mkdir -p "$d/clients"; git init -q --bare "$d/excluded-origin.git"; git init -q -b main "$d/clients/stroyremont"; git -C "$d/clients/stroyremont" config user.email t@t; git -C "$d/clients/stroyremont" config user.name t; git -C "$d/clients/stroyremont" remote add origin "$d/excluded-origin.git"
 mkdir -p "$d/clients/stroyremont/docs/tz"; printf '# TZ\n' > "$d/clients/stroyremont/docs/tz/TZ-TEST.md"
 git -C "$d/clients/stroyremont" add -- docs/tz/TZ-TEST.md; git -C "$d/clients/stroyremont" commit -q -m base; git -C "$d/clients/stroyremont" push -q -u origin main
 repo_name=$(GA_PROJECTS="$d" bash -c '. "$1"; ga_repo_of "$2"' _ "$d/bin/git-auto-lib" "$d/clients/stroyremont")
 [[ $repo_name == clients/stroyremont ]] && pass "N3 ($n)" || fail "N3 ($n)" "ga_repo_of=$repo_name"; n=$((n + 1))
 git -C "$d/clients/stroyremont" worktree add -q -b codex/dcfg-excluded.1 "$d/clients/stroyremont/.worktrees/codex/excluded"
 excluded_wt="$d/clients/stroyremont/.worktrees/codex/excluded"; excluded_tz='docs/tz/TZ-TEST.md'; printf x > "$excluded_wt/file.txt"; before=$(git -C "$excluded_wt" rev-list --count HEAD)
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex GA_PROJECTS="$d" TEST_REPOS="$d/repo:$d/clients/stroyremont"; run_tool "$d" --submit "$excluded_wt" --atom dcfg-excluded.1 --tz "$excluded_tz#U2" --evidence evidence --files "$excluded_tz" file.txt 2>&1); rc=$?; after=$(git -C "$excluded_wt" rev-list --count HEAD)
	[[ $rc == 0 && $out != *'repository excluded from courier'* ]] && pass "N3 ($n)" || fail "N3 ($n)" "rc=$rc before=$before after=$after: $out"
}

test_final_states(){
	local out rc key h a b rf
	setup_submit fs1 codex/dcfg-fs.1
	git -C "$wt" commit -q --allow-empty -m fs1 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.1\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.1/$h"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_OUT='pr:7\nprod:wait-owner no-ci'; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && jq -e -r '.stage+" "+.pr == "wait-owner 7"' "$rf" >/dev/null && grep -Fq 'ship-post: wait-owner' "$d/bd.calls" && pass '140 wait-owner' || fail '140 wait-owner' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 2 ]] && pass '141 wait-owner final' || fail '141 wait-owner final' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 2 ]] && pass '141b no-ci rerun once' || fail '141b no-ci rerun once' "$out"

	setup_submit fs2 codex/dcfg-fs.2
	git -C "$wt" commit -q --allow-empty -m fs2 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.2\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.2/$h"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_OUT='prod:hold guarded test'; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && jq -e -r '.stage == "prod-hold"' "$rf" >/dev/null && grep -Fq 'prod-hold guarded' "$d/bd.calls" && pass '142 prod-hold' || fail '142 prod-hold' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && pass '143 prod-hold final' || fail '143 prod-hold final' "$out"

	setup_submit fs3 codex/dcfg-fs.3
	git -C "$wt" commit -q --allow-empty -m fs3 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.3\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.3/$h"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=50; run_tool "$d" 2>&1); rc=$?
	for i in $(seq 1 50); do [[ -f $rf.failed ]] && break; sleep 0.2; done
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 && $(<"$rf.failed") == 50 ]] && pass '144 code 50 recorded' || fail '144 code 50 recorded' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=50; run_tool "$d" 2>&1); rc=$?
	[[ $(wc -l < "$d/ship.calls") == 1 ]] && pass '145 code 50 final' || fail '145 code 50 final' "$out"

	setup_submit fs4 codex/dcfg-fs.4
	git -C "$wt" commit -q --allow-empty -m fs4 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.4\nAgent: codex' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=70; run_tool "$d" 2>&1)
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=70; run_tool "$d" 2>&1); rc=$?
	[[ $(wc -l < "$d/ship.calls") == 2 ]] && pass '146 code 70 retries' || fail '146 code 70 retries' "$out"

	setup_submit fs5 codex/dcfg-fs.5
	git -C "$wt" commit -q --allow-empty -m fs5 -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.5\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-fs.5/$h"
	mkdir -p "$(dirname "$rf")"; printf '{"stage":"wait-owner no-ci","local_sha":"%s"}\n' "$h" > "$rf"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_OUT='pr:9\nprod:wait-owner no-ci'; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 1 ]] && jq -e -r '.stage+" "+.pr == "wait-owner 9"' "$rf" >/dev/null && pass '147 legacy wait-owner retried' || fail '147 legacy wait-owner retried' "$out"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(wc -l < "$d/ship.calls") == 2 ]] && pass '148 legacy now final' || fail '148 legacy now final' "$out"

	setup_submit fs6 codex/dcfg-fs.6
	git -C "$wt" commit -q --allow-empty -m fs6a -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.6\nAgent: codex' "$wt/$tz")"
	a=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
	mkdir -p "$d/state/inflight/$key"; printf '%s\n' "$a" > "$d/state/inflight/$key/dcfg-fs.6"
	git -C "$wt" commit -q --allow-empty -m fs6b -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.6\nAgent: codex' "$wt/$tz")"
	b=$(git -C "$wt" rev-parse HEAD)
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_PR_HEAD="$a"; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(tail -n 1 "$d/ship.calls") == *"--expected-head $b"* && $out != *'code=24'* ]] && pass '149 superseded ancestor' || fail '149 superseded ancestor' "$out"

	setup_submit fs7 codex/dcfg-fs.7
	git -C "$wt" commit -q --allow-empty -m fs7a -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.7\nAgent: codex' "$wt/$tz")"
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); mkdir -p "$d/state/inflight/$key"; printf '%s\n' 0123456789abcdef0123456789abcdef01234567 > "$d/state/inflight/$key/dcfg-fs.7"
	git -C "$wt" commit -q --allow-empty -m fs7b -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-fs.7\nAgent: codex' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ ! -s $d/ship.calls && $out == *'code=24'* ]] && pass '149b non-ancestor' || fail '149b non-ancestor' "$out"
}

test_u15(){
 local out rc key h rf
 setup_submit u15_skip codex/dcfg-u15skip.1; commit_candidate dcfg-u15skip.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=; run_tool "$d" 2>&1); rc=$?
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-u15skip.1/$h"
 [[ $rc == 0 && -f $rf.failed && -f $rf.failed.reported && ! -s $d/ship.calls ]] && grep -Fq '|reopen dcfg-u15skip.1' "$d/bd.calls" && grep -Fq 'update dcfg-u15skip.1 --append-notes ship-post exit 10: no assignee; действие: сдай через ship-post --submit' "$d/bd.calls" && ! grep -q '|create ' "$d/bd.calls" && pass u15_skip_reports_exit10 || fail u15_skip_reports_exit10 "rc=$rc: $out"
 echo closed > "$d/status"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(grep -c 'exit 10' "$d/bd.calls") == 1 && ! -s $d/ship.calls ]] && pass u15_repeat_no_second_note || fail u15_repeat_no_second_note "rc=$rc: $out"
 setup_submit u15_conf codex/dcfg-u15conf.1; commit_candidate dcfg-u15conf.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=50; run_tool "$d" 2>&1); rc=$?
 key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); h=$(git -C "$wt" rev-parse HEAD); rf="$d/state/receipts/$key/dcfg-u15conf.1/$h"
 for i in $(seq 1 50); do [[ -f $rf.failed.reported ]] && break; sleep 0.2; done; [[ -f $rf.failed && $(<"$rf.failed") == 50 ]] && grep -Fq '|reopen dcfg-u15conf.1' "$d/bd.calls" && grep -Fq 'update dcfg-u15conf.1 --append-notes ship-post exit 50: конфликт с `origin/<base>`; действие:' "$d/bd.calls" && ! grep -q '|create ' "$d/bd.calls" && pass u15_code50_reopens_atom || fail u15_code50_reopens_atom "rc=$rc: $out"
 echo closed > "$d/status"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; submit dcfg-u15conf.1 "$tz" 2>&1); rc=$?
 [[ $rc == 0 && ! -e $rf.failed && -f $rf.failed.resubmitted && ! -e $rf.failed.reported ]] && pass u15_resubmit_clears_final_failure || fail u15_resubmit_clears_final_failure "rc=$rc: $out"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == 2 ]] && pass u15_resubmit_ships_again || fail u15_resubmit_ships_again "rc=$rc: $out"
 setup_submit u15_foreign_undelivered codex/dcfg-other-x; commit_candidate dcfg-u15foreign.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && ! -s $d/ship.calls ]] && grep -Fq '|reopen dcfg-u15foreign.1' "$d/bd.calls" && grep -Fq 'ship-post exit 10: branch codex/dcfg-other-x != codex/dcfg-u15foreign.1; ветка codex/dcfg-other-x названа по другой задаче, коммит не в origin/main; действие: сдай через ship-post --submit' "$d/bd.calls" && pass u15_foreign_branch_undelivered_reports || fail u15_foreign_branch_undelivered_reports "rc=$rc: $out"
 setup_submit u15_foreign_delivered codex/dcfg-other-y; commit_candidate dcfg-u15foreign.2
 git -C "$wt" push -q origin HEAD:main
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && ! -s $d/ship.calls ]] && ! grep -q '|reopen ' "$d/bd.calls" && ! grep -q 'exit 10' "$d/bd.calls" && pass u15_foreign_branch_delivered_silent || fail u15_foreign_branch_delivered_silent "rc=$rc: $out"
}

test_adr30(){
 local out rc start elapsed i w atom out_file
 setup_submit adr30 codex/dcfg-adr30.1
 make_worktree "$d" wt2 codex/dcfg-adr30.2 || exit 1
 make_worktree "$d" wt3 codex/dcfg-adr30.3 || exit 1
 i=1
 for w in "$wt" "$d/.worktrees/codex/wt2" "$d/.worktrees/codex/wt3"; do
  atom="dcfg-adr30.$i"
  git -C "$w" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: %s\nAgent: codex' "$w/$tz" "$atom")"
  i=$((i + 1))
 done
 start=$(date +%s%3N)
 out_file="$d/adr30-first.out"
 ( export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_DELAY=2 SHIP_POST_JOBS=8 TEST_TIMEOUT=10; run_tool "$d" ) >"$out_file" 2>&1; rc=$?
 out=$(<"$out_file")
 elapsed=$(( $(date +%s%3N) - start ))
 [[ $rc == 0 && $out == *'started=3'* ]] && pass adr30_parallel_summary || fail adr30_parallel_summary "rc=$rc elapsed=${elapsed}ms: $out"
 [[ $elapsed -lt 1500 ]] && pass adr30_scan_under_1500ms || fail adr30_scan_under_1500ms "elapsed=${elapsed}ms"
 timeout 5 bash -c 'while [[ $(wc -l < "$1") -lt 3 ]]; do sleep 0.05; done' _ "$d/ship.calls"
 [[ $(wc -l < "$d/ship.calls") == 3 ]] && pass adr30_three_ships || fail adr30_three_ships "$out"
 out_file="$d/adr30-second.out"
 ( export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_DELAY=2 SHIP_POST_JOBS=8 TEST_TIMEOUT=10; run_tool "$d" ) >"$out_file" 2>&1; rc=$?
 out=$(<"$out_file")
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == 3 ]] && pass adr30_atom_lock || fail adr30_atom_lock "rc=$rc: $out"
 setup_submit adr30_retry codex/dcfg-adr30retry.1; commit_candidate dcfg-adr30retry.1; : > "$d/events"
 cat > "$d/bin/ship" <<'MOCKSHIP'
#!/usr/bin/env bash
printf '%s|%s|%s\n' "${BEADS_ACTOR:-}" "$*" "$(git -C "$1" rev-parse HEAD)" >> "$SHIP_POST_TEST_DIR/ship.calls"
if [[ ! -e $SHIP_POST_TEST_DIR/ship.retry ]]; then touch "$SHIP_POST_TEST_DIR/ship.retry"; exit 70; fi
printf '%s\n' "$(git -C "$1" rev-parse HEAD)" >> "$SHIP_POST_TEST_DIR/merged"
MOCKSHIP
 chmod +x "$d/bin/ship"
 out_file="$d/adr30-retry.out"
 ( export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex TEST_TIMEOUT=4; run_tool "$d" --watch ) >"$out_file" 2>&1; rc=$?
 out=$(<"$out_file")
 [[ $(wc -l < "$d/ship.calls") == 2 && $(wc -l < "$d/merged") == 1 ]] && pass adr30_transient_retries || fail adr30_transient_retries "rc=$rc: $out"
}

test_park(){
 local out rc h i w atom park_out park_rc park_ok=0 pdup_ok=0 pci_ok=0 psubmit_ok=0 unpark_ok=0 pf sk before
 setup_submit park codex/dcfg-park.1; commit_candidate dcfg-park.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=71; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do grep -q '|create \[ship-post\] INFRA exit 71' "$d/bd.calls" && break; sleep 0.2; done
 park_out=$out; park_rc=$rc
 [[ $rc == 0 && ! $(grep -c '|reopen dcfg-park.1' "$d/bd.calls") -gt 0 && $(grep -c '|create \[ship-post\] INFRA exit 71.*contour:delivery' "$d/bd.calls") == 1 && $(grep -c '|update dcfg-park.1 --add-label delivery-blocked' "$d/bd.calls") == 1 && $out == *'ship-post: parked: dcfg-park.1 incident test-infra'* ]] && park_ok=1

 setup_submit pdup codex/dcfg-pdup.1; commit_candidate dcfg-pdup.1
 make_worktree "$d" wt2 codex/dcfg-pdup.2; make_worktree "$d" wt3 codex/dcfg-pdup.3
 i=2
 for w in "$d/.worktrees/codex/wt2" "$d/.worktrees/codex/wt3"; do
  atom="dcfg-pdup.$i"; git -C "$w" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: %s\nAgent: codex' "$w/$tz" "$atom")"; i=$((i + 1))
 done
 echo open > "$d/status.test-infra"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do [[ $(grep -c 'update test-infra --append-notes dcfg-pdup.' "$d/bd.calls") == 3 ]] && break; sleep 0.2; done
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(grep -c '|create ' "$d/bd.calls") == 1 && $(grep -c 'update test-infra --append-notes dcfg-pdup.' "$d/bd.calls") == 3 ]] && pdup_ok=1

 setup_submit pci codex/dcfg-pci.1; commit_candidate dcfg-pci.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=40; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do grep -q '|reopen dcfg-pci.1' "$d/bd.calls" && break; sleep 0.2; done
 [[ $rc == 0 && $(grep -c '|reopen dcfg-pci.1' "$d/bd.calls") == 1 && ! -s <(grep '|create ' "$d/bd.calls") && ! -s <(grep 'delivery-blocked' "$d/bd.calls") ]] && pci_ok=1

 setup_submit psubmit codex/dcfg-psubmit.1; commit_candidate dcfg-psubmit.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=50; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do grep -q '|reopen dcfg-psubmit.1' "$d/bd.calls" && break; sleep 0.2; done
 [[ $rc == 0 && $(grep -c '|reopen dcfg-psubmit.1' "$d/bd.calls") == 1 && ! -s <(grep '|create ' "$d/bd.calls") && ! -s <(grep 'delivery-blocked' "$d/bd.calls") ]] && psubmit_ok=1

 setup_submit unpark codex/dcfg-unpark.1; commit_candidate dcfg-unpark.1; echo open > "$d/status.test-infra"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do [[ -f $d/state/incidents/parked/dcfg-unpark.1 ]] && break; sleep 0.2; done
 h=$(git -C "$wt" rev-parse HEAD)
 touch -d '-2 hours' "$d/state/incidents/parked/dcfg-unpark.1"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do grep -Fqx "$h" "$d/merged" 2>/dev/null && break; sleep 0.2; done
 [[ $rc == 0 && $(grep -c '|update dcfg-unpark.1 --remove-label delivery-blocked' "$d/bd.calls") == 1 && $(grep -c "|update test-infra --append-notes delivered dcfg-unpark.1 $h" "$d/bd.calls") == 1 && ! -f $d/state/incidents/parked/dcfg-unpark.1 && $(grep -c -F "$h" "$d/merged") == 1 ]] && unpark_ok=1
 [[ $pdup_ok == 1 ]] && pass park_dedup || fail park_dedup "rc=$rc: $out"
 [[ $pci_ok == 1 ]] && pass park_ci_author || fail park_ci_author "rc=$rc: $out"
 [[ $psubmit_ok == 1 ]] && pass park_submit_author || fail park_submit_author "rc=$rc: $out"
 [[ $unpark_ok == 1 ]] && pass park_unpark || fail park_unpark "rc=$rc: $out"
 [[ $park_ok == 1 ]] && pass park_infra || fail park_infra "rc=$park_rc: $park_out"

 setup_submit pb1 codex/dcfg-pb.1; commit_candidate dcfg-pb.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
 pf="$d/state/incidents/parked/dcfg-pb.1"
 for i in $(seq 1 50); do [[ -f $pf ]] && break; sleep 0.2; done
 for i in $(seq 1 50); do [[ $(wc -l < "$d/ship.calls") == 1 ]] && break; sleep 0.2; done
 before=$(wc -l < "$d/ship.calls")
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
 sk=$(sed -n 's/.* skip=\([0-9]*\).*/\1/p' <<<"$out")
 [[ $rc == 0 && $(wc -l < "$d/ship.calls") == $before && $sk == 1 ]] && pass PB1_park_backoff_skip || fail PB1_park_backoff_skip "rc=$rc skip=$sk: $out"

 setup_submit pb2 codex/dcfg-pb.2; commit_candidate dcfg-pb.2
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
 pf="$d/state/incidents/parked/dcfg-pb.2"
 for i in $(seq 1 50); do [[ -f $pf ]] && break; sleep 0.2; done
 for i in $(seq 1 50); do [[ $(wc -l < "$d/ship.calls") == 1 ]] && break; sleep 0.2; done
 touch -d '-10 seconds' "$pf"; before=$(wc -l < "$d/ship.calls")
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30 SHIP_POST_PARKED_RETRY_SECONDS=1; run_tool "$d" 2>&1); rc=$?
 for i in $(seq 1 50); do [[ $(wc -l < "$d/ship.calls") -gt $before ]] && break; sleep 0.2; done
 [[ $(wc -l < "$d/ship.calls") == $((before + 1)) ]] && (( $(date +%s) - $(stat -c %Y "$pf") < 10 )) && pass PB2_park_backoff_retry || fail PB2_park_backoff_retry "rc=$rc age=$(( $(date +%s) - $(stat -c %Y "$pf") )): $out"
}

test_adr35(){
 local out rc wt_a wt_b
 setup_submit adr35 codex/dcfg-adr35.a; wt_a=$wt; commit_candidate dcfg-adr35.a
 make_worktree "$d" wt2 codex/dcfg-adr35.b || exit 1; wt_b="$d/.worktrees/codex/wt2"
 git -C "$wt_b" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-adr35.b\nAgent: codex' "$wt_b/$tz")"
 : > "$d/events"
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex ADR35_CLOSE_ID=dcfg-adr35.a TEST_TIMEOUT=5; run_tool "$d" --watch 2>&1); rc=$?
 [[ $(grep -c '|show dcfg-adr35.a --json' "$d/bd.calls") -ge 1 && $(grep -c '|show dcfg-adr35.b --json' "$d/bd.calls") == 0 ]] && pass adr35_only_closed_atom_scanned || fail adr35_only_closed_atom_scanned "rc=$rc: $out"
 [[ $(grep -c -- "--atom dcfg-adr35.a " "$d/ship.calls") == 1 && $(grep -c -- '--atom dcfg-adr35.b ' "$d/ship.calls") == 0 ]] && pass adr35_only_closed_atom_shipped || fail adr35_only_closed_atom_shipped "$out"

 setup_submit adr35_full codex/dcfg-adr35.a; wt_a=$wt; commit_candidate dcfg-adr35.a
 make_worktree "$d" wt2 codex/dcfg-adr35.b || exit 1; wt_b="$d/.worktrees/codex/wt2"
 git -C "$wt_b" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-adr35.b\nAgent: codex' "$wt_b/$tz")"
 : > "$d/events"
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex ADR35_CLOSE_ID=dcfg-adr35.a ADR35_FULL_PENDING=1 TEST_TIMEOUT=5; run_tool "$d" --watch 2>&1); rc=$?
 [[ $(grep -c '|show dcfg-adr35.b --json' "$d/bd.calls") -ge 1 ]] && pass adr35_full_scan_precedes_atom || fail adr35_full_scan_precedes_atom "rc=$rc: $out"

 setup_submit adr35_filter codex/dcfg-adr35.a; wt_a=$wt; commit_candidate dcfg-adr35.a
 make_worktree "$d" wt2 codex/dcfg-adr35.b || exit 1; wt_b="$d/.worktrees/codex/wt2"
 git -C "$wt_b" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-adr35.b\nAgent: codex' "$wt_b/$tz")"
 : > "$d/events"
 out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex ADR35_CLOSE_ID=dcfg-adr35.b TEST_TIMEOUT=5; run_tool "$d" --watch --atom dcfg-adr35.a 2>&1); rc=$?
 [[ $(grep -c '|show dcfg-adr35.b --json' "$d/bd.calls") == 0 && $(wc -c < "$d/ship.calls") == 0 ]] && pass adr35_cli_filter_not_broadened || fail adr35_cli_filter_not_broadened "rc=$rc: $out"
}

test_park_live(){
 [[ ${SHIP_POST_LIVE_BD:-0} == 1 ]] || { echo "SKIP park_live (SHIP_POST_LIVE_BD!=1)"; return 0; }
 local atom=${SHIP_POST_LIVE_ATOM:?SHIP_POST_LIVE_ATOM required} live_root=${SHIP_POST_LIVE_ROOT:-/root/workspaces/projects} real_bd=${SHIP_POST_LIVE_BD_BIN:-/root/.local/bin/bd} out inc i st lbl
 setup_submit park_live "claude/$atom-live"; commit_candidate "$atom" claude
 rm -f -- "$d/bin/bd"; ln -s "$real_bd" "$d/bin/bd"
 out=$(env HOME="$HOME" PATH="$d/bin:/usr/bin:/bin" SHIP_POST_TEST_DIR="$d" SHIP_POST_REPOS="$d/repo" SHIP_POST_STATE_DIR="$d/state" \
  SHIP_POST_BEADS_ROOT="$live_root" SHIP_POST_RETRY_SECONDS=1 BEADS_ACTOR='Claude Code' MOCK_SHIP_RC=71 \
  timeout --kill-after=2 60 "$d/bin/ship-post" 2>&1)
 for i in $(seq 1 50); do [[ -f $d/state/incidents/parked/$atom ]] && break; sleep 0.2; done
 inc=$(cat "$d/state/incidents/71" 2>/dev/null)
 echo "park_live: incident=$inc"
 st=$(cd "$live_root" && "$real_bd" show "$inc" --json 2>/dev/null | jq -r '.[0] | "\(.status) \(.priority) \(.issue_type) \((.labels // []) | join(","))"')
 lbl=$(cd "$live_root" && "$real_bd" show "$atom" --json 2>/dev/null | jq -r '.[0] | "\(.status) \((.labels // []) | join(","))"')
 echo "park_live: incident_show=$st atom_show=$lbl"
 [[ -n $inc && $out == *"ship-post: parked: $atom incident $inc"* && $st == "open 0 bug contour:delivery" && $lbl == "closed "*delivery-blocked* ]] && pass park_live || fail park_live "out=$out st=$st lbl=$lbl"
}

test_status(){
	local d out rc sha
	d="$root/status"; make_mocks "$d"; mkdir -p "$d/state"
	sha=$(printf 'status\n' | sha256sum | cut -d' ' -f1)
	st_put(){ mkdir -p "$(dirname "$d/state/$1")"; printf '%b' "$2" > "$d/state/$1"; }
	out=$(run_tool "$d" --status dcfg-s.1 2>&1); rc=$?
	[[ $rc == 0 && $out == 'dcfg-s.1 none' ]] && pass ST1 || fail ST1 "rc=$rc: $out"
	st_put "submissions/a/b/dcfg-s.2/$sha" 'x\n'
	out=$(run_tool "$d" --status dcfg-s.2 2>&1); rc=$?
	[[ $rc == 0 && $out == "dcfg-s.2 ${sha:0:7} submitted" ]] && pass ST2 || fail ST2 "rc=$rc: $out"
	st_put "receipts/r/dcfg-s.2/$sha" '{"stage":"delivered"}\n'
	out=$(run_tool "$d" --status dcfg-s.2 2>&1); rc=$?
	[[ $rc == 0 && $out == *delivered* ]] && pass ST3 || fail ST3 "rc=$rc: $out"
	st_put "submissions/a/b/dcfg-s.4/$sha" 'x\n'
	st_put 'incidents/30' 'dcfg-inc\n'
	st_put "incidents/30.atoms" "dcfg-inc dcfg-s.4 $sha\n"
	out=$(run_tool "$d" --status dcfg-s.4 2>&1); rc=$?
	[[ $rc == 0 && $out == "dcfg-s.4 ${sha:0:7} parked dcfg-inc code 30" ]] && pass ST4 || fail ST4 "rc=$rc: $out"
	git init -q -b main "$d/repo"; git -C "$d/repo" config user.email t@t; git -C "$d/repo" config user.name t
	git -C "$d/repo" commit -q --allow-empty -m a; sha1=$(git -C "$d/repo" rev-parse HEAD)
	git -C "$d/repo" commit -q --allow-empty -m b; sha2=$(git -C "$d/repo" rev-parse HEAD)
	st_put "submissions/a/b/dcfg-s.5/$sha2" 'x\n'
	st_put 'incidents/40' 'dcfg-park\n'
	st_put "incidents/40.atoms" "dcfg-park dcfg-s.5 $sha1 dcfg-other.9 $sha1\n"
	out=$(run_tool "$d" --status dcfg-s.5 2>&1); rc=$?
	[[ $rc == 0 && $out == "dcfg-s.5 ${sha2:0:7} submitted" ]] && pass ST6 || fail ST6 "rc=$rc: $out"
	st_put "submissions/a/b/dcfg-s.6/$sha2" 'x\n'
	st_put "incidents/40.atoms" "dcfg-park dcfg-s.6 $sha2\n"
	out=$(run_tool "$d" --status dcfg-s.6 2>&1); rc=$?
	[[ $rc == 0 && $out == "dcfg-s.6 ${sha2:0:7} parked dcfg-park code 40" ]] && pass ST7 || fail ST7 "rc=$rc: $out"
	out=$(run_tool "$d" --status 'bad id!' 2>&1); rc=$?
	[[ $rc == 2 && $out == *'invalid atom'* ]] && pass ST5 || fail ST5 "rc=$rc: $out"
}

test_hints(){
	local out rc count i
	setup_submit hints_actor codex/dcfg-hints.1; git -C "$d/repo" worktree move "$wt" "$d/moved-wt" && wt="$d/moved-wt"; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR= BD_ASSIGNEE=Codex; submit dcfg-hints.1 "$tz" file.txt 2>&1); rc=$?
	[[ $rc == 2 && $out == *"BEADS_ACTOR='Claude Code'"* ]] && pass H1 || fail H1 "rc=$rc: $out"
	setup_submit hints_assignee codex/dcfg-hints.2; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE='Claude Code'; submit dcfg-hints.2 "$tz" file.txt 2>&1); rc=$?
	[[ $rc == 2 && $out == *'actual assignee='* && $out == *'bd update dcfg-'* && $out == *'--claim'* ]] && pass H2 || fail H2 "rc=$rc: $out"
	setup_submit hints_status codex/dcfg-hints.3; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex BD_STATUS=open; submit dcfg-hints.3 "$tz" file.txt 2>&1); rc=$?
	[[ $rc == 2 && $out == *'need in_progress'* && $out == *'--claim'* ]] && pass H3 || fail H3 "rc=$rc: $out"
	setup_submit hints_dirty codex/dcfg-hints.4; printf x > "$wt/file.txt"
	for i in $(seq 1 12); do printf 't\n' > "$wt/extra$i.txt"; done
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-hints.4 "$tz" file.txt 2>&1); rc=$?
	count=$(grep -c '^ship-post:' <<<"$out")
	[[ $rc == 1 && $out == *'total 12'* && $out == *'safe-delete'* && count -le 13 ]] && pass H4 || fail H4 "rc=$rc count=$count: $out"
	setup_submit hints_title codex/dcfg-hints.5
	printf '%s\n' '---' 'title: x' '---' '# Real title' > "$wt/$tz"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-hints.5 "$tz" 2>&1); rc=$?
	[[ $rc == 0 && $(git -C "$wt" log -1 --format=%s) == 'dcfg-hints.5: Real title' ]] && pass H5 || fail H5 "rc=$rc: $out"
	[[ $rc == 0 && $out =~ committed\ dcfg-hints.5\ [0-9a-f]{7,}\ on\  ]] && pass H6 || fail H6 "rc=$rc: $out"
	setup_submit hints_help codex/dcfg-hints.6
	out=$(run_tool "$d" --help 2>/dev/null); rc=$?
	[[ $rc == 0 && $out == *'usage:'* ]] && pass H7 || fail H7 "rc=$rc: $out"
}

test_break_glass(){
	local out rc h key after
	setup_submit bg_none codex/dcfg-bg.1; commit_candidate dcfg-bg.1
	h=$(git -C "$wt" rev-parse HEAD)
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; run_tool "$d" --break-glass "$wt" --atom dcfg-bg.1 2>&1); rc=$?
	[[ $rc == 2 && $out == *"break-glass refused: no recorded INFRA failure for $h"* ]] && pass BG1 || fail BG1 "rc=$rc: $out"
	setup_submit bg_leak codex/dcfg-bg.2; commit_candidate dcfg-bg.2
	printf 'aws_key = AKIAIOSFODNN7EXAMPLE\n' > "$wt/secret.txt"; git -C "$wt" add -- secret.txt; git -C "$wt" commit -q -m secret
	h=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
	mkdir -p "$d/state/receipts/$key/dcfg-bg.2"; printf 30 > "$d/state/receipts/$key/dcfg-bg.2/$h.failed"
	: > "$d/bd.calls"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex GITLEAKS_RC=1; run_tool "$d" --break-glass "$wt" --atom dcfg-bg.2 2>&1); rc=$?
	[[ $rc == 20 && $out == *'break-glass refused: gitleaks'* ]] && pass BG2 || fail BG2 "rc=$rc: $out"
	[[ $(grep -c '|create ' "$d/bd.calls") == 0 ]] && pass BG3 || fail BG3 'incident filed during gitleaks refusal'
	setup_submit bg_ok codex/dcfg-bg.3; commit_candidate dcfg-bg.3
	h=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
	mkdir -p "$d/state/receipts/$key/dcfg-bg.3"; printf 30 > "$d/state/receipts/$key/dcfg-bg.3/$h.failed"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; run_tool "$d" --break-glass "$wt" --atom dcfg-bg.3 2>&1); rc=$?
	[[ $rc == 0 && $out == *'incident=test-infra'* && $out == *'direct=pushed'* && $out == *'pr=skipped'* ]] && pass BG4 || fail BG4 "rc=$rc: $out"
	after=$(git --git-dir="$d/origin.git" rev-parse refs/heads/codex/dcfg-bg.3 2>/dev/null)
	[[ $after == "$h" ]] && pass BG5 || fail BG5 "remote=$after want=$h"
	grep -Fq 'break-glass used: incident test-infra' "$d/bd.notes" && pass BG6 || fail BG6 'atom note'
	[[ $(jq -r .stage "$d/state/receipts/$key/dcfg-bg.3/$h.break-glass" 2>/dev/null) == break-glass ]] && pass BG7 || fail BG7 'audit receipt'
}

v9_ship(){ # v9: stub ship; MOCK_SHIP_OK доставляет только свой atom, остальные отвечают MOCK_SHIP_RC
	cat > "$d/bin/ship" <<'V9SHIP'
#!/usr/bin/env bash
printf '%s|%s|%s\n' "${BEADS_ACTOR:-}" "$*" "$(git -C "$1" rev-parse HEAD)" >> "$SHIP_POST_TEST_DIR/ship.calls"
[[ -z ${MOCK_SHIP_LOG:-} ]] || { printf '%s\n' "$MOCK_SHIP_LOG"; printf '%s\n' "$MOCK_SHIP_LOG" >&2; }
if [[ -n ${MOCK_SHIP_OK:-} && " $* " == *" --atom $MOCK_SHIP_OK "* ]]; then
 printf '%s\n' "$(git -C "$1" rev-parse HEAD)" >> "$SHIP_POST_TEST_DIR/merged.$(git -C "$1" rev-parse --abbrev-ref HEAD | tr / _)"; exit 0
fi
exit "${MOCK_SHIP_RC:-0}"
V9SHIP
	chmod +x "$d/bin/ship"
}
v9_gh(){ # v9: gh mock filters merged PRs by --head branch, as real gh does
	cat > "$d/bin/gh" <<'V9GH'
#!/usr/bin/env bash
if [[ $1 == repo ]]; then echo '{"isPrivate":true}'; exit; fi
b=''; while (($#)); do [[ $1 == --head ]] && b=$2; shift; done
f="$SHIP_POST_TEST_DIR/merged.${b//\//_}"
if [[ -n $b && -s $f ]]; then jq -Rs '[split("\n")[] | select(length>0) | {headRefOid:.,state:"MERGED",url:"https://github.com/test/private/pull/1",mergeCommit:{oid:"merged-test"},statusCheckRollup:[]}]' "$f"; else echo '[]'; fi
V9GH
	chmod +x "$d/bin/gh"
}
test_v9(){
	local key rf marker h out rc i b_ok
	# v9c: exit 130 -> маркер .failed=130, без INFRA и без delivery-blocked.
	setup_submit v9c codex/dcfg-v9c.1; commit_candidate dcfg-v9c.1
	h=$(git -C "$wt" rev-parse HEAD); v9_ship
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=130; run_tool "$d" 2>&1); rc=$?
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); marker="$d/state/receipts/$key/dcfg-v9c.1/$h.failed"
	for i in $(seq 1 50); do [[ -f $marker ]] && break; sleep 0.2; done
	[[ $rc == 0 && -f $marker && $(<"$marker") == 130 ]] && ! grep -Fq '|create [ship-post] INFRA' "$d/bd.calls" && ! grep -Fq 'delivery-blocked' "$d/bd.calls" && pass v9c || fail v9c "rc=$rc: $out"

	# v9d: два atom в одном INFRA: первый доставлен -> инцидент открыт; второй доставлен -> bd close инцидента.
	setup_submit v9d codex/dcfg-v9d.1; commit_candidate dcfg-v9d.1
	make_worktree "$d" wt2 codex/dcfg-v9d.2 || exit 1
	git -C "$d/.worktrees/codex/wt2" commit -q --allow-empty -m candidate -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-v9d.2\nAgent: codex' "$d/.worktrees/codex/wt2/$tz")"
	echo open > "$d/status.test-infra"; v9_ship; v9_gh
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30; run_tool "$d" 2>&1)
	for i in $(seq 1 50); do [[ -f $d/state/incidents/parked/dcfg-v9d.1 && -f $d/state/incidents/parked/dcfg-v9d.2 ]] && break; sleep 0.2; done
	touch -d '-2 hours' "$d/state/incidents/parked/dcfg-v9d.1" "$d/state/incidents/parked/dcfg-v9d.2"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30 MOCK_SHIP_OK=dcfg-v9d.1; run_tool "$d" 2>&1); rc=$?
	for i in $(seq 1 50); do [[ ! -f $d/state/incidents/parked/dcfg-v9d.1 ]] && break; sleep 0.2; done
	[[ $rc == 0 && ! -f $d/state/incidents/parked/dcfg-v9d.1 && -f $d/state/incidents/parked/dcfg-v9d.2 ]] && ! grep -Fq '|close test-infra' "$d/bd.calls" && b_ok=1 || b_ok=0
	touch -d '-2 hours' "$d/state/incidents/parked/dcfg-v9d.2"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30 MOCK_SHIP_OK=dcfg-v9d.2; run_tool "$d" 2>&1); rc=$?
	for i in $(seq 1 50); do grep -Fq '|close test-infra' "$d/bd.calls" && break; sleep 0.2; done
	[[ $b_ok == 1 ]] && grep -Fq '|close test-infra' "$d/bd.calls" && pass v9d || fail v9d "rc=$rc: $out"

	# v9b: GraphQL 'No commits' при HEAD, уже в origin/main -> квитанция доставки, без INFRA и без delivery-blocked.
	setup_submit v9b codex/dcfg-v9b.1; commit_candidate dcfg-v9b.1
	h=$(git -C "$wt" rev-parse HEAD); git -C "$wt" push -q origin HEAD:main; git -C "$wt" fetch -q origin
	v9_ship
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=30 MOCK_SHIP_LOG='pull request create failed: GraphQL: No commits between main and codex/dcfg-v9b.1'; run_tool "$d" 2>&1); rc=$?
	key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1); rf="$d/state/receipts/$key/dcfg-v9b.1/$h"
	for i in $(seq 1 50); do [[ -f $rf ]] && break; sleep 0.2; done
	[[ $rc == 0 && -f $rf ]] && ! grep -Fq '|create [ship-post] INFRA' "$d/bd.calls" && ! grep -Fq 'delivery-blocked' "$d/bd.calls" && pass v9b || fail v9b "rc=$rc: $out"

	# v9e: .failed=50 на H, atom закрыт позже mtime маркера -> ship для H вызван повторно; контроль: closed_at раньше маркера -> не вызван.
	setup_submit v9e codex/dcfg-v9e.1; commit_candidate dcfg-v9e.1
	h=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
	mkdir -p "$d/state/receipts/$key/dcfg-v9e.1"; printf 50 > "$d/state/receipts/$key/dcfg-v9e.1/$h.failed"; touch -d '-1 hour' "$d/state/receipts/$key/dcfg-v9e.1/$h.failed"
	touch "$d/state/receipts/$key/dcfg-v9e.1/$h.failed.reported"
	date -u -d '-10 minutes' -Iseconds > "$d/bd.closed_at"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && $(grep -c -- '--atom dcfg-v9e.1 ' "$d/ship.calls") == 1 ]] && grep -Fq "$h" "$d/ship.calls" && pass v9e || fail v9e "rc=$rc: $out"
	setup_submit v9e_control codex/dcfg-v9e.2; commit_candidate dcfg-v9e.2
	h=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
	mkdir -p "$d/state/receipts/$key/dcfg-v9e.2"; printf 50 > "$d/state/receipts/$key/dcfg-v9e.2/$h.failed"; touch -d '-1 hour' "$d/state/receipts/$key/dcfg-v9e.2/$h.failed"
	touch "$d/state/receipts/$key/dcfg-v9e.2/$h.failed.reported"
	date -u -d '-2 hours' -Iseconds > "$d/bd.closed_at"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
	[[ $rc == 0 && ! -s $d/ship.calls ]] && pass v9e_control || fail v9e_control "rc=$rc: $out"
}

if [[ ${SHIP_POST_TEST_GROUP:-all} == review ]]; then
 test_review_recovery
elif [[ ${SHIP_POST_TEST_GROUP:-all} == status ]]; then
 test_status
elif [[ ${SHIP_POST_TEST_GROUP:-all} == hints ]]; then
 test_hints
elif [[ ${SHIP_POST_TEST_GROUP:-all} == recovery ]]; then
 test_service_recovery; test_recovery_boundaries; test_accepted_ship; test_review_recovery
elif [[ ${SHIP_POST_TEST_GROUP:-all} == broken ]]; then
 test_broken_link
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == v4 ]]; then
	 test_final_states; test_nested_repo
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == u14 ]]; then
	 test_submit_conflict_preflight
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == u15 ]]; then
	 test_u15
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == adr30 ]]; then
	 test_adr30
 elif [[ ${SHIP_POST_TEST_GROUP:-all} == park ]]; then
  test_park
 elif [[ ${SHIP_POST_TEST_GROUP:-all} == park-live ]]; then
  test_park_live
 elif [[ ${SHIP_POST_TEST_GROUP:-all} == lock ]]; then
	 test_watch_lock_released
	elif [[ ${SHIP_POST_TEST_GROUP:-all} == adr35 ]]; then
	 test_adr35
		elif [[ ${SHIP_POST_TEST_GROUP:-all} == auto ]]; then
		 test_auto_submit
else
	 test_dryrun_mocks; test_skip_log; test_valid_actors; test_rejections; test_hook_and_retry; test_closed_retry; test_remote_result_closed; test_delivery; test_beads_root_fallback; test_broken_link; test_live_sync; test_watch; test_recovery; test_stream_errors; test_closed_skip_reason; test_concurrent_repositories; test_watch_lock_released; test_service_recovery; test_recovery_boundaries; test_accepted_ship; test_review_recovery; test_actor_alias; test_nested_repo; test_final_states; test_submit_conflict_preflight; test_u15; test_adr30; test_park; test_park_live; test_hints; test_status; test_break_glass; test_auto_submit
fi
if [[ ${SHIP_POST_TEST_GROUP:-all} == all || ${SHIP_POST_TEST_GROUP:-} == v9 ]]; then test_v9; fi
T=$root
mkdir -p "$T/br/.beads"; git init -q "$T/br"
git -C "$T/br" commit -q --allow-empty -m x
git -C "$T/br" worktree add -q "$T/brw"
br_out=$(bash -c '. "$1"; ga_beads_root "$2"' _ "$bin/git-auto-lib" "$T/brw")
[[ $(realpath "$br_out") == $(realpath "$T/br") ]] && pass 'BR1 worktree beads root' || fail 'BR1 worktree beads root' "got=$br_out want=$T/br"
br_out=$(SHIP_POST_BEADS_ROOT=/x bash -c '. "$1"; ga_beads_root /tmp' _ "$bin/git-auto-lib")
[[ $br_out == /x ]] && pass 'BR2 fallback env' || fail 'BR2 fallback env' "got=$br_out want=/x"
# ship-post --wait: event-driven final delivery state (dcfg-p6mn5.2)
wd=$(mktemp -d "$root/wait.XXXXXX")
mkdir -p "$wd/state/receipts/r/wa" "$wd/state/submissions/r/w/wa"
printf '{"stage":"delivered"}\n' > "$wd/state/receipts/r/wa/aaaaaa1"; : > "$wd/state/submissions/r/w/wa/aaaaaa1"
out=$(SHIP_POST_STATE_DIR="$wd/state" timeout --kill-after=2 10 "$bin/ship-post" --wait wa --timeout 2 2>&1); rc=$?
[[ $rc == 0 && $out == *delivered* ]] && pass W1 || fail W1 "rc=$rc: $out"

wd=$(mktemp -d "$root/wait.XXXXXX")
mkdir -p "$wd/state/submissions/r/w/wb"; : > "$wd/state/submissions/r/w/wb/aaaaaa2"
out=$(SHIP_POST_STATE_DIR="$wd/state" timeout --kill-after=2 10 "$bin/ship-post" --wait wb --timeout 1 2>&1); rc=$?
[[ $rc == 3 ]] && pass W2 || fail W2 "rc=$rc: $out"

wd=$(mktemp -d "$root/wait.XXXXXX")
mkdir -p "$wd/state/submissions/r/w/wc" "$wd/state/receipts/r/wc"; : > "$wd/state/submissions/r/w/wc/aaaaaa3"
t0=$(date +%s%3N)
( SHIP_POST_STATE_DIR="$wd/state" timeout --kill-after=2 15 "$bin/ship-post" --wait wc --timeout 10 >"$wd/wc.out" 2>&1 ) & wcpid=$!
sleep 1
printf '{"stage":"delivered"}\n' > "$wd/aaaaaa3.tmp" && mv -- "$wd/aaaaaa3.tmp" "$wd/state/receipts/r/wc/aaaaaa3"
wait "$wcpid"; rc=$?
elapsed=$(( $(date +%s%3N) - t0 ))
[[ $rc == 0 && $elapsed -lt 5000 ]] && pass W3 || fail W3 "rc=$rc elapsed=${elapsed}ms: $(cat "$wd/wc.out")"

echo "checks=$checks failures=$failures"
[[ $failures == 0 ]]
