}
test_recovery(){
 local out rc h key saved
 setup_submit crash codex/dcfg-crash.1; commit_candidate dcfg-crash.1
 h=$(git -C "$wt" rev-parse HEAD); key=$(printf %s "$d/repo" | sha256sum | cut -d ' ' -f1)
 mkdir -p "$d/state/inflight/$key"; printf '%s\n' "$h" > "$d/state/inflight/$key/dcfg-crash.1"; printf '%s' "$h" > "$d/merged"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && ! -s $d/ship.calls && -f $d/state/receipts/$key/dcfg-crash.1/$h ]] && pass crash_reconciled || fail crash_reconciled "$out"
 setup_submit dirty codex/dcfg-dirty.1; commit_candidate dcfg-dirty.1; printf foreign > "$wt/untracked"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1)
 [[ ! -s $d/ship.calls && -f $wt/untracked ]] && pass dirty_preserved || fail dirty_preserved "$out"
 setup_submit claude_delivery claude/dcfg-claude.1; commit_candidate dcfg-claude.1 claude
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 ]] && grep -q '^Claude Code|' "$d/ship.calls" && pass claude_delivery || fail claude_delivery "$out"
 setup_submit failure codex/dcfg-failure.1; commit_candidate dcfg-failure.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=40; run_tool "$d" 2>&1); rc=$?
	for i in $(seq 1 50); do grep -q 'reopen dcfg-failure.1' "$d/bd.calls" && break; sleep 0.2; done
	[[ $rc == 0 ]] && grep -q 'reopen dcfg-failure.1' "$d/bd.calls" && pass ci_failure || fail ci_failure "$out"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_SHIP_RC=40; run_tool "$d" 2>&1)
 [[ $(wc -l < "$d/ship.calls") == 1 && $(grep -c 'create ' "$d/bd.calls") == 0 ]] && pass failure_dedup || fail failure_dedup "$out"
 setup_submit excluded codex/dcfg-excluded.1; commit_candidate dcfg-excluded.1
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex TEST_REPOS="$d/not-allowlisted"; run_tool "$d" 2>&1)
 [[ ! -s $d/ship.calls ]] && pass allowlist || fail allowlist "$out"
}
test_stream_errors(){
 local out rc
 setup_submit malformed codex/dcfg-malformed.1
 printf '%s\n' '{"broken":true}' > "$d/events"
 out=$(export BEADS_ACTOR=Codex TEST_TIMEOUT=3; run_tool "$d" --watch 2>&1); rc=$?
 [[ $rc == 1 && $out == *'malformed journal record'* && ! -f $d/state/cursor.json ]] && pass malformed_no_ack || fail malformed_no_ack "$out rc=$rc"
 setup_submit bd_stderr codex/dcfg-bd-stderr.1
 printf '%s\n' '{"seq":1,"op":"update","issue":{"status":"in_progress"}}' > "$d/events"
 out=$(export BEADS_ACTOR=Codex EVENT_STDERR='beads: auto-export warning' TEST_TIMEOUT=3; run_tool "$d" --watch 2>&1); rc=$?
 [[ $out == *'ship-post: bd: beads: auto-export warning'* && $out != *'malformed journal record'* && $(jq -r .seq "$d/state/cursor.json") == 1 ]] && pass bd_stderr_skipped || fail bd_stderr_skipped "$out rc=$rc"
 setup_submit truncated codex/dcfg-truncated.1
 printf '%s\n' '{"code":"events_journal_truncated","floor":9,"head":10}' > "$d/events"
 out=$(export BEADS_ACTOR=Codex TEST_TIMEOUT=3; run_tool "$d" --watch 2>&1); rc=$?
 [[ $rc == 1 && $(jq -r .seq "$d/state/cursor.json") == 8 ]] && pass truncation_rebaseline || fail truncation_rebaseline "$out rc=$rc"
 printf '%s\n' '{"seq":9,"op":"update","issue":{"status":"in_progress"}}' > "$d/events"
 out=$(export BEADS_ACTOR=Codex EVENT_STREAM_FAIL=1 TEST_TIMEOUT=3; run_tool "$d" --watch 2>&1); rc=$?
 [[ $rc == 1 && $out == *'journal stream ended (exit 7)'* ]] && pass stream_exit_observed || fail stream_exit_observed "$out rc=$rc"
 jq '.identity="different-ledger"' "$d/state/cursor.json" > "$d/state/x"; mv "$d/state/x" "$d/state/cursor.json"
 out=$(export BEADS_ACTOR=Codex TEST_TIMEOUT=3; run_tool "$d" --watch 2>&1); rc=$?
 [[ $rc == 1 && $out == *'ledger identity changed'* ]] && pass identity_refused || fail identity_refused "$out rc=$rc"
}

test_remote_result_closed(){
 local d head impl=${SHIP_POST_TEST_IMPL:-"$bin/ship-post"} rc out
 d="$root/rr"; make_repo "$d" || exit 1; make_mocks "$d"; head=$(git -C "$d/repo" rev-parse HEAD)
 out=$(export HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" SHIP_POST_TEST_DIR="$d" MOCK_PR_CLOSED=$head; bash -c 'eval "$(sed -n "/^remote_result(){/,/^}/p" "$1")"; remote_result "$2" "$3" codex/dcfg-rr.1' _ "$impl" "$d/repo" "$head" 2>&1); rc=$?
 assert_rc RR1 21 "$rc" "$out"
 out=$(export HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" SHIP_POST_TEST_DIR="$d" MOCK_PR_CLOSED=0000000000000000000000000000000000000000; bash -c 'eval "$(sed -n "/^remote_result(){/,/^}/p" "$1")"; remote_result "$2" "$3" codex/dcfg-rr.1' _ "$impl" "$d/repo" "$head" 2>&1); rc=$?
 assert_rc RR2 24 "$rc" "$out"
}
