#!/usr/bin/env bash
set -uo pipefail
case ${1:-} in --help|-h) echo 'usage: bash bin/ship-post-test [--help|-h] - run ship-post regression checks; SHIP_POST_TEST_GROUP selects a group'; exit 0 ;; esac

bin=$(cd -- "$(dirname -- "$0")" && pwd)
root=$(mktemp -d)
trap 'rm -rf -- "$root"' EXIT
checks=0 failures=0
pass(){ checks=$((checks + 1)); echo "PASS $1"; }
fail(){ checks=$((checks + 1)); failures=$((failures + 1)); echo "FAIL $1: $2"; }
assert_rc(){ [[ $3 == "$2" ]] && pass "$1" || fail "$1" "rc=$3 want=$2: $4"; }
assert_nonzero(){
 local expected
 case $1 in
 13) expected='worktree must be linked' ;; 14|15) expected='actual assignee=' ;;
 16) expected='must match codex/' ;; 17) expected='invalid ТЗ path' ;;
 18) expected='ТЗ must be an existing file' ;; 19|20) expected='dirty or staged files outside' ;;
 21) expected='unknown BEADS_ACTOR' ;; 22) expected='invalid file path' ;;
 23) expected='commit failed' ;; 25) expected='bd close failed' ;; *) expected='ship-post:' ;;
 esac
 [[ $2 != 0 && $3 == *"$expected"* ]] && pass "$1" || fail "$1" "wrong rejection rc=$2 expected=$expected: $3"
}

make_repo(){
	local d=$1
	git init -q --bare "$d/origin.git"; git -C "$d/origin.git" symbolic-ref HEAD refs/heads/main
	git clone -q "$d/origin.git" "$d/repo"; git -C "$d/repo" config user.email t@t; git -C "$d/repo" config user.name t
	mkdir -p "$d/repo/.github/workflows"; printf 'base\n' > "$d/repo/base.txt"; printf 'on: pull_request\n' > "$d/repo/.github/workflows/test.yml"; git -C "$d/repo" add -- base.txt .github/workflows/test.yml; git -C "$d/repo" commit -q -m base
	git -C "$d/repo" push -q origin main; git -C "$d/repo" fetch -q origin
}
make_worktree(){ git -C "$1/repo" worktree add -q -b "$3" "$1/.worktrees/${3%%/*}/$2" origin/main; }
make_mocks(){
	local d=$1 impl=${SHIP_POST_TEST_IMPL:-"$bin/ship-post"}; mkdir -p "$d/bin" "$d/home"; cp -f -- "$impl" "$bin/git-auto-lib" "$d/bin/"
	cat > "$d/bin/ship" <<'MOCKSHIP'
#!/usr/bin/env bash
printf '%s|%s|%s\n' "${BEADS_ACTOR:-}" "$*" "$(git -C "$1" rev-parse HEAD)" >> "$SHIP_POST_TEST_DIR/ship.calls"
[[ ${MOCK_SHIP_DELAY:-0} == 0 ]] || sleep "$MOCK_SHIP_DELAY"
[[ ${MOCK_SHIP_RC:-0} == 0 ]] || exit "$MOCK_SHIP_RC"
	[[ -z ${MOCK_SHIP_OUT:-} ]] || { printf '%b\n' "$MOCK_SHIP_OUT"; exit 0; }
printf '%s\n' "$(git -C "$1" rev-parse HEAD)" >> "$SHIP_POST_TEST_DIR/merged"
MOCKSHIP
	cat > "$d/bin/gh" <<'MOCKGH'
#!/usr/bin/env bash
[[ ${MOCK_GH_FAIL:-0} == 0 ]] || exit 1
if [[ $1 == repo ]]; then echo '{"isPrivate":true}'; exit; fi
if [[ -n ${MOCK_PR_HEAD:-} && ! -s $SHIP_POST_TEST_DIR/merged ]]; then
 jq -n --arg h "$MOCK_PR_HEAD" --arg c "${MOCK_CHECK_CONCLUSION:-}" '[{headRefOid:$h,state:"OPEN",statusCheckRollup:[{conclusion:$c}]}]'; exit
fi
if [[ -n ${MOCK_PR_CLOSED:-} ]]; then
 jq -n --arg h "$MOCK_PR_CLOSED" '[{headRefOid:$h,state:"CLOSED",url:"https://github.com/test/private/pull/2",mergeCommit:null,statusCheckRollup:[]}]'; exit
fi
if [[ -s $SHIP_POST_TEST_DIR/merged ]]; then
 jq -Rs '[split("\n")[] | select(length>0) | {headRefOid:.,state:"MERGED",url:"https://github.com/test/private/pull/1",mergeCommit:{oid:"merged-test"},statusCheckRollup:[]}]' "$SHIP_POST_TEST_DIR/merged"
else echo '[]'; fi
MOCKGH
	printf '#!/usr/bin/env bash\nexit "${GITLEAKS_RC:-0}"\n' > "$d/bin/gitleaks"
	cat > "$d/bin/bd" <<'EOF'
#!/usr/bin/env bash
printf '%s|%s|%s\n' "$PWD" "${BEADS_ACTOR:-}" "$*" >> "${SHIP_POST_TEST_DIR}/bd.calls"
case ${1:-} in
	show) [[ ! -f $SHIP_POST_TEST_DIR/bd-down ]] || exit 1
	 if [[ -f ${BEADS_DIR:-}/missing-atoms ]] && grep -Fxq -- "${2:-}" "${BEADS_DIR:-}/missing-atoms"; then printf 'Issue %s not found\n' "${2:-}" >&2; exit 1; fi
	 jq -n --arg status "$(cat "$SHIP_POST_TEST_DIR/status.${2:-}" 2>/dev/null || cat "$SHIP_POST_TEST_DIR/status" 2>/dev/null || echo "${BD_STATUS:-in_progress}")" --arg assignee "${BD_ASSIGNEE-Codex}" --arg notes "$(cat "$SHIP_POST_TEST_DIR/bd.notes" 2>/dev/null || true)" --arg desc "$(cat "$SHIP_POST_TEST_DIR/bd.description" 2>/dev/null || true)" --arg reason "$(cat "$SHIP_POST_TEST_DIR/bd.reason" 2>/dev/null || true)" --arg closed_at "$(cat "$SHIP_POST_TEST_DIR/bd.closed_at" 2>/dev/null || date -Iseconds)" '[{status:$status,assignee:$assignee,notes:$notes,description:$desc,close_reason:$reason,closed_at:$closed_at}]' ;;
info) printf '{"database_path":"%s"}\n' "$SHIP_POST_TEST_DIR/repo/.git" ;;
events) [[ -z ${EVENT_STDERR:-} ]] || printf '%s\n' "$EVENT_STDERR" >&2
 cat "$SHIP_POST_TEST_DIR/events"; [[ ${EVENT_STREAM_FAIL:-0} == 1 ]] && exit 7
 if [[ ${PARTIAL_EVENT:-0} == 1 ]]; then
  printf '{"seq":'; /bin/sleep 2; printf '%s\n' '1,"op":"update","issue":{"status":"in_progress"}}'
 fi
 if [[ ${DELAYED_CLOSE:-0} == 1 ]]; then
  /bin/sleep 1; echo in_progress > "$SHIP_POST_TEST_DIR/status"
  printf '%s\n' '{"seq":1,"op":"update","issue":{"status":"in_progress"}}'
  /bin/sleep 1; [[ ! -s $SHIP_POST_TEST_DIR/ship.calls ]] && touch "$SHIP_POST_TEST_DIR/no-early-ship"
  echo closed > "$SHIP_POST_TEST_DIR/status"
  printf '%s\n' '{"seq":2,"op":"close","issue":{"status":"closed"}}'
 fi
	 if [[ -n ${ADR35_CLOSE_ID:-} ]]; then
	  /bin/sleep 1; : > "$SHIP_POST_TEST_DIR/bd.calls"
	  echo closed > "$SHIP_POST_TEST_DIR/status.dcfg-adr35.a"
	  echo closed > "$SHIP_POST_TEST_DIR/status.dcfg-adr35.b"
	  if [[ ${ADR35_FULL_PENDING:-0} == 1 ]]; then
	   key=$(printf %s "$SHIP_POST_TEST_DIR/repo" | sha256sum | cut -d ' ' -f1)
	   touch "$SHIP_POST_STATE_DIR/pending/$key.full" "$SHIP_POST_STATE_DIR/pending/$key"
	  fi
	  printf '{"seq":1,"op":"close","issue":{"id":"%s","status":"closed"}}\n' "$ADR35_CLOSE_ID"
	 fi
 while :; do /bin/sleep 1; done ;;
create) echo "$2" > "$SHIP_POST_TEST_DIR/issue-title"; echo test-infra ;;
search) if [[ -f $SHIP_POST_TEST_DIR/issue-title ]]; then jq -n --arg title "$(cat "$SHIP_POST_TEST_DIR/issue-title")" '[{id:"test-infra",title:$title,status:"open"}]'; else echo '[]'; fi ;;
update) [[ ! -f $SHIP_POST_TEST_DIR/notes-down ]] || exit 1; printf '%s\n' "${4:-}" >> "$SHIP_POST_TEST_DIR/bd.notes" ;;
dep) [[ ! -f $SHIP_POST_TEST_DIR/dep-down ]] || exit 1 ;;
reopen) echo open > "$SHIP_POST_TEST_DIR/status" ;;
close) printf '%s\n' "${2:-}" >> "${SHIP_POST_TEST_DIR}/bd.closes"; exit "${BD_CLOSE_RC:-0}" ;;
esac
EOF
	cat > "$d/bin/git-sync" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$SHIP_POST_TEST_DIR/sync.calls"
exit "${GIT_SYNC_RC:-0}"
EOF
	chmod +x "$d/bin/ship-post" "$d/bin/ship" "$d/bin/gitleaks" "$d/bin/bd" "$d/bin/gh" "$d/bin/git-sync"; : > "$d/ship.calls"; : > "$d/bd.calls"; : > "$d/bd.closes"; : > "$d/sync.calls"
}
run_tool(){
	local d=$1; shift
	env HOME="$d/home" PATH="$d/bin:/usr/bin:/bin" SHIP_POST_TEST_DIR="$d" \
		SHIP_POST_REPOS="${TEST_REPOS:-$d/repo}" SHIP_POST_STATE_DIR="$d/state" SHIP_POST_BEADS_ROOT="$d" SHIP_POST_RETRY_SECONDS=1 \
		timeout --kill-after=2 "${TEST_TIMEOUT:-15}" "$d/bin/ship-post" "$@"
}
setup_submit(){
	local name=$1 branch=$2
	d="$root/$name"; make_repo "$d" || exit 1; mkdir -p "$d/repo/docs/tz"; printf '# TZ\n' > "$d/repo/docs/tz/TZ-TEST.md"
	git -C "$d/repo" add -- docs/tz/TZ-TEST.md; git -C "$d/repo" commit -q -m tz; git -C "$d/repo" push -q origin main
	make_worktree "$d" wt "$branch" || exit 1; wt="$d/.worktrees/${branch%%/*}/wt"; tz='docs/tz/TZ-TEST.md'; make_mocks "$d"
}
submit(){ run_tool "$d" --submit "$wt" --atom "$1" --tz "$2#U2" --evidence evidence --files "$tz" "${@:3}"; }

test_submit_conflict_preflight(){
	local out rc want
	setup_submit conflict codex/dcfg-conflict.1
	printf 'origin\n' > "$d/repo/base.txt"; git -C "$d/repo" add -- base.txt; git -C "$d/repo" commit -q -m origin-change; git -C "$d/repo" push -q origin main
	printf 'branch\n' > "$wt/base.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-conflict.1 "$tz" base.txt 2>&1); rc=$?
	want="ship-post: fix: git -C $wt fetch origin && git -C $wt merge origin/main -m \"dcfg-conflict.1: merge origin/main\" -m \"ТЗ: $wt/docs/tz/TZ-TEST.md#U2\" -m \"Atom: dcfg-conflict.1\" -m \"Agent: codex\"; resolve files; git -C $wt commit --no-edit; test; submit again"
	[[ $rc == 50 && $out == *"ship-post: conflict with origin/main: base.txt"* && $out == *"$want"* && ! -e $d/state && ! -s $d/bd.closes ]] && pass U14_conflict_before_state || fail U14_conflict_before_state "rc=$rc: $out"

	setup_submit clean codex/dcfg-clean.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-clean.1 "$tz" file.txt 2>&1); rc=$?
	[[ $rc == 0 && -s $d/bd.closes && -e $d/state/submissions ]] && pass U14_clean_submit_unchanged || fail U14_clean_submit_unchanged "rc=$rc: $out"

	setup_submit nofetch codex/dcfg-nofetch.1; printf x > "$wt/file.txt"
	git -C "$wt" remote set-url origin "$d/broken-origin.git"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-nofetch.1 "$tz" file.txt 2>&1); rc=$?
	sha=$(git -C "$wt" rev-parse HEAD)
	[[ $rc == 0 && $(<"$d/bd.closes") == dcfg-nofetch.1 && $out == *'conflict gate deferred'* \
		&& $(grep -cF 'close dcfg-nofetch.1' "$d/bd.calls") == 1 ]] && compgen -G "$d/state/submissions/*/*/dcfg-nofetch.1/$sha" >/dev/null \
		&& pass U14_fetch_failure_close || fail U14_fetch_failure_close "rc=$rc: $out"
}

test_auto_submit(){
	local out rc before after
	setup_submit auto1 claude/dcfg-auto.1; printf 'file.txt\n' >> "$wt/docs/tz/TZ-TEST.md"; printf x > "$wt/file.txt"
	printf 'ТЗ: docs/tz/TZ-TEST.md#U1\n' > "$d/bd.description"; echo closed > "$d/status.dcfg-auto.1"; echo 'done' > "$d/bd.reason"
	before=$(git -C "$wt" rev-parse HEAD)
	out=$(export BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?; after=$(git -C "$wt" rev-parse HEAD)
	if [[ $rc == 0 && $after != "$before" && $out == *"auto-submit dcfg-auto.1 $after"* ]] && grep -Fxq 'Atom: dcfg-auto.1' <(git -C "$wt" log -1 --format=%B) \
		&& grep -Fxq 'Agent: claude' <(git -C "$wt" log -1 --format=%B) && grep -Fq 'ship-post auto-submit' "$d/bd.notes" && [[ ! -s $d/bd.closes ]]; then pass AS1; else fail AS1 "rc=$rc: $out"; fi

	setup_submit auto2 claude/dcfg-auto.2; printf 'file.txt\n' >> "$wt/docs/tz/TZ-TEST.md"; printf x > "$wt/file.txt"; printf y > "$wt/extra.txt"
	printf 'ТЗ: docs/tz/TZ-TEST.md#U1\n' > "$d/bd.description"; echo closed > "$d/status.dcfg-auto.2"; echo 'done' > "$d/bd.reason"
	before=$(git -C "$wt" rev-parse HEAD)
	out=$(export BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?; after=$(git -C "$wt" rev-parse HEAD)
	[[ $after == "$before" && $out == *'not named in TZ'* ]] && pass AS2 || fail AS2 "rc=$rc: $out"

	setup_submit auto3 claude/dcfg-auto.3; printf 'file.txt\n' >> "$wt/docs/tz/TZ-TEST.md"; printf x > "$wt/file.txt"
	printf 'ТЗ: docs/tz/TZ-TEST.md#U1\n' > "$d/bd.description"; echo closed > "$d/status.dcfg-auto.3"; echo 'PARTIAL: x' > "$d/bd.reason"
	before=$(git -C "$wt" rev-parse HEAD)
	out=$(export BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?; after=$(git -C "$wt" rev-parse HEAD)
	[[ $after == "$before" && $out == *'negative close reason'* ]] && pass AS3 || fail AS3 "rc=$rc: $out"

	setup_submit auto4 claude/dcfg-auto.4; printf x > "$wt/file.txt"
	out=$(unset BEADS_ACTOR; export BD_ASSIGNEE='Claude Code'; submit dcfg-auto.4 "$tz" file.txt 2>&1); rc=$?
	[[ $rc == 0 && $out != *'unknown BEADS_ACTOR'* && $(<"$d/bd.closes") == dcfg-auto.4 ]] && pass AS4 || fail AS4 "rc=$rc: $out"

	setup_submit auto5 claude/dcfg-auto.5; printf 'file.txt\n' >> "$wt/docs/tz/TZ-TEST.md"; printf x > "$wt/file.txt"
	printf 'ТЗ: docs/tz/TZ-TEST.md#U1\n' > "$d/bd.description"; echo closed > "$d/status.dcfg-auto.5"; echo 'done' > "$d/bd.reason"
	date -u -d '48 hours ago' -Iseconds > "$d/bd.closed_at"
	before=$(git -C "$wt" rev-parse HEAD)
	out=$(export BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?; after=$(git -C "$wt" rev-parse HEAD)
	[[ $after == "$before" && $out == *'dirty worktree'* ]] && pass AS5 || fail AS5 "rc=$rc: $out"

	setup_submit auto6 claude/dcfg-auto.6; printf 'bin/ship-post\n' >> "$wt/docs/tz/TZ-TEST.md"; mkdir -p "$wt/bin"; printf x > "$wt/bin/ship"
	printf 'ТЗ: docs/tz/TZ-TEST.md#U1\n' > "$d/bd.description"; echo closed > "$d/status.dcfg-auto.6"; echo 'done' > "$d/bd.reason"
	before=$(git -C "$wt" rev-parse HEAD)
	out=$(export BD_ASSIGNEE='Claude Code'; run_tool "$d" 2>&1); rc=$?; after=$(git -C "$wt" rev-parse HEAD)
	[[ $after == "$before" && $out == *'not named in TZ'* ]] && pass AS6 || fail AS6 "rc=$rc: $out"

	setup_submit auto7 claude/dcfg-auto.7; printf 'file.txt\n' >> "$wt/docs/tz/TZ-TEST.md"; printf x > "$wt/file.txt"; : > "$d/events"
	printf 'ТЗ: docs/tz/TZ-TEST.md#U1\n' > "$d/bd.description"; echo closed > "$d/status.dcfg-auto.7"; echo 'done' > "$d/bd.reason"
	before=$(git -C "$wt" rev-parse HEAD)
	out=$(export BD_ASSIGNEE='Claude Code' TEST_TIMEOUT=15; run_tool "$d" --watch 2>&1); rc=$?; after=$(git -C "$wt" rev-parse HEAD)
	[[ $after != "$before" && $out == *'auto-submit dcfg-auto.7'* && $out != *'cannot be combined'* ]] && pass AS7 || fail AS7 "rc=$rc: $out"
}
test_dryrun_mocks(){
	local n=1 out rc
	setup_submit dry codex/dcfg-dry.1
	git -C "$wt" commit -q --allow-empty -m dry -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-dry.1' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" --dry-run 2>&1); rc=$?
	assert_rc "$n" 0 "$rc" "$out"; n=$((n + 1))
	grep -Fqx "$d|Codex|show dcfg-dry.1 --json" "$d/bd.calls" && pass "$n" || fail "$n" "mock cwd/argv"; n=$((n + 1))
	[[ ! -s $d/ship.calls ]] && pass "$n" || fail "$n" "ship called"; n=$((n + 1))
	grep -q 'ok=0 failed=0 skip=0' <<<"$out" && pass "$n" || fail "$n" "summary: $out"; n=$((n + 1))
	[[ -x $d/bin/ship-post && -x $d/bin/ship ]] && pass "$n" || fail "$n" "local candidate/mock missing"; n=$((n + 1))
	[[ $out != *'PASS '* ]] && pass "$n" || fail "$n" "misleading PASS count"
}
test_skip_log(){
	local out rc
	setup_submit skiplog codex/dcfg-skiplog.1
	git -C "$wt" commit -q --allow-empty -m skiplog -m "$(printf 'ТЗ: %s#U1\nAtom: dcfg-skiplog.1' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress BD_ASSIGNEE=Codex; run_tool "$d" --dry-run 2>&1); rc=$?
	[[ $rc == 0 && $out == *'skip dcfg-skiplog.1 status in_progress'* ]] && pass SL1 || fail SL1 "rc=$rc: $out"
	git -C "$wt" commit -q --allow-empty -m skiplog2 -m "$(printf 'ТЗ: %s#U1\nAtom: dcfg-skiplog.2' "$wt/$tz")"
	out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress BD_ASSIGNEE=Codex; run_tool "$d" --dry-run 2>&1); rc=$?
	[[ $rc == 0 && $out == *'skip dcfg-skiplog.2 branch codex/dcfg-skiplog.1 != codex/dcfg-skiplog.2'* ]] && pass SL2 || fail SL2 "rc=$rc: $out"
}
test_valid_actors(){
	local n=7 out rc msg
	setup_submit codex codex/dcfg-valid.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-valid.1 "$tz" file.txt 2>&1); rc=$?
	assert_rc "$n" 0 "$rc" "$out"; n=$((n + 1)); msg=$(git -C "$wt" log -1 --format=%B)
	grep -Fxq 'Agent: codex' <<<"$msg" && pass "$n" || fail "$n" "canonical Codex trailer"; n=$((n + 1))
	grep -Fqx "$d|Codex|close dcfg-valid.1 --reason submitted $(git -C "$wt" rev-parse HEAD): evidence" "$d/bd.calls" && pass "$n" || fail "$n" "close cwd/argv"; n=$((n + 1))
	setup_submit claude claude/dcfg-valid.2; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR='Claude Code' BD_ASSIGNEE='Claude Code'; submit dcfg-valid.2 "$tz" file.txt 2>&1); rc=$?
	assert_rc "$n" 0 "$rc" "$out"; n=$((n + 1)); msg=$(git -C "$wt" log -1 --format=%B)
	grep -Fxq 'Agent: claude' <<<"$msg" && pass "$n" || fail "$n" "canonical Claude trailer"; n=$((n + 1))
	compgen -G "$d/state/submissions/*/*/dcfg-valid.2/*" >/dev/null && pass "$n" || fail "$n" "local submission receipt"
}
test_actor_alias(){
	local n=100 out rc head
	setup_submit alias1 claude/dcfg-alias.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Claude BD_ASSIGNEE='Claude Code'; submit dcfg-alias.1 "$tz" file.txt 2>&1); rc=$?; head=$(git -C "$wt" rev-parse HEAD)
	[[ $rc == 0 ]] && grep -Fqx "$d|Claude Code|close dcfg-alias.1 --reason submitted $head: evidence" "$d/bd.calls" && pass "A1 ($n)" || fail "A1 ($n)" "rc=$rc: $out"; n=$((n + 1))
	setup_submit alias2 claude/dcfg-alias.2; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Claude BD_ASSIGNEE=claude; submit dcfg-alias.2 "$tz" file.txt 2>&1); rc=$?; head=$(git -C "$wt" rev-parse HEAD)
	[[ $rc == 0 ]] && grep -Fqx "$d|claude|close dcfg-alias.2 --reason submitted $head: evidence" "$d/bd.calls" && pass "A2 ($n)" || fail "A2 ($n)" "rc=$rc: $out"; n=$((n + 1))
	setup_submit alias3 claude/dcfg-alias.3; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=claude BD_ASSIGNEE='Claude Code'; submit dcfg-alias.3 "$tz" file.txt 2>&1); rc=$?; head=$(git -C "$wt" rev-parse HEAD)
	[[ $rc == 0 ]] && grep -Fqx "$d|Claude Code|close dcfg-alias.3 --reason submitted $head: evidence" "$d/bd.calls" && pass "A3 ($n)" || fail "A3 ($n)" "rc=$rc: $out"; n=$((n + 1))
	setup_submit alias4 codex/dcfg-alias.4; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=codex BD_ASSIGNEE=Codex; submit dcfg-alias.4 "$tz" file.txt 2>&1); rc=$?; head=$(git -C "$wt" rev-parse HEAD)
	[[ $rc == 0 ]] && grep -Fqx "$d|Codex|close dcfg-alias.4 --reason submitted $head: evidence" "$d/bd.calls" && pass "A4 ($n)" || fail "A4 ($n)" "rc=$rc: $out"
}
test_rejections(){
	local n=13 out rc
	setup_submit live codex/dcfg-live.1; printf x > "$d/repo/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; run_tool "$d" --submit "$d/repo" --atom dcfg-live.1 --tz "$tz#U2" --evidence e --files "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit unclaimed codex/dcfg-unclaimed.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=''; submit dcfg-unclaimed.1 "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit wrongactor codex/dcfg-wrongactor.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE='Claude Code'; submit dcfg-wrongactor.1 "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit prefix codex/dcfg-prefix.10; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-prefix.1 "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit outside codex/dcfg-outside.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-outside.1 /etc/hosts file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit dangling codex/dcfg-dangling.1; printf x > "$wt/file.txt"; ln -s nowhere "$wt/docs/tz/bad.md"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-dangling.1 docs/tz/bad.md file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit foreigndelete codex/dcfg-delete.1; printf foreign > "$wt/foreign.txt"; git -C "$wt" add -- foreign.txt; git -C "$wt" commit -q -m foreign; rm -f -- "$wt/foreign.txt"; printf target > "$wt/target.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-delete.1 "$tz" target.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit staged codex/dcfg-staged.1; printf foreign > "$wt/foreign.txt"; git -C "$wt" add -- foreign.txt; printf target > "$wt/target.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-staged.1 "$tz" target.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit invalid codex/dcfg-invalid.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=agent BD_ASSIGNEE=agent; submit dcfg-invalid.1 "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	setup_submit badfile codex/dcfg-badfile.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; run_tool "$d" --submit "$wt" --atom dcfg-badfile.1 --tz "$tz#U2" --evidence e --files -- --bad 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"
}
test_hook_and_retry(){
	local n=23 out rc first second
	setup_submit hook codex/dcfg-hook.1; printf x > "$wt/file.txt"; git -C "$wt" add -- file.txt; mkdir -p "$d/hooks"; printf '#!/usr/bin/env bash\nexit 1\n' > "$d/hooks/pre-commit"; chmod +x "$d/hooks/pre-commit"; git -C "$wt" config core.hooksPath "$d/hooks"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex; submit dcfg-hook.1 "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1))
	git -C "$wt" diff --cached --quiet -- file.txt && fail "$n" "hook failure changed index" || pass "$n"; n=$((n + 1))
	setup_submit retry codex/dcfg-retry.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex BD_CLOSE_RC=1; submit dcfg-retry.1 "$tz" file.txt 2>&1); rc=$?; assert_nonzero "$n" "$rc" "$out"; n=$((n + 1)); first=$(git -C "$wt" rev-list --count HEAD)
	[[ ! -e $d/state/receipts ]] && pass "$n" || fail "$n" "delivery receipt on close failure"; n=$((n + 1))
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex BD_CLOSE_RC=0; submit dcfg-retry.1 "$tz" file.txt 2>&1); rc=$?; assert_rc "$n" 0 "$rc" "$out"; n=$((n + 1)); second=$(git -C "$wt" rev-list --count HEAD)
	[[ $first == "$second" ]] && pass "$n" || fail "$n" "retry made another commit"; n=$((n + 1))
	compgen -G "$d/state/submissions/*/*/dcfg-retry.1/*" >/dev/null && pass "$n" || fail "$n" "retry receipt"
}
test_closed_retry(){
	local n=30 out rc first second
	setup_submit closed codex/dcfg-closed.1; printf x > "$wt/file.txt"
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex BD_STATUS=in_progress; submit dcfg-closed.1 "$tz" file.txt 2>&1); rc=$?; assert_rc "$n" 0 "$rc" "$out"; n=$((n + 1)); first=$(git -C "$wt" rev-list --count HEAD)
	out=$(export BEADS_ACTOR=Codex BD_ASSIGNEE=Codex BD_STATUS=closed; submit dcfg-closed.1 "$tz" file.txt 2>&1); rc=$?; assert_rc "$n" 0 "$rc" "$out"; n=$((n + 1)); second=$(git -C "$wt" rev-list --count HEAD)
	[[ $first == "$second" ]] && pass "$n" || fail "$n" "closed retry made another commit"; n=$((n + 1))
	grep -q 'already closed' <<<"$out" && pass "$n" || fail "$n" "idempotent receipt message"
}

test_delivery(){
 local out rc h before
 setup_submit delivery codex/dcfg-delivery.1
 git -C "$wt" commit -q --allow-empty -m delivery -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-delivery.1\nAgent: codex' "$wt/$tz")"
 h=$(git -C "$wt" rev-parse HEAD)
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 assert_rc delivery 0 "$rc" "$out"
 [[ $(wc -l <"$d/ship.calls") == 1 ]] && pass one_ship || fail one_ship "$out"
 grep -q -- '--handover' "$d/ship.calls" && pass preserve_live || fail preserve_live missing
 grep -Fq "$h" "$d/ship.calls" && pass exact_sha || fail exact_sha missing
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex; run_tool "$d" 2>&1); rc=$?
 [[ $rc == 0 && $(wc -l <"$d/ship.calls") == 1 ]] && pass duplicate || fail duplicate "$out"
 setup_submit open codex/dcfg-open.1
 git -C "$wt" commit -q --allow-empty -m open -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-open.1' "$wt/$tz")"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=in_progress BD_ASSIGNEE=Codex; run_tool "$d" 2>&1)
 [[ ! -s $d/ship.calls ]] && pass open_ignored || fail open_ignored "$out"
 setup_submit uncertain codex/dcfg-uncertain.1
 git -C "$wt" commit -q --allow-empty -m uncertain -m "$(printf 'ТЗ: %s#U2\nAtom: dcfg-uncertain.1' "$wt/$tz")"
 out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_GH_FAIL=1; run_tool "$d" 2>&1); rc=$?
	for i in $(seq 1 50); do compgen -G "$d/state/receipts/*/dcfg-uncertain.1/*.failed" >/dev/null && break; sleep 0.2; done
	[[ $rc == 0 && ! -s $d/ship.calls ]] && pass unknown_remote || fail unknown_remote "$out"
 compgen -G "$d/state/receipts/*/dcfg-uncertain.1/*.failed" >/dev/null && ! grep -q 'reopen dcfg-uncertain.1' "$d/bd.calls" && pass transient_retains_readiness || fail transient_retains_readiness missing
	setup_submit ci_absent_open codex/dcfg-ci-absent.1; commit_candidate dcfg-ci-absent.1; h=$(git -C "$wt" rev-parse HEAD)
	out=$(export BEADS_ACTOR=Codex BD_STATUS=closed BD_ASSIGNEE=Codex MOCK_PR_HEAD="$h" MOCK_SHIP_RC=30; run_tool "$d" 2>&1); rc=$?
	for i in $(seq 1 50); do marker=$(find "$d/state/receipts" -type f -name "$h.failed" -print -quit); [[ -n $marker ]] && break; sleep 0.2; done
	marker=$(find "$d/state/receipts" -type f -name "$h.failed" -print -quit)
	[[ $rc == 0 && -n $marker && $(<"$marker") == 30 ]] && pass 'D1 (130)' || fail 'D1 (130)' "$out rc=$rc marker=${marker:-missing}"
}

