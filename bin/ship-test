[[ $rc == 0 && $closeline == *'git diff'* && $closeline == *'echo 3'* && ${has34:-0} -gt 0 ]] && p 34 || f 34

# 35: ТЗ с файлом TZ-DOCS-DELIVERY.md — bd close не вызывается вовсе
git -C "$d/tzrepo" checkout -q main
( cd "$d/tzrepo" && printf 'Файлы: f.txt\nПроверка: test -n "$(git diff --name-only origin/main...HEAD)" && echo 3\n' > TZ-DOCS-DELIVERY.md \
	&& git add . && git commit -q -m tzdoc && git push -q origin main && git fetch -q origin )
