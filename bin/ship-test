#!/usr/bin/env bash
set -u
bin=$(cd -- "$(dirname -- "$0")" && pwd)
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT

export GA_WT_ROOT="$d/wts"
export GA_PROJECTS="$d/projects"
export GA_LOCK_DIR="$d/lock"
export GA_LOG_DIR="$d/logs"
export GH_JOURNAL="$d/gh.log"
export GH_CREATED="$d/gh-created"
export GH_TEST_DIR="$d"
mkdir -p "$GA_WT_ROOT/claude" "$GA_PROJECTS" "$GA_LOG_DIR" "$GA_LOCK_DIR" "$d/bin"

cat > "$d/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_JOURNAL"
case $1:$2 in
	pr:list)
		if [[ -f "$GH_TEST_DIR/mk-dev-on-list" ]]; then
			git -C "$PWD" push -q "$(git -C "$PWD" config remote.origin.url)" refs/remotes/origin/main:refs/heads/dev 2>/dev/null
			rm -f "$GH_TEST_DIR/mk-dev-on-list"
		fi
		if [[ -f "$GH_TEST_DIR/pr-empty" ]]; then
			echo ''
		elif [[ -f "$GH_TEST_DIR/pr-base" ]]; then
			printf '[{"number":7,"baseRefName":"%s"}]\n' "$(cat "$GH_TEST_DIR/pr-base")"
		elif [[ -f "$GH_CREATED" ]]; then
			echo 7
		else
			echo ''
		fi ;;
	pr:create)
		if [[ -f "$GH_TEST_DIR/pr-empty" ]]; then
			echo 'https://github.com/x/y/pull/7'
		elif [[ " $* " == *' --fill '* ]]; then
			echo 'could not compute title' >&2; exit 1
		else
			: > "$GH_CREATED"; echo 'https://github.com/x/y/pull/7'
		fi ;;
	pr:checks)
		if [[ " $* " == *' --watch '* ]]; then
			b=$(cat "$GH_TEST_DIR/bucket" 2>/dev/null || echo pass)
			[[ -n "$b" ]] || exit 1
		else
			if [[ -n "${GH_CI_DELAY:-}" ]]; then
				[[ -f "$GH_TEST_DIR/ci-start" ]] || date +%s > "$GH_TEST_DIR/ci-start"
				now=$(date +%s); st=$(cat "$GH_TEST_DIR/ci-start")
				(( now - st < GH_CI_DELAY )) && exit 0
			fi
			cat "$GH_TEST_DIR/bucket" 2>/dev/null || echo pass
		fi ;;
	run:list)
		ev=$(printf '%s\n' "$*" | sed -n 's/.*--event \([^ ]*\).*/\1/p')
		if [[ $ev == pull_request ]]; then
			if [[ -f "$GH_TEST_DIR/runs-pr" ]]; then
				cat "$GH_TEST_DIR/runs-pr"
			elif [[ -n "${GH_CI_DELAY:-}" ]]; then
				[[ -f "$GH_TEST_DIR/ci-start" ]] || date +%s > "$GH_TEST_DIR/ci-start"
				now=$(date +%s); st=$(cat "$GH_TEST_DIR/ci-start")
				(( now - st < GH_CI_DELAY )) && echo '[]' && exit 0
				printf '[{"status":"completed","conclusion":"success"}]\n'
			elif [[ -e "$GH_TEST_DIR/bucket" && ! -s "$GH_TEST_DIR/bucket" ]]; then
				echo '[]'
			else
				printf '[{"status":"completed","conclusion":"success"}]\n'
			fi
		else
			br=$(printf '%s\n' "$*" | sed -n 's/.*--branch \([^ ]*\).*/\1/p')
			if [[ -n $br && -f "$GH_TEST_DIR/runs-$br" ]]; then
				cat "$GH_TEST_DIR/runs-$br"
			else
				cat "$GH_TEST_DIR/runs" 2>/dev/null || echo '[]'
			fi
		fi ;;
	pr:merge)
		[[ ! -f "$GH_TEST_DIR/gh-401" ]] || { echo 'HTTP 401' >&2; exit 1; }
		[[ ! -f "$GH_TEST_DIR/merge-fail" ]] || { echo 'merge refused' >&2; exit 1; }
		base=$(grep '^pr create' "$GH_JOURNAL" | tail -n1 | sed -n 's/.*--base \([^ ]*\).*/\1/p')
		origin=${GH_ORIGIN:-$(git -C "$PWD" config remote.origin.url)}
		branch=$(git -C "$PWD" rev-parse --abbrev-ref HEAD)
		tmp=$(mktemp -d "$GH_TEST_DIR/merge.XXXXXX")
		git clone -q "$origin" "$tmp" && git -C "$tmp" config user.email t@t \
			&& git -C "$tmp" config user.name t \
			&& git -C "$tmp" fetch -q origin "refs/heads/$base:refs/remotes/origin/$base" "$branch:refs/remotes/origin/$branch" \
			&& git -C "$tmp" checkout -q -B "$base" "origin/$base" && case " $* " in
				*" --merge "*) git -C "$tmp" merge -q --no-ff --no-edit "origin/$branch" ;;
				*" --squash "*) git -C "$tmp" merge --squash "origin/$branch" && git -C "$tmp" commit -q -m squash ;;
				*) false ;;
			esac \
			&& git -C "$tmp" push -q origin "HEAD:refs/heads/$base" && git -C "$tmp" rev-parse HEAD > "$GH_TEST_DIR/merge-sha" \
			|| { echo "merge-fail base=$base branch=$branch" >> "$GH_TEST_DIR/merge-dbg"; git -C "$tmp" branch -a >> "$GH_TEST_DIR/merge-dbg" 2>&1; git -C "$tmp" merge --abort >/dev/null 2>&1; exit 1; }
		rm -rf "$tmp" ;;
	pr:view)
		if [[ " $* " == *' --json mergeable '* ]]; then
			printf '%s\n' "${GH_MERGEABLE:-MERGEABLE}"
		else
			cat "$GH_TEST_DIR/merge-sha"
		fi ;;
	api:repos/*)
		cat "$GH_TEST_DIR/allow-merge" 2>/dev/null || echo true ;;
esac
exit 0
EOF
chmod +x "$d/bin/gh"
cat > "$d/bin/pm2" <<'EOF'
#!/usr/bin/env bash
case $1 in
	startOrReload) exit 0 ;;
	jlist) printf '[{"name":"app","pm2_env":{"pm_uptime":%s}}]\n' "$(cat "$GH_TEST_DIR/uptime" 2>/dev/null || echo $(( $(date +%s%3N) + 1000 )))" ;;
esac
EOF
chmod +x "$d/bin/pm2"
cat > "$d/bin/gitleaks" <<'EOF'
#!/usr/bin/env bash
grep -rqs --exclude-dir=.git 'ghp_' . && exit 1; exit 0
EOF
chmod +x "$d/bin/gitleaks"
export PATH="$d/bin:$PATH"
printf '[core]\n\thooksPath = /root/workspaces/tools/git-hooks\n' > "$d/gitconfig"
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL="$d/gitconfig"
cat > "$d/bin/code-archive" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_TEST_DIR/code-archive-calls"
EOF
chmod +x "$d/bin/code-archive"
cat > "$d/bin/bd" <<'EOF'
#!/usr/bin/env bash
printf 'bd %s\n' "$*" >> "$GH_TEST_DIR/bd.log"
[[ ${1:-} == show && ${3:-} == --json ]] && printf '{"status":"%s","notes":"%s"}\n' "$(cat "$GH_TEST_DIR/bd-status" 2>/dev/null || echo open)" "$(cat "$GH_TEST_DIR/bd-notes" 2>/dev/null || echo '')"
[[ ${BD_FAIL:-0} == 1 ]] && exit 1
exit 0
EOF
chmod +x "$d/bin/bd"

# ТЗ-репо с bare-origin; общий ТЗ закоммичен в origin/main, Файлы: покрывает существующие сценарии
git init -q --bare "$d/origin-tz.git"
git -C "$d/origin-tz.git" symbolic-ref HEAD refs/heads/main
git clone -q "$d/origin-tz.git" "$d/tzrepo"
git -C "$d/tzrepo" config user.email t@t
git -C "$d/tzrepo" config user.name t
( cd "$d/tzrepo" && printf 'Файлы: f.txt, x.txt\nПроверка: test -n "$(git diff --name-only origin/main...HEAD)" && echo 3\n' > tz.md \
	&& git add . && git commit -q -m tz && git branch -M main \
	&& git push -q -u origin main && git fetch -q origin )
tz="$d/tzrepo/tz.md"
atom=dcfg-9jdfv.5
ship(){ ( cd "$1" && GH_ORIGIN="$(git -C "$1" config remote.origin.url)" "$bin/ship" "$@" --atom "$atom" --tz "$tz#U1" --handover ); }
p(){ echo "PASS $1"; ok=$((ok+1)); }
f(){ echo "FAIL $1"; bad=1; }
ok=0

ship_stack(){ # ADR-26: parent remains an ancestor of main, so the child can ship.
	local n=$1 a b parent rca rcb ancestor
	rm -f "$GH_CREATED"
	mkrepo "$n" 1
	a=$(mkwt "$n" "claude/$n-a")
	printf 'parent\n' >> "$a/f.txt"
	ship "$a" >/dev/null 2>&1; rca=$?
	parent=$(git -C "$a" rev-parse HEAD)
	rm -f "$GH_CREATED"
	b="$GA_WT_ROOT/claude/$n-b"
	git -C "$GA_PROJECTS/$n" worktree add -q -b "claude/$n-b" "$b" "$parent"
	printf 'child\n' >> "$b/f.txt"
	ship "$b" >/dev/null 2>&1; rcb=$?
	git -C "$GA_PROJECTS/$n" fetch -q origin main
	git -C "$b" merge-base --is-ancestor "$parent" origin/main; ancestor=$?
	[[ $rca == 0 && $rcb == 0 && $ancestor == 0 ]]
}

mkrepo(){ # name [ci] — bare+clone в GA_PROJECTS, main; [ci] добавляет workflow в origin/main
	local n=$1 ci=${2:-0}
	git init -q --bare "$d/origin-$n.git"
	git -C "$d/origin-$n.git" symbolic-ref HEAD refs/heads/main
	git clone -q "$d/origin-$n.git" "$GA_PROJECTS/$n"
	git -C "$GA_PROJECTS/$n" config user.email t@t
	git -C "$GA_PROJECTS/$n" config user.name t
	( cd "$GA_PROJECTS/$n" && printf 'x\n' > f.txt && git add . && git commit -q -m base \
		&& git branch -M main && git push -q -u origin main && git fetch -q origin )
	[[ $ci == 1 ]] && ( cd "$GA_PROJECTS/$n" && mkdir -p .github/workflows \
		&& printf 'on:\n  pull_request:\n' > .github/workflows/ci.yml \
		&& git add . && git commit -q -m ci && git push -q origin main && git fetch -q origin )
}
mkwt(){ # project branch -> worktree path
	local p=$1 br=$2 n=${2#*/}
	git -C "$GA_PROJECTS/$p" worktree add -q -b "$br" "$GA_WT_ROOT/claude/$n" origin/main
	echo "$GA_WT_ROOT/claude/$n"
}

if [[ -z ${SHIP_TEST_ONLY:-} ]]; then

git init -q --bare "$d/origin-r1.git"
git -C "$d/origin-r1.git" symbolic-ref HEAD refs/heads/main
git clone -q "$d/origin-r1.git" "$GA_PROJECTS/r1"
git -C "$GA_PROJECTS/r1" config user.email t@t
git -C "$GA_PROJECTS/r1" config user.name t
( cd "$GA_PROJECTS/r1" && printf 'base\n' > f.txt && git add . \
	&& git commit -q -m base && git branch -M main \
	&& git push -q -u origin main && git fetch -q origin )
git -C "$GA_PROJECTS/r1" worktree add -q -b claude/x "$GA_WT_ROOT/claude/r1-x" main
r1x="$GA_WT_ROOT/claude/r1-x"

ship "$GA_PROJECTS/r1" >/dev/null 2>&1; [[ $? == 10 ]] && p 2 || f 2

git -C "$GA_PROJECTS/r1" worktree add -q -b codex/y "$GA_WT_ROOT/claude/r1-y" main
ship "$GA_WT_ROOT/claude/r1-y" >/dev/null 2>&1; [[ $? == 10 ]] && p 3 || f 3

printf 'change\n' >> "$r1x/f.txt"
out=$(ship "$r1x"); rc=$?
logb=$(git -C "$r1x" log -1 --format=%B)
orig=$(git -C "$GA_PROJECTS/r1" rev-parse --verify refs/remotes/origin/claude/x 2>/dev/null || echo '')
[[ $rc == 0 && -n $orig && $logb == *'Atom: '* && $logb == *'ТЗ: '* \
	&& $logb == *'Agent: claude'* && $out == *'pr:7'* ]] && p 1 || f 1

sha1=$(git -C "$GA_PROJECTS/r1" rev-parse refs/remotes/origin/claude/x)
tok=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c36)
printf 'tok=ghp_%s\n' "$tok" > "$r1x/token.txt"
ship "$r1x" >/dev/null 2>&1; rc=$?
sha2=$(git -C "$GA_PROJECTS/r1" rev-parse refs/remotes/origin/claude/x)
[[ $rc == 20 && $sha1 == "$sha2" ]] && p 4 || f 4

git -C "$r1x" reset -q --hard origin/claude/x
before=$(grep '^pr create' "$GH_JOURNAL" | grep -vc 'ship/min-ci' || true)
git -C "$r1x" fetch -q origin
git -C "$r1x" reset -q --hard origin/main
printf 'again\n' >> "$r1x/f.txt"
ship "$r1x" >/dev/null 2>&1; rc=$?
after=$(grep '^pr create' "$GH_JOURNAL" | grep -vc 'ship/min-ci' || true)
[[ $rc == 0 && $after -eq $before ]] && p 5 || f 5

git -C "$r1x" fetch -q origin
git -C "$r1x" reset -q --hard origin/main
printf 'v2\n' > "$r1x/f.txt"
ship "$r1x" >/dev/null 2>&1; [[ $? == 0 ]] && p 6 || f 6

git init -q "$GA_PROJECTS/stroyremont"
git -C "$GA_PROJECTS/stroyremont" config user.email t@t
git -C "$GA_PROJECTS/stroyremont" config user.name t
git -C "$GA_PROJECTS/stroyremont" checkout -q -b main
git -C "$GA_PROJECTS/stroyremont" commit -q --allow-empty -m base
git init -q --bare "$d/origin-sr.git"
git -C "$d/origin-sr.git" symbolic-ref HEAD refs/heads/main
git -C "$GA_PROJECTS/stroyremont" remote add origin "$d/origin-sr.git"
git -C "$GA_PROJECTS/stroyremont" push -q -u origin main
git -C "$GA_PROJECTS/stroyremont" fetch -q origin
git -C "$GA_PROJECTS/stroyremont" worktree add -q -b claude/z "$GA_WT_ROOT/claude/sr-x" main
printf 'guarded\n' > "$GA_WT_ROOT/claude/sr-x/f.txt"
: > "$GH_JOURNAL"
out=$(ship "$GA_WT_ROOT/claude/sr-x" 2>&1); rc=$?
sr_ready=$(git -C "$GA_PROJECTS/stroyremont" rev-parse --verify refs/dev-ready/claude/z 2>/dev/null)
git -C "$d/origin-sr.git" show-ref --verify --quiet refs/heads/claude/z; sr_push=$?
[[ $rc == 0 && $out == *'prod:hold guarded'* && -n $sr_ready && $sr_push != 0 && ! -s $GH_JOURNAL ]] && p 7 || f 7

git init -q --bare "$d/origin-r2.git"
git -C "$d/origin-r2.git" symbolic-ref HEAD refs/heads/main
git clone -q "$d/origin-r2.git" "$GA_PROJECTS/r2"
git -C "$GA_PROJECTS/r2" config user.email t@t
git -C "$GA_PROJECTS/r2" config user.name t
( cd "$GA_PROJECTS/r2" && printf 'x\n' > f.txt && git add . \
	&& git commit -q -m base && git branch -M main \
	&& git push -q -u origin main && git fetch -q origin )
git -C "$GA_PROJECTS/r2" worktree add -q -b claude/c "$GA_WT_ROOT/claude/r2-c" main
printf 'c\n' > "$GA_WT_ROOT/claude/r2-c/f.txt"
git -C "$GA_WT_ROOT/claude/r2-c" add -A
git -C "$GA_WT_ROOT/claude/r2-c" commit -q -m c
( cd "$GA_PROJECTS/r2" && printf 'm\n' > f.txt && git add . \
	&& git commit -q -m m && git push -q origin main )
ship "$GA_WT_ROOT/claude/r2-c" >/dev/null 2>&1; rc=$?
status=$(git -C "$GA_WT_ROOT/claude/r2-c" status)
[[ $rc == 50 && $status != *'rebase in progress'* ]] && p 8 || f 8

git -C "$GA_PROJECTS/r2" fetch -q origin
git -C "$GA_PROJECTS/r2" worktree add -q -b claude/nine "$GA_WT_ROOT/claude/r2-nine" origin/main
r9="$GA_WT_ROOT/claude/r2-nine"
printf 'nine\n' >> "$r9/f.txt"
: > "$GH_JOURNAL"
out=$( ( cd "$r9" && GH_ORIGIN="$(git -C "$r9" config remote.origin.url)" "$bin/ship" "$r9" --atom "$atom" --tz "$tz#U1" ) ); rc=$?
git -C "$d/origin-r2.git" show-ref --verify --quiet refs/heads/claude/nine; pushed9=$?
grep -q '^pr merge' "$GH_JOURNAL"; merge9=$?
[[ $rc == 0 && $out == *'ci:bootstrap min-ci'* && $(grep -c '^pr merge' "$GH_JOURNAL") -ge 2 ]] && p 9 || f 9

mkrepo r10 1; w10=$(mkwt r10 claude/c10); printf 's10\n' >> "$w10/f.txt"
rm -f "$GH_CREATED"
printf '[]\n' > "$d/checks.json"; rm -f "$d/checks-late" "$d/ci-poll"
printf '[{"name":"min-ci","bucket":"pass"}]\n' > "$d/checks-late"
out=$(GA_CI_APPEAR=15 GH_CI_DELAY=3 ship "$w10"); rc=$?
rm -f "$d/checks.json" "$d/checks-late" "$d/ci-poll"
[[ $rc == 0 && $out != *'ci:none'* ]] && p 10 || f 10

mkrepo r11 1; w11=$(mkwt r11 claude/c11); printf 's11\n' >> "$w11/f.txt"
printf 'min-ci\n' > "$d/bucket"
out=$(ship "$w11" 2>&1); rc=$?
rm -f "$d/bucket"
[[ $rc == 40 && $out == *'min-ci'* && -d "$w11" ]] && p 11 || f 11

mkrepo r12 1; w12=$(mkwt r12 claude/c12); printf 's12\n' >> "$w12/f.txt"
: > "$d/bucket"
GA_CI_APPEAR=2 ship "$w12" >/dev/null 2>&1; rc=$?
rm -f "$d/bucket"
[[ $rc == 30 ]] && p 12 || f 12

mkrepo r13 1; w13=$(mkwt r13 claude/c13); printf 's13\n' >> "$w13/f.txt"
: > "$d/merge-fail"
ship "$w13" >/dev/null 2>&1; rc=$?
rm -f "$d/merge-fail"
[[ $rc == 50 ]] && p 13 || f 13

# 41: конфликтующий PR завершается до merge.
mkrepo r41 1; w41=$(mkwt r41 claude/c41); printf 's41\n' >> "$w41/f.txt"
before=$(grep -c '^pr merge' "$GH_JOURNAL" || true)
out=$(GH_MERGEABLE=CONFLICTING ship "$w41" 2>&1); rc=$?
after=$(grep -c '^pr merge' "$GH_JOURNAL" || true)
[[ $rc == 50 && $out == *'конфликтует с main'* && $before == "$after" ]] && p 41 || f 41

mkrepo r14 1; w14=$(mkwt r14 claude/c14); printf 's14\n' >> "$w14/f.txt"
out=$(ship "$w14"); rc=$?
[[ $rc == 0 && $out == *'live:deferred'* && -d "$w14" ]] && p 14 || f 14

mkrepo r15 1; w15=$(mkwt r15 claude/c15); printf 's15\n' >> "$w15/f.txt"
printf '9999999999999\n' > "$d/uptime"
( cd "$w15" && GH_ORIGIN="$(git -C "$w15" config remote.origin.url)" "$bin/ship" "$w15" --atom "$atom" --tz "$tz#U1" --reload app >/dev/null 2>&1 ); rc1=$?
mkrepo r15b 1; w15b=$(mkwt r15b claude/c15b); printf 's15b\n' >> "$w15b/f.txt"
printf '1000\n' > "$d/uptime"
( cd "$w15b" && GH_ORIGIN="$(git -C "$w15b" config remote.origin.url)" "$bin/ship" "$w15b" --atom "$atom" --tz "$tz#U1" --reload app >/dev/null 2>&1 ); rc2=$?
rm -f "$d/uptime"
[[ $rc1 == 0 && $rc2 == 60 && ! -d $w15b ]] && p 15 || f 15

mkrepo r16 1; w16=$(mkwt r16 claude/c16)
printf 's16\n' >> "$w16/f.txt"; git -C "$w16" add -A; git -C "$w16" commit -q -m s16
before=$(git -C "$w16" rev-parse HEAD)
: > "$d/gh-401"
ship "$w16" >/dev/null 2>&1; rc=$?
after=$(git -C "$w16" rev-parse HEAD)
rm -f "$d/gh-401"
[[ $rc == 70 && $before == "$after" && -d "$w16" ]] && p 16 || f 16

mkrepo r17 1; w17=$(mkwt r17 claude/c17); printf 's17\n' >> "$w17/f.txt"
out=$( ( cd "$w17" && GH_ORIGIN="$(git -C "$w17" config remote.origin.url)" "$bin/ship" "$w17" --atom "$atom" --tz "$tz#U1" ) 2>"$d/ship17.err" ); rc=$?
err=$(<"$d/ship17.err")
[[ $rc == 0 && $err != *getcwd* && $err != *'Unable to read current working directory'* && $out == *'r17'* ]] && p 17 || f 17

mkrepo r18; w18=$(mkwt r18 claude/c18)
printf 'branch\n' > "$w18/x.txt"
git -C "$w18" add -A; git -C "$w18" commit -q -m branchconf
( cd "$GA_PROJECTS/r18" && printf 'main\n' > x.txt && git add -A \
	&& git commit -q -m mainconf && git push -q origin main )
git -C "$w18" fetch -q origin main
git -C "$w18" merge -q origin/main || true
printf 'merged\n' > "$w18/x.txt"; git -C "$w18" add -A
git -C "$w18" commit -q -m mergeconf
mc=$(git -C "$w18" rev-parse HEAD)
: > "$GH_JOURNAL"
out=$(ship "$w18"); rc=$?
pushed=$(git -C "$GA_PROJECTS/r18" rev-parse refs/remotes/origin/claude/c18 2>/dev/null)
git -C "$w18" merge-base --is-ancestor "$mc" "$pushed" 2>/dev/null && anc=1 || anc=0
git -C "$d/origin-r18.git" show-ref --verify --quiet refs/heads/claude/c18; pushed18=$?
grep -q '^pr merge' "$GH_JOURNAL"; merge18=$?
[[ $rc == 0 && $out == *'ci:bootstrap min-ci'* && $(grep -c '^pr merge' "$GH_JOURNAL") -ge 2 && -d $w18 && $pushed18 == 0 && $anc == 1 ]] && p 18 || f 18

# 42: классификация закрыта по умолчанию; two всегда staged.
. "$bin/git-auto-lib"
[[ $(ga_class x one) == plain && $(ga_class x two) == staged \
	&& $(ga_class stroyremont one) == guarded && $(ga_class hh-scoring-dev one) == guarded \
	&& $(ga_class stroyremont two) == staged ]] && p 42 || f 42

# 43: hh-scoring-dev без pushurl остаётся guarded и не выходит в сеть.
mkrepo hh-scoring-dev; git -C "$GA_PROJECTS/hh-scoring-dev" config --unset-all remote.origin.pushurl || true
whh=$(mkwt hh-scoring-dev claude/hhguard); printf 'guarded\n' >> "$whh/f.txt"
: > "$GH_JOURNAL"
out=$(ship "$whh" 2>&1); rc=$?
git -C "$d/origin-hh-scoring-dev.git" show-ref --verify --quiet refs/heads/claude/hhguard; hh_push=$?
[[ $rc == 0 && $out == *'prod:hold guarded'* && ! -s $GH_JOURNAL && $hh_push != 0 ]] && p 43 || f 43

# U13 (ADR-26): branch B starts at A and remains mergeable after A reaches main.
ship_stack u13stack && p U13-stack || f U13-stack

# U4: код-архив вызывается только для slug arwoxbx24/<имя> после доставки.
# ship через симлинк в $d/bin, чтобы $bin=$d/bin и $bin/code-archive был заглушкой.
ln -sf "$bin/ship" "$d/bin/ship"
ln -sf "$bin/git-auto-lib" "$d/bin/git-auto-lib"
ln -sf "$bin/git-sync" "$d/bin/git-sync"
ln -sf "$bin/git-state" "$d/bin/git-state"

# отрицательный: локальный origin (slug не из arwoxbx24/) -> вызова нет
mkrepo r20 1; w20=$(mkwt r20 claude/c20); printf 's20\n' >> "$w20/f.txt"
rm -f "$d/code-archive-calls"
rm -f "$GH_CREATED"
( cd "$w20" && GH_ORIGIN="$(git -C "$w20" config remote.origin.url)" GA_ARCHIVE_ORG=arwoxbx24 "$d/bin/ship" "$w20" --atom "$atom" --tz "$tz#U1" ) >/dev/null 2>&1; rc=$?
[[ $rc == 0 && ! -e "$d/code-archive-calls" ]] && neg=0 || neg=1

# положительный: slug arwoxbx24/<имя>; git-fetch переписан на локальный bare
mkrepo r19 1; w19=$(mkwt r19 claude/c19); printf 's19\n' >> "$w19/f.txt"
git -C "$GA_PROJECTS/r19" remote set-url origin 'git@github.com:arwoxbx24/archive-name'
git -C "$GA_PROJECTS/r19" config "url.$d/origin-r19.git.insteadOf" 'git@github.com:arwoxbx24/archive-name'
rm -f "$d/code-archive-calls"
rm -f "$GH_CREATED"
( cd "$w19" && GH_ORIGIN="$d/origin-r19.git" GA_ARCHIVE_ORG=arwoxbx24 "$d/bin/ship" "$w19" --atom "$atom" --tz "$tz#U1" ) >/dev/null 2>&1; rc=$?
calls=''
for _ in $(seq 1 50); do
	[[ -s "$d/code-archive-calls" ]] && { calls=$(<"$d/code-archive-calls"); break; }
	sleep 0.1
done
[[ $rc == 0 && $calls == 'archive-name' ]] && pos=0 || pos=1
[[ $neg == 0 && $pos == 0 ]] && p 19 || f 19

mkrepo t1; t1wt="$d/tools/.worktrees/claude/t1w"
mkdir -p "$d/tools/.worktrees/claude"
git -C "$GA_PROJECTS/t1" worktree add -q -b claude/t1w "$t1wt" origin/main
unset GA_WT_ROOT
ship "$t1wt" >/dev/null 2>&1; rc=$?
export GA_WT_ROOT="$d/wts"
[[ $rc == 0 ]] && p 20 || f 20

# 23: ТЗ не найдено -> 80, stderr содержит 'ТЗ не найдено', ветка не запушена
mkrepo r23; w23=$(mkwt r23 claude/c23); printf 's23\n' >> "$w23/f.txt"
