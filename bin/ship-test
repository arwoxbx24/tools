[[ $rc == 80 && $err == *'ТЗ не найдено'* && -z $lsr ]] && p 23 || f 23

# 31: тело PR (stub gh pr create) содержит вывод проверки
mkrepo r31; w31=$(mkwt r31 claude/c31); printf 's31\n' >> "$w31/f.txt"
