last=$(grep -n '^pr create' "$GH_JOURNAL" | tail -n1 | cut -d: -f1)
entry=$(tail -n +"$last" "$GH_JOURNAL" | awk 'NR==1{print; next} /^pr list/{exit} {print}')
[[ $rc == 0 && $entry == *'3'* ]] && p 31 || f 31

# 32: успешная доставка — bd close залогирован с выводом проверки и ссылкой на PR
