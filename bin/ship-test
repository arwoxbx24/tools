err=$(<"$d/s37.err"); git -C "$d/tzrepo" checkout -q -- .
[[ $rc == 80 && $err == *'отличается от origin/main'* ]] && p 37 || f 37

# 38 (AE1): dev-ветка на origin -> режим two; PR в dev, живая копия отложена, main без нового
mkrepo r38 1
git -C "$GA_PROJECTS/r38" branch dev
git -C "$GA_PROJECTS/r38" push -q -u origin dev
git -C "$GA_PROJECTS/r38" fetch -q origin
w38=$(mkwt r38 claude/c38); printf 's38\n' >> "$w38/f.txt"
before38=$(git -C "$GA_PROJECTS/r38" rev-parse refs/remotes/origin/main)
rm -f "$GH_CREATED"
printf '[{"name":"min-ci","bucket":"pass"}]\n' > "$d/checks.json"; rm -f "$d/checks-late" "$d/ci-poll"
( cd "$w38" && GH_ORIGIN="$d/origin-r38.git" "$bin/ship" "$w38" --atom "$atom" --tz "$tz#U1" ) >/dev/null 2>&1; rc38=$?
rm -f "$d/checks.json" "$d/ci-poll"
git -C "$GA_PROJECTS/r38" fetch -q origin
new38=$(git -C "$GA_PROJECTS/r38" rev-list --count "$before38"..refs/remotes/origin/main 2>/dev/null || echo 999)
core38=$(grep '^pr create' "$GH_JOURNAL" | tail -n1)
def38=$(grep -c 'live:deferred dev' "$GA_LOG_DIR/ship.log" || true)
[[ $rc38 == 0 && $core38 == *'--base dev'* && $new38 == 0 && $def38 -gt 0 ]] && p 38 || f 38

# 39 (AE2): основная ветка master (без dev) -> режим one, PR в master
git init -q --bare "$d/origin-r39.git"
git -C "$d/origin-r39.git" symbolic-ref HEAD refs/heads/main
git -C "$d/origin-r39.git" symbolic-ref HEAD refs/heads/master
git clone -q "$d/origin-r39.git" "$GA_PROJECTS/r39"
git -C "$GA_PROJECTS/r39" config user.email t@t
git -C "$GA_PROJECTS/r39" config user.name t
( cd "$GA_PROJECTS/r39" && printf 'x\n' > f.txt && git add . && git commit -q -m base \
	&& git branch -M master && git push -q -u origin master && git fetch -q origin )
git -C "$GA_PROJECTS/r39" worktree add -q -b claude/c39 "$GA_WT_ROOT/claude/r39-c" master
w39="$GA_WT_ROOT/claude/r39-c"
printf 's39\n' >> "$w39/f.txt"
git -C "$d/tzrepo" checkout -q main
( cd "$d/tzrepo" && printf 'Файлы: f.txt, x.txt\nПроверка: test -n "$(git diff --name-only origin/master...HEAD)" && echo 3\n' > tz39.md \
	&& git add . && git commit -q -m tz39 && git push -q origin main && git fetch -q origin )
rm -f "$GH_CREATED"
( cd "$w39" && GH_ORIGIN="$d/origin-r39.git" "$bin/ship" "$w39" --atom "$atom" --tz "$d/tzrepo/tz39.md#U1" --handover ) 2>"$d/s39.err" >/dev/null; rc39=$?
base39=$(grep '^pr create' "$GH_JOURNAL" | tail -n1)
[[ $rc39 == 0 && $base39 == *'--base master'* ]] && p 39 || f 39

# 40 (Edge): bare HEAD указывает на несуществующую ветку -> 10, PR не создан
git init -q --bare "$d/origin-r40.git"
git clone -q "$d/origin-r40.git" "$GA_PROJECTS/r40"
git -C "$GA_PROJECTS/r40" config user.email t@t
git -C "$GA_PROJECTS/r40" config user.name t
( cd "$GA_PROJECTS/r40" && printf 'x\n' > f.txt && git add . && git commit -q -m base \
	&& git branch -M main && git push -q -u origin main && git fetch -q origin )
git -C "$GA_PROJECTS/r40" worktree add -q -b claude/c40 "$GA_WT_ROOT/claude/r40-c" origin/main
w40="$GA_WT_ROOT/claude/r40-c"
before40=$(grep -c '^pr create' "$GH_JOURNAL" || true)
rm -f "$GH_CREATED"
( cd "$w40" && GH_ORIGIN="$d/origin-r40.git" "$bin/ship" "$w40" --atom "$atom" --tz "$tz#U1" ) 2>"$d/s40.err" >/dev/null; rc40=$?
after40=$(grep -c '^pr create' "$GH_JOURNAL" || true)
err40=$(<"$d/s40.err")
[[ $rc40 == 10 && $err40 == *'основная ветка origin не определена'* && $after40 == $before40 ]] && p 40 || f 40

fi
for t in "$(dirname "$0")"/ship-test.d/${SHIP_TEST_ONLY:-}*.sh; do
	[[ -f $t ]] || continue
	cp -p "$d/bin/gh" "$d/bin/gh.save"; cp -p "$d/bin/bd" "$d/bin/bd.save"
	. "$t"
	cp -p "$d/bin/gh.save" "$d/bin/gh"; cp -p "$d/bin/bd.save" "$d/bin/bd"
done
[[ -z ${bad:-} ]] && { echo "PASS $ok/$ok"; exit 0; }
exit 1
