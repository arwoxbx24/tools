#!/usr/bin/env bash
set -u
bin=$(cd -- "$(dirname -- "$0")" && pwd)
. "$bin/git-auto-lib"

logdir=${GA_LOG_DIR:-/root/workspaces/tools/logs}
mkdir -p "$logdir"
ship_log="$logdir/ship.log"

name='-'; branch='-'
gg_log(){ # $1 code $2 step
	printf '%s %s %s %s %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$name" "$branch" "$1" "$2" >> "$ship_log"
}
leave(){ gg_log "$1" "$2"; exit "$1"; }

usage(){ cat >&2 <<'EOF'
usage: ship <worktree> --atom <id> --tz <path#U> [--reload <pm2-name>] [--handover]
exit codes: 0 ok, 10 preflight/usage, 20 gitleaks, 30 commit/push/pr, 40 ci, 50 merge/rebase,
            60 post, 70 gh/fetch, 75 lock, 80 ТЗ не принято (формат/граница), 90 проверка
EOF
leave 10 usage
}

# Маска путей -> regex: * = любые символы кроме '/', ** = любые символы.
mask_re(){ # $1 mask
	local m=$1 out='' c i
	for ((i=0;i<${#m};i++)); do
		c=${m:i:1}
		if [[ $c == '*' ]]; then
			if [[ ${m:i+1:1} == '*' ]]; then out+='.*'; i=$((i+1)); else out+='[^/]*'; fi
		else
			case $c in
				'.'|'['|']'|'('|')'|'{'|'}'|'+'|'?'|'^'|'$'|'\'|'|') out+="\\$c" ;;
				*) out+=$c ;;
			esac
		fi
	done
	printf '%s\n' "$out"
}

# Разбор ТЗ из origin/main: заполняет tz_regex (regex масок), tz_check, tz_repo, tz_rel.
tz_regex=(); tz_check=''; tz_repo=''; tz_rel=''; cmd=''; main_rc=''
tz_parse(){ # 0 — ок, 80 — ТЗ не принято
	local path=${tz%%#*} repo rel o w nf np mline m i
	tz_regex=()
	repo=$(git -C "$(dirname "$path")" rev-parse --show-toplevel 2>/dev/null) \
		|| { echo 'ship: ТЗ не принято — сначала в origin/main' >&2; return 80; }
	git -C "$repo" fetch -q origin main \
		|| { echo 'ship: ТЗ не принято — сначала в origin/main' >&2; return 80; }
	rel=${path#"$repo"/}; [[ -n $rel ]] || { echo 'ship: ТЗ не принято' >&2; return 80; }
	o=$(git -C "$repo" show "origin/main:$rel" 2>/dev/null) \
		|| { echo 'ship: ТЗ не принято — сначала в origin/main' >&2; return 80; }
	w=$(sed -n '1,$p' "$path" 2>/dev/null)
	[[ "$o" == "$w" ]] || { echo 'ship: ТЗ не принято — сначала в origin/main' >&2; return 80; }
	nf=$(grep -c '^Файлы: ' "$path"); np=$(grep -c '^Проверка: ' "$path")
	[[ $nf == 1 ]] || { echo 'ship: ТЗ не принято — добавь строку "Файлы: ..."' >&2; return 80; }
	[[ $np == 1 ]] || { echo 'ship: ТЗ не принято — добавь строку "Проверка: ..."' >&2; return 80; }
	tz_check=$(grep '^Проверка: ' "$path")
	mline=$(grep '^Файлы: ' "$path"); mline=${mline#*Файлы: }
	IFS=',' read -ra arr <<< "$mline"
	for m in "${arr[@]}"; do
		m=${m#"${m%%[![:space:]]*}"}; m=${m%"${m##*[![:space:]]}"}
		[[ -n $m && ${m%%/*} != *'*'* ]] \
			|| { echo "ship: ТЗ не принято — неверная маска '$m'" >&2; return 80; }
		tz_regex+=("$(mask_re "$m")")
	done
	tz_repo=$repo; tz_rel=$rel
	return 0
}

# Запуск команды Проверка: внутри $1; ветка — stdout+stderr в $chk_out, main — в /dev/null.
run_check(){ # $1 каталог
	local out=/dev/null
	[[ $1 == "$wtr" && -n ${chk_out:-} ]] && out=$chk_out
	( cd "$1" && env -i PATH="$PATH" HOME="$HOME" timeout -k 5 300 setsid bash -c "$cmd" ) >"$out" 2>&1
}

# Дифференциальная проверка: пустая/неразличимая проверка или изменение файлов — 90.
check_gate(){ # 0 — ок, 90 — проверка не прошла/изменила/не отличает/пустая
	local before tmp mrc
	cmd=${tz_check#Проверка: }
	case $cmd in
		''|true|:|'exit 0') echo 'ship: пустая проверка' >&2; return 90 ;;
		echo*|printf*) [[ $cmd != *'|'* ]] && { echo 'ship: пустая проверка' >&2; return 90; } ;;
	esac
	before=$(g status --porcelain)
	if ! run_check "$wtr"; then
		echo 'ship: проверка не прошла' >&2; return 90
	fi
	[[ $(g status --porcelain) == "$before" ]] \
		|| { echo 'ship: проверка изменила файлы' >&2; return 90; }
	tmp=$(mktemp -d) || { echo 'ship: не удалось поднять main' >&2; return 90; }
	g worktree add -q --detach "$tmp/m" origin/main \
		|| { echo 'ship: не удалось поднять main' >&2; return 90; }
	run_check "$tmp/m"; mrc=$?; main_rc=$mrc
	g worktree remove --force "$tmp/m" 2>/dev/null; rmdir "$tmp" 2>/dev/null
	case $mrc in
		0) echo 'ship: проверка не отличает изменение' >&2; return 90 ;;
		124|126|127) echo "ship: main: проверка не исполнилась ($mrc)" >&2; return 90 ;;
	esac
	return 0
}

wt=''; atom=''; tz=''; reload=''; handover=0
while [[ $# -gt 0 ]]; do
	case $1 in
		--atom) atom=${2:-}; shift 2 ;;
		--tz) tz=${2:-}; shift 2 ;;
		--reload) reload=${2:-}; shift 2 ;;
		--handover) handover=1; shift ;;
		-*) usage ;;
		*) wt=$1; shift ;;
	esac
done
[[ -n $wt && -n $atom && -n $tz ]] || usage

root=${GA_WT_ROOT:-/root/workspaces/projects/.worktrees}
[[ -z ${GA_WT_ROOT:-} && $wt == */.worktrees/* ]] && root=${wt%%/.worktrees/*}/.worktrees
wtr=$(realpath -m "$wt")
[[ $wtr == "$root"/* ]] || leave 10 preflight
agent=${wtr#"$root"/}; agent=${agent%%/*}
[[ -n $agent && $wtr == "$root/$agent/"* ]] || leave 10 preflight

branch=$(git -C "$wtr" symbolic-ref --short -q HEAD 2>/dev/null) || leave 10 preflight
[[ $branch != main && $branch != master && $branch == "$agent/"* ]] || leave 10 preflight

name=$(ga_repo_of "$wtr") || leave 10 preflight
[[ -z $(ga_skip_reason "$name") ]] || leave 10 preflight

hp=$(git -C "$wtr" config --get-all core.hooksPath)
[[ $hp == /root/workspaces/tools/git-hooks ]] || { echo 'hooksPath подменён' >&2; leave 10 preflight; }

tz_parse || leave 80 tz

g(){ git -C "$wtr" "$@"; }
g add -A
if g diff --cached --quiet; then
	[[ $(g rev-list --count origin/main..HEAD 2>/dev/null) == 0 ]] && { echo 'ship: nothing'; leave 0 nothing; }
else
	if ! ( cd "$wtr" && gitleaks git --pre-commit --staged --redact --no-banner ); then
		leave 20 gitleaks
	fi
	first=$(sed -n '1p' "${tz%%#*}" 2>/dev/null)
	g commit -q -m "$atom: ${first:-$atom}" \
		--trailer "Atom: $atom" --trailer "ТЗ: $tz" --trailer "Agent: $agent" \
		|| leave 30 commit
fi

locked_core(){
	local osha=''
	g fetch -q origin main || return 70
	if ! g merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
		g rebase -q origin/main || { g rebase --abort; return 50; }
	fi
	# граница: пути в диффе ветки обязаны лежать внутри Файлы: ТЗ
	local df p re matched found=0 tzcd wtcd
	tzcd=$( cd "$tz_repo" && d=$(git rev-parse --git-common-dir) && cd "$d" && pwd -P 2>/dev/null )
	wtcd=$( cd "$wtr" && d=$(git rev-parse --git-common-dir) && cd "$d" && pwd -P 2>/dev/null )
	df=$(mktemp) || { echo 'ship: дифф не прочитан' >&2; return 80; }
	g diff -z --name-only --no-renames origin/main...HEAD > "$df" \
		|| { rm -f "$df"; echo 'ship: дифф не прочитан' >&2; return 80; }
	while IFS= read -r -d '' p; do
		[[ $tzcd == "$wtcd" && $p == "$tz_rel" ]] && { rm -f "$df"; echo 'ship: ТЗ не принято' >&2; return 80; }
		matched=0
		for re in "${tz_regex[@]}"; do
			[[ $p =~ ^$re$ ]] && { matched=1; break; }
		done
		[[ $matched == 1 ]] || { echo "ship: $p вне Файлы:" >&2; found=1; }
	done < "$df"
	rm -f "$df"
	[[ $found == 0 ]] || return 80
	check_gate || return $?
	( cd "$wtr" && gitleaks git --redact --no-banner --log-opts "origin/main..HEAD" >/dev/null 2>&1 ) || return 20
	osha=$(g rev-parse --verify -q refs/remotes/origin/"$branch" 2>/dev/null) || osha=''
	if [[ -n $osha ]]; then
		g push -q --force-with-lease="$branch:$osha" origin HEAD:refs/heads/"$branch" || return 30
	else
		g push -q -u origin HEAD:refs/heads/"$branch" || return 30
	fi
	return 0
}
chk_out=$(mktemp)
trap 'rm -f "$chk_out"' EXIT
ga_lock "$name" 60 locked_core
rc=$?
if [[ $rc -ne 0 ]]; then
	case $rc in
		70) step=fetch;; 50) step=rebase;; 20) step=gitleaks;; 30) step=push;; 80) step=tz;; 90) step=check;; *) step=lock;;
	esac
	leave "$rc" "$step"
fi

ga_ctx "$name" 2>/dev/null; slug=$GA_SLUG; unset GIT_DIR GIT_WORK_TREE GA_LIVE GA_SLUG
[[ -n ${slug:-} && $slug != - ]] || slug=$(g config --get remote.origin.url)
num=$(gh pr list -R "$slug" --head "$branch" --state open --json number --jq '.[0].number' 2>/dev/null)
if [[ -z $num ]]; then
	body="$(g log -1 --format=%b)"
	if [[ -n ${chk_out:-} ]]; then
		body+=$'\n\nПроверка: '"${tz_check#Проверка: }"$'\n```\n'"$(tail -n 20 "$chk_out")"$'\n```'
	fi
	gh pr create -R "$slug" --head "$branch" --base main \
		--title "$(g log -1 --format=%s)" --body "$body" >/dev/null || leave 30 pr
	num=$(gh pr list -R "$slug" --head "$branch" --state open --json number --jq '.[0].number' 2>/dev/null)
fi
printf 'pr:%s\n' "$num"
ci=none
for f in $(git -C "$wtr" ls-tree --name-only origin/main:.github/workflows 2>/dev/null); do
	case $f in *.yml|*.yaml)
		git -C "$wtr" show "origin/main:.github/workflows/$f" 2>/dev/null | grep -q pull_request && { ci=ci; break; } ;;
	esac
done
if [[ $ci == none ]]; then
	echo ci:none
else
	it=$(( (${GA_CI_APPEAR:-60}) / 5 ))
	for _ in $(seq 1 "$it"); do
		n=$(gh pr checks "$num" -R "$slug" --json name,bucket --jq length 2>/dev/null)
		[[ ${n:-0} -gt 0 ]] && break
		sleep 5
	done
	[[ ${n:-0} -gt 0 ]] || leave 30 ci-absent
	timeout "${GA_CI_CAP:-900}" gh pr checks "$num" -R "$slug" --watch >/dev/null 2>&1
	bad=$(gh pr checks "$num" -R "$slug" --json name,bucket --jq '.[]|select(.bucket=="fail" or .bucket=="cancel")|.name' 2>/dev/null)
	if [[ -n $bad ]]; then printf '%s\n' "$bad" >&2; leave 40 ci; fi
fi

gh_or70(){ local e; e=$("$@" 2>&1 >/dev/null) && return 0; grep -qiE 'HTTP 40[13]|authentication|could not connect|timeout' <<<"$e" && leave 70 gh; return 1; }

ga_lock "$name" 60
gh_or70 gh pr merge "$num" -R "$slug" --squash --match-head-commit "$(git -C "$wtr" rev-parse HEAD)" || leave 50 merge
merge_sha=$(gh pr view "$num" -R "$slug" --json mergeCommit --jq .mergeCommit.oid)
merge_ms=$(( $(date +%s) * 1000 ))
rmot=$(sed '/^[[:space:]]*$/d' "$chk_out" | tail -n1)
reason="Проверка: $cmd | ветка exit 0, main exit $main_rc | $rmot | https://github.com/$slug/pull/$num"
if ! bd close "$atom" --reason "$reason" >/dev/null 2>&1; then
	echo "ship: закрой вручную: bd close \"$atom\" --reason \"$reason\"" >&2
	post_rc=60; post_step=close
	[[ $handover == 1 ]] && leave 60 close
fi
[[ $handover == 1 ]] && { echo 'live:deferred handover'; g update-ref "refs/delivered/$branch" HEAD; leave 0 handover; }

"$bin/git-sync" "$name"
[[ ${post_step:-} == close ]] || { post_rc=0; post_step=''; }
"$bin/git-state" --live "$name" "$merge_sha" >/dev/null || { echo err:live >&2; post_rc=60; post_step=live; }

if [[ -n $reload ]]; then
	pm2 startOrReload "${GA_ECOSYSTEM:-/root/workspaces/tools/ecosystem.config.js}" --only "$reload" >/dev/null
	up=$(pm2 jlist | jq -r --arg n "$reload" '.[]|select(.name==$n)|.pm2_env.pm_uptime')
	[[ ${up:-0} -gt $merge_ms ]] || { post_rc=60; post_step=reload; }
fi

org=${GA_ARCHIVE_ORG:-$(git -C "$bin" config --get remote.origin.url 2>/dev/null)}
org=${org%/*}; org=${org##*[:/]}
[[ -n $org && $slug == "$org"/* ]] && setsid -f timeout 300 "$bin/code-archive" "${slug#*/}" >/dev/null 2>&1 || true

live=$(ga_ctx "$name" && echo "$GA_LIVE")
cd "$live"
head=$(git -C "$wtr" rev-parse HEAD)
git -C "$live" worktree remove "$wtr"
git -C "$live" update-ref -d "refs/heads/$branch" "$head"
# PR head may already be gone if GitHub deleted it on merge; only try if it exists.
if git -C "$live" ls-remote --exit-code origin "refs/heads/$branch" >/dev/null 2>&1; then
	git -C "$live" push -q origin --delete "$branch" || true
fi

"$bin/git-state" --no-fetch | grep -F "$name"
leave "${post_rc:-0}" "${post_step:-live}"
