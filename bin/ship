#!/usr/bin/env bash
# closed (owner 22.10): kept only for rollback; delete these 3 lines to restore.
case ${1:-} in -h|--help) echo "usage: ${0##*/} — closed (owner 22.10)"; exit 0;; esac
echo "closed (owner 22.10)" >&2; exit 3
set -u
export BEADS_DIR=${BEADS_DIR:-/root/workspaces/projects/.beads}
bin=$(cd -- "$(dirname -- "$0")" && pwd)
. "$bin/git-auto-lib"

logdir=${GA_LOG_DIR:-/root/workspaces/tools/logs}
mkdir -p "$logdir"
ship_log="$logdir/ship.log"

name='-'; branch='-'

help(){ cat <<'EOF'
usage: ship <worktree> --atom <id> --tz <path#U> [--reload <pm2-name>] [--handover] [--expected-head <sha>]
exit codes: 0 ok, 10 preflight/usage, 20 gitleaks, 30 commit/push/pr, 40 ci, 50 merge/rebase,
            60 post, 70 gh/fetch, 72 ci-not-started, 75 lock, 80 ТЗ не найдено
EOF
}

usage(){ help >&2; leave 10 usage; }

# Разбор ТЗ.
tz_repo=''; tz_rel=''; cmd=''
tz_parse(){ # 0 — ок, 80 — ТЗ не принято
	path=${tz%%#*}
	[[ -f $path ]] || { echo "ship: ТЗ не найдено: $path" >&2; return 80; }
	tz_repo=$(git -C "$(dirname "$path")" rev-parse --show-toplevel)
	tz_rel=${path#"$tz_repo"/}
	return 0
}

wt=''; atom=''; tz=''; reload=''; handover=0; expected_head=''
while [[ $# -gt 0 ]]; do
	case $1 in
		--atom) atom=${2:-}; shift 2 ;;
		--tz) tz=${2:-}; shift 2 ;;
		--reload) reload=${2:-}; shift 2 ;;
		--handover) handover=1; shift ;;
		--expected-head) [[ $# -ge 2 && $2 =~ ^[0-9a-f]{40,64}$ ]] || usage; expected_head=$2; shift 2 ;;
		--help|-h) help; exit 0 ;; # U23: до логов, git и gh
		-*) usage ;;
		*) wt=$1; shift ;;
	esac
done
[[ -n $wt && -n $atom && -n $tz ]] || usage

root=${GA_WT_ROOT:-/root/workspaces/projects/.worktrees}
[[ -z ${GA_WT_ROOT:-} && $wt == */.worktrees/* ]] && root=${wt%%/.worktrees/*}/.worktrees
wtr=$(realpath -m "$wt")
[[ $wtr == "$root"/* ]] || { echo "ship: worktree $wtr outside $root; use $root/<agent>/<atom> or set GA_WT_ROOT" >&2; leave 10 preflight; }
agent=${wtr#"$root"/}; agent=${agent%%/*}
[[ -n $agent && $wtr == "$root/$agent/"* ]] || leave 10 preflight

branch=$(git -C "$wtr" symbolic-ref --short -q HEAD 2>/dev/null) || leave 10 preflight
[[ $branch != main && $branch != master && $branch == "$agent/"* ]] || leave 10 preflight

name=$(ga_repo_of "$wtr") || leave 10 preflight

hp=$(git -C "$wtr" config --get-all core.hooksPath)
[[ $hp == /root/workspaces/tools/git-hooks ]] || { echo 'hooksPath подменён' >&2; leave 10 preflight; }

read -r mode base prod <<< "$(ga_base "$wtr")"
if [[ -z $base ]]; then
	echo 'ship: основная ветка origin не определена' >&2
	leave 10 preflight
fi
class=$(ga_class "$name" "$mode")
gg_log 0 "class=$class"

# Политика (FR-006): --reload запрещён в режиме двух веток.
if [[ $mode == two && -n $reload ]]; then
	echo 'ship: --reload в режиме двух веток — только ship-promote' >&2
	leave 10 policy
fi

tz_parse || leave 80 tz

g(){ git -C "$wtr" "$@"; }
accepted_clean(){
	[[ $(g rev-parse HEAD) == "$expected_head" && -z $(g status --porcelain=v1 --untracked-files=all) ]]
}
if [[ -n $expected_head ]]; then
	accepted_clean || { echo 'ship: accepted HEAD or worktree changed' >&2; leave 10 accepted-head; }
else
g add -A
if g diff --cached --quiet; then
	[[ $(g rev-list --count origin/$base..HEAD 2>/dev/null) == 0 ]] && { echo 'ship: nothing'; leave 0 nothing; }
else
	if ! ( cd "$wtr" && gitleaks git --pre-commit --staged --redact --no-banner ); then
		leave 20 gitleaks
	fi
	first=$(sed -n '1p' "${tz%%#*}" 2>/dev/null)
	g commit -q -m "$atom: ${first:-$atom}" \
		--trailer "Atom: $atom" --trailer "ТЗ: $tz" --trailer "Agent: $agent" \
		|| leave 30 commit
fi
fi

if [[ $class == guarded ]]; then
	g update-ref "refs/dev-ready/$branch" HEAD
	echo "prod:hold guarded $(ga_skip_reason "$name")"
	leave 0 prod-hold
fi

locked_core(){
	local osha=''
	g fetch -q origin "$base" || return 70
	ci_base=$(g rev-parse origin/$base)
	if [[ -n $expected_head ]]; then
		accepted_clean || return 10
	elif ! g merge-base --is-ancestor origin/$base HEAD 2>/dev/null; then
		g rebase -q origin/$base || { g rebase --abort; return 50; }
	fi
	( cd "$wtr" && gitleaks git --redact --no-banner --log-opts "origin/$base..${expected_head:-HEAD}" >/dev/null 2>&1 ) || return 20
	osha=$(g rev-parse --verify -q refs/remotes/origin/"$branch" 2>/dev/null) || osha=''
	if [[ -n $osha ]]; then
		g push -q --force-with-lease="$branch:$osha" origin "${expected_head:-HEAD}":refs/heads/"$branch" || return 30
	else
		g push -q -u origin "${expected_head:-HEAD}":refs/heads/"$branch" || return 30
	fi
	printf '%s' "$ci_base"
	return 0
}
ci_base=$(ga_lock "$name" 60 locked_core)
rc=$?
if [[ $rc -ne 0 ]]; then
	case $rc in
		70) step=fetch;; 50) step=rebase;; 20) step=gitleaks;; 30) step=push;; 80) step=tz;; 90) step=check;; *) step=lock;;
	esac
	leave "$rc" "$step"
fi

ga_ctx "$name" 2>/dev/null; slug=$GA_SLUG; unset GIT_DIR GIT_WORK_TREE GA_LIVE GA_SLUG
[[ -n ${slug:-} && $slug != - ]] || slug=$(g config --get remote.origin.url)
# D5: CI-определение и отказ ci-none в режиме two — до gh pr create, чтобы не оставить открытый PR.
ci=none
for f in $(git -C "$wtr" ls-tree --name-only origin/$base:.github/workflows 2>/dev/null); do
	case $f in *.yml|*.yaml)
		git -C "$wtr" show "origin/$base:.github/workflows/$f" 2>/dev/null | grep -q pull_request && { ci=ci; break; } ;;
	esac
done
docs_only=0
if [[ $ci == none ]]; then
	changed_paths=$(git -C "$wtr" diff --name-only "origin/$base...HEAD") || leave 10 diff
	if [[ -n $changed_paths ]]; then
		docs_only=1
		while IFS= read -r path; do
			[[ $path == *.md ]] || { docs_only=0; break; }
		done <<< "$changed_paths"
	fi
fi
if [[ $ci == none && $mode == two ]]; then
	echo 'ship: в dev нет CI pull_request' >&2
	leave 30 ci-none
fi
# D3: сверить базу открытого PR — чужой (не в $base) не должен влиться в prod мимо dev.
pr=$(gh pr list -R "$slug" --head "$branch" --state open --json number,baseRefName --jq '.[0]' 2>/dev/null) || leave 70 pr-read
if [[ -z $pr ]]; then
	body="$(g log -1 --format=%b)"
	gh pr create -R "$slug" --head "$branch" --base "$base" \
		--title "$(g log -1 --format=%s)" --body "$body" >/dev/null || leave 30 pr
	pr=$(gh pr list -R "$slug" --head "$branch" --state open --json number,baseRefName --jq '.[0]' 2>/dev/null) || leave 70 pr-read
fi
num=$(printf '%s' "$pr" | sed -n 's/.*"number": *\([0-9][0-9]*\).*/\1/p')
[[ -n $num ]] || num=$pr
pbase=$(printf '%s' "$pr" | sed -n 's/.*"baseRefName":"\([^"]*\)".*/\1/p')
if [[ -n $num && -n $pbase && $pbase != "$base" ]]; then
	echo "ship: открытый PR #$num направлен в $pbase, нужен $base" >&2
	leave 10 pr-base
fi
[[ -n $num ]] || { echo 'ship: номер PR не получен' >&2; leave 30 pr; }
printf 'pr:%s\n' "$num"
# dcfg-4j1mb: no CI -> min-ci merged into $base by its own PR; the atom PR keeps its exact head and is re-opened to get a pull_request run.
ci_bootstrap(){
	local tmp cb=ship/min-ci rc=0
	tmp=$(mktemp -d) || return 1
	g worktree add -q --detach "$tmp/w" "origin/$base" || return 1
	{ "$bin/git-ci-enable" "$tmp/w" >/dev/null \
		&& git -C "$tmp/w" add .github/workflows \
		&& git -C "$tmp/w" commit -q -m "ci: enable min-ci" --trailer "Atom: $atom" --trailer "ТЗ: $tz" --trailer "Agent: $agent" \
		&& git -C "$tmp/w" push -q origin "+HEAD:refs/heads/$cb" \
		&& { gh pr create -R "$slug" --head "$cb" --base "$base" --title "ci: enable min-ci" --body "ship: repository had no pull_request CI (atom $atom)" >/dev/null || gh pr view "$cb" -R "$slug" >/dev/null; } \
		&& { gh pr merge "$cb" -R "$slug" --merge --delete-branch >/dev/null || gh pr merge "$cb" -R "$slug" --squash --delete-branch >/dev/null; }; } || rc=1
	g worktree remove --force "$tmp/w" >/dev/null 2>&1
	rm -rf "$tmp"
	return "$rc"
}
if [[ $ci == none && $docs_only == 0 ]]; then
	ci_bootstrap || { echo 'ship: min-ci bootstrap failed' >&2; leave 30 ci-enable; }
	echo 'ci:bootstrap min-ci'
	gh pr close "$num" -R "$slug" >/dev/null && gh pr reopen "$num" -R "$slug" >/dev/null || leave 70 gh
	ci=ci
fi
if [[ $docs_only == 1 ]]; then
	echo ci:none
	echo 'gate:auto docs-only'
fi
mg=$(gh pr view "$num" -R "$slug" --json mergeable -q .mergeable 2>/dev/null)
if [[ $mg == CONFLICTING ]]; then
	echo "ship: PR #$num конфликтует с $base — rebase ветки агента" >&2
	leave 50 conflict
fi
if [[ $docs_only == 0 ]]; then
	ga_ci_wait pr "$slug" "$num" "${expected_head:-$(git -C "$wtr" rev-parse HEAD)}"
	ci_rc=$?
	if [[ $ci_rc == 30 ]]; then
		for _ in 1 2 3; do
			sleep "${GA_CI_POLL:-15}"
			mg=$(gh pr view "$num" -R "$slug" --json mergeable -q .mergeable 2>/dev/null)
			[[ $mg == CONFLICTING ]] || continue
			echo "ship: PR #$num конфликтует с $base — rebase ветки агента" >&2
			leave 50 conflict
		done
		echo 'ship: CI не появился' >&2
		leave 30 ci-absent
	elif [[ $ci_rc == 70 ]]; then
		leave 72 ci-billing
	elif [[ $ci_rc != 0 ]]; then
		leave 40 ci
	fi
fi

# dcfg-4j1mb.6: .ship-hold-paths (база ∪ HEAD) — владелец держит пути до корабельного «wait-owner»; исключение снимает hold.
hold_list=$( { g show "origin/$base:.ship-hold-paths" 2>/dev/null; g show "${expected_head:-HEAD}:.ship-hold-paths" 2>/dev/null; } | grep -vE '^[[:space:]]*(#|$)' )
if [[ -n $hold_list ]]; then
	while IFS= read -r f; do
		held=0
		while IFS= read -r pat; do
			if [[ $pat == '!'* ]]; then
				[[ $f == ${pat#'!'} ]] && held=0
			else
				[[ $f == $pat ]] && held=1
			fi
		done <<< "$hold_list"
		if [[ $held == 1 ]]; then
			echo "prod:wait-owner hold-paths $f"
			leave 0 wait-owner
		fi
	done <<< "$(g diff --name-only "origin/$base...${expected_head:-HEAD}")"
fi

gh_or70(){ local e; e=$("$@" 2>&1 >/dev/null) && return 0; echo "ship: gh: $e" >&2; grep -qiE 'HTTP 40[13]|HTTP 5[0-9][0-9]|authentication|could not connect|timeout|Something went wrong' <<<"$e" && return 70; return 1; }

merge_after_ci(){
	local new moved mine head rc method
	g fetch -q origin "$base" || return 70
	new=$(g rev-parse origin/$base) || return 70
	head=${expected_head:-$(git -C "$wtr" rev-parse HEAD)}
	if [[ $new != "$ci_base" ]]; then
		moved=$(g diff --name-only "$ci_base" "$new") || return 50
		mine=$(g diff --name-only "$new...$head") || return 50
		if [[ -z $(comm -12 <(printf '%s\n' "$moved" | sort -u) <(printf '%s\n' "$mine" | sort -u)) ]] \
			&& ! grep -qE '^bin/(ship|ship-post|git-sync|git-auto-lib|git-state)$|^bin/ship-test$' <<<"$moved"; then
			printf 'ship: base moved %.7s..%.7s, disjoint, no re-CI\n' "$ci_base" "$new" >&2
		else
			printf 'ship: base moved %.7s..%.7s, re-CI #%s round %s\n' "$ci_base" "$new" "$num" "$round" >&2
			printf '%s' "$new"
			return 2
		fi
	fi
	# U22: squash-only репо не принимает merge-коммиты; ошибка запроса -> прежнее --merge.
	method=--merge
	if [[ $(gh api "repos/$slug" --jq .allow_merge_commit 2>/dev/null) == false ]]; then
		method=--squash
	fi
	gh_or70 gh pr merge "$num" -R "$slug" "$method" --match-head-commit "$head"; rc=$?
	[[ $rc == 70 ]] && return 71
	return "$rc"
}

for ((round=1; round<=5; round++)); do
	new=$(ga_lock "$name" 60 merge_after_ci); merge_rc=$?
	case $merge_rc in
		0) break ;;
		2)
			since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
			gh_or70 gh pr close "$num" -R "$slug"; gh_rc=$?
			[[ $gh_rc == 70 ]] && leave 70 gh
			[[ $gh_rc == 0 ]] || leave 50 close
			gh_or70 gh pr reopen "$num" -R "$slug"; gh_rc=$?
			[[ $gh_rc == 70 ]] && leave 70 gh
			[[ $gh_rc == 0 ]] || leave 50 reopen
			ci_base=$new
			ga_ci_wait pr "$slug" "$num" "${expected_head:-$(git -C "$wtr" rev-parse HEAD)}" "$since"
			ci_rc=$?
			[[ $ci_rc == 30 ]] && leave 30 ci-absent
			[[ $ci_rc == 70 ]] && leave 72 ci-billing
			[[ $ci_rc == 0 ]] || leave 40 ci
			;;
		70) leave 70 fetch ;;
		71) leave 70 gh ;;
		75) leave 75 lock ;;
		*) leave 50 merge ;;
	esac
done
(( round <= 5 )) || leave 70 base-moving
merge_sha=$(gh pr view "$num" -R "$slug" --json mergeCommit --jq .mergeCommit.oid)
gg_log 0 "merged $num $merge_sha"
merge_ms=$(( $(date +%s) * 1000 ))
reason="PR: https://github.com/$slug/pull/$num | ТЗ: $tz"
if [[ ${tz%%#*} != */TZ-DOCS-DELIVERY.md ]]; then
	st=$(bd show "$atom" --json 2>/dev/null | jq -r '.[0].status' 2>/dev/null)
	if [[ $st == closed ]]; then
		bd update "$atom" --append-notes "$reason" >/dev/null 2>&1 || echo "ship: notes не записаны: $atom" >&2
	elif ! bd close "$atom" --reason "$reason" >/dev/null 2>&1; then
		echo "ship: закрой вручную: bd close \"$atom\" --reason \"$reason\"" >&2
		post_rc=60; post_step=close
		[[ $handover == 1 ]] && leave 60 close
	fi
fi
[[ $handover == 1 ]] && { echo 'live:deferred handover'; g update-ref "refs/delivered/$branch" "${expected_head:-HEAD}"; leave 0 handover; }

saved_close=''; [[ ${post_step:-} == close ]] && saved_close=close
if [[ $mode == two ]]; then
	gg_log 0 'live:deferred dev'
else
	read -r post_rc post_step <<< "$(ga_live_sync "$name" "$merge_sha" "$merge_ms" "$reload")"
	[[ $saved_close == close && $post_rc == 0 ]] && { post_rc=60; post_step=close; }
fi

org=${GA_ARCHIVE_ORG:-$(git -C "$bin" config --get remote.origin.url 2>/dev/null)}
org=${org%/*}; org=${org##*[:/]}
[[ -n $org && $slug == "$org"/* ]] && setsid -f timeout 300 "$bin/code-archive" "${slug#*/}" >/dev/null 2>&1 || true

live=$(ga_ctx "$name" && echo "$GA_LIVE")
cd "$live"
head=$(git -C "$wtr" rev-parse HEAD)
git -C "$live" worktree remove "$wtr"
git -C "$live" update-ref -d "refs/heads/$branch" "$head"
# PR head may already be gone if GitHub deleted it on merge; only try if it exists.
if git -C "$live" ls-remote --exit-code origin "refs/heads/$branch" >/dev/null 2>&1; then
	git -C "$live" push -q origin --delete "$branch" || true
fi

"$bin/git-state" --no-fetch | grep -F "$name"
leave "${post_rc:-0}" "${post_step:-live}"
