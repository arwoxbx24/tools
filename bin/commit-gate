#!/usr/bin/env bash
# commit-gate: blocks secrets, unpinned dependencies and malformed messages.
set -u
SELF=$(cd "$(dirname "$0")" && pwd)
CONF=${COMMIT_GATE_CONF:-$SELF/../config/commit-gate.json}
SG=${COMMIT_GATE_SECRET_GATE:-$SELF/secret-gate}
MSG_ROUTE='route: git commit -m "fix(scope): <what>"'

die() { printf 'commit-gate: %s\n%s\n' "$1" "$2" >&2; exit 2; }

scope_repos() {
  [ -f "$CONF" ] || return 0
  python3 - "$CONF" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    sys.exit(0)
for r in d.get('git_dirs', []) if isinstance(d, dict) else []:
    if isinstance(r, str) and r.strip():
        print(r.rstrip('/'))
PY
}

scope_all() {
  [ -f "$CONF" ] || return 0
  python3 - "$CONF" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    sys.exit(0)
if isinstance(d, dict) and d.get('scope') == 'all':
    print('1')
PY
}

in_scope() {
  local dir=$1 common e
  git -C "$dir" rev-parse --git-common-dir >/dev/null 2>&1 || return 1
  [ -n "$(scope_all)" ] && return 0
  common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    [ "$common" = "$e" ] && return 0
  done < <(scope_repos)
  return 1
}

is_manifest() {
  case "$(basename "$1")" in
    package.json|pyproject.toml|go.mod|Cargo.toml|requirements*.txt) return 0 ;;
  esac
  return 1
}

lock_candidates() {
  case "$(basename "$1")" in
    package.json) echo "package-lock.json yarn.lock pnpm-lock.yaml npm-shrinkwrap.json" ;;
    pyproject.toml) echo "poetry.lock uv.lock pdm.lock Pipfile.lock" ;;
    requirements*.txt) echo "requirements.lock" ;;
    go.mod) echo "go.sum" ;;
    Cargo.toml) echo "Cargo.lock" ;;
  esac
}

in_index_or_head() {
  local repo=$1 path=$2
  git -C "$repo" cat-file -e ":$path" 2>/dev/null && return 0
  git -C "$repo" cat-file -e "HEAD:$path" 2>/dev/null && return 0
  [ -f "$repo/$path" ] && return 0
  return 1
}

check_secrets() {
  local repo=$1 err
  err=$(cd "$repo" && "$SG" check --staged 2>&1 >/dev/null) || \
    die "secrets in the staged diff${err:+: $err}" \
        "route: remove the secret from the staged changes and rotate it"
}

check_manifests() {
  local repo=$1 m base d l p found line
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    is_manifest "$m" || continue
    d=${m%/*}
    [ "$d" = "$m" ] && d=
    found=
    for l in $(lock_candidates "$m"); do
      p=${d:+$d/}$l
      if git -C "$repo" diff --cached --name-only -- "$p" | grep -q . || in_index_or_head "$repo" "$p"; then
        found=1
        break
      fi
    done
    [ -n "$found" ] || die "dependency manifest staged without its lockfile: $m" \
        "route: git add ${d:+$d/}<lockfile>"
  done < <(git -C "$repo" diff --cached --name-only --diff-filter=ACM)

  while IFS= read -r m; do
    [ -n "$m" ] || continue
    is_manifest "$m" || continue
    line=$(git -C "$repo" diff --cached -U0 -- "$m" 2>/dev/null | \
      grep -E '^\+' | grep -v '^+++' | \
      grep -E '(latest|\^|~|>=|<=|>|<|\*|[0-9]\.[xX])' | head -n 1)
    [ -n "$line" ] || continue
    line=${line#+}
    die "dependency version is not pinned in $m: $line" \
        "route: pin the exact version in $m and git add it"
  done < <(git -C "$repo" diff --cached --name-only --diff-filter=ACM)
}

check_message() {
  local msg=$1 first
  first=$(printf '%s\n' "$msg" | sed '/^#/d' | sed '/^[[:space:]]*$/d' | sed -n '1p')
  [ -n "$first" ] || return 0
  case "$first" in
    'Merge '*|'Revert "'*) return 0 ;;
  esac
  printf '%s' "$first" | grep -Eq '^(feat|fix|refactor|test|chore|docs)(\([^)]+\))?: .+' && return 0
  die "commit message does not match type(scope): what — $first" "$MSG_ROUTE"
}

run_checks() {
  local repo=$1 msg=${2:-}
  in_scope "$repo" || exit 0
  check_secrets "$repo"
  check_manifests "$repo"
  [ -n "$msg" ] && check_message "$msg"
}

parse_hook() {
  python3 /dev/fd/3 3<<'PY'
import base64, json, os, shlex, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(3)
cmd = ((d.get('tool_input') or {}).get('command') or '') if isinstance(d, dict) else ''
if not isinstance(cmd, str) or not cmd:
    sys.exit(3)
try:
    toks = shlex.split(cmd, posix=True)
except ValueError:
    sys.exit(3)
segs = [[]]
for t in toks:
    if t in (';', '&&', '||', '|', '&', '\n'):
        segs.append([])
    else:
        segs[-1].append(t)
found = None
for seg in segs:
    i = 0
    while i < len(seg):
        t = seg[i]
        if t == 'git' or t.endswith('/git'):
            j = i + 1
            repo = ''
            msg = []
            while j < len(seg):
                t = seg[j]
                if t in ('-C', '--git-dir'):
                    if j + 1 < len(seg):
                        repo = seg[j + 1]
                    j += 2
                    continue
                if t in ('-c', '--work-tree', '--namespace'):
                    j += 2
                    continue
                if t.startswith('--git-dir='):
                    repo = t.split('=', 1)[1]
                    j += 1
                    continue
                if t.startswith('-C') and len(t) > 2:
                    repo = t[2:]
                    j += 1
                    continue
                if t.startswith('-'):
                    j += 1
                    continue
                break
            if j < len(seg) and seg[j] == 'commit':
                k = j + 1
                while k < len(seg):
                    t = seg[k]
                    if t in ('-m', '--message'):
                        if k + 1 < len(seg):
                            msg.append(seg[k + 1])
                        k += 2
                        continue
                    if t.startswith('--message='):
                        msg.append(t.split('=', 1)[1])
                        k += 1
                        continue
                    if t in ('-F', '--file'):
                        if k + 1 < len(seg):
                            path = os.path.join(repo or '.', seg[k + 1])
                            try:
                                msg.append(open(path, encoding='utf-8', errors='replace').read())
                            except OSError:
                                pass
                        k += 2
                        continue
                    if t.startswith('--file='):
                        path = os.path.join(repo or '.', t.split('=', 1)[1])
                        try:
                            msg.append(open(path, encoding='utf-8', errors='replace').read())
                        except OSError:
                            pass
                        k += 1
                        continue
                    k += 1
                found = (repo, '\n'.join(msg))
                break
        i += 1
    if found:
        break
if not found:
    sys.exit(3)
print(found[0])
print(base64.b64encode(found[1].encode('utf-8')).decode('ascii'))
PY
}

mode=${1:-}
case "$mode" in
  -h|--help)
    echo "usage: commit-gate hook|pre-commit|commit-msg <file>"
    exit 0
    ;;
esac
case "$mode" in
  hook)
    parsed=$(parse_hook) || exit 0
    repo=$(printf '%s\n' "$parsed" | sed -n '1p')
    msg=$(printf '%s\n' "$parsed" | sed -n '2p' | base64 -d 2>/dev/null)
    [ -n "$repo" ] || repo=$PWD
    run_checks "$repo" "$msg"
    ;;
  pre-commit)
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
    run_checks "$repo" ""
    ;;
  commit-msg)
    [ -n "${2:-}" ] || exit 0
    repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
    msg=$(cat "$2" 2>/dev/null) || exit 0
    run_checks "$repo" "$msg"
    ;;
  *)
    echo "usage: commit-gate hook|pre-commit|commit-msg <file>" >&2
    exit 2
    ;;
esac
exit 0
