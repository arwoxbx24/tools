#!/usr/bin/env bash
set -u
d=$(mktemp -d /tmp/test-once-test.XXXXXX)
trap 'rm -rf -- "$d"' EXIT
t=$(cd -- "$(dirname -- "$0")" && pwd)/test-once
r=$d/r
git init -q "$r"
git -C "$r" config user.email t@t
git -C "$r" config user.name t
echo a > "$r/f.txt"
cat > "$r/t.sh" <<EOF
#!/usr/bin/env bash
echo x >> "$d/count"
echo "RESULT ok"
exit \${FAKE_RC:-0}
EOF
chmod +x "$r/t.sh"
git -C "$r" add f.txt t.sh
git -C "$r" commit -qm init
runs() { wc -l < "$d/count" | tr -d ' '; }
ok=0
pass() { ok=$((ok + 1)); echo "PASS $1"; }
bad() { echo "FAIL $1: $2"; }

: > "$d/count"
out=$(TEST_ONCE_DIR=$d/state1 "$t" "$r" ./t.sh); rc=$?
if [ "$rc" = 0 ] && [[ $out == *"RESULT ok"* ]] && [ "$(runs)" = 1 ]; then pass 1; else bad 1 "rc=$rc runs=$(runs) out=$out"; fi

: > "$d/count"
ob=$(find "$r/.git/objects" -type f | wc -l)
TEST_ONCE_DIR=$d/state2 "$t" "$r" ./t.sh >/dev/null
out=$(TEST_ONCE_DIR=$d/state2 "$t" "$r" ./t.sh); rc=$?
oa=$(find "$r/.git/objects" -type f | wc -l)
nd=$(mktemp -d "$d/nongit.XXXXXX")
nout=$(TEST_ONCE_DIR=$d/state2 "$t" "$nd" ./t.sh 2>&1); nrc=$?
if [ "$rc" = 0 ] && [[ $out == *"test-once: cached rc=0"* && $out == *"RESULT ok"* ]] && [ "$(runs)" = 1 ] && [ "$ob" = "$oa" ] && [ "$nrc" = 2 ] && [[ $nout == *usage* ]]; then pass 2; else bad 2 "rc=$rc runs=$(runs) out=$out ob=$ob oa=$oa nrc=$nrc nout=$nout"; fi

: > "$d/count"
git -C "$r" update-index --assume-unchanged f.txt
TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh >/dev/null
echo b > "$r/f.txt"
out=$(TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh); rc=$?
n=$(runs)
TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh >/dev/null
echo new > "$r/new.txt"
out2=$(TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh); rc2=$?
TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh >/dev/null
n3=$(runs)
chmod +x "$r/new.txt"
out3=$(TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh); rc3=$?
cat > "$d/edit.sh" <<EOF
#!/usr/bin/env bash
echo x >> "$d/count"
echo edited >> "$r/f.txt"
echo "RESULT ok"
EOF
chmod +x "$d/edit.sh"
out4=$(TEST_ONCE_DIR=$d/state3 "$t" "$r" "$d/edit.sh" 2>&1); rc4=$?
echo b > "$r/f.txt"
out5=$(TEST_ONCE_DIR=$d/state3 "$t" "$r" "$d/edit.sh" 2>&1); rc5=$?
echo one > "$r/ign.txt"; echo ign.txt > "$r/.gitignore"
git -C "$r" add -f ign.txt .gitignore
git -C "$r" commit -qm ign
TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh >/dev/null
echo two > "$r/ign.txt"
out6=$(TEST_ONCE_DIR=$d/state3 "$t" "$r" ./t.sh 2>&1); rc6=$?
if [ "$rc" = 0 ] && [[ $out != *cached* ]] && [ "$n" = 2 ] && [ "$rc2" = 0 ] && [[ $out2 != *cached* ]] && [ "$n3" = 3 ] && [ "$rc3" = 0 ] && [[ $out3 != *cached* ]] && [ "$rc4" = 0 ] && [[ $out4 == *"tree changed during run, not cached"* ]] && [ "$rc5" = 0 ] && [[ $out5 != *"test-once: cached"* ]] && [ "$(runs)" = 8 ] && [ "$rc6" = 0 ] && [[ $out6 != *"test-once: cached"* ]]; then pass 3; else bad 3 "rc=$rc runs=$n out=$out rc2=$rc2 n3=$n3 rc3=$rc3 runs=$(runs) out2=$out2 out3=$out3 rc4=$rc4 out4=$out4 rc5=$rc5 out5=$out5"; fi

: > "$d/count"; echo x > "$d/dep.txt"; echo x > "$r/rel.txt"; echo rel.txt >> "$r/.git/info/exclude"
TEST_ONCE_DIR=$d/state4 TEST_ONCE_DEPS=$d/dep.txt "$t" "$r" ./t.sh >/dev/null
echo y > "$d/dep.txt"
TEST_ONCE_DIR=$d/state4 TEST_ONCE_DEPS=$d/dep.txt "$t" "$r" ./t.sh >/dev/null
n4=$(runs)
(cd -- "$d" && TEST_ONCE_DIR=$d/state4 TEST_ONCE_DEPS=rel.txt "$t" "$r" ./t.sh >/dev/null)
(cd -- "$d" && TEST_ONCE_DIR=$d/state4 TEST_ONCE_DEPS=rel.txt "$t" "$r" ./t.sh >/dev/null)
echo z > "$r/rel.txt"
(cd -- "$d" && TEST_ONCE_DIR=$d/state4 TEST_ONCE_DEPS=rel.txt "$t" "$r" ./t.sh >/dev/null)
mkdir -p "$d/depdir"; echo x > "$d/depdir/a.txt"; ln -sfn "$d/depdir" "$d/depln"
TEST_ONCE_DIR=$d/state7 TEST_ONCE_DEPS=$d/depln "$t" "$r" ./t.sh >/dev/null
TEST_ONCE_DIR=$d/state7 TEST_ONCE_DEPS=$d/depln "$t" "$r" ./t.sh >/dev/null
n7=$(runs)
echo y > "$d/depdir/a.txt"
TEST_ONCE_DIR=$d/state7 TEST_ONCE_DEPS=$d/depln "$t" "$r" ./t.sh >/dev/null
if [ "$n4" = 2 ] && [ "$n7" = 5 ] && [ "$(runs)" = 6 ]; then pass 4; else bad 4 "runs=$(runs) before=$n4 n7=$n7"; fi

: > "$d/count"
TEST_ONCE_DIR=$d/state5 TEST_ONCE_TTL=0 "$t" "$r" ./t.sh >/dev/null
TEST_ONCE_DIR=$d/state5 TEST_ONCE_TTL=0 "$t" "$r" ./t.sh >/dev/null
if [ "$(runs)" = 2 ]; then pass 5; else bad 5 "runs=$(runs)"; fi

: > "$d/count"; s=$d/state6; ok6=1
for i in 1 2 3; do
    echo "v$i" > "$r/f.txt"
    FAKE_RC=1 TEST_ONCE_DIR=$s "$t" "$r" ./t.sh >/dev/null; [ $? = 1 ] || ok6=0
done
echo v4 > "$r/f.txt"
out=$(FAKE_RC=1 TEST_ONCE_DIR=$s "$t" "$r" ./t.sh); rc=$?
if [ "$ok6" = 1 ] && [ "$rc" = 29 ] && [[ $out == *"STALLED 3 failing runs"* ]] && [ "$(runs)" = 3 ]; then pass 6; else bad 6 "ok6=$ok6 rc=$rc runs=$(runs) out=$out"; fi

g=$d/g; git init -q "$g"
git -C "$g" config user.email t@t
git -C "$g" config user.name t
echo a > "$g/f.txt"
git -C "$g" add f.txt
git -C "$g" update-index --add --cacheinfo 160000,0123456789abcdef0123456789abcdef01234567,sub
git -C "$g" commit -qm gitlink
mkdir "$g/sub"
out=$(TEST_ONCE_DIR=$d/state8 "$t" "$g" true 2>&1); rc=$?
echo b > "$g/f.txt"
out2=$(TEST_ONCE_DIR=$d/state8 "$t" "$g" true 2>&1); rc2=$?
if [ "$rc" = 0 ] && [[ $out != *"snapshot failed"* ]] && [ "$rc2" = 0 ] && [[ $out2 != *"snapshot failed"* ]] && [[ $out2 != *"test-once: cached"* ]]; then pass "7 gitlink_snapshot"; else bad 7 "rc=$rc out=$out rc2=$rc2 out2=$out2"; fi

if [ "$ok" = 7 ]; then echo "PASS 7/7"; else echo "FAIL $ok/7"; exit 1; fi
