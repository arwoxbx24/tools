#!/usr/bin/env bash
# goal-gate — Stop/PreToolUse-хук Claude Code: блокирует ложный «✅ DONE», запрещённую формулировку завершения цели,
# /goal без МЕТОД:, отчёт без «Контроль задач:» и инструмент Agent (dcfg-86c43).
exec 2>/dev/null
case ${1-} in --help|-h) printf '%s\n' 'usage: goal-gate  (Claude Code hook: one hook JSON on stdin; PreToolUse Agent -> deny; Stop -> goal checks)'; exit 0;; esac
command -v jq >/dev/null || exit 0
json=$(cat) || exit 0
[ -n "$json" ] || exit 0
ev=$(jq -er '.hook_event_name | select(type == "string")' <<<"$json") || exit 0

if [ "$ev" = "PreToolUse" ]; then
  tool=$(jq -er '.tool_name // "" | select(type == "string")' <<<"$json") || exit 0
  [ "$tool" = "Agent" ] || exit 0
  permit=${GOAL_GATE_PERMIT:-/root/workspaces/tools/state/code-channel/permit.json}
  model=$(jq -r '(.tool_input // {}) | if type == "object" then (.model // "") else "" end | if type == "string" then . else "" end' <<<"$json") || model=''
  now=$(date +%s)
  if [ "$model" = "haiku" ] && [ -f "$permit" ] && [ -r "$permit" ]; then
    pwt=$(jq -r '(.worktree // "") | if type == "string" then . else "" end' "$permit" 2>/dev/null) || pwt=''
    ptz=$(jq -r '(.tz // "") | if type == "string" then . else "" end' "$permit" 2>/dev/null) || ptz=''
    if [ -n "$pwt" ] && [ "${pwt#/}" != "$pwt" ] && [ -e "$pwt" ] &&
      [ -n "$ptz" ] && [ "${ptz#/}" != "$ptz" ] && [ -e "$ptz" ] &&
      jq -e --argjson now "$now" '
        (.rc == 32)
        and ((.go_rc | type) == "number" and .go_rc != 0)
        and ((.sdk_rc | type) == "number" and .sdk_rc != 0)
        and ((.stderr | type) == "array" and (.stderr | length) > 0)
        and ((.canary | type) == "string" and (.canary | contains("channel-canary")))
        and ((.ts | type) == "number")
        and (($now - .ts) <= 1800)
        and (.ts <= ($now + 60))
      ' "$permit" >/dev/null 2>&1; then
      exit 0
    fi
  fi
  jq -nc --arg p "$permit" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:("Claude Code helpers are not workers (owner 26.10): Agent is allowed only with tool_input.model=haiku and a fresh permit " + $p + " (rc=32, non-zero go_rc and sdk_rc, non-empty stderr, canary, ts <= 30 min); otherwise use /root/workspaces/tools/bin/code-channel auto|audit <worktree> <TZ>")}}'
  exit 0
fi
[ "$ev" = "Stop" ] || exit 0

msg=$(jq -er '(.last_assistant_message // "") | if type == "string" then . else error("m") end' <<<"$json") || exit 0
sid=$(jq -er '.session_id | select(type == "string" and length > 0)' <<<"$json") || exit 0
[[ $sid != *[/$'\n\r']* ]] || exit 0

transcript=$(jq -r '.transcript_path // "" | if type == "string" then . else "" end' <<<"$json") || transcript=''
goal=0
[ -n "$transcript" ] && [ -r "$transcript" ] && grep -qE '<command-name>/goal(_task)?</command-name>' -- "$transcript" 2>/dev/null && goal=1

plain=$(awk '/^[[:space:]]*```/{f=!f;next} !f{gsub(/`[^`]*`/,"");print}' <<<"$msg")

reason=''
goal_re='^[[:space:]]*`?/goal[[:space:]]'
ctrl_re='^[[:space:]]*[*-]?[[:space:]]*Контроль задач:'
BANNED='/goal[[:space:]]+clear|сним(и|ите|у|ем)[[:space:]]+(цел|/goal)|сняти[ея][[:space:]]+цел|снять[[:space:]]+(цел|/goal)|очист(и|ите|ка|ить)[[:space:]]+(цел|/goal)|убер(и|ите)[[:space:]]+цел|убрать[[:space:]]+(цел|/goal)'
banned_src=$(sed -E '/^[[:space:]]*>/d; s/«[^»]*»//g; s/"[^"]*"//g; s/`[^`]*`//g' <<<"$msg")
lmsg=${banned_src,,}

if [[ $lmsg =~ $BANNED ]]; then
  reason="Banned wording (owner 26.10): never offer to end or remove the goal; finish it or report PARTIAL"
fi

while [ -z "$reason" ] && IFS= read -r l; do
  [[ $l =~ $goal_re ]] || continue
  [[ $l == *"МЕТОД:"* ]] || { reason="The /goal line needs МЕТОД: <method from the methodology catalog> (goal_task METHOD GATE)"; break; }
done <<<"$msg"

if [ "$goal" -eq 1 ] && [ -z "$reason" ]; then
  ctrl=0
  while IFS= read -r l; do [[ $l =~ $ctrl_re ]] && { ctrl=1; break; }; done <<<"$msg"
  if [[ $plain =~ ✅[[:space:]]DONE|PARTIAL|STALLED|BLOCKED ]] && [ "$ctrl" -eq 0 ]; then
    reason="Goal report needs the line «Контроль задач: выполнено <n> · в процессе <n> · открыто <n>» from the session task list (goal_task OWNER REPORT)"
  fi
fi

done_=0
if [ "$goal" -eq 1 ] && [ -z "$reason" ] && [[ $plain == *"✅ DONE"* ]]; then
  done_=1
  while IFS= read -r l; do
    case $l in
      *GOAL=NOT_MET*|*GOAL=REFUSED*|*"Не сделано"*) reason="✅ DONE contradicts: $l"; break ;;
    esac
  done <<<"$plain"
  if [ -z "$reason" ]; then
    hit=$(grep -oE 'goal-check[[:space:]]+[A-Za-z0-9]+-[A-Za-z0-9._-]+' <<<"$msg" | head -n1)
    if [ -z "$hit" ]; then
      reason="✅ DONE needs a goal-check <epic> run with GOAL=MET in the same turn"
    else
      read -r _ id <<<"$hit"
      last=$(timeout 300 "${GOAL_GATE_CHECK:-/root/workspaces/tools/bin/goal-check}" "$id" 2>/dev/null | tail -n1)
      [ "$last" = "GOAL=MET" ] || reason="goal-check $id: $last"
    fi
  fi
fi

file=/tmp/goal-gate-$sid
count=0
[ -e "$file" ] && { count=$(cat -- "$file" 2>/dev/null) || count=0; }
[[ $count =~ ^[0-9]+$ ]] || count=0
max=${GOAL_GATE_MAX:-2}
[[ $max =~ ^[0-9]+$ ]] || max=2

if [ -z "$reason" ]; then
  printf '0\n' >"$file" 2>/dev/null
  exit 0
fi
if (( 10#$count >= 10#$max )); then
  printf '0\n' >"$file" 2>/dev/null
  if [ "$done_" -eq 1 ]; then
    jq -nc --arg m "⛔ ✅ DONE НЕ ПОДТВЕРЖДЁН (goal-gate): $reason. Итог этого ответа = PARTIAL." '{systemMessage:$m}'
  else
    jq -nc --arg m "⛔ goal-gate: $reason" '{systemMessage:$m}'
  fi
  exit 0
fi
printf '%s\n' "$((10#$count + 1))" >"$file" 2>/dev/null
jq -nc --arg r "$reason" '{decision:"block",reason:$r}'
exit 0
