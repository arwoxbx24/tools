#!/usr/bin/env bash
set -u
case ${1:-} in -h|--help) echo "usage: ship-promote <repo> --atom <id> --quote \"<цитата>\"  (переносит Dev в Prod)"; exit 0;; esac
bin=$(cd -- "$(dirname -- "$0")" && pwd)
. "$bin/git-auto-lib"

logdir=${GA_LOG_DIR:-/root/workspaces/tools/logs}
mkdir -p "$logdir"
ship_log="$logdir/ship.log"
name='-'; branch='-'

usage(){ cat >&2 <<'EOF'
usage: ship-promote <repo> --atom <id> --quote "<цитата>"
exit codes: 10 preflight/usage/quote/no-pr/atom, 30 push, 40 dev-ci, 50 ancestor/sha/merge, 60 prod-ci/close, 70 fetch/pr-read, 75 locked, 0 promoted/prod-hold
EOF
leave 10 usage
}

repo=''; atom=''; quote=''; reload=''
while [[ $# -gt 0 ]]; do
	case $1 in
		--atom) atom=${2:-}; shift 2 ;;
		--quote) quote=${2:-}; shift 2 ;;
		--reload) reload=${2:-}; shift 2 ;;
		-*) usage ;;
		*) repo=$1; shift ;;
	esac
done
[[ -n $repo && -n $atom ]] || usage
repo=${repo%/}

if [[ -z ${quote//[[:space:]]/} ]]; then
	echo 'ship-promote: нужна дословная цитата владельца' >&2
	leave 10 quote
fi
quote=${quote//$'\n'/ }

# ga_repo_of сверяет git-common-dir; для основного клона (не worktree) он отдаёт
# относительный путь и совпадение не находится — тогда имя = имя каталога репо.
name=$(ga_repo_of "$repo") || name="${repo##*/}"

read -r mode base prod <<< "$(ga_base "$repo")"
[[ -n "$base" ]] || leave 10 preflight
reason=$(ga_skip_reason "$name")
if [[ $(ga_class "$name" "$mode") == guarded ]]; then
	echo "prod:hold guarded $reason — защиту снимает только слово владельца по закону" >&2
	leave 0 prod-hold
fi

st=$(bd show "$atom" --json 2>/dev/null) || st=''
status=$(printf '%s' "$st" | jq -r '.[0].status // empty' 2>/dev/null)
case $status in
	open|in_progress) : ;;
	closed) [[ $mode == one ]] || { echo 'ship-promote: атом закрыт или уже перенесён' >&2; leave 10 atom; } ;;
	*) echo 'ship-promote: атом закрыт или уже перенесён' >&2; leave 10 atom ;;
esac
if printf '%s' "$st" | jq -r '.[0].notes | if type=="array" then .[] else . end' 2>/dev/null | grep -q '^promote:'; then
	echo 'ship-promote: атом закрыт или уже перенесён' >&2; leave 10 atom
fi

ga_ctx "$name" 2>/dev/null; slug=$GA_SLUG; unset GIT_DIR GIT_WORK_TREE GA_LIVE GA_SLUG
gg_log 0 "quote: $quote"

promote(){
	git -C "$repo" fetch -q origin || leave 70 fetch
	sha=$(git -C "$repo" rev-parse origin/dev)
	ga_ci_wait sha "$slug" "$sha" dev || { echo "ship-promote: CI dev для $sha не зелёный" >&2; leave 40 dev-ci; }
	git -C "$repo" merge-base --is-ancestor "origin/$prod" "$sha" \
		|| { echo 'ship-promote: в prod есть коммиты вне dev — влей prod в dev' >&2; leave 50 ancestor; }
	push_ms=$(( $(date +%s) * 1000 ))
	git -C "$repo" push -q origin "$sha:refs/heads/$prod" || leave 30 push
	bd note "$atom" "promote: $sha quote=$quote"
	ga_ci_wait sha "$slug" "$sha" "$prod" || {
		echo 'ship-promote: CI prod красный/нет' >&2
		bd note "$atom" "prod-ci: red $sha"
		leave 60 prod-ci
	}
	read -r prc pstep <<< "$(ga_live_sync "$name" "$sha" "$push_ms" "$reload")"
	[[ $prc == 0 ]] || leave "$prc" "$pstep"
	bd close "$atom" --reason "promote $sha: prod = dev, CI prod зелёный" || leave 60 close
	leave 0 promoted
}

promote_plain(){
	local pr num head head_oid sha merge_sha prc pstep merge_ms
	pr=$(gh pr list -R "$slug" --state open --json number,headRefName,headRefOid,title --jq "[.[]|select(.title|startswith(\"$atom:\"))][0]") || leave 70 pr-read
	[[ -n $pr && $pr != null ]] || { echo 'ship-promote: у атома нет открытого PR' >&2; leave 10 no-pr; }
	num=$(printf '%s' "$pr" | jq -r '.number // empty' 2>/dev/null) || leave 70 pr-read
	head=$(printf '%s' "$pr" | jq -r '.headRefName // empty' 2>/dev/null) || leave 70 pr-read
	head_oid=$(printf '%s' "$pr" | jq -r '.headRefOid // empty' 2>/dev/null) || leave 70 pr-read
	[[ -n $num && -n $head && -n $head_oid ]] || leave 70 pr-read
	sha=$(git -C "$repo" rev-parse --verify -q "refs/dev-ready/$head") || sha=''
	if [[ -z $sha || $sha != "$head_oid" ]]; then
		echo 'ship-promote: SHA PR не тот, что проверен в dev' >&2
		leave 50 sha
	fi
	gh pr merge "$num" -R "$slug" --squash --match-head-commit "$sha" || leave 50 merge
	merge_sha=$(gh pr view "$num" -R "$slug" --json mergeCommit --jq .mergeCommit.oid) || leave 50 merge
	[[ -n $merge_sha && $merge_sha != null ]] || leave 50 merge
	bd note "$atom" "promote: $merge_sha pr=$num dev=$sha quote=$quote"
	merge_ms=$(( $(date +%s) * 1000 ))
	read -r prc pstep <<< "$(ga_live_sync "$name" "$merge_sha" "$merge_ms" "$reload")"
	[[ $prc == 0 ]] || leave "$prc" "$pstep"
	case $status in
		open|in_progress) bd close "$atom" --reason "promote $merge_sha" || leave 60 close ;;
	esac
	leave 0 promoted
}

if [[ $mode == one ]]; then
	ga_lock "$name" 60 promote_plain
else
	ga_lock "$name" 60 promote
fi
