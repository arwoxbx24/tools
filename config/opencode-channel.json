{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "lsp": false,
  "autoupdate": false,
  "provider": {
    "opencode-go": {
      "options": {
        "timeout": false
      }
    }
  },
  "mcp": {
    "vibecode": { "enabled": false },
    "context7": { "enabled": false },
    "repowise": { "enabled": false },
    "codebase-memory-mcp": { "enabled": false }
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "developer": {
      "description": "Senior developer for code-channel Go runs: minimal exact change inside the TZ FILE lines.",
      "mode": "primary",
      "prompt": "{file:../sdk-agent/system-prompt.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "audit": {
      "prompt": "{file:../sdk-agent/system-prompt.md}",
      "permission": {
        "bash": {
          "bd --readonly *": "allow"
        }
      }
    }
  }
}
