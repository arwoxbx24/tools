#!/bin/sh
# secret-gate диспетчер git-хуков: проверка секретов при коммите + цепочка хуков.
name=$(basename "$0")
Z=0000000000000000000000000000000000000000
SG=/root/workspaces/tools/bin/secret-gate
MIRROR_REPOS_DIR="/home/gitmirror/repos/"

# U13: barrier only warns — never blocks commit/push. Prints a WARN to stderr
# and appends a line to the log; a log write failure is ignored. Always exits 0.
warn() {
  echo "WARN: $1" >&2
  { printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$PWD" "$1"
  } >>"${SECRET_WARN_LOG:-/root/workspaces/system/services/gitmirror/secret-warn.log}" 2>/dev/null || true
}

if [ "$name" = "pre-commit" ]; then
  if ! "$SG" check --staged; then
    warn "secret-gate check --staged"
  fi
  if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "false" ]; then
    if [ -f "$(git rev-parse --show-toplevel)/.pre-commit-config.yaml" ]; then
      /root/.local/bin/pre-commit run --config "$(git rev-parse --show-toplevel)/.pre-commit-config.yaml" --hook-stage pre-commit || exit 1
    fi
  fi
fi

if [ "$name" = "pre-push" ]; then
  # bare GitLab mirrors re-push GitHub history and have no work tree: skip the scan
  is_bare=$(git rev-parse --is-bare-repository 2>/dev/null)
  gd=$(git rev-parse --absolute-git-dir 2>/dev/null)
  if [ "$is_bare" = "true" ]; then
    case "$gd/" in "$MIRROR_REPOS_DIR"*) exit 0 ;; esac
  fi
  tmp=
  if tmp=$(mktemp); then
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    cat > "$tmp"
  else
    echo "pre-push: cannot read refs, push refused" >&2
    exit 1
  fi
  # branch guard (dcfg-lvdzi): no branch delete without safe-delete archive tag, no history overwrite; any command spelling
  guard=on
  case "$2" in /tmp/*|file:///tmp/*) guard=off ;; esac
  # gitleaks on the commits each pushed ref adds; deletes (local sha $Z) are skipped
  while read -r lref lsha rref rsha; do
    if [ "$guard" = on ]; then
      case "$rref" in
        refs/heads/*)
          b=${rref#refs/heads/}
          if [ "$lsha" = "$Z" ]; then
            case "$b" in
              main|master) echo "pre-push: delete of $b refused" >&2; exit 1 ;;
            esac
            t=$(printf %s "$b" | tr / -)
            ok=
            for tsha in $(git ls-remote "$2" "refs/tags/archive/$t-*" 2>/dev/null | cut -f1); do
              [ "$tsha" = "$rsha" ] && ok=1
            done
            [ -n "$ok" ] || { echo "pre-push: delete of $b refused: no archive tag; use tools/bin/safe-delete branch <repo> $b" >&2; exit 1; }
          elif [ "$rsha" != "$Z" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
            echo "pre-push: non-fast-forward update of $b refused" >&2
            exit 1
          fi
          ;;
      esac
    fi
    [ "$lsha" = "$Z" ] && continue
    if [ "$rsha" = "$Z" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
    (cd "$(git rev-parse --show-toplevel)" && /root/.local/bin/gitleaks git --redact --no-banner --log-opts "$range") || { echo "gitleaks: push refused" >&2; exit 1; }
  done < "$tmp"
fi

hook="$(git rev-parse --git-common-dir)/hooks/$name"
if [ -x "$hook" ]; then
  if [ "$name" = "pre-push" ] && [ -n "$tmp" ]; then
    "$hook" "$@" < "$tmp"
    exit $?
  else
    exec "$hook" "$@"
  fi
elif [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "false" ]; then
  hook="$(git rev-parse --show-toplevel)/.beads/hooks/$name"
  if [ -x "$hook" ]; then
    if [ "$name" = "pre-push" ] && [ -n "$tmp" ]; then
      "$hook" "$@" < "$tmp"
      exit $?
    else
      exec "$hook" "$@"
    fi
  fi
fi
exit 0
