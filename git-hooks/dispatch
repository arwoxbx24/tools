#!/bin/sh
# gitleaks/secret-gate диспетчер git-хуков: сканирование секретов + цепочка хуков.
name=$(basename "$0")
Z=0000000000000000000000000000000000000000
SG=/root/workspaces/tools/bin/secret-gate

# U13: barrier only warns — never blocks commit/push. Prints a WARN to stderr
# and appends a line to the log; a log write failure is ignored. Always exits 0.
warn() {
  echo "WARN: $1" >&2
  { printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?')" "$PWD" "$1"
  } >>"${SECRET_WARN_LOG:-/root/workspaces/system/services/gitmirror/secret-warn.log}" 2>/dev/null || true
}

if [ "$name" = "pre-commit" ]; then
  if ! "$SG" check --staged; then
    warn "secret-gate check --staged"
  fi
fi

if [ "$name" = "pre-push" ]; then
  tmp=
  if tmp=$(mktemp); then
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    cat > "$tmp"
  else
    warn "не удалось создать временный файл; проверка на секреты пропущена"
  fi
  if [ -n "$tmp" ]; then
    if [ ! -x "$SG" ]; then
      warn "secret-gate недоступен"
    fi
    while read -r local_ref local_sha remote_ref remote_sha; do
      [ "$local_sha" = "$Z" ] && continue      # удаление ветки — пропуск
      if [ "$remote_sha" = "$Z" ]; then
        range="$local_sha --not --remotes=$1/*"     # новая ветка
      else
        range="$remote_sha..$local_sha"
      fi
      if ! /root/.local/bin/gitleaks git --no-banner --redact --log-opts="$range"; then
        warn "gitleaks нашёл секрет в отправляемых коммитах ($range)"
      fi
      if [ "$remote_sha" = "$Z" ]; then
        if ! "$SG" check "$local_sha" --not "--remotes=$1/*"; then
          warn "secret-gate check $range"
        fi
      elif ! "$SG" check "$remote_sha..$local_sha"; then
        warn "secret-gate check $range"
      fi
      case "$local_ref" in
        refs/tags/*)
          if [ "$(git cat-file -t "$local_sha" 2>/dev/null)" = "tag" ]; then
            if ! "$SG" check --tag "$local_sha"; then
              warn "secret-gate check --tag ($local_sha)"
            fi
          fi
          ;;
      esac
    done < "$tmp"
  fi
fi

# U7a/D12: after a commit/merge in a normal (non-bare) working repo, fire the
# local code-archive push detached so it never blocks the commit. The hook
# neither waits for it nor can change its result.
if [ "$name" = "post-commit" ] || [ "$name" = "post-merge" ]; then
  if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "false" ]; then
    setsid -f timeout 300 /root/workspaces/tools/bin/code-archive --local "$(git rev-parse --git-common-dir)" >/dev/null 2>&1 </dev/null || true
  fi
fi

hook="$(git rev-parse --git-common-dir)/hooks/$name"
if [ -x "$hook" ]; then
  if [ "$name" = "pre-push" ] && [ -n "$tmp" ]; then
    exec "$hook" "$@" < "$tmp"
  else
    exec "$hook" "$@"
  fi
elif [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "false" ]; then
  hook="$(git rev-parse --show-toplevel)/.beads/hooks/$name"
  if [ -x "$hook" ]; then
    if [ "$name" = "pre-push" ] && [ -n "$tmp" ]; then
      exec "$hook" "$@" < "$tmp"
    else
      exec "$hook" "$@"
    fi
  fi
fi
exit 0
